# Scriptase environment.
#
# Copy to `.env` (start.bat does this automatically on first run) and fill in
# what you need. Every value here is optional -- Scriptase boots without a .env
# and degrades to the providers that need no credentials.
#
# Loaded by tools/launch.ps1, NOT by the Python process: config.py reads
# os.environ only, so the backend carries no dotenv dependency and the test
# suite stays hermetic. A variable already set in your real environment always
# wins over the value here.
#
# Never commit .env -- it is gitignored. Provider credentials belong in the
# provider settings store as secret references, not in this file; these entries
# exist for local development and for the default provider instance only.

# --- Server ------------------------------------------------------------------
# SCRIPTASE_HOST=127.0.0.1     # loopback only; the API mutates the credential store
# SCRIPTASE_PORT=5000
# SCRIPTASE_DEBUG=0            # 1 enables the Flask reloader

# --- Runtime -----------------------------------------------------------------
# SCRIPTASE_GLOBAL_WORKERS=1   # global work-pool ceiling; 1 runs Jobs strictly
#                              # in submission order (steps 3.5, 13.1)
# SCRIPTASE_DISABLE_TRIGGERS=1 # do not start schedule/watch-folder/webhook services
# SCRIPTASE_DISABLE_RECONCILE=1 # skip crash recovery on boot (step 10.3)

# --- Storage overrides -------------------------------------------------------
# Point these at another drive to keep generated media off the system disk.
# SCRIPTASE_OUTPUT_DIR=
# SCRIPTASE_SETTINGS_DIR=
# SCRIPTASE_MODELS_DIR=
# SCRIPTASE_BIN_DIR=

# --- Provider credentials ----------------------------------------------------
# Used as the environment fallback for the DEFAULT instance of each provider
# type. Additional named instances hold their own settings in the provider
# store; see plans/contracts.md section 7.
# WAVESPEED_API_KEY=
# KIE_AI_API_KEY=
# INWORLD_API_KEY=
# OPENROUTER_API_KEY=

# --- Webhook endpoints -------------------------------------------------------
# N8N_WEBHOOK_URL=
# N8N_STORY_WEBHOOK_URL=
# N8N_STORYBOARD_WEBHOOK_URL=
# N8N_ASSET_WEBHOOK_URL=

# --- Testing -----------------------------------------------------------------
# STS_LIVE=1                   # run @pytest.mark.live tests against real providers
