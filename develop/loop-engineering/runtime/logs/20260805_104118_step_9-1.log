+            _edge("e2", "source", "script", "right", "script", "data"),
+        ],
+    )
+    state_lock = threading.Lock()
+    active = 0
+    maximum_active = 0
+
+    def resolver(node):
+        def execute(inputs, config, context):
+            nonlocal active, maximum_active
+            if node["id"] == "source":
