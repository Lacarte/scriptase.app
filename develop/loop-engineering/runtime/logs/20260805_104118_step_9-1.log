    def _run_sequential(self) -> ScheduleResult:
        scope = set(self.scope_node_ids)
        scoped_workflow = {
            **self.workflow,
            "nodes": [node for node in self.workflow.get("nodes", []) if node["id"] in scope],
            "edges": [
