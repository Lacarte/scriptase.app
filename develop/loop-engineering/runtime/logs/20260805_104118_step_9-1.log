+    def _status(
+        self,
+        statuses: dict[str, str],
+        node_id: str,
+        status: str,
+        *,
+        node_record: NodeExecutionRecord | None = None,
+    ) -> None:
+        # A node keeps its own event order on its worker thread.  This lock
+        # makes the shared execution snapshot and the corresponding SSE event
