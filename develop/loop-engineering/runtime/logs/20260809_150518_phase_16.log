447	    @contextmanager
448	    def lease(self):
449	        """Hold the provider open for one invocation.
450	
451	        A snapshot swap may drop this provider while a request is still using it;
452	        `retire()` waits for outstanding leases before calling `shutdown()`.
453	        """
454	        with self._lease_state:
455	            if self._retired:
456	                raise ProviderConstructionError(self.domain, self.id, "provider was retired")
457	            self._leases += 1
458	        try:
459	            yield self
460	        finally:
461	            with self._lease_state:
462	                self._leases -= 1
463	                if self._leases <= 0:
464	                    self._lease_state.notify_all()
