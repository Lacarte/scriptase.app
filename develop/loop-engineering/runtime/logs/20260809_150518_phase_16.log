202	@app.route("/api/chromium/activate-tab", methods=["POST"])
203	def activate_chromium_tab():
204	    """Activate a provider tab via WebSocket to the extension.
205	
206	    ``target`` is a canonical provider id or a documented input alias. The
207	    response echoes the canonical id so clients never re-learn a wire spelling.
208	    """
209	    data = request.get_json(silent=True) or {}
210	    raw_target = data.get("target") or ""
211	    ops = _extension_ops(raw_target)
212	    if ops is None:
213	        return jsonify({"ok": False, "error": f"Unknown target: {raw_target}"}), 400
214	
215	    # Retry briefly â€” extension WS may be mid-reconnect (2s cycle)
216	    if _retry_until(ops.activate, timeout_s=4.0, interval_s=1.0):
217	        return jsonify({"ok": True, "target": ops.provider_id})
218	
219	    return jsonify({
220	        "ok": False,
221	        "error": f"No {ops.label} extension connected",
222	        "target": ops.provider_id,
223	    }), 404
