795	def _atomic_write(files: list[tuple[Path, str]]) -> list[Path]:
796	    """Write every file, cleaning up completely on any failure."""
797	    created: list[Path] = []
798	    created_dirs: list[Path] = []
799	    try:
800	        for path, content in files:
801	            path.parent.mkdir(parents=True, exist_ok=True)
802	            if path.parent not in created_dirs and not any(
803	                path.parent == d or d in path.parent.parents for d in created_dirs
804	            ):
805	                # Track leaf dirs we created so failure can remove them.
806	                created_dirs.append(path.parent)
807	            if path.exists():
808	                raise ScaffoldError(f"refusing to overwrite existing file: {path}")
809	            path.write_text(content, encoding="utf-8", newline="\n")
810	            created.append(path)
811	    except Exception:
812	        for path in reversed(created):
813	            try:
814	                path.unlink(missing_ok=True)
815	            except OSError:
816	                pass
817	        # Remove empty provider dirs we introduced (deepest first).
818	        for directory in sorted(
819	            {p.parent for p in created},
820	            key=lambda p: len(p.parts),
821	            reverse=True,
822	        ):
823	            try:
824	                if directory.is_dir() and not any(directory.iterdir()):
825	                    directory.rmdir()
826	            except OSError:
827	                pass
828	        raise
829	    return created
