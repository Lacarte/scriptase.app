409	    def create(self) -> Any:
410	        """Construct the provider at most once per process.
411	
412	        Never called at import time or during discovery, and never while the
413	        registry lock is held: the lock taken here belongs to this instance alone.
414	        """
415	        if self._instance is not None:
416	            return self._instance
417	        with self._create_lock:
418	            if self._instance is not None:
419	                return self._instance
420	            if self._retired:
421	                raise ProviderConstructionError(self.domain, self.id, "provider was retired")
422	            if self._create_error is not None:
423	                raise ProviderConstructionError(self.domain, self.id, self._create_error)
424	            factory = self.create_callable
425	            if factory is None:
426	                self._create_error = "no create() factory found in the provider package"
427	                self.add_warning(self._create_error)
428	                raise ProviderConstructionError(self.domain, self.id, self._create_error)
429	            try:
430	                instance = factory()
431	            except Exception as e:
432	                self._create_error = v.sanitize_message(f"create() raised: {e}")
433	                self.add_warning(self._create_error)
434	                logger.error("[registry] create() failed for {}/{}: {}", self.domain, self.id, e)
435	                raise ProviderConstructionError(self.domain, self.id, self._create_error) from None
436	            if instance is None:
437	                self._create_error = "create() returned None"
438	                self.add_warning(self._create_error)
439	                raise ProviderConstructionError(self.domain, self.id, self._create_error)
440	            self._instance = instance
441	            self._construction_seq = next(_construction_counter)
442	            logger.info("[registry] Constructed provider '{}' in {}", self.id, self.domain)
443	            return instance
