471	    def retire(self, timeout: float = 5.0) -> None:
472	        """Stop new leases, wait for in-flight ones, then shut down."""
473	        with self._lease_state:
474	            self._retired = True
475	            if self._leases > 0:
476	                drained = self._lease_state.wait_for(lambda: self._leases <= 0, timeout=timeout)
477	                if not drained:
478	                    logger.warning(
479	                        "[registry] {}/{}: {} lease(s) still active after {}s; shutting down anyway",
480	                        self.domain, self.id, self._leases, timeout,
481	                    )
482	        self.shutdown()
