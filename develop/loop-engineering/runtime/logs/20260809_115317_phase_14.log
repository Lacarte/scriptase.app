 228: def mark_scene(project_id: str, index: Any, state: str, **fields) -> None:
 229:     """Set one scene's state and recount, atomically."""
 230:     with _lock:
 231:         job = read(project_id)
 232:         if job is None:
 233:             return
 234:         scenes = dict(job.get("scene_statuses") or {})
 235:         key = str(index)
 236:         entry = dict(scenes.get(key) or {})
 237:         entry["status"] = state
 238:         for name, value in fields.items():
 239:             entry[name] = value
 240:         scenes[key] = entry
 241:         job["scene_statuses"] = scenes
 242:         _recount(job)
 243:         save(project_id, job)
