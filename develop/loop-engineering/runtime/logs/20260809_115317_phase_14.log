 352: def extension_connected(hub: ExtensionWebSocketHub | None) -> bool:
 353:     """Safe connectivity probe used by preflight and health checks."""
 354:     if hub is None:
 355:         return False
 356:     try:
 357:         return bool(hub.is_connected())
 358:     except Exception:
 359:         return False
