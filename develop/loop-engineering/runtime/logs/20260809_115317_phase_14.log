 210:                 alive: list[Any] = []
 211:                 ping = json.dumps({"type": "PING"})
 212:                 for ws in self.clients:
 213:                     try:
 214:                         ws.send(ping)
 215:                         alive.append(ws)
 216:                     except Exception:
 217:                         pass
 218:                 self.clients[:] = alive
 219:                 logger.info("{} â†’ {} alive client(s)", tag, len(alive))
 220:             for ws in list(self.clients):
 221:                 try:
 222:                     ws.send(data)
 223:                     sent = True
 224:                 except Exception as exc:
 225:                     logger.warning("{} send failed: {}", tag, exc)
 226:         if sent:
 227:             logger.info("{} delivered to {} extension", tag, self.name)
 228:         else:
 229:             logger.warning("{} failed â€” no connected {} clients", tag, self.name)
 230:         return sent
 231: 
 232:     def relay(self, message: Mapping[str, Any], *, except_ws=None) -> int:
 233:         """Forward a diagnostic frame to every client except the sender."""
 234:         data = json.dumps(message)
 235:         others = 0
 236:         with self._clients_lock:
 237:             for client in list(self.clients):
 238:                 if client is except_ws:
 239:                     continue
 240:                 try:
 241:                     client.send(data)
 242:                     others += 1
 243:                 except Exception:
 244:                     pass
 245:         logger.info(
 246:             "[{}] Relayed {} to {} other client(s)",
 247:             self.name, message.get("type", "?"), others,
 248:         )
 249:         return others
 250: 
 251:     # -- pending queue ------------------------------------------------------
 252: 
 253:     def queue(self, message: Mapping[str, Any], *, label: str | None = None) -> bool:
 254:         """Queue an outbound job and try to deliver it immediately.
 255: 
 256:         Returns True when at least one connected client accepted the send.
 257:         The message stays pending either way so a late-connecting client still
 258:         receives it on handshake.
 259:         """
 260:         with self._pending_lock:
 261:             if self.pending_mode == "single":
 262:                 self._pending_single = dict(message)
 263:             else:
 264:                 self._pending.append(dict(message))
 265: 
 266:         tag = label or str(message.get("type") or "JOB")
 267:         project = message.get(self.project_key, "?")
 268:         scenes = message.get("scenes")
 269:         scene_count = len(scenes) if isinstance(scenes, list) else "?"
 270: 
 271:         sent = False
 272:         with self._clients_lock:
 273:             client_count = len(self.clients)
 274:             if self.clients:
 275:                 data = json.dumps(message)
 276:                 for ws in list(self.clients):
 277:                     try:
 278:                         ws.send(data)
 279:                         sent = True
 280:                     except Exception as exc:
 281:                         logger.warning("{} send failed to a client: {}", tag, exc)
 282: 
 283:         if sent:
 284:             logger.info(
 285:                 "{} â†’ {} extension ({} â€” {} scenes, clients: {}, awaiting JOB_RECEIVED)",
 286:                 tag, self.name, project, scene_count, client_count,
 287:             )
 288:         else:
 289:             logger.warning(
 290:                 "{} queued â€” NO connected clients ({} â€” {} scenes)",
 291:                 tag, project, scene_count,
 292:             )
 293:         return sent
 294: 
 295:     def flush_pending(self, ws) -> int:
 296:         """Re-send every pending message to a newly connected client."""
 297:         with self._pending_lock:
 298:             if self.pending_mode == "single":
 299:                 pending = [self._pending_single] if self._pending_single else []
 300:             else:
 301:                 pending = list(self._pending)
 302: 
 303:         flushed = 0
 304:         for msg in pending:
 305:             if msg is None:
 306:                 continue
 307:             try:
 308:                 ws.send(json.dumps(msg))
 309:                 flushed += 1
 310:                 logger.info(
 311:                     "[{}] Flushed pending {} to new client ({} â€” {} scenes)",
 312:                     self.name,
 313:                     msg.get("type", "?"),
 314:                     msg.get(self.project_key, "?"),
 315:                     len(msg.get("scenes") or []) if isinstance(msg.get("scenes"), list) else "?",
 316:                 )
 317:             except Exception as exc:
 318:                 logger.warning("[{}] Flush failed: {}", self.name, exc)
 319:         return flushed
 320: 
 321:     def drop_pending(self, project_id: str | None = None) -> int:
 322:         """Clear pending messages. With a project_id, only that project's jobs.
 323: 
 324:         For ``single`` mode the single slot is cleared when it matches (or when
 325:         ``project_id`` is None).
 326:         """
 327:         with self._pending_lock:
 328:             if self.pending_mode == "single":
 329:                 if self._pending_single is None:
 330:                     return 0
 331:                 if project_id is None or self._pending_single.get(self.project_key) == project_id:
 332:                     self._pending_single = None
 333:                     return 1
 334:                 return 0
 335:             before = len(self._pending)
 336:             if project_id is None:
 337:                 self._pending.clear()
 338:             else:
 339:                 self._pending[:] = [
 340:                     msg for msg in self._pending
 341:                     if msg.get(self.project_key) != project_id
 342:                 ]
 343:             return before - len(self._pending)
 344: 
 345:     def pending_count(self) -> int:
 346:         with self._pending_lock:
 347:             if self.pending_mode == "single":
 348:                 return 0 if self._pending_single is None else 1
 349:             return len(self._pending)
 350: 
