 583:             "jobId": job_id,
 584:             "projectId": project_id,
 585:             "sceneIndex": i,
 586:             "prompt": scene.get("prompt", ""),
 587:             "mode": mode,
 588:             "duration": duration,
 589:             "aspectRatio": aspect_ratio,
 590:         }
 591: 
 592:         # Resolve image: prefer base64, fall back to reading file
 593:         if scene.get("image_base64"):
 594:             payload["image"] = scene["image_base64"]
 595:         elif scene.get("image_path"):
 596:             img_path = scene["image_path"]
 597:             if os.path.isfile(img_path):
 598:                 import base64
 599:                 with open(img_path, "rb") as f:
 600:                     b64 = base64.b64encode(f.read()).decode()
 601:                 ext = os.path.splitext(img_path)[1].lstrip(".")
