 178: class CallbackIntake:
 179:     """Gate between a push transport and ``MediaJobService.apply_callback``."""
 180: 
 181:     def __init__(
 182:         self,
 183:         service: MediaJobService | None = None,
 184:         *,
 185:         store: MediaJobStore | None = None,
 186:         max_body_bytes: int = MAX_CALLBACK_BODY_BYTES,
 187:     ) -> None:
 188:         if service is not None:
 189:             self.service = service
 190:         else:
 191:             self.service = MediaJobService(store=store if store is not None else default_store())
 192:         self.max_body_bytes = max_body_bytes
 193:         self._lock = threading.Lock()
 194:         self._seen: dict[tuple[str, str, str, str], int] = {}
 195: 
 196:     def accept(
 197:         self,
 198:         *,
 199:         correlation: tuple[str, str, str, str] | None = None,
 200:         status: JobStatus | Mapping[str, Any] | None = None,
 201:         body: Any = None,
 202:         domain: str = "",
 203:         provider_id: str = "",
 204:         payload: Mapping[str, Any] | None = None,
 205:         max_body_bytes: int | None = None,
 206:         source: str = "push",
 207:     ) -> CallbackDisposition:
 208:         """Validate and apply a pushed status.
 209: 
 210:         Supply either a ready ``correlation`` + ``status``, or a raw ``payload``
 211:         (plus optional domain/provider defaults) to parse both from the body.
 212:         """
 213:         limit = self.max_body_bytes if max_body_bytes is None else max_body_bytes
 214:         size = measure_body(body if body is not None else payload if payload is not None else status)
 215:         if size > limit:
 216:             logger.warning(
 217:                 "[callbacks] rejecting oversized {} callback ({} bytes > {})",
 218:                 source, size, limit,
 219:             )
 220:             return CallbackDisposition(
 221:                 outcome=REJECTED_OVERSIZED,
 222:                 message=f"callback body exceeds {limit} bytes",
 223:             )
 224: 
 225:         resolved = correlation
 226:         if resolved is None:
 227:             resolved = parse_correlation(
 228:                 payload if payload is not None else (
 229:                     status if isinstance(status, Mapping) else None
 230:                 ),
 231:                 domain=domain,
 232:                 provider_id=provider_id,
 233:             )
 234:         if resolved is None:
 235:             logger.warning("[callbacks] rejecting malformed {} callback â€” no correlation", source)
 236:             return CallbackDisposition(
 237:                 outcome=REJECTED_MALFORMED,
 238:                 message="callback is missing domain/provider/project/job identity",
 239:             )
 240: 
 241:         domain_id, prov_id, project_id, job_id = resolved
 242:         if not all(resolved):
 243:             return CallbackDisposition(
 244:                 outcome=REJECTED_MALFORMED,
 245:                 correlation=resolved,
 246:                 message="callback correlation has empty components",
 247:             )
 248: 
 249:         # If a live job exists under a *different* provider/domain for the same
 250:         # project+job, refuse to apply â€” that is cross-provider contamination.
 251:         live = self.service.store.get(resolved)
 252:         if live is None:
 253:             # Look for any live job with the same project/job under another provider.
 254:             for other in self.service.store.snapshot():
 255:                 handle = other.handle
 256:                 if (
 257:                     handle.project_id == project_id
 258:                     and handle.job_id == job_id
 259:                     and (handle.domain != domain_id or handle.provider_id != prov_id)
 260:                 ):
 261:                     logger.warning(
 262:                         "[callbacks] dropping {} callback â€” correlation {} mismatches live {}",
 263:                         source, resolved, handle.correlation,
 264:                     )
 265:                     return CallbackDisposition(
 266:                         outcome=DROPPED_MISMATCH,
 267:                         correlation=resolved,
 268:                         message="callback provider/domain does not match the live job",
 269:                     )
 270: 
 271:         if status is None and payload is not None:
 272:             status = payload.get("status") if isinstance(payload.get("status"), (Mapping, JobStatus)) else payload
 273: 
 274:         if status is None:
 275:             return CallbackDisposition(
 276:                 outcome=REJECTED_MALFORMED,
 277:                 correlation=resolved,
 278:                 message="callback has no status payload",
 279:             )
 280: 
 281:         try:
 282:             if isinstance(status, JobStatus):
 283:                 job_status = status
 284:             elif isinstance(status, Mapping):
 285:                 # Ensure job_id is present for JobStatus construction.
 286:                 body_status = dict(status)
 287:                 body_status.setdefault("job_id", job_id)
 288:                 job_status = JobStatus.from_dict(body_status)
 289:             else:
 290:                 return CallbackDisposition(
 291:                     outcome=REJECTED_MALFORMED,
 292:                     correlation=resolved,
 293:                     message="callback status has an unexpected type",
 294:                 )
 295:         except Exception as exc:
 296:             logger.warning(
 297:                 "[callbacks] rejecting malformed status for {}: {}",
 298:                 resolved, sanitize_message(exc),
 299:             )
 300:             return CallbackDisposition(
 301:                 outcome=REJECTED_MALFORMED,
 302:                 correlation=resolved,
 303:                 message="callback status could not be parsed",
 304:             )
 305: 
 306:         # Snapshot unit states before apply so we can detect pure-duplicate pushes.
 307:         before = None
 308:         live_before = self.service.store.get(resolved)
 309:         if live_before is not None:
 310:             before = tuple(
 311:                 (unit.unit_index, unit.state) for unit in live_before.status.units
 312:             )
 313: 
 314:         applied = self.service.apply_callback(resolved, job_status)
 315:         if not applied:
 316:             logger.warning(
 317:                 "[callbacks] dropping {} callback for unknown correlation {}",
 318:                 source, resolved,
 319:             )
 320:             return CallbackDisposition(
 321:                 outcome=DROPPED_UNKNOWN,
 322:                 correlation=resolved,
 323:                 message="no live job for correlation",
 324:             )
 325: 
 326:         live_after = self.service.store.get(resolved)
 327:         after = None
 328:         if live_after is not None:
 329:             after = tuple(
 330:                 (unit.unit_index, unit.state) for unit in live_after.status.units
 331:             )
 332:         if before is not None and before == after:
 333:             return CallbackDisposition(
 334:                 outcome=IGNORED_DUPLICATE,
 335:                 correlation=resolved,
 336:                 message="duplicate terminal status ignored",
 337:             )
 338:         return CallbackDisposition(
 339:             outcome=APPLIED,
 340:             correlation=resolved,
 341:             message="callback applied",
 342:         )
 343: 
 344:     def accept_legacy_job(
 345:         self,
 346:         *,
 347:         domain: str,
 348:         provider_id: str,
 349:         project_id: str,
 350:         job: Mapping[str, Any] | None,
 351:         body: Any = None,
 352:         max_body_bytes: int | None = None,
 353:         aliases: Mapping[str, str] | None = None,
 354:         source: str = "legacy",
 355:     ) -> CallbackDisposition:
 356:         """Gate a legacy Automa/extension write against the job's recorded provider.
 357: 
 358:         Does **not** push into ``MediaJobService`` â€” legacy routes still write
 359:         the domain manifest. This only decides whether the write is allowed.
 360:         """
 361:         limit = (
 362:             MAX_MEDIA_CALLBACK_BYTES if max_body_bytes is None else max_body_bytes
 363:         )
 364:         size = measure_body(body)
 365:         if size > limit:
 366:             logger.warning(
 367:                 "[callbacks] rejecting oversized {} body for {}/{} ({} bytes)",
 368:                 source, domain, project_id, size,
 369:             )
 370:             return CallbackDisposition(
 371:                 outcome=REJECTED_OVERSIZED,
 372:                 correlation=correlation_tuple(domain, provider_id, project_id, project_id),
 373:                 message=f"callback body exceeds {limit} bytes",
 374:             )
 375: 
 376:         if not project_id:
 377:             return CallbackDisposition(
 378:                 outcome=REJECTED_MALFORMED,
 379:                 message="callback is missing project identity",
 380:             )
 381: 
 382:         if job is None:
 383:             logger.warning(
 384:                 "[callbacks] dropping {} for unknown project {} (domain={})",
 385:                 source, project_id, domain,
 386:             )
 387:             return CallbackDisposition(
 388:                 outcome=DROPPED_UNKNOWN,
 389:                 correlation=correlation_tuple(domain, provider_id, project_id, project_id),
 390:                 message="no job for project",
 391:             )
 392: 
 393:         if not job_matches_provider(job, provider_id=provider_id, aliases=aliases):
 394:             recorded = str(job.get("provider") or "")
 395:             logger.warning(
 396:                 "[callbacks] dropping {} for {} â€” expected provider {}, job has {}",
 397:                 source, project_id, provider_id, recorded or "(none)",
 398:             )
 399:             return CallbackDisposition(
 400:                 outcome=DROPPED_MISMATCH,
