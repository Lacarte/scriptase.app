FILE studio/animator/jobs.py
   1: """The animator job manifest â€” one owner for `grabber_job.json` (step 14.3).
   2: 
   3: Before this step the route, the Kie AI background thread, the Automa upload
   4: handlers, and the workflow adapter each wrote the same file with different
   5: rules, and Kie options were merged with inverted precedence. Providers now own
   6: only remote/local generation mechanics and call `record_ready` / `record_error`
   7: when a unit settles; the manifest shape, thumbnails, and status counters are
   8: applied here, identically for every provider.
   9: 
  10: `grabber_job.json` stays authoritative and public (Â§17.1): the legacy status
  11: route, the pipeline poller, and the Assets page all keep reading the same
  12: document. While the process lives the in-memory store is preferred (Automa
  13: callbacks land on the request thread while a worker may be writing), and the
  14: file is the restart path â€” the same dual-write the route has always had.
  15: """
  16: 
  17: from __future__ import annotations
  18: 
  19: import os
  20: import subprocess
  21: import threading
  22: from datetime import datetime
  23: from typing import Any, Mapping
  24: 
  25: from loguru import logger
  26: 
  27: from config import ANIMATOR_DIR, THUMBNAILS_DIR
  28: from studio.ffmpeg_utils import find_ffmpeg
  29: from studio.io_utils import JobStore, now_iso, safe_json_read, safe_json_write
  30: from studio.shared.providers_common.jobs import (
  31:     RUNNING,
  32:     JobStatus,
  33:     status_from_scenes,
  34: )
  35: 
  36: MANIFEST_NAME = "grabber_job.json"
  37: VIDEO_EXTS = (".mp4", ".webm", ".mov")
  38: IMAGE_EXTS = (".jpg", ".jpeg", ".png", ".webp")
  39: 
  40: # In-memory store is authoritative while the process lives; the file is the
  41: # restart path. Both writers always go through this module.
  42: _store = JobStore()
  43: _lock = threading.RLock()
  44: 
  45: # Compatibility alias so `from studio.animator.animation_routes import grabber_jobs`
  46: # and any external reader that already holds a reference keep resolving.
  47: grabber_jobs = _store
  48: 
  49: 
  50: # -- paths -------------------------------------------------------------------
  51: 
  52: 
  53: def project_dir(project_id: str) -> str:
  54:     return os.path.join(ANIMATOR_DIR, project_id)
  55: 
  56: 
  57: def manifest_path(project_id: str) -> str:
  58:     return os.path.join(project_dir(project_id), MANIFEST_NAME)
  59: 
  60: 
  61: def scene_dir(project_id: str, index: Any) -> str:
  62:     return os.path.join(project_dir(project_id), str(index))
  63: 
  64: 
  65: def local_path(project_id: str, index: Any, filename: str) -> str:
  66:     """The browser-facing `/output/...` path the manifest has always stored."""
  67:     return f"/output/animator/{project_id}/{index}/{filename}"
  68: 
  69: 
  70: def thumbnail_path(project_id: str, index: Any) -> str:
  71:     return os.path.join(THUMBNAILS_DIR, project_id, "animator", f"{index}.jpg")
  72: 
  73: 
  74: # -- store access ------------------------------------------------------------
  75: 
  76: 
  77: def get(project_id: str) -> dict | None:
  78:     """In-memory job, if the process still holds it."""
  79:     job = _store.get(project_id)
  80:     return dict(job) if isinstance(job, Mapping) else None
  81: 
  82: 
  83: def set_job(project_id: str, job: Mapping[str, Any]) -> None:
  84:     """Publish a job into the in-memory store (does not touch disk)."""
  85:     _store.set(project_id, dict(job))
  86: 
  87: 
  88: def read(project_id: str) -> dict | None:
  89:     """Current job: memory first, then the on-disk manifest."""
  90:     live = get(project_id)
  91:     if live is not None:
  92:         return live
  93:     path = manifest_path(project_id)
  94:     if not os.path.isfile(path):
  95:         return None
  96:     try:
  97:         data = safe_json_read(path)
  98:     except (OSError, ValueError):
  99:         return None
 100:     if not isinstance(data, Mapping):
 101:         return None
 102:     job = dict(data)
 103:     # Rehydrate so subsequent writers and the status route see one copy.
 104:     _store.set(project_id, job)
 105:     return job
 106: 
 107: 
 108: def save(project_id: str, job: Mapping[str, Any] | None = None) -> None:
 109:     """Persist the job to disk and keep the in-memory copy in sync. Never raises."""
 110:     with _lock:
 111:         current = dict(job) if job is not None else get(project_id)
 112:         if current is None:
 113:             return
 114:         current["updated_at"] = now_iso()
 115:         try:
 116:             safe_json_write(manifest_path(project_id), current, indent=2)
 117:         except OSError as exc:
 118:             logger.error("[animator] could not save {}: {}", MANIFEST_NAME, exc)
 119:         _store.set(project_id, current)
 120: 
