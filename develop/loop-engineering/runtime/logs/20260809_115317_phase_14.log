 357: def _recount(job: dict) -> None:
 358:     """Recompute `ready`/`errors`/`total` from the scene map."""
 359:     scenes = job.get("scene_statuses") or {}
 360:     ready = sum(
 361:         1 for entry in scenes.values()
 362:         if isinstance(entry, Mapping) and entry.get("status") in ("ready", "done")
 363:     )
 364:     errors = sum(
 365:         1 for entry in scenes.values()
 366:         if isinstance(entry, Mapping) and entry.get("status") == "error"
 367:     )
 368:     job["ready"] = ready
 369:     job["errors"] = errors
 370:     job["total"] = max(int(job.get("total") or 0), len(scenes))
 371:     if job["total"] and ready + errors >= job["total"]:
 372:         if job.get("status") not in ("done", "error"):
 373:             job["status"] = "done"
 374:         if not job.get("completed_at"):
 375:             job["completed_at"] = now_iso()
 376:             job["generation_time"] = _elapsed_seconds(job)
 377: 
 378: 
 379: # -- media helpers -----------------------------------------------------------
 380: 
 381: 
 382: def requires_video(job: Mapping[str, Any] | None) -> bool:
 383:     """True when the job is expected to produce videos only (Grok video mode)."""
 384:     if not isinstance(job, Mapping):
 385:         return False
 386:     payload = job.get("payload") or {}
 387:     if not isinstance(payload, Mapping):
 388:         return False
 389:     return str(payload.get("grok_mode") or payload.get("mode") or "").lower() == "video"
 390: 
 391: 
 392: def looks_like_video(value: str) -> bool:
 393:     clean = str(value or "").split("?", 1)[0].lower()
 394:     return clean.endswith(VIDEO_EXTS) or "/generated_video" in clean
 395: 
 396: 
 397: def filter_video_urls(urls) -> list:
 398:     return [url for url in (urls or []) if looks_like_video(url)]
 399: 
 400: 
 401: def filter_video_images(images) -> list:
 402:     filtered = []
 403:     for image in images or []:
 404:         if not isinstance(image, Mapping):
 405:             continue
 406:         ext = str(image.get("ext", "")).lower()
 407:         source_url = image.get("source_url", "")
 408:         filename = image.get("filename", "")
 409:         if ext in VIDEO_EXTS or looks_like_video(source_url) or looks_like_video(filename):
 410:             filtered.append(image)
 411:     return filtered
 412: 
 413: 
 414: def generate_video_thumbnail(video_path: str, project_id: str, index: Any) -> str | None:
 415:     """Extract a thumbnail jpg from a video file. Returns a URL or None."""
 416:     # Prefer a co-located `_thumb.jpg` when the organizer already wrote one.
 417:     sibling = video_path.rsplit(".", 1)[0] + "_thumb.jpg"
 418:     destination = thumbnail_path(project_id, index)
 419:     ffmpeg = find_ffmpeg()
 420:     if not ffmpeg:
 421:         if os.path.isfile(sibling):
 422:             return f"/api/thumbnails/{project_id}/animator/{index}.jpg"
 423:         return None
 424:     try:
 425:         os.makedirs(os.path.dirname(destination), exist_ok=True)
 426:         target = destination if not os.path.isfile(sibling) else sibling
 427:         if not os.path.isfile(target):
 428:             subprocess.run(
 429:                 [ffmpeg, "-y", "-i", video_path, "-map", "0:v:0",
 430:                  "-vframes", "1", "-ss", "0.1", "-q:v", "3", destination],
 431:                 capture_output=True, timeout=10,
 432:             )
 433:             target = destination
 434:         if os.path.isfile(target) and target != destination:
 435:             # Copy sibling into the managed thumbnails tree when present.
 436:             import shutil
 437:             os.makedirs(os.path.dirname(destination), exist_ok=True)
 438:             shutil.copy2(target, destination)
 439:         if os.path.isfile(destination):
 440:             return f"/api/thumbnails/{project_id}/animator/{index}.jpg"
 441:     except (OSError, subprocess.SubprocessError):
 442:         pass
 443:     return None
 444: 
 445: 
 446: def generate_image_thumbnail(image_path: str, project_id: str, index: Any) -> str | None:
 447:     ffmpeg = find_ffmpeg()
 448:     if not ffmpeg:
 449:         return None
 450:     destination = thumbnail_path(project_id, index)
 451:     try:
 452:         os.makedirs(os.path.dirname(destination), exist_ok=True)
 453:         subprocess.run(
 454:             [ffmpeg, "-y", "-i", image_path, "-vf", "scale=480:-1",
 455:              "-q:v", "4", destination],
 456:             capture_output=True, timeout=15,
 457:         )
 458:         if os.path.isfile(destination):
 459:             return f"/api/thumbnails/{project_id}/animator/{index}.jpg"
 460:     except (OSError, subprocess.SubprocessError):
 461:         pass
 462:     return None
 463: 
 464: 
 465: def _absolute_local(browser_path: str) -> str | None:
 466:     """Turn `/output/animator/...` into an absolute filesystem path."""
 467:     text = str(browser_path or "").replace("\\", "/")
 468:     if text.startswith("/output/animator/"):
 469:         relative = text[len("/output/animator/"):]
 470:         candidate = os.path.join(ANIMATOR_DIR, *relative.split("/"))
 471:         return candidate if os.path.isfile(candidate) else None
 472:     if os.path.isfile(text):
 473:         return text
 474:     return None
 475: 
 476: 
 477: def _probe_duration(path: str) -> float | None:
 478:     ffmpeg = find_ffmpeg()
 479:     if not ffmpeg:
 480:         return None
 481:     try:
 482:         completed = subprocess.run(
 483:             [ffmpeg, "-hide_banner", "-i", path],
 484:             capture_output=True, timeout=10,
 485:         )
 486:     except (OSError, subprocess.SubprocessError):
 487:         return None
 488:     import re
 489:     match = re.search(rb"Duration:\s*(\d+):(\d+):(\d+\.\d+)", completed.stderr or b"")
 490:     if not match:
 491:         return None
 492:     hours, minutes, seconds = match.groups()
 493:     return int(hours) * 3600 + int(minutes) * 60 + float(seconds)
 494: 
 495: 
 496: def _elapsed_seconds(job: Mapping[str, Any], *, include_running: bool = False) -> float:
 497:     try:
 498:         existing = float(job.get("generation_time", 0) or 0)
 499:         if existing > 0:
 500:             return round(existing, 3)
 501:     except (TypeError, ValueError):
 502:         pass
 503: 
 504:     start_dt = _parse_iso(job.get("created_at"))
 505:     if not start_dt:
 506:         return 0.0
 507:     end_dt = _parse_iso(job.get("completed_at"))
 508:     if end_dt is None and include_running:
 509:         end_dt = datetime.now().astimezone()
 510:     if end_dt is None:
 511:         end_dt = _parse_iso(job.get("updated_at"))
 512:     if end_dt is None:
 513:         return 0.0
 514:     if start_dt.tzinfo is not None:
 515:         start_dt = start_dt.replace(tzinfo=None)
 516:     if end_dt.tzinfo is not None:
 517:         end_dt = end_dt.replace(tzinfo=None)
 518:     return round(max((end_dt - start_dt).total_seconds(), 0.0), 3)
 519: 
 520: 
 521: def _parse_iso(value: Any) -> datetime | None:
 522:     if not value:
 523:         return None
 524:     try:
 525:         return datetime.fromisoformat(str(value))
 526:     except (TypeError, ValueError):
 527:         return None
 528: 
 529: 
 530: def elapsed_seconds(job: Mapping[str, Any], *, include_running: bool = False) -> float:
 531:     """Public wrapper used by the status and history routes."""
 532:     return _elapsed_seconds(job, include_running=include_running)
 533: 
 534: 
 535: def load_from_disk() -> None:
 536:     """Rehydrate the in-memory store from every on-disk grabber job."""
 537:     if not os.path.isdir(ANIMATOR_DIR):
 538:         return
 539:     from studio.animator.organizer import reconcile_project
 540: 
 541:     for entry in os.scandir(ANIMATOR_DIR):
 542:         if not entry.is_dir():
 543:             continue
 544:         pid = entry.name
 545:         try:
 546:             reconcile_project(ANIMATOR_DIR, pid)
 547:         except Exception as exc:
 548:             logger.debug("[animator] reconcile failed for {}: {}", pid, exc)
 549:         path = os.path.join(entry.path, MANIFEST_NAME)
 550:         if not os.path.isfile(path):
 551:             continue
 552:         try:
 553:             with open(path, "r", encoding="utf-8") as handle:
 554:                 import json
 555:                 job = json.load(handle)
 556:             if isinstance(job, dict):
 557:                 _store.set(pid, job)
 558:         except (OSError, ValueError, TypeError) as exc:
 559:             logger.warning("[animator] skipped loading job from {}: {}", pid, exc)
 560: 
 561: 
