  74:         self._pending_single: Mapping[str, Any] | None = None
  75:         self._pending_lock = threading.Lock()
  76:         self._registered = False
  77: 
  78:     # -- registration -------------------------------------------------------
  79: 
  80:     def register(self, sock) -> None:
