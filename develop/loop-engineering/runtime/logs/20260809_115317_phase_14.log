 131: class DirectApiClient:
 132:     """Thin requests session wrapper with shared classification and no POST retry.
 133: 
 134:     Parameters
 135:     ----------
 136:     base_url:
 137:         Optional prefix for relative paths.
 138:     default_headers:
 139:         Merged into every request (Authorization, Content-Type, â€¦).
 140:     timeout:
 141:         Default per-request timeout in seconds.
 142:     """
 143: 
 144:     def __init__(
 145:         self,
 146:         *,
 147:         base_url: str = "",
 148:         default_headers: Mapping[str, str] | None = None,
 149:         timeout: float = 30,
 150:         domain: str = "",
 151:         provider_id: str = "",
 152:         session: http_requests.Session | None = None,
 153:     ) -> None:
 154:         self.base_url = (base_url or "").rstrip("/")
 155:         self.default_headers = dict(default_headers or {})
 156:         self.timeout = timeout
 157:         self.domain = domain
 158:         self.provider_id = provider_id
 159:         self.session = session or http_requests.Session()
 160: 
 161:     def _url(self, path_or_url: str) -> str:
 162:         if path_or_url.startswith("http://") or path_or_url.startswith("https://"):
 163:             return path_or_url
 164:         if not self.base_url:
 165:             return path_or_url
 166:         return f"{self.base_url}/{path_or_url.lstrip('/')}"
 167: 
 168:     def request(
 169:         self,
 170:         method: str,
 171:         path_or_url: str,
 172:         *,
 173:         json: Mapping[str, Any] | None = None,
 174:         params: Mapping[str, Any] | None = None,
 175:         headers: Mapping[str, str] | None = None,
 176:         timeout: float | None = None,
 177:         retries: int = 0,
 178:     ) -> http_requests.Response:
 179:         """Issue one HTTP request. ``retries`` applies only to GET-like methods.
 180: 
 181:         Generation POSTs pass ``retries=0`` (the default) so a lost response
 182:         cannot duplicate remote work (D40).
 183:         """
 184:         method_u = method.upper()
 185:         if method_u not in {"GET", "HEAD"} and retries:
 186:             # Defensive: never silently retry a non-idempotent verb.
 187:             logger.warning(
 188:                 "[direct_api] ignoring retries={} for non-idempotent {}",
 189:                 retries, method_u,
 190:             )
 191:             retries = 0
 192: 
 193:         url = self._url(path_or_url)
 194:         hdrs = {**self.default_headers, **dict(headers or {})}
 195:         last_exc: BaseException | None = None
 196:         attempts = max(1, retries + 1)
 197: 
 198:         for attempt in range(attempts):
 199:             try:
 200:                 response = self.session.request(
 201:                     method_u,
 202:                     url,
 203:                     json=json,
 204:                     params=params,
 205:                     headers=hdrs,
 206:                     timeout=timeout if timeout is not None else self.timeout,
 207:                 )
 208:                 if response.status_code in _AUTH_STATUS:
 209:                     raise classify_http_error(
 210:                         http_requests.HTTPError(response=response),
 211:                         domain=self.domain,
 212:                         provider_id=self.provider_id,
 213:                         response=response,
 214:                     )
 215:                 if (
 216:                     response.status_code in _RETRYABLE_STATUS
 217:                     and attempt < attempts - 1
 218:                     and method_u in {"GET", "HEAD"}
 219:                 ):
 220:                     time.sleep(min(2 ** attempt, 8))
 221:                     continue
 222:                 response.raise_for_status()
 223:                 return response
 224:             except ProviderError:
 225:                 raise
 226:             except Exception as exc:
 227:                 last_exc = exc
 228:                 response = getattr(exc, "response", None)
 229:                 if attempt < attempts - 1 and method_u in {"GET", "HEAD"}:
 230:                     time.sleep(min(2 ** attempt, 8))
 231:                     continue
 232:                 raise classify_http_error(
 233:                     exc,
 234:                     domain=self.domain,
 235:                     provider_id=self.provider_id,
 236:                     response=response,
 237:                 ) from exc
 238: 
 239:         raise classify_http_error(
 240:             last_exc or RuntimeError("request failed"),
 241:             domain=self.domain,
 242:             provider_id=self.provider_id,
 243:         )
 244: 
 245:     def post_json(
 246:         self,
 247:         path_or_url: str,
 248:         payload: Mapping[str, Any],
 249:         *,
 250:         timeout: float | None = None,
 251:         headers: Mapping[str, str] | None = None,
 252:     ) -> Mapping[str, Any]:
 253:         """POST once (no transport retry) and return the JSON body."""
 254:         response = self.request(
 255:             "POST", path_or_url, json=payload, timeout=timeout, headers=headers, retries=0
 256:         )
 257:         try:
 258:             data = response.json()
 259:         except Exception as exc:
 260:             raise classify_http_error(
 261:                 exc, domain=self.domain, provider_id=self.provider_id, response=response
 262:             ) from exc
 263:         if not isinstance(data, Mapping):
 264:             raise DirectApiError(
 265:                 PROVIDER_RESPONSE_MALFORMED,
 266:                 "The API returned an unusable response",
 267:                 domain=self.domain,
 268:                 provider_id=self.provider_id,
 269:             )
 270:         return data
 271: 
 272:     def get_json(
 273:         self,
 274:         path_or_url: str,
 275:         *,
 276:         params: Mapping[str, Any] | None = None,
 277:         timeout: float | None = None,
 278:         headers: Mapping[str, str] | None = None,
 279:         retries: int = 2,
 280:     ) -> Mapping[str, Any]:
 281:         """GET with optional transient retries and return the JSON body."""
 282:         response = self.request(
 283:             "GET",
 284:             path_or_url,
 285:             params=params,
 286:             timeout=timeout,
 287:             headers=headers,
 288:             retries=retries,
 289:         )
 290:         try:
 291:             data = response.json()
 292:         except Exception as exc:
 293:             raise classify_http_error(
 294:                 exc, domain=self.domain, provider_id=self.provider_id, response=response
 295:             ) from exc
 296:         if not isinstance(data, Mapping):
 297:             raise DirectApiError(
 298:                 PROVIDER_RESPONSE_MALFORMED,
 299:                 "The API returned an unusable response",
 300:                 domain=self.domain,
 301:                 provider_id=self.provider_id,
 302:             )
 303:         return data
 304: 
 305:     def close(self) -> None:
 306:         self.session.close()
 307: 
 308: 
 309: def submit_and_poll(
 310:     client: DirectApiClient,
 311:     *,
 312:     submit_path: str,
 313:     submit_payload: Mapping[str, Any],
 314:     poll_path: str | Callable[[Mapping[str, Any]], str],
 315:     is_done: Callable[[Mapping[str, Any]], bool],
 316:     is_failed: Callable[[Mapping[str, Any]], bool] | None = None,
 317:     extract: Callable[[Mapping[str, Any]], Any],
 318:     poll_interval_s: float = 3.0,
 319:     poll_timeout_s: float = 180.0,
 320:     submit_timeout: float | None = None,
 321:     poll_timeout: float | None = None,
 322:     clock: Callable[[], float] = time.monotonic,
 323:     sleeper: Callable[[float], None] = time.sleep,
 324:     extract_poll_params: Callable[[Mapping[str, Any]], Mapping[str, Any] | None] | None = None,
 325: ) -> Any:
 326:     """POST once, then poll until ``is_done`` / failure / deadline.
 327: 
 328:     ``poll_path`` may be a string or a callable of the submit response so the
 329:     provider can build ``/jobs/{id}`` style URLs. The submit is never retried.
 330:     """
 331:     submitted = client.post_json(
 332:         submit_path, submit_payload, timeout=submit_timeout
 333:     )
 334: 
 335:     if callable(poll_path):
 336:         path = poll_path(submitted)
 337:     else:
 338:         path = poll_path
 339: 
 340:     deadline = clock() + poll_timeout_s
 341:     last: Mapping[str, Any] = submitted
 342:     while clock() < deadline:
 343:         params = None
 344:         if extract_poll_params is not None:
 345:             params = extract_poll_params(submitted)
 346:         last = client.get_json(path, params=params, timeout=poll_timeout)
 347:         if is_failed is not None and is_failed(last):
 348:             raise DirectApiError(
 349:                 PROVIDER_TRANSPORT_FAILED,
 350:                 "The remote job failed",
 351:                 domain=client.domain,
 352:                 provider_id=client.provider_id,
 353:             )
 354:         if is_done(last):
 355:             try:
 356:                 return extract(last)
 357:             except Exception as exc:
 358:                 raise classify_http_error(
 359:                     exc, domain=client.domain, provider_id=client.provider_id
 360:                 ) from exc
 361:         sleeper(poll_interval_s)
 362: 
 363:     raise DirectApiError(
 364:         PROVIDER_TIMEOUT,
 365:         "The remote job timed out",
 366:         retryable=True,
 367:         domain=client.domain,
 368:         provider_id=client.provider_id,
 369:     )
 370: 
 371: 
 372: __all__ = [
 373:     "DirectApiClient",
 374:     "DirectApiError",
 375:     "classify_http_error",
 376:     "submit_and_poll",
 377: ]
