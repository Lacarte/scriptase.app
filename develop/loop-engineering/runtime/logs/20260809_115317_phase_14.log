 729:     def _bind_cancel(
 730:         self, provider: Any, handle: JobHandle, invocation: ProviderInvocation
 731:     ) -> None:
 732:         cancel_job = getattr(provider, "cancel_job", None)
 733:         if not callable(cancel_job):
 734:             return
 735: 
 736:         def _on_cancel() -> None:
 737:             try:
 738:                 cancel_job(handle.job_id, invocation)
 739:             except Exception as exc:  # best-effort; never raise through cancel
 740:                 logger.warning(
 741:                     "[media_jobs] cancel_job raised for {}: {}", handle.job_id, exc
 742:                 )
 743:             # Reflect cancellation on the live record so waiters observe it.
 744:             cancelled = JobStatus(
 745:                 job_id=handle.job_id,
 746:                 state=JOB_CANCELLED,
 747:                 ready=0,
 748:                 total=0,
 749:             )
 750:             live = self.store.get(handle.correlation)
 751:             if live is not None and not live.status.terminal:
 752:                 try:
 753:                     live.status = live.status.advance(
 754:                         state=JOB_CANCELLED,
 755:                         ready=live.status.ready,
 756:                         total=live.status.total,
 757:                         units=live.status.units,
 758:                     )
 759:                 except ProviderError:
 760:                     pass
 761:                 live.event.set()
 762:                 if live.record_path:
 763:                     self.store.save(handle, live.status, live.record_path)
 764: 
 765:         invocation.cancel.on_cancel(_on_cancel)
