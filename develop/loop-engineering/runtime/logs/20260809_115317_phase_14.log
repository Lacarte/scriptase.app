 124:     def _storyboard_image(self, project_id: str, index) -> str | None:
 125:         directory = os.path.join(STORYBOARD_DIR, project_id, str(index))
 126:         if not os.path.isdir(directory):
 127:             return None
 128:         for name in os.listdir(directory):
 129:             if not (name.startswith("image") and name.lower().endswith(IMAGE_EXTS)):
 130:                 continue
 131:             path = os.path.join(directory, name)
 132:             try:
 133:                 with open(path, "rb") as handle:
 134:                     raw = handle.read()
