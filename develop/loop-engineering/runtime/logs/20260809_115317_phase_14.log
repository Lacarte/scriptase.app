 122: # -- lifecycle ---------------------------------------------------------------
 123: 
 124: 
 125: def seed(
 126:     project_id: str,
 127:     request,
 128:     *,
 129:     provider_id: str = "",
 130:     payload: Mapping[str, Any] | None = None,
 131:     grabber_id: str | None = None,
 132:     status: str = "waiting",
 133:     preserve_prior: bool = True,
 134: ) -> dict:
 135:     """Create the manifest for a new job and publish it.
 136: 
 137:     `provider_id` is recorded so a reader can tell which provider produced an
 138:     asset; it is metadata only and never drives dispatch. When `preserve_prior`
 139:     is true (the default), already-ready scenes that are *not* being resent keep
 140:     their status â€” the grabber start route has always done this so a partial
 141:     re-run does not wipe completed work.
 142:     """
 143:     scene_list = list(request.legacy_scenes()) if hasattr(request, "legacy_scenes") else []
 144:     prior = read(project_id) if preserve_prior else None
 145:     scene_statuses: dict[str, Any] = {}
 146:     if prior and isinstance(prior.get("scene_statuses"), Mapping):
 147:         scene_statuses = {
 148:             str(key): dict(value) if isinstance(value, Mapping) else value
 149:             for key, value in prior["scene_statuses"].items()
 150:         }
 151:     for scene in scene_list:
 152:         key = str(scene.get("scene", scene.get("index", 0)))
 153:         scene_statuses[key] = {
 154:             "status": "pending",
 155:             "urls": [],
 156:             "local_files": [],
 157:         }
 158: 
 159:     body = dict(payload or {})
 160:     if "projectId" not in body:
 161:         body["projectId"] = project_id
 162:     if "scenes" not in body:
 163:         body["scenes"] = scene_list
 164:     if "aspect_ratio" not in body:
 165:         body["aspect_ratio"] = getattr(request, "aspect_ratio", "9:16")
 166: 
 167:     stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
 168:     job = {
 169:         "grabber_id": grabber_id or f"grab_{stamp}_{project_id}",
 170:         "project_id": project_id,
 171:         "provider": provider_id,
 172:         "arguments": "",
 173:         "payload": body,
 174:         "scene_statuses": scene_statuses,
 175:         "status": status,
 176:         "created_at": now_iso(),
 177:         "updated_at": now_iso(),
 178:         "total": len(scene_list),
 179:         "ready": 0,
 180:         "errors": 0,
 181:     }
 182:     # Drop stale completion fields so a re-run is not reported as already done.
 183:     job.pop("completed_at", None)
 184:     job.pop("generation_time", None)
 185:     save(project_id, job)
 186:     return job
 187: 
 188: 
 189: def status(
 190:     project_id: str, job_id: str | None = None, *, unit_count: int = 0
 191: ) -> JobStatus:
 192:     """The `JobStatus` every animator provider's `poll` returns (Â§33.2)."""
 193:     from studio.shared.providers_common.media_jobs import (
 194:         JOB_DONE_STATES,
 195:         settled_state,
 196:         units_from_legacy_scenes,
 197:     )
 198: 
 199:     identity = job_id or project_id
 200:     job = read(project_id)
 201:     if job is None:
 202:         return JobStatus(job_id=identity, state=RUNNING, total=unit_count)
 203: 
 204:     raw = job.get("scene_statuses")
 205:     scenes = raw if isinstance(raw, Mapping) else {}
 206:     derived = status_from_scenes(identity, scenes)
 207:     produced = units_from_legacy_scenes(scenes)
 208:     total = derived.total or int(job.get("total") or 0) or unit_count
 209: 
 210:     state = derived.state
 211:     if not derived.terminal and str(job.get("status") or "") in JOB_DONE_STATES:
 212:         state = settled_state(produced, total)
 213: 
 214:     return JobStatus(
 215:         job_id=identity,
 216:         state=state,
 217:         ready=derived.ready,
 218:         total=total,
 219:         fraction=derived.fraction,
 220:         units=produced,
 221:         error=derived.error,
 222:     )
