   1: """Outbound n8n / webhook transport â€” step 14.4.
   2: 
   3: Wraps ``studio.webhooks.call_webhook`` so providers share one retry policy and
   4: map every failure onto the shared ``ProviderError`` catalog without copying
   5: response bodies (contracts.md Â§34.4 / L2). Domain-specific payload shape and
   6: response field extraction stay in the provider.
   7: """
   8: 
   9: from __future__ import annotations
  10: 
  11: from typing import Any, Callable, Mapping
  12: 
  13: import requests as http_requests
  14: 
  15: from studio.security import is_safe_webhook_url
  16: from studio.shared.providers_common.errors import (
  17:     PROVIDER_AUTH_FAILED,
  18:     PROVIDER_REQUEST_INVALID,
  19:     PROVIDER_RESPONSE_MALFORMED,
  20:     PROVIDER_TIMEOUT,
  21:     PROVIDER_TRANSPORT_FAILED,
  22:     ProviderError,
  23: )
  24: from studio.webhooks import call_webhook
  25: 
  26: _AUTH_MARKERS = (
  27:     "401", "403", "unauthorized", "forbidden", "invalid api key", "api key",
  28: )
  29: 
  30: 
  31: def classify_webhook_error(
  32:     exc: BaseException,
  33:     *,
  34:     domain: str = "",
  35:     provider_id: str = "",
  36: ) -> ProviderError:
  37:     """Map a webhook/transport failure onto the shared catalog.
  38: 
  39:     The original text never reaches the message: a raw body may embed URLs,
  40:     tokens, or third-party stack traces.
  41:     """
  42:     if isinstance(exc, ProviderError):
  43:         return exc
  44:     if isinstance(exc, http_requests.Timeout):
  45:         return ProviderError(
  46:             PROVIDER_TIMEOUT,
  47:             "The webhook timed out",
  48:             retryable=True,
  49:             domain=domain,
  50:             provider_id=provider_id,
  51:             cause_type=type(exc).__name__,
  52:         )
  53:     if isinstance(exc, http_requests.ConnectionError):
  54:         return ProviderError(
  55:             PROVIDER_TRANSPORT_FAILED,
  56:             "Could not reach the webhook",
  57:             retryable=True,
  58:             domain=domain,
  59:             provider_id=provider_id,
  60:             cause_type=type(exc).__name__,
  61:         )
  62:     text = str(exc).lower()
  63:     if any(marker in text for marker in _AUTH_MARKERS):
  64:         return ProviderError(
  65:             PROVIDER_AUTH_FAILED,
  66:             "The webhook rejected the credentials",
  67:             domain=domain,
  68:             provider_id=provider_id,
  69:             cause_type=type(exc).__name__,
  70:         )
  71:     if isinstance(exc, (ValueError, KeyError, TypeError)):
  72:         return ProviderError(
  73:             PROVIDER_RESPONSE_MALFORMED,
  74:             "The webhook returned an unusable response",
  75:             domain=domain,
  76:             provider_id=provider_id,
  77:             cause_type=type(exc).__name__,
  78:         )
  79:     return ProviderError(
  80:         PROVIDER_TRANSPORT_FAILED,
  81:         "The webhook failed",
  82:         retryable=True,
  83:         domain=domain,
  84:         provider_id=provider_id,
  85:         cause_type=type(exc).__name__,
  86:     )
  87: 
  88: 
  89: def post_webhook(
  90:     url: str,
  91:     payload: Mapping[str, Any],
  92:     *,
  93:     timeout: int = 180,
  94:     label: str = "Webhook",
  95:     allow_private: bool = True,
  96:     domain: str = "",
  97:     provider_id: str = "",
  98:     caller: Callable[..., Mapping[str, Any]] | None = None,
  99: ) -> Mapping[str, Any]:
 100:     """POST ``payload`` to ``url`` with the shared retry policy.
 101: 
 102:     Raises ``ProviderError`` (never a raw transport exception). An unsafe URL
 103:     fails closed as ``PROVIDER_REQUEST_INVALID`` before any network call.
 104:     """
 105:     target = (url or "").strip()
 106:     if not target:
 107:         raise ProviderError(
 108:             PROVIDER_REQUEST_INVALID,
 109:             "No webhook URL is configured",
 110:             domain=domain,
 111:             provider_id=provider_id,
 112:         )
 113:     if not is_safe_webhook_url(target, allow_private=allow_private):
 114:         raise ProviderError(
 115:             PROVIDER_REQUEST_INVALID,
 116:             "The webhook URL is not allowed",
 117:             domain=domain,
 118:             provider_id=provider_id,
 119:         )
 120: 
 121:     invoke = caller or call_webhook
 122:     try:
 123:         result = invoke(target, dict(payload), timeout=timeout, label=label)
 124:     except Exception as exc:
 125:         raise classify_webhook_error(exc, domain=domain, provider_id=provider_id) from exc
 126: 
 127:     if result is None:
 128:         raise ProviderError(
 129:             PROVIDER_RESPONSE_MALFORMED,
 130:             "The webhook returned an empty response",
 131:             domain=domain,
 132:             provider_id=provider_id,
 133:         )
 134:     if not isinstance(result, Mapping):
 135:         raise ProviderError(
 136:             PROVIDER_RESPONSE_MALFORMED,
 137:             "The webhook returned an unusable response",
 138:             domain=domain,
 139:             provider_id=provider_id,
 140:         )
 141:     return result
 142: 
 143: 
 144: def webhook_transport(
 145:     url: str,
 146:     *,
 147:     build_payload: Callable[..., Mapping[str, Any]],
 148:     extract: Callable[[Mapping[str, Any]], Any],
 149:     timeout: int = 180,
 150:     label: str = "Webhook",
 151:     allow_private: bool = True,
 152:     domain: str = "",
 153:     provider_id: str = "",
 154:     caller: Callable[..., Mapping[str, Any]] | None = None,
 155: ) -> Callable[..., Any]:
 156:     """Build a per-call transport: ``(*args, **kwargs) -> extract(response)``.
 157: 
 158:     ``build_payload`` and ``extract`` are the only domain-specific pieces. A
 159:     missing extract value becomes ``PROVIDER_RESPONSE_MALFORMED``.
 160:     """
 161: 
 162:     def generate(*args: Any, **kwargs: Any) -> Any:
 163:         payload = build_payload(*args, **kwargs)
 164:         result = post_webhook(
 165:             url,
 166:             payload,
 167:             timeout=timeout,
 168:             label=label,
 169:             allow_private=allow_private,
 170:             domain=domain,
 171:             provider_id=provider_id,
 172:             caller=caller,
 173:         )
 174:         try:
 175:             value = extract(result)
 176:         except Exception as exc:
 177:             raise classify_webhook_error(
 178:                 exc, domain=domain, provider_id=provider_id
 179:             ) from exc
 180:         if value is None or value == "":
 181:             raise ProviderError(
 182:                 PROVIDER_RESPONSE_MALFORMED,
 183:                 "The webhook returned no usable result",
 184:                 domain=domain,
 185:                 provider_id=provider_id,
 186:             )
 187:         return value
 188: 
 189:     return generate
 190: 
 191: 
 192: __all__ = [
 193:     "classify_webhook_error",
 194:     "post_webhook",
 195:     "webhook_transport",
 196: ]

