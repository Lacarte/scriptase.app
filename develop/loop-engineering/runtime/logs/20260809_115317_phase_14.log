 525: def submit_jobs():
 526:     """Submit animation jobs â€” sends image+prompt pairs to the extension."""
 527:     data = request.get_json(silent=True) or {}
 528:     project_id = sanitize_project_id(data.get("project_id", ""))
 529:     scenes = data.get("scenes", [])
