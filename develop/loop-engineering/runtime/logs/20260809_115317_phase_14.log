  82:         if sock is None:
  83:             logger.warning(
  84:                 "[{}] No socket provided, skipping runtime registration", self.name
  85:             )
  86:             return
  87:         if self._registered:
  88:             logger.debug("[{}] route {} already registered", self.name, self.route)
