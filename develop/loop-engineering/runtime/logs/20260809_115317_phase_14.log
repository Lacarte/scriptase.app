 246: def record_ready(
 247:     project_id: str,
 248:     index: Any,
 249:     local_files: list[str],
 250:     *,
 251:     urls: list[str] | None = None,
 252:     kind: str = "image",
 253: ) -> dict:
 254:     """Settle one unit as produced, with the same metadata for every provider.
 255: 
 256:     `local_files` are the browser-facing `/output/...` paths the organizer has
 257:     always returned. Remote `urls` are kept on the job for redownload only and
 258:     never cross into the workflow port (D38).
 259:     """
 260:     thumb = None
 261:     duration_s = None
 262:     if local_files:
 263:         absolute = _absolute_local(local_files[0])
 264:         if absolute and kind == "video":
 265:             thumb = generate_video_thumbnail(absolute, project_id, index)
 266:             duration_s = _probe_duration(absolute)
 267:         elif absolute:
 268:             thumb = generate_image_thumbnail(absolute, project_id, index)
 269: 
 270:     entry = {
 271:         "status": "ready",
 272:         "local_files": list(local_files or []),
 273:         "urls": list(urls or []),
 274:     }
 275:     if thumb:
 276:         entry["thumb_path"] = thumb
 277:     if duration_s is not None:
 278:         entry["duration_s"] = duration_s
 279:     if kind:
 280:         entry["kind"] = kind
 281:     mark_scene(
 282:         project_id, index, "ready",
 283:         **{k: v for k, v in entry.items() if k != "status"},
 284:     )
 285:     return entry
 286: 
 287: 
 288: def record_error(project_id: str, index: Any, message: str = "") -> None:
 289:     """Settle one unit as failed with a caller-supplied, already-safe message."""
 290:     fields: dict[str, Any] = {"local_files": [], "urls": []}
 291:     if message:
