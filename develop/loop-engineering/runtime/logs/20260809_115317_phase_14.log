 103:         logger.info("[{}] registered WebSocket route {}", self.name, self.route)
 104: 
 105:     def _serve(self, ws) -> None:
 106:         with self._clients_lock:
 107:             self.clients.append(ws)
 108:             count = len(self.clients)
 109:         logger.info("[{}] WS client connected (clients: {})", self.name, count)
 110: 
 111:         if self.on_connect is not None:
 112:             try:
 113:                 self.on_connect(ws)
 114:             except Exception as exc:
 115:                 logger.warning("[{}] on_connect failed: {}", self.name, exc)
