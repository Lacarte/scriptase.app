 694:     def _submit(
 695:         self, provider: Any, request: Any, invocation: ProviderInvocation
 696:     ) -> JobHandle:
 697:         try:
 698:             handle = provider.submit(request, invocation)
 699:         except ProviderCancelled:
 700:             raise
 701:         except ProviderError:
 702:             raise
 703:         except BaseException as exc:
 704:             raise wrap_exception(
 705:                 exc,
 706:                 domain=invocation.domain,
 707:                 provider_id=invocation.provider_id,
 708:                 log=invocation.log,
 709:             ) from None
 710:         if not isinstance(handle, JobHandle):
 711:             raise ProviderError(
 712:                 "PROVIDER_RESULT_INVALID",
 713:                 "Provider submit() must return a JobHandle",
 714:                 domain=invocation.domain,
 715:                 provider_id=invocation.provider_id,
 716:             )
 717:         # Fill identity the provider may have left blank so correlation works.
 718:         if not handle.domain or not handle.provider_id or not handle.project_id:
 719:             handle = JobHandle(
 720:                 job_id=handle.job_id,
 721:                 domain=handle.domain or invocation.domain,
 722:                 provider_id=handle.provider_id or invocation.provider_id,
 723:                 project_id=handle.project_id or invocation.project_id,
 724:                 invocation_id=handle.invocation_id or invocation.invocation_id,
 725:                 created_at=handle.created_at,
 726:             )
 727:         return handle
