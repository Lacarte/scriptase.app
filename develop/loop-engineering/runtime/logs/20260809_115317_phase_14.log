   1: """Gemini image generator â€” WebSocket bridge for the storyboard extension.
   2: 
   3: Provides:
   4:   WS  /ws/storyboard-gemini-image-grabber  â€” endpoint for the Gemini extension
   5: 
   6: Protocol (Extension â†’ Server):
   7:   { type: "EXTENSION_READY", source: "sts-gemini-ext" }
   8:   { type: "IMAGE_UPLOAD", projectId, scene, image: { data, source_url } }
   9:   { type: "STATUS_UPDATE", projectId, scene, status }
  10:   { type: "JOB_RECEIVED", projectId, scenes }
  11:   { type: "JOB_COMPLETE", projectId }
  12: 
  13: Protocol (Server â†’ Extension):
  14:   { type: "IMAGE_JOB", projectId, scenes: [...], aspectRatio, autoType }
  15:   { type: "PONG" }
  16: 
  17: Step 14.2 reduced this module to transport + domain handlers. Step 14.4 moves
  18: the client pool, pending queue, prune, and broadcast onto the shared
  19: ``ExtensionWebSocketHub``; this file keeps only Gemini message handling and the
  20: ``auto_animate`` hand-off. The frozen route path is unchanged.
  21: """
  22: 
  23: from __future__ import annotations
  24: 
  25: import base64
  26: import os
  27: import threading
  28: 
  29: from loguru import logger
  30: 
  31: from studio.shared.providers_common.transports.callbacks import (
  32:     default_callback_intake,
  33:     job_matches_provider,
  34: )
  35: from studio.shared.providers_common.transports.extension import ExtensionWebSocketHub
  36: from studio.storyboard import jobs
  37: 
  38: PROVIDER_ID = "gemini_ws"
  39: DOMAIN = "storyboard"
  40: WS_ROUTE = "/ws/storyboard-gemini-image-grabber"
  41: 
  42: 
  43: def _handle_message(msg, ws):
  44:     """Process a domain message from the Gemini extension."""
  45:     msg_type = msg.get("type", "")
  46: 
  47:     if msg_type == "EXTENSION_READY":
  48:         logger.success(
  49:             "Gemini extension HANDSHAKE â† source={}, pending_jobs={}",
  50:             msg.get("source", "unknown"), hub.pending_count(),
  51:         )
  52:         hub.flush_pending(ws)
  53: 
  54:     elif msg_type == "IMAGE_UPLOAD":
  55:         logger.info(
  56:             "Gemini â† IMAGE_UPLOAD {} scene {}",
  57:             msg.get("projectId", "?"), msg.get("scene", "?"),
  58:         )
  59:         _handle_image_upload(msg)
  60: 
  61:     elif msg_type == "STATUS_UPDATE":
  62:         project_id = msg.get("projectId", "")
  63:         scene = msg.get("scene")
  64:         status = msg.get("status", "")
  65:         logger.info("Gemini â† STATUS_UPDATE {} scene {} â†’ {}", project_id or "?", scene, status)
  66:         if project_id and _accept_project(project_id, source="STATUS_UPDATE"):
  67:             jobs.mark_scene(project_id, scene, status)
  68: 
  69:     elif msg_type == "JOB_RECEIVED":
  70:         project_id = msg.get("projectId", "")
  71:         removed = hub.drop_pending(project_id)
  72:         logger.success(
  73:             "Gemini â† JOB_RECEIVED {} ({} scenes, cleared {} pending)",
  74:             project_id, msg.get("scenes", 0), removed,
  75:         )
  76: 
  77:     elif msg_type == "JOB_COMPLETE":
  78:         project_id = msg.get("projectId", "")
  79:         hub.drop_pending(project_id)
  80:         logger.success("Gemini â† JOB_COMPLETE {}", project_id)
  81:         if _accept_project(project_id, source="JOB_COMPLETE"):
  82:             _mark_job_done(project_id)
  83: 
  84:     # PING / DIAGNOSE* are handled by the shared hub.
  85: 
  86: 
  87: hub = ExtensionWebSocketHub(
  88:     "gemini",
  89:     WS_ROUTE,
  90:     pending_mode="list",
  91:     on_message=_handle_message,
  92: )
  93: 
  94: # Compatibility aliases â€” health checks and tests still patch/read these names.
  95: _ws_clients = hub.clients
  96: 
  97: 
  98: def register_runtime(app, sock=None):
  99:     """Register the /ws/storyboard-gemini-image-grabber WebSocket route."""
 100:     hub.register(sock)
 101: 
 102: 
 103: def _capability(name: str, default: bool = False) -> bool:
 104:     """Read one declared capability of this provider (Â§20.4).
 105: 
 106:     Falls back to `default` when the registry has not been discovered, which is
 107:     the case in unit tests that exercise the transport in isolation.
 108:     """
 109:     from studio.shared.providers_common.hub import hub as provider_hub
 110: 
 111:     instance = provider_hub.get("storyboard", PROVIDER_ID)
 112:     if instance is None:
 113:         return default
 114:     return bool(instance.capabilities.get(name, default))
 115: 
 116: 
 117: def is_extension_connected():
 118:     """Check if at least one Gemini extension client is connected."""
 119:     return hub.is_connected()
 120: 
 121: 
 122: def queue_image_job(msg):
 123:     """Queue an IMAGE_JOB message. Sends immediately to connected clients."""
 124:     return hub.queue(msg, label="IMAGE_JOB")
 125: 
 126: 
 127: def _accept_project(project_id: str, *, source: str) -> bool:
 128:     """Refuse pushes that target a job owned by another storyboard provider."""
 129:     if not project_id:
 130:         return False
 131:     job = jobs.read(project_id)
 132:     disposition = default_callback_intake().accept_legacy_job(
 133:         domain=DOMAIN,
 134:         provider_id=PROVIDER_ID,
 135:         project_id=project_id,
 136:         job=job,
 137:         source=source,
 138:     )
 139:     if not disposition.ok:
 140:         logger.warning(
 141:             "Gemini {} dropped for {}: {}", source, project_id, disposition.message
 142:         )
 143:         return False
 144:     return True
 145: 
 146: 
 147: def _handle_image_upload(msg):
 148:     """Save a base64 frame from the extension through the shared job store."""
 149:     project_id = msg.get("projectId", "")
 150:     scene_num = msg.get("scene")
 151:     image = msg.get("image", {})
 152:     image_data = image.get("data", "") if isinstance(image, dict) else ""
 153: 
 154:     if not project_id or scene_num is None or not image_data:
 155:         logger.warning("IMAGE_UPLOAD missing fields")
 156:         return
 157: 
 158:     if not _accept_project(project_id, source="IMAGE_UPLOAD"):
 159:         return
 160: 
 161:     # Bound the base64 payload so a runaway extension cannot fill the disk.
 162:     from studio.shared.providers_common.transports.callbacks import (
 163:         MAX_MEDIA_CALLBACK_BYTES,
 164:         measure_body,
 165:     )
 166: 
 167:     if measure_body(image_data) > MAX_MEDIA_CALLBACK_BYTES:
 168:         logger.warning(
 169:             "IMAGE_UPLOAD rejected oversized frame for {} scene {}",
 170:             project_id, scene_num,
 171:         )
 172:         jobs.record_error(project_id, scene_num, "The uploaded frame was too large")
 173:         return
 174: 
 175:     logger.info(
 176:         "IMAGE_UPLOAD: {} scene {} (~{} KB)",
 177:         project_id, scene_num, len(image_data) * 3 // 4 // 1024,
 178:     )
 179: 
 180:     try:
 181:         if "," in image_data:
 182:             header, encoded = image_data.split(",", 1)
 183:             ext = jobs.extension_for(header, default=".png")
 184:             if "jpeg" in header or "jpg" in header:
 185:                 ext = ".jpeg"
 186:             elif "webp" in header:
 187:                 ext = ".webp"
 188:             elif "png" in header:
 189:                 ext = ".png"
 190:         else:
 191:             encoded, ext = image_data, ".jpeg"
 192: 
 193:         destination = jobs.prepare_scene_file(project_id, scene_num, ext)
 194:         with open(destination, "wb") as handle:
 195:             handle.write(base64.b64decode(encoded))
 196:         logger.success("Saved: {} ({:.0f} KB)", destination, os.path.getsize(destination) / 1024)
 197:     except (OSError, ValueError) as exc:
 198:         logger.error("IMAGE_UPLOAD save failed: {}", exc)
 199:         jobs.record_error(project_id, scene_num, "The uploaded frame could not be saved")
 200:         return
 201: 
 202:     # Watermark removal and thumbnail generation are both applied by the job
 203:     # store, so an extension frame carries the same per-scene metadata as a
 204:     # downloaded one. Off the WebSocket thread: the remover loads a CV stack
 205:     # and the extension is waiting to send the next frame.
 206:     threading.Thread(
 207:         target=jobs.record_ready,
 208:         args=(project_id, scene_num, destination),
 209:         kwargs={"remove_watermark": _capability("watermark_removal", True)},
 210:         name=f"storyboard-frame-{project_id}-{scene_num}",
 211:         daemon=True,
 212:     ).start()
 213: 
 214: 
 215: def activate_tab():
 216:     """Send ACTIVATE_TAB to all connected Gemini extension clients."""
 217:     return hub.broadcast({"type": "ACTIVATE_TAB"}, label="ACTIVATE_TAB", prune=True)
 218: 
 219: 
 220: def focus_studio_tab():
 221:     """Send FOCUS_STUDIO_TAB to all connected Gemini extension clients."""
 222:     return hub.broadcast({"type": "FOCUS_STUDIO_TAB"}, label="FOCUS_STUDIO_TAB")
 223: 
 224: 
 225: def _mark_job_done(project_id):
 226:     """Close the job, then run the provider's declared completion behaviour."""
 227:     jobs.mark_done(project_id)
 228: 
 229:     if _capability("watermark_removal", True):
 230:         _sweep_watermarks(project_id)

