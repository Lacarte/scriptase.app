  57:         on_connect: ConnectHandler | None = None,
  58:         project_key: str = "projectId",
  59:     ) -> None:
  60:         if pending_mode not in {"list", "single"}:
  61:             raise ValueError(f"unknown pending_mode: {pending_mode!r}")
  62:         self.name = name
  63:         self.route = route
  64:         self.pending_mode: PendingMode = pending_mode
