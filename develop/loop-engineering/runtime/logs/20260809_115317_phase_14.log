 176: class KieAIProvider(AnimatorProvider):
 177:     """Animator provider using the direct Kie AI API."""
 178: 
 179:     def submit(self, request: AnimatorRequest, invocation) -> JobHandle:
 180:         # Request options win over durable settings (Â§40.2 O4).
 181:         options = {**dict(invocation.settings), **dict(invocation.options)}
 182:         api_key = (
 183:             str(options.get("api_key") or "").strip()
 184:             or str(invocation.settings.get("api_key") or "").strip()
 185:             or KIE_AI_API_KEY
 186:         )
 187:         if not api_key:
 188:             raise ValueError("KIE_AI_API_KEY not configured")
 189: 
 190:         # Credentials never reach the job file (Â§22.6). Only portable options.
 191:         portable = {
 192:             key: value
 193:             for key, value in options.items()
 194:             if key not in {"api_key"}
 195:         }
 196:         portable.setdefault("aspect_ratio", request.aspect_ratio)
 197:         portable.setdefault("model", KIE_AI_MODEL)
 198:         portable.setdefault("resolution", "1")
 199:         portable.setdefault("output_format", "jpg")
 200: 
 201:         jobs.seed(
 202:             invocation.project_id,
 203:             request,
 204:             provider_id=PROVIDER_ID,
 205:             payload={
 206:                 "projectId": invocation.project_id,
 207:                 "aspect_ratio": request.aspect_ratio,
 208:                 "scenes": request.legacy_scenes(),
 209:             },
 210:             status="generating",
 211:         )
 212: 
 213:         def transport(**kwargs):
 214:             return generate_image(api_key=api_key, **kwargs)
 215: 
 216:         project_id = invocation.project_id
 217:         threading.Thread(
 218:             target=generation.run_batch,
 219:             args=(project_id, request, transport),
 220:             kwargs={
 221:                 "options": portable,
 222:                 "is_cancelled": invocation.cancel.is_cancelled,
 223:             },
 224:             name=f"animator-kie-{project_id}",
 225:             daemon=True,
 226:         ).start()
 227: 
 228:         return JobHandle(
 229:             job_id=project_id,
 230:             domain=invocation.domain,
 231:             provider_id=PROVIDER_ID,
 232:             project_id=project_id,
 233:             invocation_id=invocation.invocation_id,
 234:         )
 235: 
 236:     def poll(self, job_id: str, invocation) -> JobStatus:
 237:         return jobs.status(invocation.project_id or job_id, job_id)
