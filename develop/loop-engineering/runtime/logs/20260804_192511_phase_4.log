  184: 
  185: def _summarize(value: Any, *, depth: int = 0) -> Any:
  186:     """Create a bounded diagnostic summary instead of persisting payload bodies."""
  187:     if depth >= 4:
  188:         return {"type": type(value).__name__}
  189:     if isinstance(value, str):
  190:         return {"chars": len(value)}
  191:     if isinstance(value, bytes):
  192:         return {"bytes": len(value)}
  193:     if isinstance(value, Mapping):
  194:         summary = {str(key): _summarize(child, depth=depth + 1) for key, child in list(value.items())[:30]}
  195:         if len(value) > 30:
  196:             summary["_truncated_keys"] = len(value) - 30
  197:         return summary
  198:     if isinstance(value, (list, tuple)):
  199:         result = {"count": len(value)}
  200:         if value:
  201:             result["items"] = [_summarize(child, depth=depth + 1) for child in value[:3]]
  202:         return result
  203:     if value is None or isinstance(value, (bool, int, float)):
  204:         return value
  205:     return {"type": type(value).__name__}
  206: 
  207: 
  208: def _artifact_refs(value: Any) -> list[str]:
  209:     refs: list[str] = []
  210:     if isinstance(value, Mapping):
  211:         candidates = value.get("artifact_refs")
  212:         if isinstance(candidates, list):
  213:             refs.extend(item for item in candidates if isinstance(item, str))
  214:         for child in value.values():
  215:             refs.extend(_artifact_refs(child))
  216:     elif isinstance(value, (list, tuple)):
  217:         for child in value:
  218:             refs.extend(_artifact_refs(child))
  219:     return list(dict.fromkeys(refs))
