   58: class ProjectLock(AbstractContextManager):
   59:     """Non-blocking in-process and cross-process lock for one project."""
   60: 
   61:     _guard = threading.Lock()
   62:     _held: set[str] = set()
   63: 
   64:     def __init__(self, project_id: str, *, lock_root: str | None = None, execution_id: str = ""):
   65:         if not isinstance(project_id, str) or not PROJECT_ID_RE.fullmatch(project_id):
   66:             raise SchedulerError("PROJECT_ID_INVALID", "A strict pp_/pm_ project ID is required")
   67:         self.project_id = project_id
   68:         self.execution_id = execution_id
   69:         self.lock_root = lock_root or os.path.join(OUTPUT_DIR, "workflows", "locks")
   70:         self.path = safe_join(self.lock_root, f"{project_id}.lock")
   71:         self._lock_key = os.path.normcase(os.path.abspath(self.path))
   72:         self._acquired = False
   73: 
   74:     def acquire(self) -> "ProjectLock":
   75:         os.makedirs(self.lock_root, exist_ok=True)
   76:         with self._guard:
   77:             if self._lock_key in self._held:
   78:                 raise ProjectLockedError(self.project_id)
   79:             self._held.add(self._lock_key)
   80:         try:
   81:             flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
   82:             fd = os.open(self.path, flags, 0o600)
   83:             with os.fdopen(fd, "w", encoding="utf-8") as handle:
   84:                 json.dump({
   85:                     "project_id": self.project_id,
   86:                     "execution_id": self.execution_id,
   87:                     "pid": os.getpid(),
   88:                 }, handle)
   89:                 handle.flush()
   90:                 os.fsync(handle.fileno())
   91:         except FileExistsError as exc:
   92:             with self._guard:
   93:                 self._held.discard(self._lock_key)
   94:             raise ProjectLockedError(self.project_id) from exc
   95:         except BaseException:
   96:             with self._guard:
   97:                 self._held.discard(self._lock_key)
   98:             raise
   99:         self._acquired = True
  100:         return self
  101: 
  102:     def release(self) -> None:
  103:         if not self._acquired:
  104:             return
  105:         try:
  106:             os.unlink(self.path)
  107:         except FileNotFoundError:
  108:             pass
  109:         finally:
  110:             with self._guard:
  111:                 self._held.discard(self._lock_key)
  112:             self._acquired = False
  113: 
  114:     def __enter__(self) -> "ProjectLock":
  115:         return self.acquire()
  116: 
  117:     def __exit__(self, exc_type, exc, traceback) -> bool:
  118:         self.release()
  119:         return False
