   89: def resolve_project_id(workflow: Mapping[str, Any], requested: str | None) -> str:
   90:     if requested is not None and (not isinstance(requested, str) or not PROJECT_ID_RE.fullmatch(requested)):
   91:         raise ExecutionRequestError("BAD_REQUEST", "project_id must match pp_/pm_XXXXXX")
   92:     existing = [
