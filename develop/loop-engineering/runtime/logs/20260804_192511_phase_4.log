  222: @dataclass(frozen=True)
  223: class WorkflowGraph:
  224:     nodes: dict[str, dict]
  225:     incoming: dict[str, list[dict]]
  226:     dependents: dict[str, list[str]]
  227:     saved_order: dict[str, int]
  228: 
  229: 
  230: def build_graph(workflow: Mapping[str, Any]) -> WorkflowGraph:
  231:     nodes = {node["id"]: node for node in workflow.get("nodes", [])}
  232:     incoming = {node_id: [] for node_id in nodes}
  233:     dependents = {node_id: [] for node_id in nodes}
  234:     for edge in workflow.get("edges", []):
  235:         incoming[edge["target_node"]].append(edge)
  236:         dependents[edge["source_node"]].append(edge["target_node"])
  237:     return WorkflowGraph(
  238:         nodes=nodes,
  239:         incoming=incoming,
  240:         dependents=dependents,
  241:         saved_order={node["id"]: index for index, node in enumerate(workflow.get("nodes", []))},
  242:     )
  243: 
  244: 
  245: def deterministic_order(workflow: Mapping[str, Any]) -> list[str]:
  246:     """Return stable topological order (saved node order, then node ID)."""
  247:     graph = build_graph(workflow)
  248:     remaining = {node_id: len(edges) for node_id, edges in graph.incoming.items()}
  249:     ready = [(graph.saved_order[node_id], node_id) for node_id, count in remaining.items() if count == 0]
  250:     heapq.heapify(ready)
  251:     order: list[str] = []
  252:     while ready:
  253:         _, node_id = heapq.heappop(ready)
  254:         order.append(node_id)
  255:         for target in graph.dependents[node_id]:
  256:             remaining[target] -= 1
  257:             if remaining[target] == 0:
  258:                 heapq.heappush(ready, (graph.saved_order[target], target))
  259:     if len(order) != len(graph.nodes):
  260:         raise SchedulerError("CYCLE_DETECTED", "Workflow connections must form a DAG")
  261:     return order
  262: 
  263: 
  264: def dependency_maps(workflow: Mapping[str, Any]) -> tuple[dict[str, set[str]], dict[str, set[str]]]:
  265:     """Return predecessor and reverse/dependent maps for scope calculations."""
  266:     graph = build_graph(workflow)
  267:     dependencies = {
  268:         node_id: {edge["source_node"] for edge in edges}
  269:         for node_id, edges in graph.incoming.items()
  270:     }
  271:     reverse_dependencies = {
  272:         node_id: set(targets) for node_id, targets in graph.dependents.items()
  273:     }
  274:     return dependencies, reverse_dependencies
  275: 
  276: 
  277: RUN_MODES = {
  278:     "full",
  279:     "node_with_deps",
  280:     "node_isolated",
  281:     "selected",
  282:     "from_node",
  283:     "retry_failed",
  284:     "retry_failed_desc",
  285: }
  286: 
  287: 
  288: def calculate_scope(
  289:     workflow: Mapping[str, Any],
  290:     run_mode: str,
  291:     target_node_ids: list[str],
  292: ) -> list[str]:
  293:     """Calculate a stable execution subgraph for every topology-based run mode.
  294: 
  295:     Isolation has input-port semantics in addition to graph topology and is
  296:     completed by ``execution.resolve_scope`` after this function validates its
  297:     target.  Returned IDs always follow saved node order, never traversal order.
  298:     """
  299:     if run_mode not in RUN_MODES:
  300:         raise ValueError(f"Unsupported run_mode: {run_mode}")
  301:     saved_ids = [node["id"] for node in workflow.get("nodes", [])]
  302:     known_ids = set(saved_ids)
  303:     if not isinstance(target_node_ids, list):
  304:         raise ValueError("target_node_ids must be an array of node IDs")
  305:     if len(set(target_node_ids)) != len(target_node_ids):
  306:         raise ValueError("target_node_ids must not contain duplicates")
  307:     unknown = [node_id for node_id in target_node_ids if node_id not in known_ids]
  308:     if unknown:
  309:         raise ValueError(f"Unknown target node: {unknown[0]}")
  310: 
  311:     if run_mode == "full":
  312:         if target_node_ids:
  313:             raise ValueError("full mode does not accept target_node_ids")
  314:         return saved_ids
  315: 
  316:     if run_mode == "selected":
  317:         if not target_node_ids:
  318:             raise ValueError("selected requires at least one existing target node")
  319:         seeds = set(target_node_ids)
  320:         direction = "dependencies"
  321:     else:
  322:         if len(target_node_ids) != 1:
  323:             raise ValueError(f"{run_mode} requires exactly one existing target node")
  324:         seeds = {target_node_ids[0]}
  325:         if run_mode in {"node_with_deps"}:
  326:             direction = "dependencies"
  327:         elif run_mode in {"from_node", "retry_failed_desc"}:
  328:             direction = "descendants"
  329:         else:
  330:             # node_isolated and retry_failed contain only their target at the
  331:             # topology layer. Isolation may add directly-connected stubs.
  332:             return [node_id for node_id in saved_ids if node_id in seeds]
  333: 
  334:     dependencies, descendants = dependency_maps(workflow)
  335:     adjacency = dependencies if direction == "dependencies" else descendants
  336:     scope = set(seeds)
  337:     pending = list(seeds)
  338:     while pending:
  339:         node_id = pending.pop()
  340:         for related_id in adjacency[node_id]:
  341:             if related_id not in scope:
  342:                 scope.add(related_id)
  343:                 pending.append(related_id)
  344:     return [node_id for node_id in saved_ids if node_id in scope]
  345: 
  346: 
  347: def resolve_executor(node: Mapping[str, Any]) -> Callable:
  348:     definition = get_node_type(node.get("type"))
  349:     spec = definition.get("executor") if definition else None
  350:     if not spec or ":" not in spec:
  351:         raise SchedulerError("NODE_EXECUTOR_MISSING", f"No executor is registered for {node.get('type')}")
  352:     module_name, function_name = spec.split(":", 1)
  353:     function = getattr(importlib.import_module(module_name), function_name, None)
  354:     if not callable(function):
  355:         raise SchedulerError("NODE_EXECUTOR_MISSING", f"Executor {spec} is not callable")
  356:     return function
  357: 
