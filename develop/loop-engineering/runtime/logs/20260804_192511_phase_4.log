   31: @dataclass
   32: class ActiveExecution:
   33:     scheduler: WorkflowScheduler
   34:     stop_event: threading.Event
   35:     thread: threading.Thread | None = None
   36: 
   37: 
   38: def _transient_workflow_id() -> str:
   39:     alphabet = string.ascii_uppercase + string.digits
   40:     return "wf_" + "".join(random.SystemRandom().choices(alphabet, k=6))
   41: 
   42: 
   43: def prepare_snapshot(document: Mapping[str, Any]) -> dict[str, Any]:
   44:     snapshot = deepcopy(dict(document))
   45:     if "workflow_id" not in snapshot:
   46:         snapshot["workflow_id"] = _transient_workflow_id()
   47:     timestamp = now_iso()
   48:     snapshot.setdefault("created_at", timestamp)
   49:     snapshot.setdefault("updated_at", timestamp)
   50:     problems = validation_errors(validate_workflow(snapshot, require_identity=True, require_complete=True))
   51:     if problems:
   52:         raise ExecutionRequestError(
   53:             "WORKFLOW_INVALID", "Workflow has validation errors", details={"problems": problems}
   54:         )
   55:     return snapshot
   56: 
   57: 
   58: def resolve_scope(workflow: Mapping[str, Any], run_mode: str, target_node_ids: list[str]) -> list[str]:
   59:     nodes = {node["id"]: node for node in workflow.get("nodes", [])}
   60:     try:
   61:         scope = calculate_scope(workflow, run_mode, target_node_ids)
   62:     except ValueError as exc:
   63:         raise ExecutionRequestError("BAD_REQUEST", str(exc)) from exc
   64:     if run_mode != "node_isolated":
   65:         return scope
   66: 
   67:     target = target_node_ids[0]
   68:     # Isolation deliberately ignores normal upstream nodes. Required inputs
   69:     # must instead be supplied by directly connected Sample Input nodes.
   70:     incoming = [edge for edge in workflow.get("edges", []) if edge["target_node"] == target]
   71:     stub_ids = {
   72:         edge["source_node"] for edge in incoming
   73:         if nodes[edge["source_node"]].get("type") == "stub.input"
   74:     }
   75:     definition = get_node_type(nodes[target]["type"])
   76:     for port in definition.get("inputs", []):
   77:         if not port.get("required"):
   78:             continue
   79:         sources = [edge["source_node"] for edge in incoming if edge["target_port"] == port["id"]]
   80:         if not sources or any(source not in stub_ids for source in sources):
   81:             raise ExecutionRequestError(
   82:                 "MISSING_REQUIRED_INPUT",
   83:                 f"Isolated node {target} requires Sample Input data for port {port['id']}",
   84:             )
   85:     scope = stub_ids | {target}
   86:     return [node_id for node_id in nodes if node_id in scope]
   87: 
   88: 
   89: def resolve_project_id(workflow: Mapping[str, Any], requested: str | None) -> str:
   90:     if requested is not None and (not isinstance(requested, str) or not PROJECT_ID_RE.fullmatch(requested)):
   91:         raise ExecutionRequestError("BAD_REQUEST", "project_id must match pp_/pm_XXXXXX")
   92:     existing = [
   93:         (node.get("configuration") or {}).get("project_id")
   94:         for node in workflow.get("nodes", [])
   95:         if node.get("type") == "project.existing" and not node.get("disabled")
   96:     ]
   97:     existing = [value for value in existing if value]
   98:     if len(set(existing)) > 1:
   99:         raise ExecutionRequestError("WORKFLOW_INVALID", "Enabled existing-project nodes disagree")
  100:     if existing and requested and existing[0] != requested:
  101:         raise ExecutionRequestError("WORKFLOW_INVALID", "Requested project_id disagrees with project.existing")
  102:     return requested or (existing[0] if existing else generate_project_id("pm"))
  103: 
