   82:             return None
   83:     except (ValueError, OSError):
   84:         return None
   85:     return path
   86: 
   87: 
   88: def artifact_integrity(refs: list[str], *, output_dir: str) -> tuple[dict[str, dict[str, Any]], str | None]:
   89:     """Hash managed artifacts. Empty/non-files fail closed for cache reuse."""
   90:     result: dict[str, dict[str, Any]] = {}
   91:     for ref in dict.fromkeys(refs):
   92:         path = _managed_artifact_path(output_dir, ref)
   93:         try:
   94:             if path is None or not os.path.isfile(path):
   95:                 return {}, "artifact_missing"
   96:             size = os.path.getsize(path)
   97:             if size <= 0:
   98:                 return {}, "artifact_integrity_failed"
   99:             digest = hashlib.sha256()
  100:             with open(path, "rb") as handle:
  101:                 for chunk in iter(lambda: handle.read(1024 * 1024), b""):
  102:                     digest.update(chunk)
  103:         except OSError:
  104:             return {}, "artifact_integrity_failed"
  105:         result[ref] = {"size": size, "sha256": digest.hexdigest()}
  106:     return result, None
  107: 
  108: 
  109: def output_fingerprint(outputs: Mapping[str, Any], integrity: Mapping[str, Any]) -> str:
  110:     return "sha256:" + _sha256_bytes(_canonical({
  111:         "outputs": outputs,
  112:         "artifact_integrity": integrity,
  113:     }).encode("utf-8"))
  114: 
  115: 
  116: def miss_reason(previous: Mapping[str, Any], current: Mapping[str, Any]) -> str:
  117:     if previous.get("node_type") != current.get("node_type") or previous.get("type_version") != current.get("type_version"):
  118:         return "type_or_version_changed"
  119:     if previous.get("adapter_cache_schema_version") != current.get("adapter_cache_schema_version"):
  120:         return "adapter_schema_changed"
  121:     if previous.get("configuration") != current.get("configuration"):
  122:         return "config_changed"
  123:     if previous.get("upstream_artifact_fingerprints") != current.get("upstream_artifact_fingerprints"):
  124:         return "upstream_changed"
  125:     if previous.get("inputs") != current.get("inputs"):
  126:         return "inputs_changed"
  127:     return "fingerprint_mismatch"
  128: 
  129: 
  130: @dataclass(frozen=True)
  131: class CacheLookup:
  132:     hit: bool
  133:     reason: str
  134:     outputs: dict[str, Any] | None = None
  135:     output_fingerprint: str | None = None
  136: 
  137: 
  138: class NodeCache:
  139:     def __init__(self, *, root: str, output_dir: str):
  140:         self.root = root
  141:         self.output_dir = output_dir
  142: 
  143:     def _path(self, workflow_id: str, project_id: str, node_id: str) -> str:
  144:         # Validated workflow documents constrain all three values. Hashing the
  145:         # compound identity keeps this persistence boundary safe independently.
  146:         key = _sha256_bytes(f"{workflow_id}\0{project_id}\0{node_id}".encode("utf-8"))
  147:         return safe_join(self.root, f"{key}.json")
  148: 
  149:     def lookup(
  150:         self,
  151:         *,
  152:         workflow_id: str,
  153:         project_id: str,
  154:         node_id: str,
  155:         fingerprint: str,
  156:         components: Mapping[str, Any],
  157:         force: bool = False,
  158:     ) -> CacheLookup:
  159:         if force:
  160:             return CacheLookup(False, "forced_regeneration")
  161:         try:
  162:             entry = safe_json_read(self._path(workflow_id, project_id, node_id))
  163:         except FileNotFoundError:
  164:             return CacheLookup(False, "no_prior_success")
  165:         except (OSError, ValueError, json.JSONDecodeError):
  166:             return CacheLookup(False, "cache_corrupt")
  167:         if entry.get("cache_schema_version") != CACHE_SCHEMA_VERSION or entry.get("status") != "succeeded":
  168:             return CacheLookup(False, "no_prior_success")
  169:         if entry.get("fingerprint") != fingerprint:
  170:             return CacheLookup(False, miss_reason(
  171:                 entry.get("component_signatures") or {}, component_signatures(components)
  172:             ))
  173:         outputs = entry.get("outputs")
  174:         if not isinstance(outputs, dict):
  175:             return CacheLookup(False, "cache_corrupt")
  176:         stored_integrity = entry.get("artifact_integrity") or {}
  177:         refs = list(stored_integrity)
  178:         current_integrity, failure = artifact_integrity(refs, output_dir=self.output_dir)
  179:         if failure:
  180:             return CacheLookup(False, failure)
  181:         if current_integrity != stored_integrity:
  182:             return CacheLookup(False, "artifact_integrity_failed")
  183:         return CacheLookup(
  184:             True,
  185:             "fingerprint_match",
  186:             deepcopy(outputs),
  187:             entry.get("output_fingerprint"),
  188:         )
  189: 
  190:     def store(
  191:         self,
  192:         *,
  193:         workflow_id: str,
  194:         project_id: str,
  195:         node_id: str,
  196:         fingerprint: str,
  197:         components: Mapping[str, Any],
  198:         outputs: Mapping[str, Any],
  199:         artifact_refs: list[str],
  200:     ) -> tuple[str | None, str | None]:
  201:         integrity, failure = artifact_integrity(artifact_refs, output_dir=self.output_dir)
  202:         if failure:
  203:             return None, failure
  204:         try:
  205:             output_fp = output_fingerprint(outputs, integrity)
  206:             entry = {
  207:                 "cache_schema_version": CACHE_SCHEMA_VERSION,
  208:                 "status": "succeeded",
  209:                 "workflow_id": workflow_id,
  210:                 "project_id": project_id,
  211:                 "node_id": node_id,
  212:                 "fingerprint": fingerprint,
  213:                 "component_signatures": component_signatures(components),
  214:                 "outputs": deepcopy(dict(outputs)),
  215:                 "artifact_integrity": integrity,
  216:                 "output_fingerprint": output_fp,
  217:                 "created_at": now_iso(),
  218:             }
  219:             # Prove serializability before the atomic writer boundary.
  220:             _canonical(entry)
  221:             safe_json_write(self._path(workflow_id, project_id, node_id), entry, indent=2)
  222:         except (TypeError, ValueError, OSError):
  223:             return None, "cache_not_serializable"
  224:         return output_fp, None
### studio/workflows/scheduler.py
    1: """Deterministic, sequential workflow scheduling and project serialization.
    2: 
    3: The scheduler deliberately contains no Flask state.  It consumes a validated
    4: workflow snapshot and invokes registry adapters directly, which makes ordering
    5: and readiness independently testable.
    6: """
