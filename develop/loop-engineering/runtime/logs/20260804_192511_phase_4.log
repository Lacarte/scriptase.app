   58: def resolve_scope(workflow: Mapping[str, Any], run_mode: str, target_node_ids: list[str]) -> list[str]:
   59:     nodes = {node["id"]: node for node in workflow.get("nodes", [])}
   60:     try:
   61:         scope = calculate_scope(workflow, run_mode, target_node_ids)
   62:     except ValueError as exc:
   63:         raise ExecutionRequestError("BAD_REQUEST", str(exc)) from exc
   64:     if run_mode != "node_isolated":
   65:         return scope
   66: 
   67:     target = target_node_ids[0]
   68:     # Isolation deliberately ignores normal upstream nodes. Required inputs
   69:     # must instead be supplied by directly connected Sample Input nodes.
   70:     incoming = [edge for edge in workflow.get("edges", []) if edge["target_node"] == target]
   71:     stub_ids = {
   72:         edge["source_node"] for edge in incoming
   73:         if nodes[edge["source_node"]].get("type") == "stub.input"
   74:     }
   75:     definition = get_node_type(nodes[target]["type"])
   76:     for port in definition.get("inputs", []):
   77:         if not port.get("required"):
   78:             continue
   79:         sources = [edge["source_node"] for edge in incoming if edge["target_port"] == port["id"]]
   80:         if not sources or any(source not in stub_ids for source in sources):
   81:             raise ExecutionRequestError(
   82:                 "MISSING_REQUIRED_INPUT",
   83:                 f"Isolated node {target} requires Sample Input data for port {port['id']}",
   84:             )
   85:     scope = stub_ids | {target}
   86:     return [node_id for node_id in nodes if node_id in scope]
