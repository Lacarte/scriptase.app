  210:     if isinstance(value, Mapping):
  211:         candidates = value.get("artifact_refs")
  212:         if isinstance(candidates, list):
  213:             refs.extend(item for item in candidates if isinstance(item, str))
  214:         for child in value.values():
  215:             refs.extend(_artifact_refs(child))
  216:     elif isinstance(value, (list, tuple)):
  217:         for child in value:
  218:             refs.extend(_artifact_refs(child))
  219:     return list(dict.fromkeys(refs))
  220: 
  221: 
  222: @dataclass(frozen=True)
  223: class WorkflowGraph:
  224:     nodes: dict[str, dict]
  225:     incoming: dict[str, list[dict]]
  226:     dependents: dict[str, list[str]]
  227:     saved_order: dict[str, int]
  228: 
  229: 
  230: def build_graph(workflow: Mapping[str, Any]) -> WorkflowGraph:
  231:     nodes = {node["id"]: node for node in workflow.get("nodes", [])}
  232:     incoming = {node_id: [] for node_id in nodes}
  233:     dependents = {node_id: [] for node_id in nodes}
  234:     for edge in workflow.get("edges", []):
  235:         incoming[edge["target_node"]].append(edge)
  236:         dependents[edge["source_node"]].append(edge["target_node"])
  237:     return WorkflowGraph(
  238:         nodes=nodes,
  239:         incoming=incoming,
  240:         dependents=dependents,
  241:         saved_order={node["id"]: index for index, node in enumerate(workflow.get("nodes", []))},
  242:     )
  243: 
  244: 
  245: def deterministic_order(workflow: Mapping[str, Any]) -> list[str]:
  246:     """Return stable topological order (saved node order, then node ID)."""
  247:     graph = build_graph(workflow)
  248:     remaining = {node_id: len(edges) for node_id, edges in graph.incoming.items()}
  249:     ready = [(graph.saved_order[node_id], node_id) for node_id, count in remaining.items() if count == 0]
  250:     heapq.heapify(ready)
  251:     order: list[str] = []
  252:     while ready:
  253:         _, node_id = heapq.heappop(ready)
  254:         order.append(node_id)
  255:         for target in graph.dependents[node_id]:
  256:             remaining[target] -= 1
  257:             if remaining[target] == 0:
  258:                 heapq.heappush(ready, (graph.saved_order[target], target))
  259:     if len(order) != len(graph.nodes):
  260:         raise SchedulerError("CYCLE_DETECTED", "Workflow connections must form a DAG")
  261:     return order
  262: 
  263: 
  264: def dependency_maps(workflow: Mapping[str, Any]) -> tuple[dict[str, set[str]], dict[str, set[str]]]:
  265:     """Return predecessor and reverse/dependent maps for scope calculations."""
  266:     graph = build_graph(workflow)
  267:     dependencies = {
  268:         node_id: {edge["source_node"] for edge in edges}
  269:         for node_id, edges in graph.incoming.items()
  270:     }
  271:     reverse_dependencies = {
  272:         node_id: set(targets) for node_id, targets in graph.dependents.items()
  273:     }
  274:     return dependencies, reverse_dependencies
  275: 
  276: 
  277: RUN_MODES = {
  278:     "full",
  279:     "node_with_deps",
  280:     "node_isolated",
  281:     "selected",
  282:     "from_node",
  283:     "retry_failed",
  284:     "retry_failed_desc",
  285: }
  286: 
  287: 
  288: def calculate_scope(
  289:     workflow: Mapping[str, Any],
  290:     run_mode: str,
  291:     target_node_ids: list[str],
  292: ) -> list[str]:
  293:     """Calculate a stable execution subgraph for every topology-based run mode.
  294: 
  295:     Isolation has input-port semantics in addition to graph topology and is
  296:     completed by ``execution.resolve_scope`` after this function validates its
  297:     target.  Returned IDs always follow saved node order, never traversal order.
  298:     """
  299:     if run_mode not in RUN_MODES:
  300:         raise ValueError(f"Unsupported run_mode: {run_mode}")
  301:     saved_ids = [node["id"] for node in workflow.get("nodes", [])]
  302:     known_ids = set(saved_ids)
  303:     if not isinstance(target_node_ids, list):
  304:         raise ValueError("target_node_ids must be an array of node IDs")
  305:     if len(set(target_node_ids)) != len(target_node_ids):
  306:         raise ValueError("target_node_ids must not contain duplicates")
  307:     unknown = [node_id for node_id in target_node_ids if node_id not in known_ids]
  308:     if unknown:
  309:         raise ValueError(f"Unknown target node: {unknown[0]}")
  310: 
  311:     if run_mode == "full":
  312:         if target_node_ids:
  313:             raise ValueError("full mode does not accept target_node_ids")
  314:         return saved_ids
  315: 
  316:     if run_mode == "selected":
  317:         if not target_node_ids:
  318:             raise ValueError("selected requires at least one existing target node")
  319:         seeds = set(target_node_ids)
  320:         direction = "dependencies"
  321:     else:
  322:         if len(target_node_ids) != 1:
  323:             raise ValueError(f"{run_mode} requires exactly one existing target node")
  324:         seeds = {target_node_ids[0]}
  325:         if run_mode in {"node_with_deps"}:
  326:             direction = "dependencies"
  327:         elif run_mode in {"from_node", "retry_failed_desc"}:
  328:             direction = "descendants"
  329:         else:
  330:             # node_isolated and retry_failed contain only their target at the
  331:             # topology layer. Isolation may add directly-connected stubs.
  332:             return [node_id for node_id in saved_ids if node_id in seeds]
  333: 
  334:     dependencies, descendants = dependency_maps(workflow)
  335:     adjacency = dependencies if direction == "dependencies" else descendants
  336:     scope = set(seeds)
  337:     pending = list(seeds)
  338:     while pending:
  339:         node_id = pending.pop()
  340:         for related_id in adjacency[node_id]:
  341:             if related_id not in scope:
  342:                 scope.add(related_id)
  343:                 pending.append(related_id)
  344:     return [node_id for node_id in saved_ids if node_id in scope]
  345: 
  346: 
  347: def resolve_executor(node: Mapping[str, Any]) -> Callable:
  348:     definition = get_node_type(node.get("type"))
  349:     spec = definition.get("executor") if definition else None
  350:     if not spec or ":" not in spec:
  351:         raise SchedulerError("NODE_EXECUTOR_MISSING", f"No executor is registered for {node.get('type')}")
  352:     module_name, function_name = spec.split(":", 1)
  353:     function = getattr(importlib.import_module(module_name), function_name, None)
  354:     if not callable(function):
  355:         raise SchedulerError("NODE_EXECUTOR_MISSING", f"Executor {spec} is not callable")
  356:     return function
  357: 
  358: 
  359: class WorkflowScheduler:
  360:     def __init__(
  361:         self,
  362:         workflow: Mapping[str, Any],
  363:         *,
  364:         project_id: str,
  365:         execution_id: str = "",
  366:         executor_resolver: Callable[[Mapping[str, Any]], Callable] = resolve_executor,
  367:         lock_root: str | None = None,
  368:         output_dir: str = OUTPUT_DIR,
  369:         on_status: Callable[[str, str], None] | None = None,
  370:         on_event: Callable[[dict[str, Any]], None] | None = None,
  371:         run_mode: str = "full",
  372:         scope_node_ids: list[str] | None = None,
  373:         stop_requested: Callable[[], bool] | None = None,
  374:         force: bool = False,
  375:         sleeper: Callable[[float], None] = time.sleep,
  376:     ):
  377:         problems = validation_errors(validate_workflow(dict(workflow), require_complete=True))
  378:         if problems:
  379:             raise SchedulerError("WORKFLOW_INVALID", "Workflow has validation errors", details={"problems": problems})
  380:         if not isinstance(project_id, str) or not PROJECT_ID_RE.fullmatch(project_id):
  381:             raise SchedulerError("PROJECT_ID_INVALID", "A strict pp_/pm_ project ID is required")
  382:         self.workflow = dict(workflow)
  383:         self.project_id = project_id
  384:         execution_root = os.path.join(output_dir, "workflows", "executions")
  385:         self.execution_id = execution_id or generate_execution_id(root=execution_root)
  386:         self.executor_resolver = executor_resolver
  387:         self.lock_root = lock_root
  388:         self.output_dir = output_dir
  389:         self.on_status = on_status
  390:         self.on_event = on_event
  391:         self.run_mode = run_mode
  392:         self.scope_node_ids = list(scope_node_ids or [node["id"] for node in workflow.get("nodes", [])])
  393:         self.stop_requested = stop_requested or (lambda: False)
  394:         self.force = force
  395:         self.sleeper = sleeper
  396:         self.execution_root = execution_root
  397:         self.cache = NodeCache(
  398:             root=os.path.join(output_dir, "workflows", "cache"),
  399:             output_dir=output_dir,
  400:         )
  401:         self.redactor = Redactor(workflow)
  402:         self.record = ExecutionRecord(
  403:             execution_id=self.execution_id,
  404:             workflow_id=str(workflow.get("workflow_id", "")),
  405:             workflow_snapshot=self.redactor(workflow),
  406:             project_id=project_id,
  407:             run_mode=run_mode,
  408:             scope_node_ids=self.scope_node_ids,
  409:             started_at=now_iso(),
  410:             nodes={node["id"]: NodeExecutionRecord() for node in workflow.get("nodes", [])},
  411:         )
  412: 
  413:     def run(self) -> ScheduleResult:
  414:         scope = set(self.scope_node_ids)
  415:         scoped_workflow = {
  416:             **self.workflow,
  417:             "nodes": [node for node in self.workflow.get("nodes", []) if node["id"] in scope],
  418:             "edges": [
  419:                 edge for edge in self.workflow.get("edges", [])
  420:                 if edge["source_node"] in scope and edge["target_node"] in scope
  421:             ],
  422:         }
  423:         graph = build_graph(scoped_workflow)
  424:         order = deterministic_order(scoped_workflow)
  425:         statuses = {node_id: "idle" for node_id in graph.nodes}
  426:         node_outputs: dict[str, dict[str, Any]] = {}
  427:         node_output_fingerprints: dict[str, str] = {}
  428:         errors: dict[str, dict[str, Any]] = {}
  429:         executed: list[str] = []
  430:         self._persist()
### 431-760
  431:         self._emit({"type": "execution_status", "node_id": None, "status": "running"})
  432: 
  433:         with ProjectLock(self.project_id, lock_root=self.lock_root, execution_id=self.execution_id):
  434:             stopped = False
  435:             cancelled = False
  436:             for node_id in order:
  437:                 node = graph.nodes[node_id]
  438:                 if self.stop_requested():
  439:                     cancelled = True
  440:                 if cancelled:
  441:                     self.record.nodes[node_id].duration_ms = 0
  442:                     self._status(statuses, node_id, "cancelled")
  443:                     executed.append(node_id)
  444:                     continue
  445:                 incoming_edges = graph.incoming[node_id]
  446:                 incoming_active = all(
  447:                     self._edge_was_activated(edge, statuses, node_outputs)
  448:                     for edge in incoming_edges
  449:                 )
  450:                 if stopped or node.get("disabled") or not incoming_active:
  451:                     self.record.nodes[node_id].duration_ms = 0
  452:                     self._status(statuses, node_id, "skipped")
  453:                     executed.append(node_id)
  454:                     continue
  455: 
  456:                 inputs = self._resolve_inputs(node_id, graph, node_outputs)
  457:                 node_record = self.record.nodes[node_id]
  458:                 node_record.from_sample_data = (
  459:                     node.get("type") == "stub.input"
  460:                     or any(
  461:                         self.record.nodes[edge["source_node"]].from_sample_data
  462:                         for edge in graph.incoming[node_id]
  463:                     )
  464:                 )
  465:                 node_record.resolved_inputs_summary = self.redactor(_summarize(inputs))
  466:                 configuration = self._configuration(node)
  467:                 incoming_fingerprints = {
  468:                     ":".join((
  469:                         edge["id"], edge["source_node"], edge["source_port"], edge["target_port"],
  470:                     )): node_output_fingerprints[edge["source_node"]]
  471:                     for edge in graph.incoming[node_id]
  472:                 }
  473:                 pinned = node.get("type") == "stub.output" and configuration.get("pinned") is True
  474:                 fingerprint_inputs = {} if pinned else inputs
  475:                 fingerprint_upstream = {} if pinned else incoming_fingerprints
  476:                 components = fingerprint_components(
  477:                     node,
  478:                     configuration,
  479:                     fingerprint_inputs,
  480:                     fingerprint_upstream,
  481:                     adapter_schema_version=int(get_node_type(node["type"]).get("cache_schema_version", 1)),
  482:                 )
  483:                 fingerprint = canonical_fingerprint(components)
  484:                 node_record.fingerprint = fingerprint
  485: 
  486:                 if pinned:
  487:                     result = {"value": configuration.get("payload")}
  488:                     self._validate_outputs(node, result)
  489:                     node_outputs[node_id] = result
  490:                     output_fp = output_fingerprint(result, {})
  491:                     node_output_fingerprints[node_id] = output_fp
  492:                     node_record.outputs_summary = self.redactor(_summarize(result))
  493:                     node_record.cache = {"hit": True, "reason": "pinned_payload"}
  494:                     node_record.duration_ms = 0
  495:                     self._status(statuses, node_id, "succeeded")
  496:                     executed.append(node_id)
  497:                     continue
  498: 
  499:                 lookup = self.cache.lookup(
  500:                     workflow_id=str(self.workflow.get("workflow_id", "")),
  501:                     project_id=self.project_id,
  502:                     node_id=node_id,
  503:                     fingerprint=fingerprint,
  504:                     components=components,
  505:                     force=self.force,
  506:                 )
  507:                 node_record.cache = {"hit": lookup.hit, "reason": lookup.reason}
  508:                 if lookup.hit:
  509:                     result = dict(lookup.outputs or {})
  510:                     try:
  511:                         self._validate_outputs(node, result)
  512:                     except SchedulerError:
  513:                         lookup = CacheLookup(False, "cache_corrupt")
  514:                         node_record.cache = {"hit": False, "reason": lookup.reason}
  515:                     else:
  516:                         node_outputs[node_id] = result
  517:                         node_output_fingerprints[node_id] = lookup.output_fingerprint or output_fingerprint(result, {})
  518:                         node_record.outputs_summary = self.redactor(_summarize(result))
  519:                         node_record.artifact_refs = self.redactor(_artifact_refs(result))
  520:                         node_record.duration_ms = 0
  521:                         self._status(statuses, node_id, "succeeded")
  522:                         executed.append(node_id)
  523:                         continue
  524: 
  525:                 if lookup.reason not in {"no_prior_success", "forced_regeneration"}:
  526:                     self._status(statuses, node_id, "stale")
  527:                 started = time.perf_counter()
  528:                 policy = self._error_policy(node)
  529:                 max_attempts = policy["max_attempts"] if policy["policy"] == "retry" else 1
  530:                 while node_record.attempts < max_attempts:
  531:                     node_record.attempts += 1
  532:                     self._status(statuses, node_id, "running")
  533:                     promoter = ArtifactPromoter(output_dir=self.output_dir, execution_id=self.execution_id or node_id)
  534:                     context = AdapterContext(
  535:                         project_id=self.project_id,
  536:                         execution_id=self.execution_id,
  537:                         node_id=node_id,
  538:                         stage_artifact=promoter.stage_path,
  539:                         stop_requested=self.stop_requested,
  540:                     )
  541:                     failure = None
  542:                     try:
  543:                         result = self.executor_resolver(node)(inputs, configuration, context)
  544:                         if self.stop_requested():
  545:                             raise CancellationRequested()
  546:                         if not isinstance(result, Mapping):
  547:                             raise SchedulerError("NODE_OUTPUT_INVALID", f"Node {node_id} returned a non-object output")
  548:                         result = dict(result)
  549:                         self._validate_outputs(node, result)
  550:                         promoter.promote()
  551:                         node_outputs[node_id] = result
  552:                         node_record.outputs_summary = self.redactor(_summarize(result))
  553:                         node_record.artifact_refs = self.redactor(_artifact_refs(result))
  554:                         if self.redactor(result) != result:
  555:                             output_fp, cache_failure = None, "sensitive_output"
  556:                         else:
  557:                             output_fp, cache_failure = self.cache.store(
  558:                                 workflow_id=str(self.workflow.get("workflow_id", "")),
  559:                                 project_id=self.project_id,
  560:                                 node_id=node_id,
  561:                                 fingerprint=fingerprint,
  562:                                 components=components,
  563:                                 outputs=result,
  564:                                 artifact_refs=_artifact_refs(result),
  565:                             )
  566:                         if output_fp is None:
  567:                             node_record.cache = {"hit": False, "reason": cache_failure}
  568:                             output_fp = output_fingerprint(result, {})
  569:                         node_output_fingerprints[node_id] = output_fp
  570:                         node_record.duration_ms = max(0, round((time.perf_counter() - started) * 1000))
  571:                         node_record.error = None
  572:                         self._status(statuses, node_id, "succeeded")
  573:                         break
  574:                     except CancellationRequested as exc:
  575:                         failure = exc
  576:                         cancelled = True
  577:                     except Exception as exc:  # adapters are a plugin boundary
  578:                         failure = exc
  579:                     finally:
  580:                         promoter.cleanup()
  581: 
  582:                     if cancelled or getattr(failure, "code", None) == "CANCELLED":
  583:                         cancelled = True
  584:                         node_record.error = self._failure_payload(node, failure, node_record.attempts)
  585:                         node_record.duration_ms = max(0, round((time.perf_counter() - started) * 1000))
  586:                         self._status(statuses, node_id, "cancelled")
  587:                         break
  588: 
  589:                     attempt_error = self._failure_payload(node, failure, node_record.attempts)
  590:                     node_record.attempt_errors.append(attempt_error)
  591:                     if policy["policy"] == "retry" and node_record.attempts < max_attempts:
  592:                         delay_ms = min(
  593:                             60_000,
  594:                             round(policy["delay_ms"] * (policy["backoff_multiplier"] ** (node_record.attempts - 1))),
  595:                         )
  596:                         self._emit({
  597:                             "type": "node_retry", "execution_id": self.execution_id,
  598:                             "node_id": node_id, "attempt": node_record.attempts,
  599:                             "next_attempt": node_record.attempts + 1, "delay_ms": delay_ms,
  600:                             "error": attempt_error,
  601:                         })
  602:                         node_record.logs.append(self.redactor(ExecutionLog(
  603:                             ts=now_iso(), level="warning",
  604:                             message=f"Attempt {node_record.attempts} failed; retrying in {delay_ms} ms",
  605:                         ).__dict__))
  606:                         self._persist()
  607:                         if delay_ms:
  608:                             self._sleep_before_retry(delay_ms / 1000)
  609:                         if self.stop_requested():
  610:                             cancelled = True
  611:                             node_record.error = self._failure_payload(node, CancellationRequested(), node_record.attempts)
  612:                             self._status(statuses, node_id, "cancelled")
  613:                             break
  614:                         continue
  615: 
  616:                     error = attempt_error
  617:                     errors[node_id] = error
  618:                     node_record.error = error
  619:                     node_record.logs.append(self.redactor(ExecutionLog(
  620:                         ts=now_iso(), level="error", message=error["message"]
  621:                     ).__dict__))
  622:                     self._emit({"type": "node_error", "execution_id": self.execution_id,
  623:                                 "node_id": node_id, "error": error})
  624:                     node_record.duration_ms = max(0, round((time.perf_counter() - started) * 1000))
  625:                     if policy["policy"] == "continue_error":
  626:                         node_outputs[node_id] = {"error": {"ok": False}}
  627:                         node_output_fingerprints[node_id] = output_fingerprint(node_outputs[node_id], {})
  628:                         self._status(statuses, node_id, "failed")
  629:                     elif policy["policy"] == "skip_optional":
  630:                         self._status(statuses, node_id, "skipped")
  631:                     else:
  632:                         self._status(statuses, node_id, "failed")
  633:                         stopped = True
  634:                     break
  635:                 executed.append(node_id)
  636: 
  637:         handled = any(
  638:             self._error_policy(graph.nodes[node_id])["policy"] in {"continue_error", "skip_optional"}
  639:             for node_id in errors
  640:         )
  641:         overall = "cancelled" if cancelled or self.stop_requested() else (
  642:             "partial" if errors and handled and not stopped else ("failed" if errors else "succeeded")
  643:         )
  644:         self.record.status = overall
  645:         self.record.finished_at = now_iso()
  646:         persisted = self._persist()
  647:         self._emit({"type": "execution_finished", "node_id": None, "status": overall})
  648:         return ScheduleResult(overall, executed, statuses, node_outputs, errors, persisted)
  649: 
  650:     def _status(self, statuses: dict[str, str], node_id: str, status: str) -> None:
  651:         statuses[node_id] = status
  652:         node_record = self.record.nodes[node_id]
  653:         node_record.status = status
  654:         node_record.logs.append(self.redactor(ExecutionLog(
  655:             ts=now_iso(), level="info", message=f"Node status changed to {status}"
  656:         ).__dict__))
  657:         self._persist()
  658:         if self.on_status:
  659:             self.on_status(node_id, status)
  660:         self._emit({
  661:             "type": "node_status",
  662:             "execution_id": self.execution_id,
  663:             "node_id": node_id,
  664:             "status": status,
  665:             "attempt": node_record.attempts,
  666:             "duration_ms": node_record.duration_ms or 0,
  667:             "from_sample_data": node_record.from_sample_data,
  668:         })
  669: 
  670:     def _persist(self) -> dict[str, Any]:
  671:         return save_execution(self.record, root=self.execution_root, secrets=self.redactor.secrets)
  672: 
  673:     def _emit(self, event: dict[str, Any]) -> None:
  674:         if self.on_event:
  675:             self.on_event(self.redactor(event))
  676: 
  677:     @staticmethod
  678:     def _error_policy(node: Mapping[str, Any]) -> dict[str, Any]:
  679:         supplied = node.get("on_error") or {}
  680:         return {
  681:             "policy": supplied.get("policy", "stop"),
  682:             "max_attempts": supplied.get("max_attempts", 3),
  683:             "delay_ms": supplied.get("delay_ms", 1000),
  684:             "backoff_multiplier": supplied.get("backoff_multiplier", 2.0),
  685:         }
  686: 
  687:     def _failure_payload(self, node: Mapping[str, Any], exc: Exception, attempt: int) -> dict[str, Any]:
  688:         code = getattr(exc, "code", "NODE_EXECUTION_FAILED")
  689:         message = "Execution was cancelled" if code == "CANCELLED" else str(exc)
  690:         suggestion = (
  691:             "Start a new run when ready."
  692:             if code == "CANCELLED"
  693:             else "Review the node inputs and settings, then retry the failed node."
  694:         )
  695:         return self.redactor({
  696:             "node_id": node["id"],
  697:             "node_name": node.get("name") or node["id"],
  698:             "code": code,
  699:             "message": message,
  700:             "details": getattr(exc, "details", None),
  701:             "attempt": attempt,
  702:             "timestamp": now_iso(),
