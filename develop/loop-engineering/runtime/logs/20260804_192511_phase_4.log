   44: class ProjectLockedError(SchedulerError):
   45:     def __init__(self, project_id: str):
   46:         super().__init__(
   47:             "PROJECT_LOCKED",
   48:             f"Project {project_id} already has an active execution",
   49:             details={"project_id": project_id},
   50:         )
