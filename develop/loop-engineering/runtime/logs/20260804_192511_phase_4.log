  162:             handle.scheduler.run()
  163:         except Exception as exc:  # lock acquisition and scheduler setup boundary
  164:             record = handle.scheduler.record
  165:             status = "cancelled" if handle.stop_event.is_set() else "failed"
  166:             record.status = status
  167:             record.finished_at = now_iso()
