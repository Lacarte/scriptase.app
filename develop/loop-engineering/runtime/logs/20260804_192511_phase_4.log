  122: class ArtifactPromoter:
  123:     """Give adapters staged paths and atomically publish them after success."""
  124: 
  125:     def __init__(self, *, output_dir: str = OUTPUT_DIR, execution_id: str = "execution"):
  126:         self.output_dir = os.path.abspath(output_dir)
  127:         staging_root = os.path.join(self.output_dir, "workflows", ".staging")
  128:         os.makedirs(staging_root, exist_ok=True)
  129:         self.staging_dir = tempfile.mkdtemp(prefix=f"{execution_id}_", dir=staging_root)
  130:         self._pending: list[tuple[str, str]] = []
  131: 
  132:     def stage_path(self, destination: str) -> str:
  133:         destination = self._destination(destination)
  134:         suffix = os.path.splitext(destination)[1]
  135:         fd, staged = tempfile.mkstemp(prefix="artifact_", suffix=suffix, dir=self.staging_dir)
  136:         os.close(fd)
  137:         os.unlink(staged)  # callers commonly require a path which does not exist
  138:         self._pending.append((staged, destination))
  139:         return staged
  140: 
  141:     def _destination(self, destination: str) -> str:
  142:         candidate = destination if os.path.isabs(destination) else safe_join(self.output_dir, destination)
  143:         candidate = os.path.abspath(candidate)
  144:         try:
  145:             inside = os.path.commonpath([self.output_dir, candidate]) == self.output_dir
  146:         except ValueError:
  147:             inside = False
  148:         if not inside:
  149:             raise SchedulerError("ARTIFACT_UNMANAGED", "Artifact destination is outside the managed output directory")
  150:         return candidate
  151: 
  152:     def promote(self) -> None:
  153:         for staged, destination in self._pending:
  154:             if not os.path.isfile(staged):
  155:                 raise SchedulerError("ARTIFACT_MISSING", f"Staged artifact was not created: {staged}")
  156:             os.makedirs(os.path.dirname(destination), exist_ok=True)
  157:             # Copy into the destination directory first.  os.replace then
  158:             # publishes on the destination filesystem in one atomic step.
  159:             fd, local_stage = tempfile.mkstemp(prefix=".promote_", dir=os.path.dirname(destination))
  160:             os.close(fd)
  161:             try:
  162:                 shutil.copy2(staged, local_stage)
  163:                 os.replace(local_stage, destination)
  164:             finally:
  165:                 try:
  166:                     os.unlink(local_stage)
  167:                 except FileNotFoundError:
  168:                     pass
  169:         self._pending.clear()
  170: 
  171:     def cleanup(self) -> None:
  172:         shutil.rmtree(self.staging_dir, ignore_errors=True)
  173: 
