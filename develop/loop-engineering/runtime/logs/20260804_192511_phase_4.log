  105: class ExecutionManager:
  106:     def __init__(
  107:         self,
  108:         *,
  109:         output_dir: str = OUTPUT_DIR,
  110:         max_events: int = 1000,
  111:         executor_resolver=resolve_executor,
  112:     ):
  113:         self.output_dir = output_dir
  114:         self.execution_root = os.path.join(output_dir, "workflows", "executions")
  115:         self.active = JobStore()
  116:         self.events = EventBroker(max_events=max_events)
  117:         self.executor_resolver = executor_resolver
  118: 
  119:     def start(
  120:         self,
  121:         workflow: Mapping[str, Any],
  122:         *,
  123:         run_mode: str,
  124:         target_node_ids: list[str],
  125:         project_id: str | None = None,
  126:         force: bool = False,
  127:     ) -> tuple[str, str]:
  128:         snapshot = prepare_snapshot(workflow)
