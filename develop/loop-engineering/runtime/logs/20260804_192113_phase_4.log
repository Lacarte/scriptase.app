   1: """Persisted workflow and execution record models."""
   2: 
   3: from __future__ import annotations
   4: 
   5: from copy import deepcopy
   6: from dataclasses import asdict, dataclass, field
   7: from typing import Any
   8: 
   9: 
  10: @dataclass
  11: class ExecutionLog:
  12:     ts: str
  13:     level: str
  14:     message: str
  15: 
  16: 
  17: @dataclass
  18: class NodeExecutionRecord:
  19:     status: str = "idle"
  20:     attempts: int = 0
  21:     duration_ms: int | None = None
  22:     fingerprint: str | None = None
  23:     cache: dict[str, Any] | None = None
  24:     from_sample_data: bool = False
  25:     resolved_inputs_summary: dict[str, Any] = field(default_factory=dict)
  26:     outputs_summary: dict[str, Any] = field(default_factory=dict)
  27:     artifact_refs: list[str] = field(default_factory=list)
  28:     logs: list[dict[str, Any]] = field(default_factory=list)
  29:     attempt_errors: list[dict[str, Any]] = field(default_factory=list)
  30:     error: dict[str, Any] | None = None
  31: 
  32: 
  33: @dataclass
  34: class ExecutionRecord:
  35:     execution_id: str
  36:     workflow_id: str
  37:     workflow_snapshot: dict[str, Any]
  38:     project_id: str
  39:     run_mode: str = "full"
  40:     scope_node_ids: list[str] = field(default_factory=list)
  41:     status: str = "running"
  42:     started_at: str = ""
  43:     finished_at: str | None = None
  44:     nodes: dict[str, NodeExecutionRecord] = field(default_factory=dict)
  45:     schema_version: int = 1
  46: 
  47:     def to_dict(self) -> dict[str, Any]:
  48:         return asdict(self)
  49: 
  50: 
  51: def workflow_draft(*, name: str = "Untitled workflow", description: str = "") -> dict:
  52:     return {
  53:         "schema_version": 1,
  54:         "name": name,
  55:         "description": description,
  56:         "nodes": [],
  57:         "edges": [],
  58:         "variables": {},
  59:         "viewport": {"x": 0, "y": 0, "zoom": 1},
  60:         "settings": {"on_error": "stop"},
  61:         "extensions": {},
  62:     }
  63: 
  64: 
  65: def summary(document: dict) -> dict:
  66:     return {
  67:         "workflow_id": document["workflow_id"],
  68:         "name": document["name"],
  69:         "description": document.get("description", ""),
  70:         "node_count": len(document.get("nodes", [])),
  71:         "edge_count": len(document.get("edges", [])),
  72:         "created_at": document.get("created_at"),
  73:         "updated_at": document.get("updated_at"),
  74:     }
  75: 
  76: 
  77: def copy_draft(document: dict, *, name: str | None = None) -> dict:
  78:     draft = deepcopy(document)
  79:     for field in ("workflow_id", "created_at", "updated_at"):
  80:         draft.pop(field, None)
  81:     if name is not None:
  82:         draft["name"] = name
  83:     return draft
