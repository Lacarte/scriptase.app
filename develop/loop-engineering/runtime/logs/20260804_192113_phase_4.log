 264: def dependency_maps(workflow: Mapping[str, Any]) -> tuple[dict[str, set[str]], dict[str, set[str]]]:
 265:     """Return predecessor and reverse/dependent maps for scope calculations."""
 266:     graph = build_graph(workflow)
 267:     dependencies = {
 268:         node_id: {edge["source_node"] for edge in edges}
 269:         for node_id, edges in graph.incoming.items()
 270:     }
 271:     reverse_dependencies = {
 272:         node_id: set(targets) for node_id, targets in graph.dependents.items()
 273:     }
 274:     return dependencies, reverse_dependencies
