 133:     stamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
 134:     destination = safe_join(trash_root, f"{workflow_id}_{stamp}.json")
 135:     shutil.move(source, destination)
 136:     backup = source + ".bak"
