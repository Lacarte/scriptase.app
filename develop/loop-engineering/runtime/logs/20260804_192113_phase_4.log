 339:         return _error("BAD_REQUEST", "force must be a boolean", 400)
 340:     try:
 341:         if has_id:
 342:             workflow = load_workflow(body.get("workflow_id"))
 343:         elif isinstance(body.get("workflow"), dict):
 344:             workflow = body["workflow"]
 345:         else:
 346:             return _error("BAD_REQUEST", "workflow must be an object", 400)
 347:         execution_id, project_id = execution_manager.start(
 348:             workflow,
 349:             run_mode=body.get("run_mode", "full"),
 350:             target_node_ids=targets,
 351:             project_id=body.get("project_id"),
 352:             force=body.get("force", False),
 353:         )
 354:     except WorkflowNotFound:
