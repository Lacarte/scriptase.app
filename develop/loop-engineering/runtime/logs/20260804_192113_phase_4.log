 185: def _summarize(value: Any, *, depth: int = 0) -> Any:
 186:     """Create a bounded diagnostic summary instead of persisting payload bodies."""
 187:     if depth >= 4:
 188:         return {"type": type(value).__name__}
 189:     if isinstance(value, str):
 190:         return {"chars": len(value)}
 191:     if isinstance(value, bytes):
 192:         return {"bytes": len(value)}
 193:     if isinstance(value, Mapping):
