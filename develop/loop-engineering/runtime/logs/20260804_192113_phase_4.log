 195:         if len(value) > 30:
 196:             summary["_truncated_keys"] = len(value) - 30
 197:         return summary
 198:     if isinstance(value, (list, tuple)):
 199:         result = {"count": len(value)}
 200:         if value:
 201:             result["items"] = [_summarize(child, depth=depth + 1) for child in value[:3]]
 202:         return result
 203:     if value is None or isinstance(value, (bool, int, float)):
 204:         return value
 205:     return {"type": type(value).__name__}
