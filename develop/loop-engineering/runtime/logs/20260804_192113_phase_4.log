 141: def import_workflow(document: dict, *, on_conflict: str = "new_id") -> tuple[dict, str | None]:
 142:     original_id = document.get("workflow_id") if isinstance(document, dict) else None
 143:     if on_conflict not in {"new_id", "reject"}:
 144:         raise ValueError("on_conflict must be new_id or reject")
 145:     if original_id is not None and (
 146:         not isinstance(original_id, str) or not WORKFLOW_ID_RE.fullmatch(original_id)
 147:     ):
 148:         raise WorkflowValidationError([{
 149:             "code": "WORKFLOW_INVALID",
 150:             "message": "Imported workflow_id must match wf_XXXXXX",
 151:             "severity": "error",
 152:             "path": "workflow_id",
 153:         }])
 154:     if on_conflict == "reject" and isinstance(original_id, str) and WORKFLOW_ID_RE.fullmatch(original_id):
 155:         if os.path.exists(_path(original_id)):
 156:             raise WorkflowConflict(original_id)
 157:     draft = deepcopy(document)
 158:     for field in ("workflow_id", "created_at", "updated_at"):
 159:         draft.pop(field, None)
 160:     return create_workflow(draft), original_id
