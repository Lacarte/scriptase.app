 222: @dataclass(frozen=True)
 223: class WorkflowGraph:
 224:     nodes: dict[str, dict]
 225:     incoming: dict[str, list[dict]]
 226:     dependents: dict[str, list[str]]
 227:     saved_order: dict[str, int]
 228: 
 229: 
 230: def build_graph(workflow: Mapping[str, Any]) -> WorkflowGraph:
 231:     nodes = {node["id"]: node for node in workflow.get("nodes", [])}
 232:     incoming = {node_id: [] for node_id in nodes}
 233:     dependents = {node_id: [] for node_id in nodes}
 234:     for edge in workflow.get("edges", []):
 235:         incoming[edge["target_node"]].append(edge)
 236:         dependents[edge["source_node"]].append(edge["target_node"])
 237:     return WorkflowGraph(
 238:         nodes=nodes,
 239:         incoming=incoming,
 240:         dependents=dependents,
 241:         saved_order={node["id"]: index for index, node in enumerate(workflow.get("nodes", []))},
 242:     )
 243: 
 244: 
 245: def deterministic_order(workflow: Mapping[str, Any]) -> list[str]:
 246:     """Return stable topological order (saved node order, then node ID)."""
 247:     graph = build_graph(workflow)
 248:     remaining = {node_id: len(edges) for node_id, edges in graph.incoming.items()}
 249:     ready = [(graph.saved_order[node_id], node_id) for node_id, count in remaining.items() if count == 0]
 250:     heapq.heapify(ready)
 251:     order: list[str] = []
 252:     while ready:
 253:         _, node_id = heapq.heappop(ready)
 254:         order.append(node_id)
 255:         for target in graph.dependents[node_id]:
 256:             remaining[target] -= 1
 257:             if remaining[target] == 0:
 258:                 heapq.heappush(ready, (graph.saved_order[target], target))
 259:     if len(order) != len(graph.nodes):
 260:         raise SchedulerError("CYCLE_DETECTED", "Workflow connections must form a DAG")
