 126: def delete_workflow(workflow_id: str, *, expected_updated_at: str | None = None) -> None:
 127:     current = load_workflow(workflow_id)
 128:     if expected_updated_at and current.get("updated_at") != expected_updated_at:
 129:         raise WorkflowConflict(workflow_id)
