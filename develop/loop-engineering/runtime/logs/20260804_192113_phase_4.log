 682:             "max_attempts": supplied.get("max_attempts", 3),
 683:             "delay_ms": supplied.get("delay_ms", 1000),
 684:             "backoff_multiplier": supplied.get("backoff_multiplier", 2.0),
 685:         }
 686: 
 687:     def _failure_payload(self, node: Mapping[str, Any], exc: Exception, attempt: int) -> dict[str, Any]:
 688:         code = getattr(exc, "code", "NODE_EXECUTION_FAILED")
 689:         message = "Execution was cancelled" if code == "CANCELLED" else str(exc)
 690:         suggestion = (
 691:             "Start a new run when ready."
 692:             if code == "CANCELLED"
 693:             else "Review the node inputs and settings, then retry the failed node."
 694:         )
 695:         return self.redactor({
 696:             "node_id": node["id"],
 697:             "node_name": node.get("name") or node["id"],
 698:             "code": code,
 699:             "message": message,
 700:             "details": getattr(exc, "details", None),
 701:             "attempt": attempt,
 702:             "timestamp": now_iso(),
 703:             "recovery_suggestion": suggestion,
 704:         })
