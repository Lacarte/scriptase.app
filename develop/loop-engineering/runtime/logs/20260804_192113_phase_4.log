 112: def update_workflow(workflow_id: str, draft: dict, *, expected_updated_at: str) -> dict:
 113:     current = load_workflow(workflow_id)
 114:     if not expected_updated_at or current.get("updated_at") != expected_updated_at:
 115:         raise WorkflowConflict(workflow_id)
 116:     document = deepcopy(draft)
 117:     document["workflow_id"] = workflow_id
 118:     document["created_at"] = current["created_at"]
 119:     document["updated_at"] = now_iso()
