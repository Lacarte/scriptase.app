 706:     def _sleep_before_retry(self, seconds: float) -> None:
 707:         """Wait in short intervals so a stop request interrupts long backoffs."""
 708:         remaining = seconds
 709:         while remaining > 0 and not self.stop_requested():
 710:             interval = min(0.1, remaining)
 711:             self.sleeper(interval)
 712:             remaining = max(0.0, remaining - interval)
