    # Â§19.1 â€” the domain catalog is where a default provider id belongs.
    ("studio/shared/providers_common/domains.py", "kokoro"),
    ("studio/shared/providers_common/domains.py", "gemini_ws"),
    ("studio/shared/providers_common/domains.py", "gemini"),
    ("studio/shared/providers_common/domains.py", "grok_automa"),
    # Â§41.3 â€” the frozen v1 defaults M1â€“M3 migrate onto.
    ("studio/workflows/config_migrations.py", "kokoro"),
    ("studio/workflows/config_migrations.py", "wavespeed_webhook"),
