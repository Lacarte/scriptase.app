# The surfaces Â§26 names: adding a provider must not edit any of them.
AUDITED_SURFACES = (
    "studio/workflows/registry.py",
    "studio/workflows/options.py",
    "studio/workflows/validation.py",
    "studio/workflows/templates.py",
