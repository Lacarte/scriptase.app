// one fetch per (source, context) for the whole session. No context is sent:
// the `*_providers` sources accept none and imply their domain (Â§23.1).
const asyncOptions = SELECT_TYPES.includes(props.field.type) && props.field.options_source
  ? useOptionSource(props.field.options_source)
  : null

const jsonText = ref('')
const jsonError = ref('')

function setJsonError(message) {
  if (jsonError.value === message) return
  jsonError.value = message
  emit('invalid', message || null)
}

watch(
  () => props.value,
  (value) => {
    if (props.field.type === 'json') {
      jsonText.value = JSON.stringify(value ?? {}, null, 2)
      setJsonError('')
    }
  },
  { immediate: true },
)

// A hidden widget (conditional field, node switch) can no longer hold
// invalid text â€” release the Save block it registered.
onBeforeUnmount(() => {
