+pre { max-height: 180px; overflow: auto; margin: 5px 0 0; padding: 6px; border-radius: 4px; background: rgba(0,0,0,.18); color: #cbd5e1; font: 8px/1.45 var(--font-mono, monospace); white-space: pre-wrap; overflow-wrap: anywhere; }
