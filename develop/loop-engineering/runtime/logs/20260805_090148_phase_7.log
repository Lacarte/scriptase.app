 1315:   function updateNodeConfig(nodeId, name, value) {
 1316:     return executeCommand('Change node configuration', () => {
 1317:     const node = nodeById(nodeId)
 1318:     if (!node) return false
 1319:     const previous = node.configuration[name] === undefined
 1320:       ? undefined
 1321:       : plain(node.configuration[name])
 1322:     if (JSON.stringify(previous) === JSON.stringify(value)) return false
 1323:     node.configuration[name] = value === undefined ? undefined : plain(value)
 1324:     markNodesStale([nodeId])
 1325:     // Retyping a stub retargets its dynamic port: reseed the editable sample
 1326:     // payload and drop edges that no longer type-match (contracts Â§3 â€”
 1327:     // dynamic ports obey exact-match once resolved).
 1328:     if (
 1329:       name === 'port_type'
 1330:       && (node.type === 'stub.input' || node.type === 'stub.output')
 1331:     ) {
 1332:       if (node.type === 'stub.input') {
 1333:         node.configuration.payload = samplePayloadFor(value)
 1334:       }
 1335:       edges.value = edges.value.filter((e) => {
 1336:         if (e.source_node === nodeId && e.source_port === 'value') {
 1337:           const target = nodeById(e.target_node)
 1338:           return endpointPortType(target, 'inputs', e.target_port) === value
 1339:         }
 1340:         if (e.target_node === nodeId && e.target_port === 'value') {
 1341:           const source = nodeById(e.source_node)
 1342:           return endpointPortType(source, 'outputs', e.source_port) === value
 1343:         }
 1344:         return true
 1345:       })
 1346:     }
 1347:     markDocumentDirty()
 1348:     return true
 1349:     })
 1350:   }
