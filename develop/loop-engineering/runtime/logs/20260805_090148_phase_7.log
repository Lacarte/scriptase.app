  776:         if (!position || (position.x === note.position.x && position.y === note.position.y)) return note
  777:         changed = true
  778:         return { ...note, position: { x: position.x, y: position.y } }
  779:       })
  780:       if (!changed) return false
  781:       extensions.value = { ...extensions.value, notes: next }
