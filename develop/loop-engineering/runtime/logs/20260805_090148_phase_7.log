 1391:   function copyFragment(nodeIds) {
 1392:     return makeWorkflowFragment(nodes.value, edges.value, nodeIds)
 1393:   }
 1394: 
 1395:   function pasteFragment(value, { position, label = 'Paste nodes' } = {}) {
 1396:     return executeCommand(label, () => {
 1397:       const fragment = parseWorkflowFragment(value)
 1398:       if (!fragment?.nodes.length) return []
 1399:       if (fragment.nodes.some((node) => {
 1400:         const definition = nodeTypes.value[node.type]
 1401:         return !definition || definition.type_version !== node.type_version
 1402:       })) return []
 1403: 
 1404:       const minX = Math.min(...fragment.nodes.map((node) => node.position?.x ?? 0))
 1405:       const minY = Math.min(...fragment.nodes.map((node) => node.position?.y ?? 0))
 1406:       const offsetX = position ? position.x - minX : 40
 1407:       const offsetY = position ? position.y - minY : 40
 1408:       const ids = new Map()
 1409:       const pasted = fragment.nodes.map((source) => {
 1410:         const copy = plain(source)
 1411:         copy.id = nextNodeId()
 1412:         copy.position = {
 1413:           x: Math.max(-1_000_000, Math.min(1_000_000, (source.position?.x ?? 0) + offsetX)),
 1414:           y: Math.max(-1_000_000, Math.min(1_000_000, (source.position?.y ?? 0) + offsetY)),
 1415:         }
 1416:         ids.set(source.id, copy.id)
 1417:         return copy
 1418:       })
 1419:       nodes.value.push(...pasted)
 1420:       for (const source of fragment.edges) {
 1421:         if (!ids.has(source.source_node) || !ids.has(source.target_node)) continue
 1422:         edges.value.push({
 1423:           ...plain(source),
 1424:           id: nextEdgeId(),
 1425:           source_node: ids.get(source.source_node),
 1426:           target_node: ids.get(source.target_node),
 1427:         })
 1428:       }
 1429:       markDocumentDirty()
 1430:       selectedNodeId.value = pasted.at(-1)?.id || null
 1431:       return pasted
 1432:     })
 1433:   }
 1434: 
 1435:   function duplicateNodes(nodeIds) {
 1436:     const fragment = copyFragment(nodeIds)
 1437:     if (!fragment) return []
 1438:     for (const source of fragment.nodes) {
 1439:       const suffix = ' copy'
 1440:       source.name = `${source.name.slice(0, 120 - suffix.length).trimEnd()}${suffix}`
 1441:     }
 1442:     return pasteFragment(fragment, { label: nodeIds.length === 1 ? 'Duplicate node' : 'Duplicate nodes' })
 1443:   }
