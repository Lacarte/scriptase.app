   65: class CronExpression:
   66:     """A dependency-free standard five-field cron expression (UTC)."""
   67: 
   68:     def __init__(self, expression: str):
   69:         parts = expression.split() if isinstance(expression, str) else []
   70:         if len(parts) != 5:
   71:             raise CronExpressionError("Cron expression must have five fields")
   72:         self.expression = expression
   73:         self.minutes, _ = _field(parts[0], 0, 59)
   74:         self.hours, _ = _field(parts[1], 0, 23)
   75:         self.days, self.day_wildcard = _field(parts[2], 1, 31)
   76:         self.months, _ = _field(parts[3], 1, 12)
   77:         self.weekdays, self.weekday_wildcard = _field(parts[4], 0, 7, sunday=True)
   78: 
   79:     def matches(self, moment: datetime) -> bool:
   80:         moment = _utc(moment)
   81:         # Python Monday=0; cron Sunday=0.
   82:         weekday = (moment.weekday() + 1) % 7
   83:         day_match = moment.day in self.days
   84:         weekday_match = weekday in self.weekdays
   85:         if self.day_wildcard:
   86:             calendar_match = weekday_match
   87:         elif self.weekday_wildcard:
   88:             calendar_match = day_match
   89:         else:
   90:             calendar_match = day_match or weekday_match
   91:         return (
   92:             moment.minute in self.minutes
   93:             and moment.hour in self.hours
   94:             and moment.month in self.months
   95:             and calendar_match
   96:         )
