 1000:   /**
 1001:    * Spawn one pre-connected Sample Input per still-unconnected required
 1002:    * data input of `nodeId`. Returns the created stub nodes.
 1003:    */
 1004:   function attachSampleInputs(nodeId) {
 1005:     return executeCommand('Attach sample inputs', () => {
 1006:     const node = nodeById(nodeId)
 1007:     const def = nodeTypes.value[node?.type]
 1008:     if (!node || !def || !nodeTypes.value['stub.input']) return []
 1009:     const created = []
 1010:     let slot = 0
 1011:     for (const port of def.inputs || []) {
 1012:       if (!port.required || port.type === 'control') continue
 1013:       const connected = edges.value.some(
 1014:         (e) => e.target_node === nodeId && e.target_port === port.id,
 1015:       )
 1016:       if (connected) continue
 1017:       const stub = addNode('stub.input', {
 1018:         x: node.position.x - 260,
 1019:         y: node.position.y + slot * 80,
 1020:       })
 1021:       stub.name = `Sample ${port.id}`
 1022:       stub.configuration.port_type = port.type
 1023:       stub.configuration.payload = samplePayloadFor(port.type)
 1024:       edges.value.push({
 1025:         id: nextEdgeId(),
 1026:         source_node: stub.id,
 1027:         source_port: 'value',
 1028:         target_node: nodeId,
 1029:         target_port: port.id,
 1030:         edge_type: 'data',
 1031:       })
 1032:       created.push(stub)
 1033:       slot += 1
 1034:     }
 1035:     if (created.length) markDocumentDirty()
 1036:     return created
 1037:     })
 1038:   }
