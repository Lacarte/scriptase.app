  107:     def latest_between(self, start: datetime, end: datetime) -> datetime | None:
  108:         """Return only the latest fire in ``(start, end]`` (catch-up policy)."""
  109:         start, end = _utc(start), _utc(end)
  110:         if end <= start:
  111:             return None
  112:         candidate = end.replace(second=0, microsecond=0)
  113:         floor = start.replace(second=0, microsecond=0)
  114:         while candidate >= floor:
  115:             if candidate > start and self.matches(candidate):
  116:                 return candidate
  117:             candidate -= timedelta(minutes=1)
  118:         return None
