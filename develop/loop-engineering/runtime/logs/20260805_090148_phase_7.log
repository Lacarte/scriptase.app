   25: 
   26: class JobStore:
   27:     """A thread-safe dict wrapper for in-memory job tracking."""
   28: 
   29:     def __init__(self):
   30:         self._jobs: dict = {}
   31:         self._lock = threading.Lock()
   32: 
   33:     def get(self, key, default=None):
   34:         with self._lock:
   35:             return self._jobs.get(key, default)
   36: 
   37:     def set(self, key, value):
   38:         with self._lock:
   39:             self._jobs[key] = value
   40: 
   41:     def pop(self, key, default=None):
   42:         with self._lock:
   43:             return self._jobs.pop(key, default)
   44: 
   45:     def values(self):
   46:         with self._lock:
   47:             return list(self._jobs.values())
   48: 
   49:     def items(self):
   50:         with self._lock:
   51:             return list(self._jobs.items())
   52: 
   53:     def __contains__(self, key):
   54:         with self._lock:
   55:             return key in self._jobs
