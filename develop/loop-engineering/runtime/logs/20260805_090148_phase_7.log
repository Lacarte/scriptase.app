 1124:   function applyDocument(document, {
 1125:     markDirty = false,
 1126:     preserveSelection = false,
 1127:     preserveExecution = false,
 1128:   } = {}) {
 1129:     if (!preserveExecution) {
 1130:       clearExecution()
 1131:       clearExecutionHistory()
 1132:     }
 1133:     workflowId.value = document.workflow_id || null
 1134:     workflowName.value = document.name || 'Untitled workflow'
 1135:     workflowDescription.value = document.description || ''
 1136:     nodes.value = plain(document.nodes || [])
 1137:     edges.value = plain(document.edges || [])
 1138:     variables.value = plain(document.variables || {})
 1139:     viewport.value = plain(document.viewport || { x: 0, y: 0, zoom: 1 })
 1140:     settings.value = plain(document.settings || { on_error: 'stop' })
 1141:     extensions.value = plain(document.extensions || {})
 1142:     createdAt.value = document.created_at || null
 1143:     updatedAt.value = document.updated_at || null
 1144:     resetCounters()
 1145:     clearCommandHistory()
 1146:     // Editor widgets remount against the new document; any invalid text they
 1147:     // held is gone with them.
 1148:     clearInvalidFields()
 1149:     if (!preserveSelection || !nodeById(selectedNodeId.value)) selectedNodeId.value = null
 1150:     if (markDirty) {
 1151:       // Unsaved content (template/import-as-draft, draft recovery): keep the
 1152:       // autosave loop armed so the new document is protected too.
 1153:       markDocumentDirty()
 1154:     } else {
 1155:       // A clean document from disk supersedes any stored draft.
 1156:       dirty.value = false
 1157:       clearDraft()
 1158:     }
 1159:   }
