 1445:   function replacementPlan(nodeId, typeKey) {
 1446:     const node = nodeById(nodeId)
 1447:     const definition = nodeTypes.value[typeKey]
 1448:     if (!node || !definition || node.type === typeKey) return null
 1449:     const defaults = defaultsFor(typeKey)
 1450:     const compatible = Object.fromEntries(
 1451:       Object.keys(defaults)
 1452:         .filter((name) => Object.hasOwn(node.configuration || {}, name))
 1453:         .map((name) => [name, plain(node.configuration[name])]),
 1454:     )
 1455:     const candidate = {
 1456:       ...plain(node), type: typeKey, type_version: definition.type_version,
 1457:       configuration: { ...defaults, ...compatible },
 1458:     }
 1459:     const keptEdges = []
 1460:     const droppedEdges = []
 1461:     const inputCounts = new Map()
 1462:     for (const edge of edges.value) {
 1463:       if (edge.source_node !== nodeId && edge.target_node !== nodeId) continue
 1464:       let compatible = true
 1465:       if (edge.source_node === nodeId) {
 1466:         compatible = endpointPortType(candidate, 'outputs', edge.source_port)
 1467:           === endpointPortType(nodeById(edge.target_node), 'inputs', edge.target_port)
 1468:       } else {
 1469:         const port = (definition.inputs || []).find((item) => item.id === edge.target_port)
 1470:         const count = inputCounts.get(edge.target_port) || 0
 1471:         compatible = endpointPortType(nodeById(edge.source_node), 'outputs', edge.source_port)
 1472:           === endpointPortType(candidate, 'inputs', edge.target_port)
 1473:           && Boolean(port?.multiple || count === 0)
 1474:         if (compatible) inputCounts.set(edge.target_port, count + 1)
 1475:       }
 1476:       ;(compatible ? keptEdges : droppedEdges).push(edge)
 1477:     }
 1478:     return { keptEdges: plain(keptEdges), droppedEdges: plain(droppedEdges) }
 1479:   }
 1480: 
 1481:   function replaceNode(nodeId, typeKey, { configuration, keepEdges = true } = {}) {
 1482:     return executeCommand('Replace node', () => {
 1483:       const node = nodeById(nodeId)
 1484:       const def = nodeTypes.value[typeKey]
 1485:       if (!node || !def || node.type === typeKey) return null
 1486:       const previous = plain(node.configuration || {})
 1487:       const previousEdges = plain(edges.value)
 1488:       const defaults = defaultsFor(typeKey)
 1489:       const compatible = Object.fromEntries(
 1490:         Object.keys(defaults)
 1491:           .filter((name) => Object.hasOwn(previous, name))
 1492:           .map((name) => [name, previous[name]]),
 1493:       )
 1494:       const plan = replacementPlan(nodeId, typeKey)
 1495:       node.type = typeKey
 1496:       node.type_version = def.type_version
 1497:       node.configuration = configuration === undefined
 1498:         ? { ...defaults, ...compatible }
 1499:         : plain(configuration)
 1500:       node.on_error = { policy: 'stop' }
 1501:       edges.value = edges.value.filter((edge) => {
 1502:         if (!keepEdges && (edge.source_node === nodeId || edge.target_node === nodeId)) return false
 1503:         if (edge.source_node === nodeId || edge.target_node === nodeId) {
 1504:           return plan.keptEdges.some((kept) => kept.id === edge.id)
 1505:         }
 1506:         return true
 1507:       })
 1508:       markNodesStale([nodeId], previousEdges)
 1509:       markDocumentDirty()
 1510:       return node
 1511:     })
 1512:   }
 1513: 
 1514:   function insertNodeAndConnect(typeKey, position, start, candidatePort) {
 1515:     return executeCommand('Insert connected node', () => {
 1516:       const wasDirty = dirty.value
 1517:       const previousStale = plain(staleNodeIds.value)
 1518:       const node = addNode(typeKey, position)
 1519:       if (!node) return null
 1520:       recordNodeUse(typeKey)
 1521:       if (nodeTypes.value[typeKey]?.category === 'testing') {
 1522:         node.configuration.port_type = start.portType
 1523:         if (typeKey === 'stub.input') node.configuration.payload = samplePayloadFor(start.portType)
 1524:       }
 1525:       const connection = start.handleType === 'target'
 1526:         ? { sourceNode: node.id, sourcePort: candidatePort, targetNode: start.nodeId, targetPort: start.handleId }
 1527:         : { sourceNode: start.nodeId, sourcePort: start.handleId, targetNode: node.id, targetPort: candidatePort }
 1528:       const verdict = connectNodes(connection)
 1529:       if (!verdict.ok) {
 1530:         nodes.value = nodes.value.filter((item) => item.id !== node.id)
 1531:         dirty.value = wasDirty
 1532:         staleNodeIds.value = previousStale
 1533:         return null
 1534:       }
 1535:       selectedNodeId.value = node.id
 1536:       return node
 1537:     })
 1538:   }
