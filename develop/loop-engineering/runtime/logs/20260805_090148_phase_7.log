  918:       const oldEdges = [...edges.value]
  919:       const affected = oldEdges.filter((e) => doomed.has(e.id)).map((e) => e.target_node)
  920:       markNodesStale(affected, oldEdges)
  921:       edges.value = edges.value.filter((e) => !doomed.has(e.id))
  922:       markDocumentDirty()
  923:       return true
  924:     })
  925:   }
