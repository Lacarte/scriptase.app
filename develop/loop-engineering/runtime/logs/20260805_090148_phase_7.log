   98:     def next_after(self, moment: datetime) -> datetime:
   99:         candidate = _utc(moment).replace(second=0, microsecond=0) + timedelta(minutes=1)
  100:         limit = candidate + timedelta(days=366 * 6)
  101:         while candidate <= limit:
  102:             if self.matches(candidate):
  103:                 return candidate
  104:             candidate += timedelta(minutes=1)
