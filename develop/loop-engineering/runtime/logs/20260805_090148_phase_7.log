  665:   const saveBlockedReason = computed(() => {
  666:     const reasons = Object.values(invalidConfigFields.value)
  667:     if (!reasons.length) return ''
  668:     return reasons.length === 1
  669:       ? reasons[0]
  670:       : `${reasons[0]} (and ${reasons.length - 1} more invalid field${reasons.length > 2 ? 's' : ''})`
  671:   })
