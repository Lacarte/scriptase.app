  568:   /** Every mutation that makes the document diverge from disk funnels here. */
  569:   function markDocumentDirty() {
  570:     dirty.value = true
  571:     scheduleDraftAutosave()
  572:   }
  573: 
  574:   /** Write the draft immediately (no-op when there is nothing unsaved). */
  575:   function flushDraft() {
  576:     cancelDraftAutosave()
  577:     if (!dirty.value) return false
  578:     try {
  579:       const payload = {
  580:         version: 1,
  581:         saved_at: new Date().toISOString(),
  582:         document: toDocument(),
  583:       }
  584:       globalThis.localStorage?.setItem(DRAFT_STORAGE_KEY, JSON.stringify(payload))
  585:       draftSavedAt.value = payload.saved_at
  586:       return true
  587:     } catch {
  588:       // Quota exceeded / storage disabled: autosave is best-effort, the
  589:       // explicit Save path and dirty indicator still protect the user.
  590:       return false
  591:     }
  592:   }
  593: 
  594:   /** Read the stored draft without applying it. Corrupt drafts are dropped. */
  595:   function peekDraft() {
  596:     let raw = null
  597:     try {
  598:       raw = globalThis.localStorage?.getItem(DRAFT_STORAGE_KEY)
  599:     } catch {
  600:       return null
  601:     }
  602:     if (!raw) return null
  603:     try {
  604:       const draft = JSON.parse(raw)
  605:       if (!draft || typeof draft !== 'object') throw new Error('not an object')
  606:       if (!draft.document || typeof draft.document !== 'object') throw new Error('no document')
  607:       return draft
  608:     } catch {
  609:       clearDraft()
  610:       return null
  611:     }
  612:   }
  613: 
  614:   function clearDraft() {
  615:     cancelDraftAutosave()
  616:     draftSavedAt.value = null
  617:     try {
  618:       globalThis.localStorage?.removeItem(DRAFT_STORAGE_KEY)
  619:     } catch {
  620:       /* storage unavailable â€” nothing to clear */
  621:     }
  622:   }
  623: 
  624:   /** Apply the stored draft as the (still unsaved) working document. */
  625:   function recoverDraft() {
  626:     const draft = peekDraft()
  627:     if (!draft) return false
  628:     applyDocument(draft.document, { markDirty: true })
  629:     draftSavedAt.value = draft.saved_at || null
  630:     return true
  631:   }
