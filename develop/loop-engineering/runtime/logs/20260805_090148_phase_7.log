 1104:       description: workflowDescription.value,
 1105:       nodes: plain(nodes.value),
 1106:       edges: plain(edges.value),
 1107:       variables: plain(variables.value),
 1108:       viewport: plain(viewport.value),
 1109:       settings: plain(settings.value),
 1110:       extensions: plain(extensions.value),
 1111:     }
 1112:     if (workflowId.value) document.workflow_id = workflowId.value
 1113:     if (createdAt.value) document.created_at = createdAt.value
 1114:     if (updatedAt.value) document.updated_at = updatedAt.value
 1115:     return document
