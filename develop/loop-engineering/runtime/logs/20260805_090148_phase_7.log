  859:   /**
  860:    * Validate + create a connection. Returns the validation result;
  861:    * on success the edge is appended in the persisted shape.
  862:    *
  863:    * Step 2.5: when a REAL edge lands on an input currently fed by a Sample
  864:    * Input stub, the stub edge (and the stub itself, unless it still feeds
  865:    * other inputs) is removed first â€” undoably via undoStubDetach().
  866:    */
  867:   function connectNodes({ sourceNode, sourcePort, targetNode, targetPort }) {
  868:     return executeCommand('Connect nodes', () => {
  869:       const sourceIsStub = nodeById(sourceNode)?.type === 'stub.input'
  870:       const stubEdge = sourceIsStub
  871:         ? null
  872:         : edges.value.find(
  873:           (e) => e.target_node === targetNode && e.target_port === targetPort
  874:             && nodeById(e.source_node)?.type === 'stub.input',
  875:         )
  876:       // Validate against the graph as it would look after the stub detaches,
  877:       // so replacing sample data with a real edge is never "input occupied".
  878:       const candidateEdges = stubEdge
  879:         ? edges.value.filter((e) => e.id !== stubEdge.id)
  880:         : edges.value
  881:       const verdict = validateConnection(
  882:         { nodes: nodes.value, edges: candidateEdges, nodeTypes: nodeTypes.value, portTypes: portTypes.value },
  883:         { sourceNode, sourcePort, targetNode, targetPort },
  884:       )
  885:       if (!verdict.ok) return verdict
  886: 
  887:       if (stubEdge) {
  888:         const stubNode = nodeById(stubEdge.source_node)
  889:         const stillFeedsOthers = edges.value.some(
  890:           (e) => e.source_node === stubNode.id && e.id !== stubEdge.id,
  891:         )
  892:         edges.value = edges.value.filter((e) => e.id !== stubEdge.id)
  893:         if (!stillFeedsOthers) {
  894:           nodes.value = nodes.value.filter((n) => n.id !== stubNode.id)
  895:           if (selectedNodeId.value === stubNode.id) selectedNodeId.value = null
  896:         }
  897:       }
  898: 
  899:       const edge = {
  900:         id: nextEdgeId(),
  901:         source_node: sourceNode,
  902:         source_port: sourcePort,
  903:         target_node: targetNode,
  904:         target_port: targetPort,
  905:         edge_type: verdict.edgeType,
  906:       }
  907:       edges.value.push(edge)
  908:       markNodesStale([targetNode])
  909:       markDocumentDirty()
  910:       return { ...verdict, detachedStub: Boolean(stubEdge) }
  911:     })
  912:   }
