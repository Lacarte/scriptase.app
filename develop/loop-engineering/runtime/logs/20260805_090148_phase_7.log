  560:   function scheduleDraftAutosave() {
  561:     cancelDraftAutosave()
  562:     draftTimer = setTimeout(() => {
  563:       draftTimer = null
  564:       flushDraft()
  565:     }, DRAFT_DEBOUNCE_MS)
  566:   }
