  643:   const invalidConfigFields = ref({}) // key â†’ user-facing reason
  644: 
  645:   function reportInvalidField(key, reason = '') {
  646:     if (!key) return
  647:     if (reason) {
  648:       invalidConfigFields.value = { ...invalidConfigFields.value, [key]: reason }
  649:     } else if (Object.hasOwn(invalidConfigFields.value, key)) {
  650:       const next = { ...invalidConfigFields.value }
  651:       delete next[key]
  652:       invalidConfigFields.value = next
  653:     }
  654:   }
