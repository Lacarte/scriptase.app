   1: """Settings Manager — Phase 1: load, save, validate, atomic writes, redaction.
   2: 
   3: Canonical source of truth for nested provider settings at settings/settings.json.
   4: Thread-safe with file locking.
   5: """
   6: 
   7: import json
   8: import os
   9: import re
  10: import tempfile
  11: import threading
  12: from pathlib import Path
  13: from typing import Any
  14: 
  15: from loguru import logger
  16: 
  17: from config import ROOT_DIR
  18: from studio.shared.providers_common.settings_migrations import apply_migrations
  19: 
  20: 
  21: SETTINGS_DIR = os.path.join(ROOT_DIR, "settings")
  22: SETTINGS_PATH = os.path.join(SETTINGS_DIR, "settings.json")
  23: 
  24: _lock = threading.RLock()
  25: 
  26: 
  27: def _ensure_settings_dir() -> None:
  28:     """Ensure the settings directory exists."""
  29:     os.makedirs(SETTINGS_DIR, exist_ok=True)
  30: 
  31: 
  32: _settings_seeded = False
  33: 
  34: 
  35: def load_settings() -> dict:
  36:     """Load settings from settings/settings.json, applying migrations if needed.
  37:     
  38:     On first load, seeds from environment variables if settings.json doesn't exist.
  39:     Returns the full settings dict with version, general, and domains keys.
  40:     """
  41:     global _settings_seeded
  42:     
  43:     _ensure_settings_dir()
  44:     
  45:     with _lock:
  46:         try:
  47:             with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
  48:                 data = json.load(f)
  49:         except FileNotFoundError:
  50:             logger.warning("[settings] settings.json not found, seeding from env vars")
  51:             data = _seed_from_env()
  52:             save_settings(data)
  53:             _settings_seeded = True
  54:             return data
  55:         except json.JSONDecodeError as e:
  56:             logger.error("[settings] Corrupted settings.json: {}, returning defaults", e)
  57:             return _default_settings()
  58:     
  59:     migrated, changed = apply_migrations(data)
  60:     if changed:
  61:         logger.info("[settings] Applied migrations, version now {}", migrated.get("version"))
  62:         save_settings(migrated)
  63: 
  64:     return migrated
  65: 
  66: 
  67: def _seed_from_env() -> dict:
  68:     """Seed default settings from environment variables."""
  69:     import os as os_module
  70: 
  71:     def env(key: str, default: Any = None) -> str:
  72:         return os_module.environ.get(key, default) or default or ""
  73: 
  74:     settings = _default_settings()
  75:     tts_pp = settings["domains"]["tts"]["per_provider"]
  76:     sb_pp = settings["domains"]["storyboard"]["per_provider"]
  77:     an_pp = settings["domains"]["animator"]["per_provider"]
  78: 
  79:     sync_folder = env("STS_SYNC_FOLDER", "")
  80:     if sync_folder:
  81:         settings["general"]["sync_folder"] = sync_folder
  82: 
  83:     settings["general"]["auto_sync"] = env("STS_AUTO_SYNC", "true").lower() in ("true", "1", "yes")
  84: 
  85:     inworld_api_key = env("INWORLD_API_KEY", "")
  86:     if inworld_api_key:
  87:         tts_pp.setdefault("inworld", {})["api_key"] = inworld_api_key
  88:         settings["domains"]["tts"]["selected_provider"] = "inworld"
  89: 
  90:     inworld_model = env("INWORLD_TTS_MODEL", "")
  91:     if inworld_model:
  92:         tts_pp.setdefault("inworld", {})["model"] = inworld_model
  93: 
  94:     wavespeed_api_key = env("WAVESPEED_API_KEY", "")
  95:     if wavespeed_api_key:
  96:         sb_pp.setdefault("wavespeed_direct", {})["api_key"] = wavespeed_api_key
  97: 
  98:     kie_api_key = env("KIE_AI_API_KEY", "")
  99:     if kie_api_key:
 100:         an_pp.setdefault("kie_ai", {})["api_key"] = kie_api_key
 101: 
 102:     kie_model = env("KIE_AI_MODEL", "")
 103:     if kie_model:
 104:         an_pp.setdefault("kie_ai", {})["model"] = kie_model
 105: 
 106:     logger.info("[settings] Seeded settings from environment variables")
 107:     return settings
 108: 
 109: 
 110: def save_settings(data: dict) -> None:
 111:     """Save settings to settings/settings.json atomically.
 112:     
 113:     Uses write-to-temp-then-rename for atomicity.
 114:     """
 115:     _ensure_settings_dir()
 116:     
 117:     with _lock:
 118:         temp_fd, temp_path = tempfile.mkstemp(
 119:             dir=SETTINGS_DIR,
 120:             prefix=".settings_",
 121:             suffix=".tmp"
 122:         )
 123:         try:
 124:             with os.fdopen(temp_fd, "w", encoding="utf-8", newline="\n") as f:
 125:                 json.dump(data, f, indent=2, ensure_ascii=False)
 126:                 f.write("\n")
 127:                 f.flush()
 128:                 os.fsync(f.fileno())
 129:             os.replace(temp_path, SETTINGS_PATH)
 130:             logger.debug("[settings] Saved settings.json")
 131:         except Exception:
 132:             if os.path.exists(temp_path):
 133:                 os.unlink(temp_path)
 134:             raise
 135: 
