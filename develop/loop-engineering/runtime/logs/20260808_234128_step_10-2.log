 214: SENSITIVE_KEYS_RE = re.compile(
 215:     r"(api_key|token|secret|password|auth|bearer|credential)",
 216:     re.IGNORECASE
 217: )
 218: 
 219: 
 220: def redact_settings(data: dict) -> dict:
 221:     """Redact sensitive fields from settings.
 222:     
 223:     Redacts fields that:
 224:     - Have type "password" in schema
 225:     - Keys matching *_key, *_token, *_secret patterns
 226:     """
 227:     if not isinstance(data, dict):
 228:         return data
 229:     
 230:     redacted = {}
 231:     for key, value in data.items():
 232:         if SENSITIVE_KEYS_RE.search(key):
 233:             redacted[key] = "***"
 234:         elif isinstance(value, dict):
 235:             redacted[key] = redact_settings(value)
 236:         elif isinstance(value, list):
 237:             redacted[key] = [
 238:                 redact_settings(item) if isinstance(item, dict) else item
 239:                 for item in value
 240:             ]
 241:         else:
 242:             redacted[key] = value
 243:     
 244:     return redacted
 245: 
 246: 
 247: def redacted_provider_settings(domain: str, provider_id: str) -> dict:
 248:     """Get redacted settings for a specific provider."""
 249:     return redact_settings(get_provider_settings(domain, provider_id))
 250: 
 251: 
 252: def validate_settings(data: dict) -> list[dict]:
 253:     """Validate settings structure.
 254:     
 255:     Returns list of ValidationIssue dicts with 'field', 'severity', 'message'.
 256:     """
 257:     issues = []
 258:     
 259:     if not isinstance(data, dict):
 260:         return [{"field": "root", "severity": "error", "message": "Settings must be a JSON object"}]
 261:     
 262:     version = data.get("version")
 263:     if version is None:
 264:         issues.append({"field": "version", "severity": "warning", "message": "version field missing, assuming v1"})
 265:     
 266:     domains = data.get("domains")
 267:     if not isinstance(domains, dict):
 268:         issues.append({"field": "domains", "severity": "error", "message": "domains must be an object"})
 269:     else:
 270:         valid_domains = {"tts", "storyboard", "animator"}
 271:         for domain in domains:
 272:             if domain not in valid_domains:
 273:                 issues.append({
 274:                     "field": f"domains.{domain}",
 275:                     "severity": "warning",
 276:                     "message": f"Unknown domain '{domain}'"
 277:                 })
 278:     
 279:     return issues
--- studio/workflows/options.py ---
   1: """Backend-approved async option sources (step 2.3, contracts §11).
   2: 
   3: Every `options_source` identifier in the registry resolves through this
   4: allowlist — schema-provided URLs are never fetched. Resolvers import
   5: their data sources lazily so importing this module stays cheap.
   6: """
   7: 
   8: from loguru import logger
   9: 
  10: from .registry import ASYNC_OPTION_SOURCES
  11: 
  12: EXPORT_PROFILES = ["yt_shorts", "tiktok", "reels", "yt_landscape", "square"]
  13: 
  14: 
  15: def _opt(value, label=None):
  16:     return {"value": value, "label": label or value}
  17: 
  18: 
  19: def _tts_voices():
  20:     from studio.tts.routes import VOICES
  21:     return [_opt(voice) for voice in VOICES]
  22: 
  23: 
  24: def _story_tones():
  25:     from studio.music.selector import TONE_MUSIC_MAP
  26:     return [_opt("", "—")] + [_opt(tone) for tone in sorted(TONE_MUSIC_MAP)]
  27: 
  28: 
  29: def _style_templates():
  30:     from studio.build_scene_blueprints.templates import TEMPLATES_BY_ID
  31:     options = []
  32:     for template_id in sorted(TEMPLATES_BY_ID):
  33:         template = TEMPLATES_BY_ID[template_id] or {}
  34:         options.append(_opt(template_id, template.get("name") or template_id))
  35:     return options
  36: 
  37: 
  38: def _provider_options(domain):
  39:     if domain == "storyboard":
  40:         from studio.storyboard.providers import registry
  41:     else:
  42:         from studio.animator.providers import registry
  43:     options = []
  44:     for provider in registry.list_providers():
  45:         manifest = getattr(provider, "manifest", None)
  46:         provider_id = getattr(manifest, "id", None) or getattr(provider, "id", None)
  47:         label = getattr(manifest, "label", None) or provider_id
  48:         if provider_id:
  49:             options.append(_opt(provider_id, label))
  50:     return options
  51: 
  52: 
  53: def _caption_presets():
  54:     from studio.captions.routes import CAPTION_PRESETS
  55:     options = []
  56:     for preset_id, preset in CAPTION_PRESETS.items():
  57:         label = preset_id
  58:         if isinstance(preset, dict):
  59:             label = preset.get("name") or preset.get("label") or preset_id
  60:         options.append(_opt(preset_id, label))
  61:     return options
  62: 
  63: 
  64: _RESOLVERS = {
  65:     "tts_voices": _tts_voices,
  66:     "story_tones": _story_tones,
  67:     "style_templates": _style_templates,
  68:     "storyboard_providers": lambda: _provider_options("storyboard"),
  69:     "animator_providers": lambda: _provider_options("animator"),
  70:     "export_profiles": lambda: [_opt(p) for p in EXPORT_PROFILES],
  71:     "caption_presets": _caption_presets,
  72: }
  73: 
  74: # The registry allowlist and the resolver table must never drift.
  75: assert set(_RESOLVERS) == set(ASYNC_OPTION_SOURCES), (
  76:     "options resolvers out of sync with ASYNC_OPTION_SOURCES"
  77: )
  78: 
  79: 
  80: # Process-lifetime cache of legal values per source: every resolver serves
  81: # static in-process data, and validation runs on each save (step 6.3).
  82: _VALUE_CACHE: dict[str, frozenset] = {}
  83: 
  84: 
  85: def allowed_option_values(source: str):
  86:     """Frozen set of legal values for an allowlisted source, or None when the
  87:     source is unknown or currently unavailable.
  88: 
  89:     Server-side validation of submitted option values (step 6.3) fails open on
  90:     resolver errors: bad values are rejected, but an unavailable provider must
  91:     never block saving otherwise-valid workflows.
  92:     """
  93:     cached = _VALUE_CACHE.get(source)
  94:     if cached is not None:
  95:         return cached
  96:     resolver = _RESOLVERS.get(source)
  97:     if resolver is None:
  98:         return None
  99:     try:
 100:         values = frozenset(option["value"] for option in resolver())
 101:     except Exception as exc:
 102:         logger.warning("option source {} unavailable for validation: {}", source, exc)
 103:         return None
 104:     _VALUE_CACHE[source] = values
 105:     return values
 106: 
 107: 
 108: def resolve_options(source: str):
 109:     """Return [{value, label}] for an allowlisted source, or None if unknown.
 110: 
 111:     Raises RuntimeError when a known source fails to load (surfaced as
 112:     PROVIDER_UNAVAILABLE by the route).
 113:     """
 114:     resolver = _RESOLVERS.get(source)
 115:     if resolver is None:
 116:         return None
 117:     try:
 118:         return resolver()
 119:     except Exception as exc:  # data source unavailable — never a 500
 120:         logger.warning("option source {} failed: {}", source, exc)
 121:         raise RuntimeError(f"Option source {source} is unavailable") from exc
