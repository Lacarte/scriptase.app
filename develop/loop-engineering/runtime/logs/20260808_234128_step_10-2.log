  12: _ID_RE = re.compile(r"[^A-Za-z0-9_-]+")
  13: 
  14: 
  15: def sanitize_project_id(value: str | None, max_len: int = 100) -> str:
  16:     """Return a strict project id (alnum, underscore, hyphen)."""
  17:     raw = (value or "").strip()
  18:     cleaned = _ID_RE.sub("", raw)
  19:     return cleaned[:max_len]
  20: 
  21: 
  22: def sanitize_folder_name(value: str | None, max_len: int = 120) -> str:
  23:     """Folder-safe identifier using the same charset constraints as project IDs."""
  24:     return sanitize_project_id(value, max_len=max_len)
  25: 
  26: 
  27: def safe_join(root: str, *parts: str) -> str:
  28:     """Join paths while preventing traversal outside root."""
  29:     root_abs = os.path.abspath(root)
  30:     target = root_abs
  31:     for part in parts:
  32:         target = os.path.join(target, part)
  33:     target_abs = os.path.abspath(target)
  34:     if os.path.commonpath([root_abs, target_abs]) != root_abs:
  35:         raise ValueError("Path escapes root")
  36:     return target_abs
  37: 
  38: 
  39: def _host_resolves_to_private(hostname: str) -> bool:
  40:     host = (hostname or "").strip().lower()
  41:     if not host:
  42:         return True
  43:     if host in {"localhost", "127.0.0.1", "::1"}:
  44:         return True
  45:     try:
  46:         ip = ipaddress.ip_address(host)
  47:         return (
  48:             ip.is_private
  49:             or ip.is_loopback
  50:             or ip.is_link_local
  51:             or ip.is_multicast
  52:             or ip.is_reserved
  53:         )
  54:     except ValueError:
  55:         pass
  56: 
  57:     try:
  58:         infos = socket.getaddrinfo(host, None, proto=socket.IPPROTO_TCP)
  59:     except OSError:
  60:         return True
  61: 
  62:     for info in infos:
  63:         addr = info[4][0]
  64:         try:
  65:             ip = ipaddress.ip_address(addr)
  66:             if (
  67:                 ip.is_private
  68:                 or ip.is_loopback
  69:                 or ip.is_link_local
  70:                 or ip.is_multicast
  71:                 or ip.is_reserved
  72:             ):
  73:                 return True
  74:         except ValueError:
  75:             return True
  76:     return False
  77: 
  78: 
  79: def is_safe_webhook_url(url: str | None, allow_private: bool = True) -> bool:
  80:     """Allow only http(s) webhook URLs, optionally blocking private/local targets."""
  81:     raw = (url or "").strip()
  82:     if not raw:
  83:         return False
  84:     try:
  85:         parsed = urlparse(raw)
  86:     except ValueError:
  87:         return False
  88:     if parsed.scheme not in {"http", "https"}:
  89:         return False
  90:     if not parsed.hostname:
  91:         return False
  92:     if allow_private:
  93:         return True
  94:     return not _host_resolves_to_private(parsed.hostname)
  95: 
  96: 
  97: def is_loopback_remote(remote_addr: str | None) -> bool:
  98:     value = (remote_addr or "").strip()
  99:     if not value:
 100:         return False
 101:     try:
 102:         ip = ipaddress.ip_address(value)
 103:     except ValueError:
 104:         return False
 105:     return ip.is_loopback
