 153:                 return result
 154:             except Exception as e:
 155:                 logger.warning("[registry] health_check failed for {}: {}", self.id, e)
 156:                 return HealthResult(status='fail', message=str(e))
 157:         return HealthResult(status='ok')
 158:     
 159:     def to_dict(self) -> dict:
 160:         """Serialize to dict for API responses."""
 161:         return {
 162:             'id': self.id,
 163:             'label': self.label,
 164:             'domain': self.domain,
 165:             'kind': self.kind,
 166:             'version': self.version,
 167:             'requires': self.requires,
 168:             'capabilities': self.capabilities,
 169:             'open_url': self.manifest.open_url,
 170:             'has_settings': self.settings_schema() is not None,
 171:         }
 172: 
 173: 
 174: class ProviderRegistry:
 175:     """Domain-scoped provider registry with discovery."""
 176:     
 177:     VALID_DOMAINS = {'tts', 'storyboard', 'animator'}
 178:     
 179:     def __init__(self, domain: str):
 180:         if domain not in self.VALID_DOMAINS:
 181:             raise ValueError(f"Invalid domain: {domain}. Must be one of {self.VALID_DOMAINS}")
 182:         self.domain = domain
 183:         self._providers: dict[str, ProviderInstance] = {}
 184:         self._lock = threading.RLock()
 185:         self._discovered = False
 186:     
 187:     def register(
 188:         self,
 189:         provider_id: str,
 190:         module: Any,
 191:         manifest: ProviderManifest,
 192:         provider_module: Any = None,
 193:         schema_module: Any = None,
 194:     ) -> None:
 195:         """Register a provider instance."""
 196:         if manifest.domain != self.domain:
 197:             logger.error("[registry] Cannot register {}: wrong domain (expected {}, got {})",
 198:                         provider_id, self.domain, manifest.domain)
 199:             return
 200: 
 201:         with self._lock:
 202:             if provider_id in self._providers:
 203:                 logger.warning("[registry] Duplicate provider id '{}' in domain '{}', skipping",
 204:                              provider_id, self.domain)
 205:                 return
 206:             self._providers[provider_id] = ProviderInstance(
 207:                 provider_id, module, manifest,
 208:                 provider_module=provider_module,
 209:                 schema_module=schema_module,
 210:             )
 211:             logger.info("[registry] Registered provider '{}' ({}) in {}",
 212:                        provider_id, manifest.label, self.domain)
 213:     
 214:     def get(self, provider_id: str) -> ProviderInstance | None:
 215:         """Get a provider by ID."""
 216:         return self._providers.get(provider_id)
 217:     
 218:     def list_providers(self) -> list[ProviderInstance]:
 219:         """List all registered providers."""
 220:         return list(self._providers.values())
 221:     
 222:     def list_ids(self) -> list[str]:
 223:         """List all provider IDs."""
 224:         return list(self._providers.keys())
 225:     
 226:     def __len__(self) -> int:
 227:         return len(self._providers)
 228:     
 229:     def discovery_scan(self, providers_base: str) -> None:
 230:         """Scan provider folders and load manifests.
 231:         
 232:         Args:
 233:             providers_base: Base path like 'studio/tts/providers'
 234:         """
 235:         if not os.path.isdir(providers_base):
 236:             logger.debug("[registry] Provider base not found: {}", providers_base)
 237:             return
 238:         
 239:         for entry in os.listdir(providers_base):
 240:             provider_path = os.path.join(providers_base, entry)
 241:             if not os.path.isdir(provider_path):
 242:                 continue
 243:             if entry.startswith('_') or entry.startswith('.'):
 244:                 continue
 245:             
 246:             manifest_file = os.path.join(provider_path, 'manifest.py')
 247:             if not os.path.isfile(manifest_file):
 248:                 logger.debug("[registry] No manifest.py in {}, skipping", entry)
 249:                 continue
 250:             
 251:             self._load_provider(entry, provider_path, manifest_file)
 252:         
 253:         self._discovered = True
 254:     
 255:     def _load_module_from_file(self, file_path: str, module_name: str) -> Any:
 256:         """Load a Python module from a file path. Returns module or None on failure."""
 257:         try:
 258:             spec = importlib.util.spec_from_file_location(module_name, file_path)
 259:             if spec is None or spec.loader is None:
 260:                 return None
 261:             module = importlib.util.module_from_spec(spec)
 262:             spec.loader.exec_module(module)
 263:             return module
 264:         except Exception as e:
 265:             logger.warning("[registry] Failed to load {}: {}", file_path, e)
 266:             return None
 267: 
 268:     def _load_provider(self, provider_id: str, provider_path: str, manifest_file: str) -> None:
 269:         """Load a provider's manifest + optional provider.py + optional settings_schema.py.
 270: 
 271:         Applies broken-provider isolation: any exclusion logs WARN and returns.
 272:         """
 273:         module_prefix = f"_sts_provider_{self.domain}_{provider_id}"
 274: 
 275:         try:
 276:             spec = importlib.util.spec_from_file_location(f"{module_prefix}_manifest", manifest_file)
 277:             if spec is None or spec.loader is None:
 278:                 logger.warning("[registry] [EXCLUDED] {}: could not load manifest (spec failed)", provider_id)
 279:                 return
 280: 
 281:             module = importlib.util.module_from_spec(spec)
 282:             spec.loader.exec_module(module)
 283:         except SyntaxError as e:
 284:             logger.warning("[registry] [EXCLUDED] {}: SyntaxError in manifest.py: {}", provider_id, e)
 285:             return
 286:         except ImportError as e:
 287:             logger.warning("[registry] [EXCLUDED] {}: ImportError in manifest.py: {}", provider_id, e)
 288:             return
 289:         except Exception as e:
 290:             logger.warning("[registry] [EXCLUDED] {}: failed to load manifest.py: {}", provider_id, e)
 291:             return
 292: 
 293:         if not hasattr(module, 'manifest'):
 294:             logger.warning("[registry] [EXCLUDED] {}: manifest() function not found", provider_id)
 295:             return
 296: 
 297:         try:
 298:             manifest_data = module.manifest()
 299:         except Exception as e:
 300:             logger.warning("[registry] [EXCLUDED] {}: manifest() call raised: {}", provider_id, e)
 301:             return
 302: 
 303:         if not isinstance(manifest_data, ProviderManifest):
 304:             if isinstance(manifest_data, dict):
 305:                 try:
 306:                     manifest_data = ProviderManifest(**manifest_data)
 307:                 except Exception as e:
 308:                     logger.warning("[registry] [EXCLUDED] {}: invalid manifest dict: {}", provider_id, e)
 309:                     return
 310:             else:
 311:                 logger.warning("[registry] [EXCLUDED] {}: manifest() must return ProviderManifest or dict", provider_id)
 312:                 return
 313: 
 314:         required_fields = ['id', 'label', 'domain', 'kind', 'version', 'capabilities']
 315:         missing = [f for f in required_fields if not getattr(manifest_data, f, None)]
 316:         if missing:
 317:             logger.warning("[registry] [EXCLUDED] {}: missing required fields: {}", provider_id, missing)
 318:             return
 319: 
 320:         if manifest_data.id != provider_id:
 321:             logger.warning("[registry] [EXCLUDED] {}: manifest.id '{}' != folder name",
 322:                          provider_id, manifest_data.id)
 323:             return
 324: 
 325:         provider_file = os.path.join(provider_path, 'provider.py')
 326:         schema_file = os.path.join(provider_path, 'settings_schema.py')
 327:         provider_module = None
 328:         schema_module = None
 329: 
 330:         if os.path.isfile(provider_file):
 331:             provider_module = self._load_module_from_file(
 332:                 provider_file, f"{module_prefix}_provider"
 333:             )
 334:             if provider_module is None:
 335:                 logger.warning("[registry] {}: provider.py failed to load — functions will fall back to manifest", provider_id)
 336: 
 337:         if os.path.isfile(schema_file):
 338:             schema_module = self._load_module_from_file(
 339:                 schema_file, f"{module_prefix}_schema"
 340:             )
 341:             if schema_module is None:
 342:                 logger.warning("[registry] {}: settings_schema.py failed to load", provider_id)
 343: 
 344:         self.register(
 345:             provider_id, module, manifest_data,
 346:             provider_module=provider_module,
 347:             schema_module=schema_module,
 348:         )
 349:     
 350:     def to_dict(self, selected_provider: str | None = None) -> dict:
 351:         """Serialize registry state for API response."""
 352:         return {
 353:             'domain': self.domain,
 354:             'providers': [p.to_dict() for p in self.list_providers()],
 355:             'selected': selected_provider,
 356:             'count': len(self),
 357:         }
