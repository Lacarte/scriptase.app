+def _strict_execution_id(execution_id: str) -> str:
+    if not isinstance(execution_id, str) or not EXECUTION_ID_RE.fullmatch(execution_id):
+        raise ValueError("execution_id must match ex_XXXXXX")
+    return execution_id
