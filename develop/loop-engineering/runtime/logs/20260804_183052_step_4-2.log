+
+    store.updateNodeConfig(viewer.id, 'payload', { segments: [{ start: 2, end: 1, words: 'bad' }] })
+    expect(store.issuesByNode[viewer.id].some((issue) => issue.name === 'payload')).toBe(true)
+  })
+})
