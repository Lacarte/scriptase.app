def _wav_duration(path: Path) -> float:
    with wave.open(str(path), "rb") as handle:
        frames = handle.getnframes()
        rate = handle.getframerate()
    if rate <= 0 or frames <= 0:
        raise ValueError(f"{path.name} is not a playable WAV file")
    return frames / rate


