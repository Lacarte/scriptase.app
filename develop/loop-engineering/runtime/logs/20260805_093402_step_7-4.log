+            "type": "tts.generate",
+            "type_version": 1,
+            "name": "Narration",
+            "position": {"x": 0, "y": 0},
+            "configuration": {},
+            "disabled": False,
+            "extensions": {},
+        }],
+        "edges": [],
+        "variables": {},
+        "viewport": {"x": 0, "y": 0, "zoom": 1},
+        "settings": {
+            "on_error": "stop",
+            "webhook": {
+                "enabled": True,
+                "mappings": [{
