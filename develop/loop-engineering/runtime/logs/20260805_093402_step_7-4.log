+
+def test_webhook_settings_validate_declared_unique_data_ports():
+    workflow = _workflow()
+    assert validation_errors(validate_workflow(workflow, require_identity=True)) == []
+    assert map_webhook_payload(workflow, {"story": {"text": "hello"}}) == {
+        "tts": {"script": "hello"}
