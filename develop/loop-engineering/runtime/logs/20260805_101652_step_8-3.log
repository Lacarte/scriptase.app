def _problem(code: str, message: str, path: str = "", *, severity: str = "error") -> dict:
    item = {"code": code, "message": message, "severity": severity}
    if path:
        item["path"] = path
    return item


def _json_size(value: Any) -> int:
    return len(json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":"),
        allow_nan=False,
    ).encode("utf-8"))


