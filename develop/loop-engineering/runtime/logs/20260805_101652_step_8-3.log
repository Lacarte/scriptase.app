    if (!node) return false
    const next = { ...(node.on_error || { policy: 'stop' }), ...plain(patch) }
    if (JSON.stringify(node.on_error) === JSON.stringify(next)) return false
    node.on_error = next
    markDocumentDirty()
    return true
