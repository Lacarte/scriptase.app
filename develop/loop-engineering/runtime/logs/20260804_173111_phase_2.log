 151: def _validate_string(payload, problems, *, label, max_length=10000):
 152:     if not isinstance(payload, str) or not payload.strip():
 153:         problems.append(_invalid(f"A {label} payload must be a non-empty string"))
 154:     elif len(payload) > max_length:
 155:         problems.append(_invalid(f"A {label} payload must stay under {max_length} characters"))
 156: 
