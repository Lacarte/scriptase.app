 124: def _check_artifact_refs(payload: dict, problems: list[dict]) -> None:
 125:     refs = payload.get("artifact_refs")
 126:     if refs is None:
 127:         return
 128:     if not isinstance(refs, list):
 129:         problems.append(_invalid("artifact_refs must be a list of fixture-relative paths"))
 130:         return
 131:     for index, ref in enumerate(refs):
 132:         _check_ref(ref, problems, f"artifact_refs[{index}]")
 133: 
