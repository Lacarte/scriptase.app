 163: def _validate_audio_file(payload, problems):
 164:     if not _require_object(payload, problems, "audio_file"):
 165:         return
 166:     _check_ref(payload.get("wav_path"), problems, "wav_path")
 167:     if not _finite(payload.get("duration_seconds")) or payload.get("duration_seconds") <= 0:
 168:         problems.append(_invalid("duration_seconds must be a positive number"))
 169: 
 170: 
 171: def _validate_tts_metadata(payload, problems):
 172:     if not _require_object(payload, problems, "tts_metadata"):
 173:         return
 174:     for key in ("folder", "filename"):
 175:         if not isinstance(payload.get(key), str) or not payload.get(key):
 176:             problems.append(_invalid(f"{key} must be a non-empty string"))
 177:     _check_ref(payload.get("wav_path"), problems, "wav_path")
 178:     if not _finite(payload.get("duration_seconds")) or payload.get("duration_seconds") <= 0:
 179:         problems.append(_invalid("duration_seconds must be a positive number"))
 180:     words = payload.get("words")
 181:     if not isinstance(words, int) or isinstance(words, bool) or words <= 0:
 182:         problems.append(_invalid("words must be a positive integer"))
 183: 
