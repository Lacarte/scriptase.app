 291: def _validate_storyboard_images(payload, problems):
 292:     if not _require_object(payload, problems, "storyboard_images"):
 293:         return
 294:     counts = _counts(payload, problems, "storyboard_images")
 295:     statuses = payload.get("scene_statuses")
 296:     if not isinstance(statuses, dict):
 297:         problems.append(_invalid("scene_statuses must be an object keyed by scene"))
 298:         return
 299:     ready_seen = 0
 300:     error_seen = 0
 301:     for key, status in statuses.items():
 302:         if not isinstance(status, dict) or not isinstance(status.get("status"), str):
 303:             problems.append(_invalid(f"scene_statuses[{key}] must carry a status string"))
 304:             return
 305:         if status["status"] == "ready":
 306:             ready_seen += 1
 307:             if "local_path" in status:
 308:                 _check_ref(status.get("local_path"), problems, f"scene_statuses[{key}].local_path")
 309:         elif status["status"] == "error":
 310:             error_seen += 1
 311:     if counts is not None:
 312:         total, ready, errors = counts
 313:         if len(statuses) != total or ready_seen != ready or error_seen != errors:
 314:             problems.append(_invalid("storyboard counts must match the listed scene statuses"))
 315: 
