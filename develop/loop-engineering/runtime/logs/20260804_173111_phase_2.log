 135: def _finite(value: Any) -> bool:
 136:     return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
 137: 
 138: 
 139: def _require_object(payload: Any, problems: list[dict], type_name: str) -> bool:
 140:     if not isinstance(payload, dict):
 141:         problems.append(_invalid(f"A {type_name} payload must be a JSON object"))
 142:         return False
 143:     return True
