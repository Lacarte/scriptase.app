 100: def _check_ref(ref: Any, problems: list[dict], label: str) -> None:
 101:     if not isinstance(ref, str) or not ref.strip():
 102:         problems.append(_invalid(f"{label} must be a non-empty fixture-relative path"))
 103:         return
 104:     normalized = ref.replace("\\", "/")
 105:     parts = PurePosixPath(normalized).parts
 106:     if (
 107:         normalized.startswith("/")
 108:         or _DRIVE_RE.match(normalized)
 109:         or normalized.startswith("~")
 110:         or ".." in parts
 111:         or not parts
 112:     ):
 113:         problems.append(_invalid(
 114:             f"{label} must stay inside the bundled sample fixtures (got: {ref})"
 115:         ))
 116:         return
 117:     if not (FIXTURES_DIR / Path(*parts)).is_file():
 118:         problems.append(_problem(
 119:             "SAMPLE_FIXTURE_MISSING",
 120:             f"{label} references a missing sample fixture: {ref}",
 121:         ))
 122: 
