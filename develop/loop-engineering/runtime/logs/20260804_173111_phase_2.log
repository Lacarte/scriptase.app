 158: def _validate_project_id(payload, problems):
 159:     if not isinstance(payload, str) or not _PROJECT_ID_RE.fullmatch(payload):
 160:         problems.append(_invalid("A project_id payload must match pp_XXXXXX or pm_XXXXXX"))
 161: 
