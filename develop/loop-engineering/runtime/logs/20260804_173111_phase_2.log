 456: # ---------------------------------------------------------------------------
 457: # Fixture-set validation (manifest + cross-file contract, contracts.md Â§10).
 458: # ---------------------------------------------------------------------------
 459: 
 460: def _wav_duration(path: Path) -> float:
 461:     with wave.open(str(path), "rb") as handle:
 462:         frames = handle.getnframes()
 463:         rate = handle.getframerate()
 464:     if rate <= 0 or frames <= 0:
 465:         raise ValueError(f"{path.name} is not a playable WAV file")
 466:     return frames / rate
 467: 
 468: 
 469: def validate_fixtures() -> list[str]:
 470:     """Validate the committed fixture set. Empty list == frozen contract holds."""
 471:     problems: list[str] = []
 472:     if not FIXTURES_DIR.is_dir():
 473:         return ["studio/workflows/fixtures/ does not exist â€” run fixtures/generate.py"]
 474:     manifest_path = FIXTURES_DIR / "manifest.json"
 475:     if not manifest_path.is_file():
 476:         return ["fixtures/manifest.json is missing â€” run fixtures/generate.py"]
 477:     with open(manifest_path, encoding="utf-8") as handle:
 478:         manifest = json.load(handle)
 479:     if manifest.get("fixture_schema_version") != FIXTURE_SCHEMA_VERSION:
 480:         problems.append("manifest fixture_schema_version mismatch")
 481: 
 482:     listed = manifest.get("files") or {}
 483:     on_disk = {
 484:         path.relative_to(FIXTURES_DIR).as_posix()
 485:         for path in FIXTURES_DIR.rglob("*")
 486:         if path.is_file() and path.name not in {"manifest.json", "generate.py"}
 487:         and "__pycache__" not in path.parts
 488:     }
 489:     for missing in sorted(set(listed) - on_disk):
