 440: def validate_stub_payload(port_type: str, payload: Any) -> list[dict]:
 441:     """Structured problems for a user-edited stub.input payload.
 442: 
 443:     Returns ``[{code, message}]`` with codes STUB_PAYLOAD_INVALID or
 444:     SAMPLE_FIXTURE_MISSING; empty list means the payload is acceptable.
 445:     """
 446:     validator = _VALIDATORS.get(port_type)
 447:     if validator is None:
 448:         return [_invalid(f"Unsupported sample data type: {port_type}")]
 449:     problems: list[dict] = []
 450:     validator(payload, problems)
 451:     if isinstance(payload, dict):
 452:         _check_artifact_refs(payload, problems)
 453:     return problems
