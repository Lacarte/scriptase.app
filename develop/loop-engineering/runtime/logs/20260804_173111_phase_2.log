 319:         return
 320:     counts = _counts(payload, problems, "animation_assets")
 321:     scenes = payload.get("scenes")
 322:     if not isinstance(scenes, dict) or not scenes:
 323:         problems.append(_invalid("scenes must be a non-empty object keyed by scene"))
 324:         return
 325:     ready_seen = 0
 326:     for key, scene in scenes.items():
 327:         if not isinstance(scene, dict) or not isinstance(scene.get("local_files"), list):
 328:             problems.append(_invalid(f"scenes[{key}] must carry a local_files list"))
 329:             return
 330:         if scene["local_files"]:
 331:             ready_seen += 1
 332:         for index, ref in enumerate(scene["local_files"]):
 333:             _check_ref(ref, problems, f"scenes[{key}].local_files[{index}]")
 334:     if counts is not None:
 335:         total, ready, _errors = counts
 336:         if len(scenes) != total or ready_seen != ready:
 337:             problems.append(_invalid("animation asset counts must match the listed scenes"))
