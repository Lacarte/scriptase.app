 234: def _validate_scenes(payload, problems):
 235:     if not _require_object(payload, problems, "scenes"):
 236:         return
 237:     scenes = payload.get("scenes")
 238:     if not isinstance(scenes, list) or not scenes:
 239:         problems.append(_invalid("scenes must be a non-empty list"))
 240:         return
 241:     seen: set[int] = set()
 242:     for position, scene in enumerate(scenes):
 243:         if not isinstance(scene, dict):
 244:             problems.append(_invalid(f"scenes[{position}] must be an object"))
 245:             return
 246:         index = scene.get("index")
 247:         if not isinstance(index, int) or isinstance(index, bool) or index in seen:
 248:             problems.append(_invalid("every scene needs a stable unique integer index"))
 249:             return
 250:         seen.add(index)
 251:         prompt = scene.get("image_prompt")
 252:         if not isinstance(prompt, str) or not prompt.strip():
 253:             problems.append(_invalid(f"scenes[{position}].image_prompt must be a non-empty string"))
 254:             return
 255: 
 256: 
 257: def _validate_image_prompts(payload, problems):
 258:     if not _require_object(payload, problems, "image_prompts"):
 259:         return
 260:     prompts = payload.get("prompts")
 261:     if not isinstance(prompts, list) or not prompts:
 262:         problems.append(_invalid("prompts must be a non-empty list"))
 263:         return
 264:     for position, item in enumerate(prompts):
 265:         if (
 266:             not isinstance(item, dict)
 267:             or not isinstance(item.get("index"), int)
 268:             or isinstance(item.get("index"), bool)
 269:             or not isinstance(item.get("image_prompt"), str)
 270:             or not item["image_prompt"].strip()
 271:         ):
 272:             problems.append(_invalid(f"prompts[{position}] must be {{index, image_prompt}}"))
 273:             return
