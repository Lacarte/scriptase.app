 276: def _counts(payload, problems, type_name):
 277:     values = []
 278:     for key in ("total", "ready", "errors"):
 279:         value = payload.get(key)
 280:         if not isinstance(value, int) or isinstance(value, bool) or value < 0:
 281:             problems.append(_invalid(f"{type_name}.{key} must be a non-negative integer"))
 282:             return None
 283:         values.append(value)
 284:     total, ready, errors = values
 285:     if ready + errors > total:
 286:         problems.append(_invalid(f"{type_name} ready+errors cannot exceed total"))
 287:         return None
 288:     return total, ready, errors
 289: 
