 185: def _validate_alignment(payload, problems):
 186:     if not _require_object(payload, problems, "alignment"):
 187:         return
 188:     if not isinstance(payload.get("transcript"), str) or not payload.get("transcript").strip():
 189:         problems.append(_invalid("transcript must be a non-empty string"))
 190:     words = payload.get("alignment")
 191:     if not isinstance(words, list) or not words:
 192:         problems.append(_invalid("alignment must be a non-empty list of timed words"))
 193:         return
 194:     previous_begin = -math.inf
 195:     for index, word in enumerate(words):
 196:         if not isinstance(word, dict) or not isinstance(word.get("word"), str):
 197:             problems.append(_invalid(f"alignment[{index}] must be {{word, begin, end}}"))
 198:             return
 199:         begin, end = word.get("begin"), word.get("end")
 200:         if not _finite(begin) or not _finite(end) or begin < 0 or end < begin:
 201:             problems.append(_invalid(f"alignment[{index}] has invalid word timings"))
 202:             return
 203:         if begin < previous_begin:
 204:             problems.append(_invalid("alignment words must be ordered by start time"))
 205:             return
 206:         previous_begin = begin
 207: 
 208: 
 209: def _validate_segments(payload, problems):
 210:     if not _require_object(payload, problems, "segments"):
 211:         return
 212:     segments = payload.get("segments")
 213:     if not isinstance(segments, list) or not segments:
 214:         problems.append(_invalid("segments must be a non-empty list"))
 215:         return
 216:     previous_end = -math.inf
 217:     for index, segment in enumerate(segments):
 218:         if not isinstance(segment, dict):
 219:             problems.append(_invalid(f"segments[{index}] must be an object"))
 220:             return
 221:         start, end = segment.get("start"), segment.get("end")
 222:         if not _finite(start) or not _finite(end) or start < 0 or end < start:
 223:             problems.append(_invalid(f"segments[{index}] has invalid start/end times"))
 224:             return
 225:         if start < previous_end - 1e-6:
 226:             problems.append(_invalid("segments must be ordered and non-overlapping"))
 227:             return
 228:         if not isinstance(segment.get("words"), str):
 229:             problems.append(_invalid(f"segments[{index}].words must be a string"))
 230:             return
 231:         previous_end = end
 232: 
