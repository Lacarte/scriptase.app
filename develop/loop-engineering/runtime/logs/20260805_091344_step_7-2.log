+    schema_version: 1,
+    workflow_id: 'wf_ABC123',
+    name: 'Scheduled', description: '', nodes: [], edges: [], variables: {},
+    viewport: { x: 0, y: 0, zoom: 1 },
+    settings: {
+      on_error: 'stop',
+      schedules: [{ id: 'sch_daily', cron: '0 9 * * *', enabled: true }],
+    },
