diff --git a/frontend/src/features/workflow/__tests__/scheduleSettings.test.js b/frontend/src/features/workflow/__tests__/scheduleSettings.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..ac79e388904b5998d3fee2b0b7808683fb9c0106
