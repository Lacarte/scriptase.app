+def _validate_schedules(value: Any, problems: list[dict]) -> None:
+    if value is None:
+        return
+    if not isinstance(value, list):
+        problems.append(_problem("WORKFLOW_INVALID", "settings.schedules must be an array", "settings.schedules"))
+        return
+    if len(value) > 16:
