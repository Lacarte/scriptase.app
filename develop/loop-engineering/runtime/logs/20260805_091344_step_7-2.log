+    vi.spyOn(api, 'get').mockResolvedValue({
+      timezone: 'UTC',
+      schedules: [{
+        id: 'sch_daily', cron: '0 9 * * *', enabled: true,
+        next_fire_at: '2026-08-06T09:00:00Z', timezone: 'UTC',
+      }],
+    })
