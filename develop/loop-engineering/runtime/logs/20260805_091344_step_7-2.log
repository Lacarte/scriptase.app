  function assertSaveNotBlocked() {
    if (!saveBlockedReason.value) return
    persistenceError.value = saveBlockedReason.value
    throw Object.assign(new Error(saveBlockedReason.value), { code: 'INVALID_EDITOR_FIELD' })
