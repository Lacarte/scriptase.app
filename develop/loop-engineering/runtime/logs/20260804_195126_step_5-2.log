      </main>

      <!-- Right â€” node inspector -->
      <aside class="wf-inspector">
        <div class="wf-panel-header">Inspector</div>
        <NodeInspector />
      </aside>
    </div>

    <!-- Bottom â€” live execution inspector (step 3.6) -->
    <ExecutionPanel />
  </div>
</template>

