+  })
+  if (!candidates.length) return
+  const palette = {
+    x: point.x, y: point.y,
+    position: screenToFlowCoordinate(point),
+    start: { ...start, portType: candidates[0].portType },
+    candidates,
+  }
+  requestAnimationFrame(() => { insertionPalette.value = palette })
+}
+
