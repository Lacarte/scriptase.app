+        }),
+        slots.default?.(),
+      ])
+    },
+  }),
+}))
+vi.mock('@vue-flow/background', () => ({ Background: defineComponent(() => () => h('div')) }))
+vi.mock('@vue-flow/controls', () => ({ Controls: defineComponent(() => () => h('div')) }))
