+_reloader = WorkflowDevReloader()
+
+
+def start_dev_reloader():
+    return _reloader.start()
+
+
+def dev_reloader():
+    return _reloader
+
+
+def next_reload_event(channel, timeout=15):
+    try:
+        return channel.get(timeout=timeout)
+    except Empty:
+        return None
