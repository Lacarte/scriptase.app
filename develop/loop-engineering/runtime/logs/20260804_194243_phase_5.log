  517:                 if pinned:
  518:                     result = {"value": configuration.get("payload")}
  519:                     self._validate_outputs(node, result)
  520:                     node_outputs[node_id] = result
  521:                     output_fp = output_fingerprint(result, {})
  522:                     node_output_fingerprints[node_id] = output_fp
  523:                     node_record.outputs_summary = self.redactor(_summarize(result))
  524:                     node_record.cache = {"hit": True, "reason": "pinned_payload"}
  525:                     node_record.duration_ms = 0
  526:                     self._status(statuses, node_id, "succeeded")
  527:                     executed.append(node_id)
  528:                     continue
  529: 
  530:                 cacheable = get_node_type(node["type"]).get("capabilities", {}).get("cacheable", True)
  531:                 lookup = self.cache.lookup(
  532:                     workflow_id=str(self.workflow.get("workflow_id", "")),
  533:                     project_id=self.project_id,
  534:                     node_id=node_id,
  535:                     fingerprint=fingerprint,
  536:                     components=components,
  537:                     force=self.force,
  538:                 ) if cacheable else CacheLookup(False, "cache_disabled")
  539:                 node_record.cache = {"hit": lookup.hit, "reason": lookup.reason}
  540:                 if lookup.hit:
  541:                     result = dict(lookup.outputs or {})
  542:                     try:
  543:                         self._validate_outputs(node, result)
  544:                     except SchedulerError:
  545:                         lookup = CacheLookup(False, "cache_corrupt")
  546:                         node_record.cache = {"hit": False, "reason": lookup.reason}
  547:                     else:
  548:                         node_outputs[node_id] = result
  549:                         node_output_fingerprints[node_id] = lookup.output_fingerprint or output_fingerprint(result, {})
  550:                         node_record.outputs_summary = self.redactor(_summarize(result))
  551:                         node_record.artifact_refs = self.redactor(_artifact_refs(result))
  552:                         node_record.duration_ms = 0
  553:                         self._status(statuses, node_id, "succeeded")
  554:                         executed.append(node_id)
  555:                         continue
  556: 
  557:                 if lookup.reason not in {"no_prior_success", "forced_regeneration", "cache_disabled"}:
  558:                     self._status(statuses, node_id, "stale")
  559:                 started = time.perf_counter()
  560:                 policy = self._error_policy(node)
  561:                 max_attempts = policy["max_attempts"] if policy["policy"] == "retry" else 1
  562:                 while node_record.attempts < max_attempts:
  563:                     node_record.attempts += 1
  564:                     self._status(statuses, node_id, "running")
  565:                     promoter = ArtifactPromoter(output_dir=self.output_dir, execution_id=self.execution_id or node_id)
  566:                     context = AdapterContext(
  567:                         project_id=self.project_id,
  568:                         execution_id=self.execution_id,
  569:                         node_id=node_id,
  570:                         stage_artifact=promoter.stage_path,
  571:                         stop_requested=self.stop_requested,
  572:                     )
  573:                     failure = None
