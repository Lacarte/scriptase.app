  694:         self._emit({
  695:             "type": "node_status",
  696:             "execution_id": self.execution_id,
  697:             "node_id": node_id,
  698:             "status": status,
  699:             "attempt": node_record.attempts,
  700:             "duration_ms": node_record.duration_ms or 0,
