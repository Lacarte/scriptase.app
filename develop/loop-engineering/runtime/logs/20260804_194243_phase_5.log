  435: 
  436:         with ProjectLock(self.project_id, lock_root=self.lock_root, execution_id=self.execution_id):
  437:             stopped = False
  438:             cancelled = False
  439:             for node_id in order:
  440:                 node = graph.nodes[node_id]
  441:                 if self.stop_requested():
  442:                     cancelled = True
  443:                 if cancelled:
  444:                     self.record.nodes[node_id].duration_ms = 0
  445:                     self._status(statuses, node_id, "cancelled")
  446:                     executed.append(node_id)
  447:                     continue
  448:                 incoming_edges = graph.incoming[node_id]
  449:                 active_edges = [
  450:                     edge for edge in incoming_edges
  451:                     if self._edge_was_activated(edge, statuses, node_outputs)
  452:                 ]
  453:                 if node.get("type") == "utility.merge":
  454:                     # Merge is the explicit convergence boundary for
  455:                     # conditional branches.  Skipped predecessors and absent
  456:                     # ports on successful Condition nodes are resolved but
  457:                     # inactive; failures remain governed by error policy.
  458:                     inactive_resolved = all(
  459:                         edge in active_edges
  460:                         or statuses.get(edge["source_node"]) in {"succeeded", "skipped"}
  461:                         for edge in incoming_edges
  462:                     )
  463:                     incoming_active = inactive_resolved and bool(active_edges)
  464:                 else:
  465:                     incoming_active = len(active_edges) == len(incoming_edges)
  466:                 if stopped or node.get("disabled") or not incoming_active:
  467:                     self.record.nodes[node_id].duration_ms = 0
  468:                     self._status(statuses, node_id, "skipped")
  469:                     executed.append(node_id)
  470:                     continue
  471: 
  472:                 inputs = self._resolve_inputs(node_id, graph, node_outputs, active_edges=active_edges)
  473:                 node_record = self.record.nodes[node_id]
  474:                 node_record.from_sample_data = (
  475:                     node.get("type") == "stub.input"
  476:                     or any(
  477:                         self.record.nodes[edge["source_node"]].from_sample_data
  478:                         for edge in graph.incoming[node_id]
  479:                     )
  480:                 )
  481:                 node_record.resolved_inputs_summary = self.redactor(_summarize(inputs))
  482:                 try:
  483:                     configuration = resolve_configuration(
  484:                         self._configuration(node),
  485:                         node_outputs=node_outputs,
  486:                         variables=self.workflow.get("variables", {}),
  487:                         project_id=self.project_id,
  488:                     )
  489:                 except ExpressionError as exc:
  490:                     raise SchedulerError(exc.code, exc.message, details={"node_id": node_id}) from exc
  491:                 resolved_problems = validation_errors(validate_resolved_configuration(node, configuration))
  492:                 if resolved_problems:
  493:                     raise SchedulerError(
  494:                         "EXPRESSION_TYPE_MISMATCH",
  495:                         f"Resolved configuration is invalid for node {node_id}",
  496:                         details={"node_id": node_id, "problems": resolved_problems},
  497:                     )
  498:                 incoming_fingerprints = {
  499:                     ":".join((
  500:                         edge["id"], edge["source_node"], edge["source_port"], edge["target_port"],
  501:                     )): node_output_fingerprints[edge["source_node"]]
  502:                     for edge in active_edges
  503:                 }
  504:                 pinned = node.get("type") == "stub.output" and configuration.get("pinned") is True
  505:                 fingerprint_inputs = {} if pinned else inputs
  506:                 fingerprint_upstream = {} if pinned else incoming_fingerprints
  507:                 components = fingerprint_components(
  508:                     node,
  509:                     configuration,
  510:                     fingerprint_inputs,
  511:                     fingerprint_upstream,
  512:                     adapter_schema_version=int(get_node_type(node["type"]).get("cache_schema_version", 1)),
  513:                 )
  514:                 fingerprint = canonical_fingerprint(components)
  515:                 node_record.fingerprint = fingerprint
