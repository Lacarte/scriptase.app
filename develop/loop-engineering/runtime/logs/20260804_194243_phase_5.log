  704:     def _persist(self) -> dict[str, Any]:
  705:         return save_execution(self.record, root=self.execution_root, secrets=self.redactor.secrets)
  706: 
  707:     def _emit(self, event: dict[str, Any]) -> None:
  708:         if self.on_event:
  709:             self.on_event(self.redactor(event))
  710: 
  711:     @staticmethod
  712:     def _error_policy(node: Mapping[str, Any]) -> dict[str, Any]:
  713:         supplied = node.get("on_error") or {}
  714:         return {
  715:             "policy": supplied.get("policy", "stop"),
  716:             "max_attempts": supplied.get("max_attempts", 3),
  717:             "delay_ms": supplied.get("delay_ms", 1000),
  718:             "backoff_multiplier": supplied.get("backoff_multiplier", 2.0),
  719:         }
  720: 
  721:     def _failure_payload(self, node: Mapping[str, Any], exc: Exception, attempt: int) -> dict[str, Any]:
  722:         code = getattr(exc, "code", "NODE_EXECUTION_FAILED")
  723:         message = "Execution was cancelled" if code == "CANCELLED" else str(exc)
  724:         suggestion = (
  725:             "Start a new run when ready."
  726:             if code == "CANCELLED"
  727:             else "Review the node inputs and settings, then retry the failed node."
  728:         )
  729:         return self.redactor({
  730:             "node_id": node["id"],
  731:             "node_name": node.get("name") or node["id"],
  732:             "code": code,
  733:             "message": message,
  734:             "details": getattr(exc, "details", None),
  735:             "attempt": attempt,
  736:             "timestamp": now_iso(),
  737:             "recovery_suggestion": suggestion,
  738:         })
  739: 
  740:     def _sleep_before_retry(self, seconds: float) -> None:
  741:         """Wait in short intervals so a stop request interrupts long backoffs."""
  742:         remaining = seconds
  743:         while remaining > 0 and not self.stop_requested():
  744:             interval = min(0.1, remaining)
  745:             self.sleeper(interval)
  746:             remaining = max(0.0, remaining - interval)
  747: 
  748:     @staticmethod
  749:     def _edge_was_activated(
  750:         edge: Mapping[str, Any],
  751:         statuses: Mapping[str, str],
  752:         outputs: Mapping[str, Mapping[str, Any]],
  753:     ) -> bool:
  754:         source = edge["source_node"]
  755:         if edge["source_port"] == "error":
  756:             return statuses.get(source) == "failed" and "error" in outputs.get(source, {})
  757:         return statuses.get(source) == "succeeded" and edge["source_port"] in outputs.get(source, {})
  758: 
  759:     @staticmethod
  760:     def _configuration(node: Mapping[str, Any]) -> dict[str, Any]:
  761:         definition = get_node_type(node["type"])
  762:         config = {
  763:             field["name"]: field["default"]
  764:             for field in definition.get("config_schema", [])
  765:             if "default" in field
  766:         }
  767:         config.update(node.get("configuration") or {})
  768:         return config
  769: 
  770:     @staticmethod
  771:     def _resolve_inputs(
  772:         node_id: str,
  773:         graph: WorkflowGraph,
  774:         outputs: Mapping[str, Mapping[str, Any]],
  775:         *,
  776:         active_edges: list[Mapping[str, Any]] | None = None,
  777:     ) -> dict:
  778:         resolved: dict[str, Any] = {}
  779:         edges = graph.incoming[node_id] if active_edges is None else active_edges
  780:         for edge in edges:
  781:             value = outputs[edge["source_node"]][edge["source_port"]]
  782:             target_port = edge["target_port"]
  783:             definition = get_node_type(graph.nodes[node_id]["type"])
  784:             port = next(item for item in definition["inputs"] if item["id"] == target_port)
  785:             if port.get("multiple"):
  786:                 resolved.setdefault(target_port, []).append(value)
  787:             else:
  788:                 resolved[target_port] = value
  789:         return resolved
  790: 
  791:     @staticmethod
  792:     def _validate_outputs(node: Mapping[str, Any], outputs: Mapping[str, Any]) -> None:
  793:         definition = get_node_type(node["type"])
  794:         for port in definition.get("outputs", []):
  795:             if port["id"] == "error" or port.get("conditional"):
  796:                 continue
  797:             if port["id"] not in outputs:
  798:                 raise SchedulerError(
  799:                     "NODE_OUTPUT_MISSING",
  800:                     f"Node {node['id']} did not produce output port {port['id']}",
  801:                 )
  802: 
