  582:                         promoter.promote()
  583:                         node_outputs[node_id] = result
  584:                         node_record.outputs_summary = self.redactor(_summarize(result))
  585:                         node_record.artifact_refs = self.redactor(_artifact_refs(result))
  586:                         if self.redactor(result) != result:
  587:                             output_fp, cache_failure = None, "sensitive_output"
  588:                         elif cacheable:
  589:                             output_fp, cache_failure = self.cache.store(
  590:                                 workflow_id=str(self.workflow.get("workflow_id", "")),
  591:                                 project_id=self.project_id,
  592:                                 node_id=node_id,
  593:                                 fingerprint=fingerprint,
  594:                                 components=components,
  595:                                 outputs=result,
  596:                                 artifact_refs=_artifact_refs(result),
  597:                             )
  598:                         else:
  599:                             output_fp, cache_failure = output_fingerprint(result, {}), "cache_disabled"
  600:                         if output_fp is None:
  601:                             node_record.cache = {"hit": False, "reason": cache_failure}
  602:                             output_fp = output_fingerprint(result, {})
  603:                         node_output_fingerprints[node_id] = output_fp
  604:                         node_record.duration_ms = max(0, round((time.perf_counter() - started) * 1000))
  605:                         node_record.error = None
  606:                         self._status(statuses, node_id, "succeeded")
  607:                         break
  608:                     except CancellationRequested as exc:
  609:                         failure = exc
  610:                         cancelled = True
  611:                     except Exception as exc:  # adapters are a plugin boundary
  612:                         failure = exc
  613:                     finally:
  614:                         promoter.cleanup()
  615: 
  616:                     if cancelled or getattr(failure, "code", None) == "CANCELLED":
  617:                         cancelled = True
  618:                         node_record.error = self._failure_payload(node, failure, node_record.attempts)
  619:                         node_record.duration_ms = max(0, round((time.perf_counter() - started) * 1000))
  620:                         self._status(statuses, node_id, "cancelled")
  621:                         break
  622: 
  623:                     attempt_error = self._failure_payload(node, failure, node_record.attempts)
  624:                     node_record.attempt_errors.append(attempt_error)
  625:                     if policy["policy"] == "retry" and node_record.attempts < max_attempts:
  626:                         delay_ms = min(
  627:                             60_000,
  628:                             round(policy["delay_ms"] * (policy["backoff_multiplier"] ** (node_record.attempts - 1))),
  629:                         )
  630:                         self._emit({
  631:                             "type": "node_retry", "execution_id": self.execution_id,
  632:                             "node_id": node_id, "attempt": node_record.attempts,
  633:                             "next_attempt": node_record.attempts + 1, "delay_ms": delay_ms,
  634:                             "error": attempt_error,
  635:                         })
  636:                         node_record.logs.append(self.redactor(ExecutionLog(
  637:                             ts=now_iso(), level="warning",
  638:                             message=f"Attempt {node_record.attempts} failed; retrying in {delay_ms} ms",
  639:                         ).__dict__))
