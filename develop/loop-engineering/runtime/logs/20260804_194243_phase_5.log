289-{
290-  "schema_version": 1,
291-  "execution_id": "ex_XXXXXX",           // generate_project_id-style, sanitized
292-  "workflow_id": "wf_XXXXXX",
293-  "workflow_snapshot": { /* full workflow JSON at run time */ },
294-  "project_id": "pm_XXXXXX",
295-  "run_mode": "full|node_with_deps|node_isolated|selected|from_node|retry_failed|retry_failed_desc",
296-  "scope_node_ids": ["n_tts"],
297-  "status": "running|succeeded|failed|cancelled|partial",
298-  "started_at": "ISO", "finished_at": "ISO|null",
299-  "nodes": {
300-    "n_tts": {
301-      "status": "idle|invalid|queued|running|waiting|succeeded|failed|cancelled|skipped|stale",
302-      "attempts": 1, "duration_ms": 5230,
303-      "fingerprint": "sha256…", "cache": {"hit": false, "reason": "config_changed"},
304-      "from_sample_data": false,
305-      "resolved_inputs_summary": {"script": {"chars": 812}},
306-      "outputs_summary": {"audio_file": {"artifact": "tts/pm_X/voice.wav", "duration_s": 28.5}},
307-      "artifact_refs": ["tts/pm_X/voice.wav", "tts/pm_X/tts.json"],
