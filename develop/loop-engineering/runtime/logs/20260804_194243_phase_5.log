  424:             ],
  425:         }
  426:         graph = build_graph(scoped_workflow)
  427:         order = deterministic_order(scoped_workflow)
  428:         statuses = {node_id: "idle" for node_id in graph.nodes}
  429:         node_outputs: dict[str, dict[str, Any]] = {}
  430:         node_output_fingerprints: dict[str, str] = {}
  431:         errors: dict[str, dict[str, Any]] = {}
  432:         executed: list[str] = []
  433:         self._persist()
