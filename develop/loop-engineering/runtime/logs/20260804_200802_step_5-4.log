    monkeypatch.setattr(scenes, "with_artifacts", lambda payload, *paths: payload)
    scenes.blueprint({"segments": {}, "script": "x", "settings": {"style": "inherited", "tone": "dark"}}, {"style": "explicit"}, CTX)
