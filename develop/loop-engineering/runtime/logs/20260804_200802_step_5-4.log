diff --git a/_dev/loop-engineering/phases-plans/contracts.md b/_dev/loop-engineering/phases-plans/contracts.md
index 52ff79ab24491be973621eb36377e2dd880ac71b..9b1bb0008798a787d5bdecf76f3f7d9388dfcb34
--- a/_dev/loop-engineering/phases-plans/contracts.md
