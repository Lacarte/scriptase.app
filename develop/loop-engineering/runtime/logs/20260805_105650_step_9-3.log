+    body, failure = _json_body(allow_empty=True)
+    if failure:
+        return failure
+    if set(body) - {"paths", "dry_run"}:
+        return _error("BAD_REQUEST", "Body may contain only paths and dry_run", 400)
+    dry_run = body.get("dry_run", True)
+    paths = body.get("paths")
