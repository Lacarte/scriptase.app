 198:     directory = root or EXECUTIONS_DIR
 199:     os.makedirs(directory, exist_ok=True)
 200:     items = []
 201:     for filename in os.listdir(directory):
 202:         execution_id = filename[:-5] if filename.endswith(".json") else ""
 203:         if not EXECUTION_ID_RE.fullmatch(execution_id):
 204:             continue
 205:         try:
 206:             record = load_execution(execution_id, root=directory)
 207:         except (OSError, ValueError):
 208:             continue
 209:         if record.get("workflow_id") != workflow_id:
 210:             continue
 211:         items.append({
 212:             "execution_id": execution_id,
 213:             "workflow_id": workflow_id,
 214:             "project_id": record.get("project_id"),
 215:             "run_mode": record.get("run_mode"),
 216:             "status": record.get("status"),
 217:             "started_at": record.get("started_at"),
 218:             "finished_at": record.get("finished_at"),
 219:         })
