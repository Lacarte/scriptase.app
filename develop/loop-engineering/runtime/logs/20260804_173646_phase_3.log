  27: 
  28: onMounted(async () => {
  29:   try {
  30:     await Promise.all([
  31:       store.loadNodeTypes(),
  32:       store.refreshWorkflowList(),
  33:       store.loadTemplates(),
  34:     ])
  35:   } catch (err) {
  36:     toast.error(err?.message || 'Failed to load workflow data')
  37:   }
  38:   await maybeRecoverDraft()
  39:   window.addEventListener('beforeunload', onBeforeUnload)
  40:   document.addEventListener('visibilitychange', onVisibilityChange)
  41:   window.addEventListener('keydown', onKeydown)
  42: })
  43: 
  44: onBeforeUnmount(() => {
  45:   window.removeEventListener('beforeunload', onBeforeUnload)
  46:   document.removeEventListener('visibilitychange', onVisibilityChange)
  47:   window.removeEventListener('keydown', onKeydown)
  48:   // The component is going away (in-app navigation): persist any pending
  49:   // debounced edits so nothing is lost while the user is elsewhere.
  50:   store.flushDraft()
  51: })
  52: 
  53: // Ctrl+Z restores the most recently auto-detached sample stub (step 2.5;
  54: // the full undo/redo command stack arrives in Phase 5.1).
  55: function onKeydown(event) {
  56:   if (!(event.ctrlKey || event.metaKey) || event.shiftKey || event.key.toLowerCase() !== 'z') return
  57:   const target = event.target
  58:   if (target instanceof HTMLElement
  59:     && (['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable)) {
  60:     return
  61:   }
  62:   if (store.canUndoStubDetach && store.undoStubDetach()) {
  63:     event.preventDefault()
  64:     toast.info('Sample input restored')
  65:   }
  66: }
  67: 
  68: // â”€â”€ Draft autosave protection (step 2.4) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  69: async function maybeRecoverDraft() {
  70:   const draft = store.peekDraft()
  71:   if (!draft) return
  72:   const name = draft.document?.name || 'Untitled workflow'
  73:   const when = draft.saved_at ? ` (autosaved ${new Date(draft.saved_at).toLocaleString()})` : ''
  74:   if (window.confirm(`Recover unsaved draft "${name}"${when}?`)) {
  75:     store.recoverDraft()
  76:     // Deliberately not restoreViewport(): the recovered document is unsaved
  77:     // and must stay dirty until the user explicitly saves it.
  78:     await setFlowViewport(store.viewport)
  79:     toast.info('Draft recovered â€” save to keep it')
  80:   } else {
  81:     store.clearDraft()
  82:   }
  83: }
  84: 
  85: function onBeforeUnload(event) {
  86:   // Synchronous flush: this is what makes a killed tab lose nothing.
  87:   store.flushDraft()
  88:   if (store.dirty) {
  89:     event.preventDefault()
  90:     event.returnValue = ''
  91:   }
  92: }
  93: 
  94: function onVisibilityChange() {
  95:   if (document.visibilityState === 'hidden') store.flushDraft()
  96: }
  97: 
  98: onBeforeRouteLeave(() => {
  99:   if (!store.dirty) return true
 100:   store.flushDraft()
 101:   return window.confirm(
 102:     'You have unsaved workflow changes. A draft has been kept â€” leave the workflow builder?',
 103:   )
 104: })
 105: 
 106: const nodeTypes = { sts: markRaw(NodeCard) }
 107: 
 108: // Store (persisted shape) â†’ Vue Flow elements. Vue Flow runtime props stay here.
 109: const flowNodes = computed(() =>
 110:   store.nodes.map((n) => ({
 111:     id: n.id,
 112:     type: 'sts',
 113:     position: { ...n.position },
 114:     data: { nodeType: n.type, label: n.name, disabled: n.disabled },
 115:   })),
 116: )
 117: 
 118: const flowEdges = computed(() =>
 119:   store.edges.map((e) => {
 120:     const sourceExecution = store.nodeExecution(e.source_node)
 121:     const summary = sourceExecution.status === 'succeeded'
 122:       ? sourceExecution.outputs_summary?.[e.source_port]
 123:       : undefined
 124:     return {
 125:       id: e.id,
 126:       source: e.source_node,
 127:       target: e.target_node,
 128:       sourceHandle: e.source_port,
 129:       targetHandle: e.target_port,
 130:       markerEnd: MarkerType.ArrowClosed,
 131:       animated: sourceExecution.status === 'running',
 132:       label: summary === undefined ? '' : edgeSummary(summary),
 133:       class: [
 134:         e.edge_type === 'control' ? 'wf-edge-control' : 'wf-edge-data',
 135:         `wf-edge-${sourceExecution.status}`,
 136:         sourceExecution.from_sample_data ? 'wf-edge-sample' : '',
 137:       ].filter(Boolean).join(' '),
 138:     }
 139:   }),
 140: )
 141: 
 142: function edgeSummary(value) {
 143:   let text
 144:   if (typeof value === 'string') text = value
 145:   else if (value === null) text = 'null'
 146:   else if (Array.isArray(value)) text = `${value.length} items`
 147:   else if (typeof value === 'object') {
 148:     const keys = Object.keys(value)
 149:     text = keys.length ? keys.slice(0, 3).join(', ') : '{}'
 150:   } else text = String(value)
 151:   return text.length > 42 ? `${text.slice(0, 39)}â€¦` : text
 152: }
 153: 
 154: // â”€â”€ Palette drop â†’ add node at canvas position â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 155: function onDragOver(event) {
 156:   if (event.dataTransfer?.types?.includes(DRAG_MIME)) {
 157:     event.preventDefault()
 158:     event.dataTransfer.dropEffect = 'copy'
 159:   }
 160: }
 161: 
 162: function onDrop(event) {
 163:   const typeKey = event.dataTransfer?.getData(DRAG_MIME)
 164:   if (!typeKey) return
 165:   const position = screenToFlowCoordinate({ x: event.clientX, y: event.clientY })
 166:   // Auto-spawns pre-connected sample stubs when the workflow setting is on.
 167:   store.addNodeWithStubs(typeKey, position)
 168: }
 169: 
 170: // â”€â”€ Sync Vue Flow interactions back into the store â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 171: function onNodeDragStop({ node, nodes: draggedNodes }) {
 172:   // Multi-select/box drags carry every moved node in `nodes`; persisting
 173:   // only the grab target would snap the rest back on the next re-render.
 174:   const moved = draggedNodes?.length ? draggedNodes : [node]
 175:   for (const dragged of moved) {
 176:     store.moveNode(dragged.id, { x: dragged.position.x, y: dragged.position.y })
 177:   }
 178: }
 179: 
 180: function onNodesChange(changes) {
 181:   const removed = changes.filter((c) => c.type === 'remove').map((c) => c.id)
 182:   if (removed.length) store.removeNodes(removed)
 183: }
 184: 
 185: function onEdgesChange(changes) {
 186:   const removed = changes.filter((c) => c.type === 'remove').map((c) => c.id)
 187:   if (removed.length) store.removeEdges(removed)
 188: }
 189: 
 190: function onViewportChangeEnd(vp) {
 191:   store.setViewport(vp)
 192: }
 193: 
 194: // â”€â”€ Connections (validated, contracts Â§3) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 195: function toConnectionShape(params) {
 196:   return {
 197:     sourceNode: params.source,
 198:     sourcePort: params.sourceHandle,
 199:     targetNode: params.target,
 200:     targetPort: params.targetHandle,
 201:     // Present only when Vue Flow re-validates an existing edge; interactive
 202:     // connection params carry no id.
 203:     edgeId: params.id,
 204:   }
 205: }
 206: 
 207: function onConnect(params) {
 208:   const verdict = store.connectNodes(toConnectionShape(params))
 209:   if (!verdict.ok) {
 210:     toast.error(verdict.reason)
 211:   } else if (verdict.detachedStub) {
 212:     toast.info('Sample input replaced by the real connection â€” Ctrl+Z restores it')
 213:   }
 214: }
 215: 
 216: // â”€â”€ Node context menu: manual stub attachment (step 2.5) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 217: const contextMenu = ref(null) // {nodeId, x, y}
 218: 
 219: function onNodeContextMenu({ event, node }) {
 220:   event.preventDefault()
 221:   if (store.isStubType(store.nodeById(node.id)?.type)) {
 222:     contextMenu.value = null
 223:     return
 224:   }
 225:   // Fixed positioning: viewport coordinates work regardless of panel layout.
 226:   contextMenu.value = { nodeId: node.id, x: event.clientX, y: event.clientY }
 227: }
 228: 
 229: function closeContextMenu() {
 230:   contextMenu.value = null
 231: }
 232: 
 233: function onAttachSampleInputs() {
 234:   const created = store.attachSampleInputs(contextMenu.value.nodeId)
 235:   closeContextMenu()
 236:   toast.info(created.length
 237:     ? `Attached ${created.length} sample input${created.length > 1 ? 's' : ''}`
 238:     : 'Every required input is already connected')
 239: }
 240: 
 241: function onAttachResultViewer() {
 242:   const stub = store.attachResultViewer(contextMenu.value.nodeId)
 243:   closeContextMenu()
 244:   toast.info(stub ? 'Result viewer attached' : 'This node has no data output to view')
 245: }
 246: 
 247: // Live feedback while dragging a connection: valid targets highlight,
 248: // invalid ones show the not-allowed cursor.
 249: function isValidConnection(params) {
 250:   return validateConnection(
 251:     { nodes: store.nodes, edges: store.edges, nodeTypes: store.nodeTypes, portTypes: store.portTypes },
 252:     toConnectionShape(params),
 253:   ).ok
 254: }
 255: 
 256: // â”€â”€ Minimap colored by category â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 257: function minimapColor(node) {
 258:   const def = store.nodeTypes[node.data?.nodeType]
 259:   return store.categories[def?.category]?.color || '#4b5563'
 260: }
 261: 
 262: // â”€â”€ Dagre tidy-up â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 263: function tidyUp() {
 264:   if (!store.nodes.length) return
 265:   const g = new dagre.graphlib.Graph()
 266:   g.setGraph({ rankdir: 'LR', nodesep: 40, ranksep: 90 })
 267:   g.setDefaultEdgeLabel(() => ({}))
 268:   for (const node of store.nodes) {
 269:     g.setNode(node.id, { width: 200, height: 60 })
 270:   }
 271:   for (const edge of store.edges) {
 272:     g.setEdge(edge.source_node, edge.target_node)
 273:   }
 274:   dagre.layout(g)
 275:   for (const node of store.nodes) {
 276:     const pos = g.node(node.id)
 277:     if (pos) {
 278:       store.moveNode(node.id, {
 279:         x: Math.round((pos.x - 100) / 20) * 20,
 280:         y: Math.round((pos.y - 30) / 20) * 20,
 281:       })
 282:     }
 283:   }
 284:   requestAnimationFrame(() => fitView({ padding: 0.15 }))
 285: }
