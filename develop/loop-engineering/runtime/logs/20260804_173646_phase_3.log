 287: const validating = ref(false)
 288: 
 289: async function onValidate() {
 290:   validating.value = true
 291:   try {
 292:     const data = await api.post('/api/workflow/validate', {
 293:       body: { workflow: store.toDocument() },
 294:     })
 295:     if (data.valid && !data.warnings.length) {
 296:       toast.success('Workflow is valid')
 297:     } else if (data.valid) {
 298:       toast.warning(`Valid, with ${data.warnings.length} warning(s): ${data.warnings[0]?.message}`)
 299:     } else {
 300:       const first = data.problems[0]?.message || 'see node badges'
 301:       toast.error(`${data.problems.length} problem(s) â€” ${first}`)
 302:     }
 303:   } catch (err) {
 304:     toast.error(err?.message || 'Validation request failed')
 305:   } finally {
 306:     validating.value = false
 307:   }
 308: }
 309: 
 310: function confirmDiscard() {
 311:   return !store.dirty || window.confirm('Discard unsaved workflow changes?')
 312: }
 313: 
 314: async function restoreViewport() {
 315:   await setFlowViewport(store.viewport)
 316:   store.dirty = false
 317: }
 318: 
 319: async function onNew() {
 320:   if (!confirmDiscard()) return
 321:   store.newWorkflow()
 322:   await restoreViewport()
 323: }
 324: 
 325: async function onOpen(event) {
 326:   const id = event.target.value
 327:   event.target.value = ''
 328:   if (!id || !confirmDiscard()) return
 329:   try {
 330:     await store.openWorkflow(id)
 331:     await restoreViewport()
 332:     toast.success(`Opened ${store.workflowName}`)
 333:   } catch (err) {
 334:     toast.error(store.persistenceError || err.message)
 335:   }
 336: }
 337: 
 338: async function onSave() {
 339:   try {
 340:     if (!store.workflowId && store.workflowName === 'Untitled workflow') {
 341:       const name = window.prompt('Workflow name', store.workflowName)
 342:       if (!name?.trim()) return
 343:       store.workflowName = name.trim()
 344:     }
 345:     await store.saveWorkflow()
 346:     toast.success('Workflow saved')
 347:   } catch (err) {
 348:     toast.error(store.persistenceError || err.message)
 349:   }
 350: }
 351: 
 352: async function onSaveAs() {
 353:   const name = window.prompt('Save workflow as', `${store.workflowName} copy`)
 354:   if (!name?.trim()) return
 355:   try {
 356:     await store.saveAs(name)
 357:     toast.success('Workflow copy saved')
 358:   } catch (err) {
 359:     toast.error(store.persistenceError || err.message)
 360:   }
 361: }
 362: 
 363: async function onDuplicate() {
 364:   try {
 365:     await store.saveAs(`${store.workflowName} copy`)
 366:     toast.success('Workflow duplicated')
 367:   } catch (err) {
 368:     toast.error(store.persistenceError || err.message)
 369:   }
 370: }
 371: 
 372: async function onTemplate(event) {
 373:   const templateId = event.target.value
 374:   event.target.value = ''
 375:   if (!templateId || !confirmDiscard()) return
 376:   if (store.applyTemplate(templateId)) {
 377:     requestAnimationFrame(() => fitView({ padding: 0.1 }))
 378:     toast.info('Template loaded â€” add your script and save when ready')
 379:   }
 380: }
 381: 
 382: async function onImportFile(event) {
 383:   const file = event.target.files?.[0]
 384:   event.target.value = ''
 385:   if (!file || !confirmDiscard()) return
 386:   if (file.size > 2 * 1024 * 1024) {
 387:     toast.error('Workflow JSON exceeds the 2 MiB limit')
 388:     return
 389:   }
 390:   try {
 391:     const document = JSON.parse(await file.text())
 392:     await store.importDocument(document)
 393:     await restoreViewport()
 394:     toast.success('Workflow imported')
 395:   } catch (err) {
 396:     toast.error(store.persistenceError || err?.message || 'Invalid workflow JSON')
 397:   }
 398: }
 399: 
 400: function onExport() {
 401:   if (!store.workflowId) {
 402:     toast.warning('Save the workflow before exporting it')
 403:     return
 404:   }
 405:   const anchor = document.createElement('a')
 406:   anchor.href = `/api/workflows/${encodeURIComponent(store.workflowId)}/export`
 407:   anchor.download = `${store.workflowId}.json`
 408:   anchor.click()
 409: }
 410: 
 411: async function onRun() {
 412:   try {
 413:     await store.runWorkflow()
 414:     toast.success('Workflow run started')
 415:   } catch (err) {
 416:     toast.error(store.executionError || err?.message || 'Failed to run workflow')
 417:   }
 418: }
 419: 
 420: async function onStop() {
 421:   try {
 422:     await store.stopExecution()
 423:     toast.info('Stopping workflowâ€¦')
 424:   } catch (err) {
 425:     toast.error(store.executionError || err?.message || 'Failed to stop workflow')
 426:   }
 427: }
 428: </script>
