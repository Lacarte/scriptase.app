  53:     def replay(self, last_sequence: int, *, snapshot: Callable[[], dict] | None = None) -> ReplayBatch:
  54:         """Return retained events after ``last_sequence``, with reset if stale."""
  55:         with self._condition:
  56:             events = list(self._events)
  57:             result: list[dict[str, Any]] = []
  58:             if events and last_sequence < events[0]["sequence"] - 1:
  59:                 reset_sequence = events[0]["sequence"] - 1
  60:                 result.append(redact({
  61:                     "sequence": reset_sequence,
  62:                     "execution_id": self.execution_id,
  63:                     "node_id": None,
  64:                     "status": "reset",
  65:                     "timestamp": now_iso(),
  66:                     "summary": "Requested events are no longer retained; state was reset",
  67:                     "snapshot": snapshot() if snapshot else None,
  68:                 }))
  69:             result.extend(deepcopy(event) for event in events if event["sequence"] > last_sequence)
  70:             return ReplayBatch(result, self._terminal)
  71: 
  72:     def subscribe(
  73:         self,
  74:         last_sequence: int = 0,
  75:         *,
  76:         snapshot: Callable[[], dict] | None = None,
  77:         wait_seconds: float = 15.0,
  78:     ) -> Iterator[dict[str, Any] | None]:
  79:         cursor = last_sequence
  80:         first = True
  81:         while True:
  82:             heartbeat = False
  83:             with self._condition:
  84:                 events = list(self._events)
  85:                 batch: list[dict[str, Any]] = []
  86:                 if first and events and cursor < events[0]["sequence"] - 1:
  87:                     batch.append(redact({
  88:                         "sequence": events[0]["sequence"] - 1,
  89:                         "execution_id": self.execution_id,
  90:                         "node_id": None,
  91:                         "status": "reset",
  92:                         "timestamp": now_iso(),
  93:                         "summary": "Requested events are no longer retained; state was reset",
  94:                         "snapshot": snapshot() if snapshot else None,
  95:                     }))
  96:                 batch.extend(deepcopy(event) for event in events if event["sequence"] > cursor)
  97:                 terminal = self._terminal
  98:                 first = False
  99:                 if not batch and not terminal:
 100:                     notified = self._condition.wait(timeout=wait_seconds)
 101:                     if not notified:
 102:                         heartbeat = True
 103:             if heartbeat:
 104:                 yield None
 105:                 continue
 106:             if not batch and not terminal:
 107:                 continue
 108:             for event in batch:
 109:                 cursor = max(cursor, int(event["sequence"]))
 110:                 yield event
 111:             if terminal and (not events or cursor >= events[-1]["sequence"]):
 112:                 return
