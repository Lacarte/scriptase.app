a way to help you learn.\",\"isPreset\":true},{\"personalityId\":\"comprehensive\",\"name\":\"Comprehensive\",\"prompt\":\"Provide thorough, detailed responses that explore topics from multiple angles. Include relevant context, examples, nuances, and implications. Structure information clearly with appropriate depth, covering edge cases and related considerations. Aim for completeness while maintaining clarity and organization.\",\"description\":\"Responds with thorough explanations.\",\"isPreset\":true}]},\"voice_mode_config\":{},\"max_files\":{\"max_files\":100},\"is_xai_employee\":false,\"is_x_employee\":false,\"new_voice_mode_1.0.36\":false,\"voice_mode_camera_rollout\":false,\"gork_voice_rollout\":false,\"allow_custom_prompts\":false,\"grok_4_mini_enable_inline_charts\":true,\"fast_followup_config\":{\"enabled\":false},\"tool_composer_config\":{\"max_qps_per_tool\":100,\"server_rate_limit_config\":{\"default\":100},\"client_rate_limit_config\":{\"default\":{\"default\":100}}},\"satisfaction_score\":3,\"mixpanel_server_url\":\"\",\"try_projects_name\":\"pick-personas\",\"grok_code_install_command\":\"npm install -g @xai-official/grok\",\"grok_mode_extras\":{\"extra_modes\":[\"grok-420\"]},\"enable_memory_v2_explicit_tools\":false,\"grok_build_symbol_references\":true,\"bustin-test\":[{\"feature_id\":\"unique name\",\"start_date\":\"new Date()\",\"name\":\"\",\"desc\":\"\",\"promotion\":{\"// used in home page banner rotations title\":\"\",\"subtitle\":\"\",\"banner_image\":\"\",\"max_passive_impressions\":10,\"priotiy\":12},\"value\":\"counter\",\"dot_threshold\":\"val\",\"banner_threshold\":\"val\",\"parent_feature\":\"name\",\"deprecated\":false}],\"boyan-test-feature\":{\"a\":\"test\"},\"dm_test_flag\":true,\"test-initial-load\":{},\"enable_compact_query_bar\":true,\"enable_unselected_log\":false,\"enable_inline_text_followups\":true,\"show_nonmode_modes\":true,\"enable_unknown_tag_processing\":true,\"enable_templates\":true,\"enable_xai_logging\":false,\"ena