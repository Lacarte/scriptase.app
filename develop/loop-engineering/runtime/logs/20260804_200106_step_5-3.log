diff --git a/frontend/src/features/workflow/components/StickyNote.vue b/frontend/src/features/workflow/components/StickyNote.vue
new file mode 100644
index 0000000000000000000000000000000000000000..eafcb4926b828e725da12b13d3219766e9979d72
--- /dev/null
