+  function updateNote(noteId, patch) {
+    return executeCommand('Edit note', () => {
+      const current = notes.value.find((note) => note.id === noteId)
+      if (!current) return false
+      const next = {
+        ...current,
+        ...(Object.hasOwn(patch || {}, 'text') ? { text: String(patch.text).slice(0, 4000) } : {}),
