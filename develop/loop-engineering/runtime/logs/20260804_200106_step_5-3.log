<template>
  <div class="workflow-page">
    <!-- Top â€” toolbar -->
    <header class="wf-toolbar">
      <div class="wf-toolbar-group">
        <span class="wf-title">{{ store.workflowName }}</span>
        <span v-if="store.dirty" class="wf-dirty" title="Unsaved changes">â—</span>
        <span
