  146:         return
  147: 
  148:     fields = {field["name"]: field for field in definition.get("config_schema", [])}
  149:     for unknown in sorted(set(config) - set(fields)):
  150:         problems.append(_problem("WORKFLOW_INVALID", f"Unknown configuration field: {unknown}", f"{path}.configuration.{unknown}"))
  151: 
  152:     for name, field in fields.items():
  153:         value = config.get(name, field.get("default"))
  154:         field_path = f"{path}.configuration.{name}"
  155:         if field.get("required") and _field_is_visible(field, config) and (
  156:             value is None or value == ""
  157:         ):
  158:             problems.append(_problem(
  159:                 "WORKFLOW_INVALID",
  160:                 f"{field.get('label', name)} is required",
  161:                 field_path,
  162:                 severity="error" if require_complete else "warning",
  163:             ))
  164:             continue
  165:         if value is None:
  166:             continue
  167:         widget = field.get("type")
  168:         if widget in {"string", "textarea"}:
  169:             if not isinstance(value, str):
  170:                 problems.append(_problem("WORKFLOW_INVALID", "must be a string", field_path))
  171:                 continue
  172:             if len(value) < field.get("min_length", 0) or len(value) > field.get("max_length", 100000):
  173:                 problems.append(_problem("WORKFLOW_INVALID", "string length is outside allowed limits", field_path))
  174:             pattern = field.get("pattern")
  175:             if pattern and value and not re.fullmatch(pattern, value):
  176:                 problems.append(_problem("WORKFLOW_INVALID", "value has an invalid format", field_path))
  177:         elif widget == "number":
  178:             if not _finite_number(value):
  179:                 problems.append(_problem("WORKFLOW_INVALID", "must be a finite number", field_path))
  180:             elif value < field.get("min", -math.inf) or value > field.get("max", math.inf):
  181:                 problems.append(_problem("WORKFLOW_INVALID", "number is outside allowed limits", field_path))
  182:         elif widget == "boolean" and not isinstance(value, bool):
  183:             problems.append(_problem("WORKFLOW_INVALID", "must be a boolean", field_path))
  184:         elif widget == "options":
  185:             options = field.get("options")
  186:             if options and value not in options:
  187:                 problems.append(_problem("WORKFLOW_INVALID", "value is not an allowed option", field_path))
  188:         elif widget == "json":
  189:             try:
  190:                 _json_size(value)
  191:             except (TypeError, ValueError):
  192:                 problems.append(_problem("WORKFLOW_INVALID", "must be JSON-serializable", field_path))
  193:         elif widget == "media_asset" and value is not None and not isinstance(value, dict):
  194:             problems.append(_problem("WORKFLOW_INVALID", "must be a managed media reference", field_path))
