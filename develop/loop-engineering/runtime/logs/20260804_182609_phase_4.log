   92: def _valid_server_timestamp(value: Any) -> bool:
   93:     if not isinstance(value, str) or not RFC3339_RE.fullmatch(value):
   94:         return False
   95:     try:
   96:         parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
   97:     except ValueError:
   98:         return False
   99:     return parsed.tzinfo is not None
