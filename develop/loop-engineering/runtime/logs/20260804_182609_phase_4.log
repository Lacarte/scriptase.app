  132: def _validate_config(
  133:     node: dict,
  134:     definition: dict,
  135:     path: str,
  136:     problems: list[dict],
  137:     *,
  138:     require_complete: bool,
  139: ) -> None:
  140:     config = node.get("configuration")
  141:     if not isinstance(config, dict):
  142:         problems.append(_problem("WORKFLOW_INVALID", "configuration must be an object", f"{path}.configuration"))
  143:         return
  144:     if _json_size(config) > 256 * 1024:
