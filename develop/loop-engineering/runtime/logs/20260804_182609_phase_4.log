  377:         problems = validation_errors(validate_workflow(dict(workflow), require_complete=True))
  378:         if problems:
  379:             raise SchedulerError("WORKFLOW_INVALID", "Workflow has validation errors", details={"problems": problems})
  380:         if not isinstance(project_id, str) or not PROJECT_ID_RE.fullmatch(project_id):
  381:             raise SchedulerError("PROJECT_ID_INVALID", "A strict pp_/pm_ project ID is required")
  382:         self.workflow = dict(workflow)
  383:         self.project_id = project_id
  384:         execution_root = os.path.join(output_dir, "workflows", "executions")
  385:         self.execution_id = execution_id or generate_execution_id(root=execution_root)
  386:         self.executor_resolver = executor_resolver
  387:         self.lock_root = lock_root
  388:         self.output_dir = output_dir
  389:         self.on_status = on_status
  390:         self.on_event = on_event
  391:         self.run_mode = run_mode
  392:         self.scope_node_ids = list(scope_node_ids or [node["id"] for node in workflow.get("nodes", [])])
  393:         self.stop_requested = stop_requested or (lambda: False)
  394:         self.force = force
  395:         self.sleeper = sleeper
  396:         self.execution_root = execution_root
  397:         self.cache = NodeCache(
  398:             root=os.path.join(output_dir, "workflows", "cache"),
  399:             output_dir=output_dir,
  400:         )
  401:         self.redactor = Redactor(workflow)
  402:         self.record = ExecutionRecord(
  403:             execution_id=self.execution_id,
  404:             workflow_id=str(workflow.get("workflow_id", "")),
  405:             workflow_snapshot=self.redactor(workflow),
  406:             project_id=project_id,
  407:             run_mode=run_mode,
  408:             scope_node_ids=self.scope_node_ids,
  409:             started_at=now_iso(),
  410:             nodes={node["id"]: NodeExecutionRecord() for node in workflow.get("nodes", [])},
  411:         )
  412: 
  413:     def run(self) -> ScheduleResult:
  414:         scope = set(self.scope_node_ids)
  415:         scoped_workflow = {
  416:             **self.workflow,
  417:             "nodes": [node for node in self.workflow.get("nodes", []) if node["id"] in scope],
  418:             "edges": [
  419:                 edge for edge in self.workflow.get("edges", [])
  420:                 if edge["source_node"] in scope and edge["target_node"] in scope
  421:             ],
  422:         }
  423:         graph = build_graph(scoped_workflow)
  424:         order = deterministic_order(scoped_workflow)
  425:         statuses = {node_id: "idle" for node_id in graph.nodes}
  426:         node_outputs: dict[str, dict[str, Any]] = {}
  427:         node_output_fingerprints: dict[str, str] = {}
  428:         errors: dict[str, dict[str, Any]] = {}
  429:         executed: list[str] = []
  430:         self._persist()
  431:         self._emit({"type": "execution_status", "node_id": None, "status": "running"})
  432: 
  433:         with ProjectLock(self.project_id, lock_root=self.lock_root, execution_id=self.execution_id):
  434:             stopped = False
  435:             cancelled = False
  436:             for node_id in order:
  437:                 node = graph.nodes[node_id]
  438:                 if self.stop_requested():
  439:                     cancelled = True
  440:                 if cancelled:
  441:                     self.record.nodes[node_id].duration_ms = 0
  442:                     self._status(statuses, node_id, "cancelled")
  443:                     executed.append(node_id)
  444:                     continue
  445:                 incoming_edges = graph.incoming[node_id]
  446:                 incoming_active = all(
  447:                     self._edge_was_activated(edge, statuses, node_outputs)
  448:                     for edge in incoming_edges
  449:                 )
  450:                 if stopped or node.get("disabled") or not incoming_active:
  451:                     self.record.nodes[node_id].duration_ms = 0
  452:                     self._status(statuses, node_id, "skipped")
  453:                     executed.append(node_id)
  454:                     continue
  455: 
  456:                 inputs = self._resolve_inputs(node_id, graph, node_outputs)
  457:                 node_record = self.record.nodes[node_id]
  458:                 node_record.from_sample_data = (
  459:                     node.get("type") == "stub.input"
  460:                     or any(
  461:                         self.record.nodes[edge["source_node"]].from_sample_data
  462:                         for edge in graph.incoming[node_id]
  463:                     )
  464:                 )
  465:                 node_record.resolved_inputs_summary = self.redactor(_summarize(inputs))
  466:                 configuration = self._configuration(node)
  467:                 incoming_fingerprints = {
  468:                     ":".join((
  469:                         edge["id"], edge["source_node"], edge["source_port"], edge["target_port"],
  470:                     )): node_output_fingerprints[edge["source_node"]]
  471:                     for edge in graph.incoming[node_id]
  472:                 }
  473:                 pinned = node.get("type") == "stub.output" and configuration.get("pinned") is True
  474:                 fingerprint_inputs = {} if pinned else inputs
  475:                 fingerprint_upstream = {} if pinned else incoming_fingerprints
  476:                 components = fingerprint_components(
  477:                     node,
  478:                     configuration,
  479:                     fingerprint_inputs,
  480:                     fingerprint_upstream,
  481:                     adapter_schema_version=int(get_node_type(node["type"]).get("cache_schema_version", 1)),
  482:                 )
  483:                 fingerprint = canonical_fingerprint(components)
  484:                 node_record.fingerprint = fingerprint
