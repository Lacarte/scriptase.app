   88: def artifact_integrity(refs: list[str], *, output_dir: str) -> tuple[dict[str, dict[str, Any]], str | None]:
   89:     """Hash managed artifacts. Empty/non-files fail closed for cache reuse."""
   90:     result: dict[str, dict[str, Any]] = {}
   91:     for ref in dict.fromkeys(refs):
   92:         path = _managed_artifact_path(output_dir, ref)
   93:         try:
   94:             if path is None or not os.path.isfile(path):
   95:                 return {}, "artifact_missing"
   96:             size = os.path.getsize(path)
   97:             if size <= 0:
   98:                 return {}, "artifact_integrity_failed"
   99:             digest = hashlib.sha256()
  100:             with open(path, "rb") as handle:
  101:                 for chunk in iter(lambda: handle.read(1024 * 1024), b""):
  102:                     digest.update(chunk)
  103:         except OSError:
  104:             return {}, "artifact_integrity_failed"
  105:         result[ref] = {"size": size, "sha256": digest.hexdigest()}
  106:     return result, None
