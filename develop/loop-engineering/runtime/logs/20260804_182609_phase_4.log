  650:     def _status(self, statuses: dict[str, str], node_id: str, status: str) -> None:
  651:         statuses[node_id] = status
  652:         node_record = self.record.nodes[node_id]
  653:         node_record.status = status
  654:         node_record.logs.append(self.redactor(ExecutionLog(
  655:             ts=now_iso(), level="info", message=f"Node status changed to {status}"
  656:         ).__dict__))
  657:         self._persist()
  658:         if self.on_status:
  659:             self.on_status(node_id, status)
  660:         self._emit({
  661:             "type": "node_status",
  662:             "execution_id": self.execution_id,
  663:             "node_id": node_id,
  664:             "status": status,
  665:             "attempt": node_record.attempts,
  666:             "duration_ms": node_record.duration_ms or 0,
  667:             "from_sample_data": node_record.from_sample_data,
  668:         })
  669: 
  670:     def _persist(self) -> dict[str, Any]:
  671:         return save_execution(self.record, root=self.execution_root, secrets=self.redactor.secrets)
  672: 
  673:     def _emit(self, event: dict[str, Any]) -> None:
  674:         if self.on_event:
  675:             self.on_event(self.redactor(event))
  676: 
  677:     @staticmethod
  678:     def _error_policy(node: Mapping[str, Any]) -> dict[str, Any]:
  679:         supplied = node.get("on_error") or {}
  680:         return {
  681:             "policy": supplied.get("policy", "stop"),
  682:             "max_attempts": supplied.get("max_attempts", 3),
  683:             "delay_ms": supplied.get("delay_ms", 1000),
  684:             "backoff_multiplier": supplied.get("backoff_multiplier", 2.0),
  685:         }
  686: 
  687:     def _failure_payload(self, node: Mapping[str, Any], exc: Exception, attempt: int) -> dict[str, Any]:
  688:         code = getattr(exc, "code", "NODE_EXECUTION_FAILED")
  689:         message = "Execution was cancelled" if code == "CANCELLED" else str(exc)
  690:         suggestion = (
  691:             "Start a new run when ready."
  692:             if code == "CANCELLED"
  693:             else "Review the node inputs and settings, then retry the failed node."
  694:         )
  695:         return self.redactor({
  696:             "node_id": node["id"],
  697:             "node_name": node.get("name") or node["id"],
  698:             "code": code,
  699:             "message": message,
  700:             "details": getattr(exc, "details", None),
  701:             "attempt": attempt,
  702:             "timestamp": now_iso(),
  703:             "recovery_suggestion": suggestion,
  704:         })
  705: 
  706:     def _sleep_before_retry(self, seconds: float) -> None:
  707:         """Wait in short intervals so a stop request interrupts long backoffs."""
  708:         remaining = seconds
  709:         while remaining > 0 and not self.stop_requested():
  710:             interval = min(0.1, remaining)
  711:             self.sleeper(interval)
  712:             remaining = max(0.0, remaining - interval)
  713: 
  714:     @staticmethod
  715:     def _edge_was_activated(
  716:         edge: Mapping[str, Any],
  717:         statuses: Mapping[str, str],
  718:         outputs: Mapping[str, Mapping[str, Any]],
  719:     ) -> bool:
  720:         source = edge["source_node"]
  721:         if edge["source_port"] == "error":
  722:             return statuses.get(source) == "failed" and "error" in outputs.get(source, {})
  723:         return statuses.get(source) == "succeeded" and edge["source_port"] in outputs.get(source, {})
  724: 
  725:     @staticmethod
  726:     def _configuration(node: Mapping[str, Any]) -> dict[str, Any]:
  727:         definition = get_node_type(node["type"])
  728:         config = {
  729:             field["name"]: field["default"]
  730:             for field in definition.get("config_schema", [])
  731:             if "default" in field
  732:         }
  733:         config.update(node.get("configuration") or {})
  734:         return config
  735: 
  736:     @staticmethod
  737:     def _resolve_inputs(node_id: str, graph: WorkflowGraph, outputs: Mapping[str, Mapping[str, Any]]) -> dict:
  738:         resolved: dict[str, Any] = {}
  739:         for edge in graph.incoming[node_id]:
  740:             value = outputs[edge["source_node"]][edge["source_port"]]
  741:             target_port = edge["target_port"]
  742:             definition = get_node_type(graph.nodes[node_id]["type"])
  743:             port = next(item for item in definition["inputs"] if item["id"] == target_port)
  744:             if port.get("multiple"):
  745:                 resolved.setdefault(target_port, []).append(value)
  746:             else:
  747:                 resolved[target_port] = value
  748:         return resolved
  749: 
  750:     @staticmethod
  751:     def _validate_outputs(node: Mapping[str, Any], outputs: Mapping[str, Any]) -> None:
  752:         definition = get_node_type(node["type"])
  753:         for port in definition.get("outputs", []):
  754:             if port["id"] == "error":
  755:                 continue
  756:             if port["id"] not in outputs:
  757:                 raise SchedulerError(
  758:                     "NODE_OUTPUT_MISSING",
  759:                     f"Node {node['id']} did not produce output port {port['id']}",
  760:                 )
  761: 
