  555:                             output_fp, cache_failure = None, "sensitive_output"
  556:                         else:
  557:                             output_fp, cache_failure = self.cache.store(
  558:                                 workflow_id=str(self.workflow.get("workflow_id", "")),
  559:                                 project_id=self.project_id,
  560:                                 node_id=node_id,
  561:                                 fingerprint=fingerprint,
  562:                                 components=components,
  563:                                 outputs=result,
  564:                                 artifact_refs=_artifact_refs(result),
  565:                             )
  566:                         if output_fp is None:
  567:                             node_record.cache = {"hit": False, "reason": cache_failure}
  568:                             output_fp = output_fingerprint(result, {})
  569:                         node_output_fingerprints[node_id] = output_fp
  570:                         node_record.duration_ms = max(0, round((time.perf_counter() - started) * 1000))
  571:                         node_record.error = None
  572:                         self._status(statuses, node_id, "succeeded")
  573:                         break
  574:                     except CancellationRequested as exc:
  575:                         failure = exc
  576:                         cancelled = True
  577:                     except Exception as exc:  # adapters are a plugin boundary
  578:                         failure = exc
  579:                     finally:
  580:                         promoter.cleanup()
  581: 
  582:                     if cancelled or getattr(failure, "code", None) == "CANCELLED":
  583:                         cancelled = True
  584:                         node_record.error = self._failure_payload(node, failure, node_record.attempts)
  585:                         node_record.duration_ms = max(0, round((time.perf_counter() - started) * 1000))
  586:                         self._status(statuses, node_id, "cancelled")
  587:                         break
  588: 
  589:                     attempt_error = self._failure_payload(node, failure, node_record.attempts)
  590:                     node_record.attempt_errors.append(attempt_error)
  591:                     if policy["policy"] == "retry" and node_record.attempts < max_attempts:
  592:                         delay_ms = min(
  593:                             60_000,
  594:                             round(policy["delay_ms"] * (policy["backoff_multiplier"] ** (node_record.attempts - 1))),
  595:                         )
  596:                         self._emit({
  597:                             "type": "node_retry", "execution_id": self.execution_id,
  598:                             "node_id": node_id, "attempt": node_record.attempts,
  599:                             "next_attempt": node_record.attempts + 1, "delay_ms": delay_ms,
  600:                             "error": attempt_error,
  601:                         })
  602:                         node_record.logs.append(self.redactor(ExecutionLog(
  603:                             ts=now_iso(), level="warning",
  604:                             message=f"Attempt {node_record.attempts} failed; retrying in {delay_ms} ms",
