  213: def _validate_error_policy(node: dict, definition: dict, path: str, problems: list[dict]) -> None:
  214:     policy = node.get("on_error")
  215:     if policy is None:
  216:         return
  217:     policy_path = f"{path}.on_error"
  218:     if not isinstance(policy, dict):
  219:         problems.append(_problem("WORKFLOW_INVALID", "on_error must be an object", policy_path))
  220:         return
  221:     allowed = {"policy", "max_attempts", "delay_ms", "backoff_multiplier"}
  222:     for unknown in sorted(set(policy) - allowed):
  223:         problems.append(_problem(
  224:             "WORKFLOW_INVALID", f"Unknown on_error field: {unknown}", f"{policy_path}.{unknown}"
  225:         ))
  226:     name = policy.get("policy", "stop")
  227:     if name not in _ERROR_POLICIES:
  228:         problems.append(_problem(
  229:             "WORKFLOW_INVALID", f"Unsupported error policy: {name}", f"{policy_path}.policy"
  230:         ))
  231:         return
  232:     capabilities = definition.get("capabilities", {})
  233:     capability = {"retry": "retry", "continue_error": "error_output", "skip_optional": "skip_optional"}.get(name)
  234:     if capability and not capabilities.get(capability, False):
  235:         problems.append(_problem(
  236:             "WORKFLOW_INVALID", f"{name} is not supported by this node type", f"{policy_path}.policy"
  237:         ))
  238: 
  239:     max_attempts = policy.get("max_attempts", 3)
  240:     delay_ms = policy.get("delay_ms", 1000)
  241:     multiplier = policy.get("backoff_multiplier", 2.0)
  242:     if isinstance(max_attempts, bool) or not isinstance(max_attempts, int) or not 1 <= max_attempts <= 10:
  243:         problems.append(_problem(
  244:             "WORKFLOW_INVALID", "max_attempts must be an integer from 1 to 10",
  245:             f"{policy_path}.max_attempts",
  246:         ))
  247:     if isinstance(delay_ms, bool) or not isinstance(delay_ms, int) or not 0 <= delay_ms <= 60_000:
  248:         problems.append(_problem(
  249:             "WORKFLOW_INVALID", "delay_ms must be an integer from 0 to 60000",
  250:             f"{policy_path}.delay_ms",
  251:         ))
  252:     if isinstance(multiplier, bool) or not isinstance(multiplier, (int, float)) or not 1 <= multiplier <= 10:
  253:         problems.append(_problem(
  254:             "WORKFLOW_INVALID", "backoff_multiplier must be a number from 1 to 10",
  255:             f"{policy_path}.backoff_multiplier",
  256:         ))
