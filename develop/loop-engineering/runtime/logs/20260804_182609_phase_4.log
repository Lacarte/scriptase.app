  121: def _field_is_visible(field: dict, configuration: dict) -> bool:
  122:     display = field.get("display_options") or {}
  123:     for reference, values in (display.get("show") or {}).items():
  124:         if configuration.get(reference) not in values:
  125:             return False
  126:     for reference, values in (display.get("hide") or {}).items():
  127:         if configuration.get(reference) in values:
  128:             return False
  129:     return True
