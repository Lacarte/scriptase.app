  304:         raise ValueError("target_node_ids must be an array of node IDs")
  305:     if len(set(target_node_ids)) != len(target_node_ids):
  306:         raise ValueError("target_node_ids must not contain duplicates")
  307:     unknown = [node_id for node_id in target_node_ids if node_id not in known_ids]
  308:     if unknown:
  309:         raise ValueError(f"Unknown target node: {unknown[0]}")
  310: 
  311:     if run_mode == "full":
  312:         if target_node_ids:
  313:             raise ValueError("full mode does not accept target_node_ids")
  314:         return saved_ids
  315: 
  316:     if run_mode == "selected":
  317:         if not target_node_ids:
  318:             raise ValueError("selected requires at least one existing target node")
  319:         seeds = set(target_node_ids)
  320:         direction = "dependencies"
  321:     else:
  322:         if len(target_node_ids) != 1:
  323:             raise ValueError(f"{run_mode} requires exactly one existing target node")
  324:         seeds = {target_node_ids[0]}
  325:         if run_mode in {"node_with_deps"}:
  326:             direction = "dependencies"
  327:         elif run_mode in {"from_node", "retry_failed_desc"}:
  328:             direction = "descendants"
  329:         else:
  330:             # node_isolated and retry_failed contain only their target at the
  331:             # topology layer. Isolation may add directly-connected stubs.
  332:             return [node_id for node_id in saved_ids if node_id in seeds]
  333: 
  334:     dependencies, descendants = dependency_maps(workflow)
  335:     adjacency = dependencies if direction == "dependencies" else descendants
  336:     scope = set(seeds)
  337:     pending = list(seeds)
  338:     while pending:
  339:         node_id = pending.pop()
  340:         for related_id in adjacency[node_id]:
  341:             if related_id not in scope:
  342:                 scope.add(related_id)
  343:                 pending.append(related_id)
  344:     return [node_id for node_id in saved_ids if node_id in scope]
  345: 
  346: 
  347: def resolve_executor(node: Mapping[str, Any]) -> Callable:
  348:     definition = get_node_type(node.get("type"))
  349:     spec = definition.get("executor") if definition else None
  350:     if not spec or ":" not in spec:
  351:         raise SchedulerError("NODE_EXECUTOR_MISSING", f"No executor is registered for {node.get('type')}")
  352:     module_name, function_name = spec.split(":", 1)
  353:     function = getattr(importlib.import_module(module_name), function_name, None)
  354:     if not callable(function):
  355:         raise SchedulerError("NODE_EXECUTOR_MISSING", f"Executor {spec} is not callable")
  356:     return function
