   81:             raise ExecutionRequestError(
   82:                 "MISSING_REQUIRED_INPUT",
   83:                 f"Isolated node {target} requires Sample Input data for port {port['id']}",
   84:             )
   85:     scope = stub_ids | {target}
   86:     return [node_id for node_id in nodes if node_id in scope]
