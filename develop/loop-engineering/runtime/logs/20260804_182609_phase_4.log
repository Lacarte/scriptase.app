  488:                     self._validate_outputs(node, result)
  489:                     node_outputs[node_id] = result
  490:                     output_fp = output_fingerprint(result, {})
  491:                     node_output_fingerprints[node_id] = output_fp
  492:                     node_record.outputs_summary = self.redactor(_summarize(result))
  493:                     node_record.cache = {"hit": True, "reason": "pinned_payload"}
  494:                     node_record.duration_ms = 0
  495:                     self._status(statuses, node_id, "succeeded")
  496:                     executed.append(node_id)
  497:                     continue
  498: 
  499:                 lookup = self.cache.lookup(
  500:                     workflow_id=str(self.workflow.get("workflow_id", "")),
  501:                     project_id=self.project_id,
  502:                     node_id=node_id,
  503:                     fingerprint=fingerprint,
  504:                     components=components,
  505:                     force=self.force,
  506:                 )
  507:                 node_record.cache = {"hit": lookup.hit, "reason": lookup.reason}
  508:                 if lookup.hit:
  509:                     result = dict(lookup.outputs or {})
  510:                     try:
  511:                         self._validate_outputs(node, result)
  512:                     except SchedulerError:
  513:                         lookup = CacheLookup(False, "cache_corrupt")
  514:                         node_record.cache = {"hit": False, "reason": lookup.reason}
  515:                     else:
  516:                         node_outputs[node_id] = result
  517:                         node_output_fingerprints[node_id] = lookup.output_fingerprint or output_fingerprint(result, {})
  518:                         node_record.outputs_summary = self.redactor(_summarize(result))
  519:                         node_record.artifact_refs = self.redactor(_artifact_refs(result))
  520:                         node_record.duration_ms = 0
  521:                         self._status(statuses, node_id, "succeeded")
  522:                         executed.append(node_id)
  523:                         continue
  524: 
  525:                 if lookup.reason not in {"no_prior_success", "forced_regeneration"}:
  526:                     self._status(statuses, node_id, "stale")
  527:                 started = time.perf_counter()
  528:                 policy = self._error_policy(node)
  529:                 max_attempts = policy["max_attempts"] if policy["policy"] == "retry" else 1
  530:                 while node_record.attempts < max_attempts:
  531:                     node_record.attempts += 1
  532:                     self._status(statuses, node_id, "running")
  533:                     promoter = ArtifactPromoter(output_dir=self.output_dir, execution_id=self.execution_id or node_id)
  534:                     context = AdapterContext(
  535:                         project_id=self.project_id,
  536:                         execution_id=self.execution_id,
  537:                         node_id=node_id,
  538:                         stage_artifact=promoter.stage_path,
  539:                         stop_requested=self.stop_requested,
  540:                     )
  541:                     failure = None
