  670:     def _persist(self) -> dict[str, Any]:
  671:         return save_execution(self.record, root=self.execution_root, secrets=self.redactor.secrets)
  672: 
  673:     def _emit(self, event: dict[str, Any]) -> None:
  674:         if self.on_event:
  675:             self.on_event(self.redactor(event))
