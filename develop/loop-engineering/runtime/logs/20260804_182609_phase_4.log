   40: def fingerprint_components(
   41:     node: Mapping[str, Any],
   42:     configuration: Mapping[str, Any],
   43:     inputs: Mapping[str, Any],
   44:     upstream_fingerprints: Mapping[str, str],
   45:     *,
   46:     adapter_schema_version: int = ADAPTER_CACHE_SCHEMA_VERSION,
   47: ) -> dict[str, Any]:
   48:     """Return the inspectable canonical inputs to a node fingerprint."""
   49:     return {
   50:         "node_type": node.get("type"),
   51:         "type_version": node.get("type_version"),
   52:         "configuration": deepcopy(dict(configuration)),
   53:         "inputs": deepcopy(dict(inputs)),
   54:         "upstream_artifact_fingerprints": dict(sorted(upstream_fingerprints.items())),
   55:         "adapter_cache_schema_version": adapter_schema_version,
   56:     }
