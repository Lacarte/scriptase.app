   75: def _managed_artifact_path(output_dir: str, ref: str) -> str | None:
   76:     if not isinstance(ref, str) or not ref or os.path.isabs(ref):
   77:         return None
   78:     try:
   79:         path = os.path.abspath(safe_join(output_dir, ref.replace("/", os.sep)))
   80:         root = os.path.abspath(output_dir)
   81:         if os.path.commonpath([root, path]) != root:
   82:             return None
   83:     except (ValueError, OSError):
   84:         return None
   85:     return path
