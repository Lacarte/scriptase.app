  116: def miss_reason(previous: Mapping[str, Any], current: Mapping[str, Any]) -> str:
  117:     if previous.get("node_type") != current.get("node_type") or previous.get("type_version") != current.get("type_version"):
  118:         return "type_or_version_changed"
  119:     if previous.get("adapter_cache_schema_version") != current.get("adapter_cache_schema_version"):
  120:         return "adapter_schema_changed"
  121:     if previous.get("configuration") != current.get("configuration"):
  122:         return "config_changed"
  123:     if previous.get("upstream_artifact_fingerprints") != current.get("upstream_artifact_fingerprints"):
  124:         return "upstream_changed"
  125:     if previous.get("inputs") != current.get("inputs"):
  126:         return "inputs_changed"
  127:     return "fingerprint_mismatch"
