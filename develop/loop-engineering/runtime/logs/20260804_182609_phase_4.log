   63: def _json_shape_error(value: Any) -> str | None:
   64:     """Return the first transport-independent JSON shape violation."""
   65:     stack = [(value, 1)]
   66:     seen: set[int] = set()
   67:     while stack:
   68:         item, depth = stack.pop()
   69:         if isinstance(item, bool) or item is None or isinstance(item, str):
   70:             continue
   71:         if isinstance(item, (int, float)):
   72:             if isinstance(item, float) and not math.isfinite(item):
   73:                 return "JSON numbers must be finite"
   74:             continue
   75:         if not isinstance(item, (dict, list)):
   76:             return "Workflow contains a value that is not valid JSON"
   77:         if depth > MAX_NESTING_DEPTH:
   78:             return f"JSON nesting depth exceeds {MAX_NESTING_DEPTH}"
   79:         identity = id(item)
   80:         if identity in seen:
   81:             return "Workflow contains a recursive JSON value"
   82:         seen.add(identity)
   83:         if isinstance(item, dict):
   84:             if any(not isinstance(key, str) for key in item):
   85:                 return "JSON object keys must be strings"
   86:             stack.extend((child, depth + 1) for child in item.values())
   87:         else:
   88:             stack.extend((child, depth + 1) for child in item)
   89:     return None
   90: 
