  259: def validate_workflow(document: Any, *, require_identity: bool = True, require_complete: bool = False) -> list[dict]:
  260:     """Return structured errors/warnings for a workflow document."""
  261:     problems: list[dict] = []
  262:     if not isinstance(document, dict):
  263:         return [_problem("WORKFLOW_INVALID", "Workflow must be a JSON object")]
  264:     shape_error = _json_shape_error(document)
  265:     if shape_error:
  266:         return [_problem("WORKFLOW_INVALID", shape_error)]
  267:     try:
  268:         if _json_size(document) > MAX_DOCUMENT_BYTES:
  269:             return [_problem("WORKFLOW_INVALID", "Workflow exceeds the 2 MiB limit")]
  270:     except (TypeError, ValueError):
  271:         return [_problem("WORKFLOW_INVALID", "Workflow is not valid JSON data")]
  272: 
  273:     for unknown in sorted(set(document) - _TOP_FIELDS):
  274:         problems.append(_problem("WORKFLOW_INVALID", f"Unknown workflow field: {unknown}", unknown))
  275:     if document.get("schema_version") != 1:
  276:         problems.append(_problem("WORKFLOW_INVALID", "schema_version must be 1", "schema_version"))
  277:     workflow_id = document.get("workflow_id")
  278:     if (require_identity or workflow_id is not None) and (
  279:         not isinstance(workflow_id, str) or not WORKFLOW_ID_RE.fullmatch(workflow_id)
  280:     ):
  281:         problems.append(_problem("WORKFLOW_INVALID", "workflow_id must match wf_XXXXXX", "workflow_id"))
  282:     for field in ("created_at", "updated_at"):
  283:         value = document.get(field)
  284:         if (require_identity or value is not None) and not _valid_server_timestamp(value):
  285:             problems.append(_problem("WORKFLOW_INVALID", f"{field} must be an RFC 3339 timestamp", field))
  286:     name = document.get("name")
  287:     if not isinstance(name, str) or not (1 <= len(name.strip()) <= 120):
  288:         problems.append(_problem("WORKFLOW_INVALID", "name must contain 1â€“120 characters", "name"))
  289:     description = document.get("description", "")
  290:     if not isinstance(description, str) or len(description) > 2000:
  291:         problems.append(_problem("WORKFLOW_INVALID", "description must be at most 2,000 characters", "description"))
  292: 
  293:     nodes = document.get("nodes")
  294:     edges = document.get("edges")
  295:     if not isinstance(nodes, list):
  296:         problems.append(_problem("WORKFLOW_INVALID", "nodes must be an array", "nodes"))
  297:         nodes = []
  298:     elif len(nodes) > MAX_NODES:
  299:         problems.append(_problem("WORKFLOW_INVALID", f"nodes exceeds the {MAX_NODES} item limit", "nodes"))
  300:     if not isinstance(edges, list):
  301:         problems.append(_problem("WORKFLOW_INVALID", "edges must be an array", "edges"))
  302:         edges = []
  303:     elif len(edges) > MAX_EDGES:
  304:         problems.append(_problem("WORKFLOW_INVALID", f"edges exceeds the {MAX_EDGES} item limit", "edges"))
  305: 
  306:     node_map: dict[str, tuple[dict, dict]] = {}
  307:     for index, node in enumerate(nodes):
  308:         path = f"nodes[{index}]"
  309:         if not isinstance(node, dict):
  310:             problems.append(_problem("WORKFLOW_INVALID", "node must be an object", path))
  311:             continue
  312:         for unknown in sorted(set(node) - _NODE_FIELDS):
  313:             problems.append(_problem("WORKFLOW_INVALID", f"Unknown node field: {unknown}", f"{path}.{unknown}"))
  314:         node_id = node.get("id")
  315:         if not isinstance(node_id, str) or not ELEMENT_ID_RE.fullmatch(node_id):
  316:             problems.append(_problem("WORKFLOW_INVALID", "node id has an invalid format", f"{path}.id"))
  317:             continue
  318:         if node_id in node_map:
  319:             problems.append(_problem("WORKFLOW_INVALID", f"Duplicate node id: {node_id}", f"{path}.id"))
  320:             continue
  321:         type_key = node.get("type")
  322:         definition = get_node_type(type_key) if isinstance(type_key, str) else None
  323:         if not definition:
  324:             problems.append(_problem("UNKNOWN_NODE_TYPE", f"Unknown node type: {type_key}", f"{path}.type"))
  325:             continue
  326:         if not is_supported(type_key, node.get("type_version")):
  327:             problems.append(_problem("UNSUPPORTED_NODE_VERSION", f"Unsupported version for {type_key}", f"{path}.type_version"))
  328:         node_name = node.get("name")
  329:         if not isinstance(node_name, str) or not (1 <= len(node_name.strip()) <= 120):
  330:             problems.append(_problem("WORKFLOW_INVALID", "node name must contain 1â€“120 characters", f"{path}.name"))
  331:         position = node.get("position")
  332:         if not isinstance(position, dict) or set(position) != {"x", "y"} or not all(
  333:             _finite_number(position.get(axis)) and -1_000_000 <= position[axis] <= 1_000_000 for axis in ("x", "y")
  334:         ):
  335:             problems.append(_problem("WORKFLOW_INVALID", "position must contain finite x/y coordinates", f"{path}.position"))
  336:         if not isinstance(node.get("disabled"), bool):
  337:             problems.append(_problem("WORKFLOW_INVALID", "disabled must be a boolean", f"{path}.disabled"))
  338:         _validate_extensions(node.get("extensions"), f"{path}.extensions", problems)
  339:         _validate_config(node, definition, path, problems, require_complete=require_complete)
  340:         _validate_error_policy(node, definition, path, problems)
  341:         node_map[node_id] = (node, definition)
  342: 
  343:     edge_ids: set[str] = set()
