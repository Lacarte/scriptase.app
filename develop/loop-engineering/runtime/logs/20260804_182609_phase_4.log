   58: 
   59: def canonical_fingerprint(components: Mapping[str, Any]) -> str:
   60:     return "sha256:" + _sha256_bytes(_canonical(components).encode("utf-8"))
   61: 
   62: 
   63: def component_signatures(components: Mapping[str, Any]) -> dict[str, Any]:
   64:     """Persist comparison hashes, never raw configuration/input values."""
   65:     signatures = {
   66:         "node_type": components.get("node_type"),
   67:         "type_version": components.get("type_version"),
   68:         "adapter_cache_schema_version": components.get("adapter_cache_schema_version"),
   69:     }
   70:     for key in ("configuration", "inputs", "upstream_artifact_fingerprints"):
   71:         signatures[key] = "sha256:" + _sha256_bytes(_canonical(components.get(key)).encode("utf-8"))
   72:     return signatures
