   62:     except ValueError as exc:
   63:         raise ExecutionRequestError("BAD_REQUEST", str(exc)) from exc
   64:     if run_mode != "node_isolated":
   65:         return scope
   66: 
   67:     target = target_node_ids[0]
   68:     # Isolation deliberately ignores normal upstream nodes. Required inputs
   69:     # must instead be supplied by directly connected Sample Input nodes.
   70:     incoming = [edge for edge in workflow.get("edges", []) if edge["target_node"] == target]
   71:     stub_ids = {
   72:         edge["source_node"] for edge in incoming
   73:         if nodes[edge["source_node"]].get("type") == "stub.input"
   74:     }
   75:     definition = get_node_type(nodes[target]["type"])
