  362:         _validate_extensions(edge.get("extensions"), f"{path}.extensions", problems)
  363:         source_id, target_id = edge.get("source_node"), edge.get("target_node")
  364:         if source_id not in node_map or target_id not in node_map:
  365:             problems.append(_problem("WORKFLOW_INVALID", "edge endpoint does not exist", path))
  366:             continue
  367:         source_node, source_def = node_map[source_id]
  368:         target_node, target_def = node_map[target_id]
  369:         source_port = next((p for p in source_def["outputs"] if p["id"] == edge.get("source_port")), None)
  370:         target_port = next((p for p in target_def["inputs"] if p["id"] == edge.get("target_port")), None)
  371:         if not source_port or not target_port:
  372:             problems.append(_problem("WORKFLOW_INVALID", "edge references an unknown port", path))
  373:             continue
  374:         source_type = _port_type(source_node, source_port)
  375:         target_type = _port_type(target_node, target_port)
  376:         if source_type not in DYNAMIC_PORT_TYPES + ["control"] or target_type not in DYNAMIC_PORT_TYPES + ["control"]:
  377:             problems.append(_problem("PORT_TYPE_MISMATCH", "dynamic port_type is invalid", path))
  378:             continue
  379:         expected_edge_type = "control" if source_type == "control" else "data"
  380:         if source_type != target_type or edge.get("edge_type") != expected_edge_type:
  381:             problems.append(_problem("PORT_TYPE_MISMATCH", f"Cannot connect {source_type} to {target_type}", path))
  382:             continue
  383:         key = (source_id, source_port["id"], target_id, target_port["id"])
  384:         if key in connections:
  385:             problems.append(_problem("WORKFLOW_INVALID", "duplicate connection", path))
  386:             continue
  387:         connections.add(key)
  388:         target_key = (target_id, target_port["id"])
  389:         if not target_port.get("multiple") and target_key in occupied:
  390:             problems.append(_problem("WORKFLOW_INVALID", "single-value input has multiple connections", path))
  391:             continue
  392:         occupied.add(target_key)
  393:         connected_inputs.add(target_key)
  394:         adjacency[source_id].append(target_id)
