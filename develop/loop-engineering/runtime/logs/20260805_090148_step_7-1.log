+    response = http.post(f"/api/workflow/queue/{pending}/cancel", json={})
+    assert response.status_code == 202
+    assert response.get_json()["status"] == "cancelled"
+
+    release.set()
+    manager.active.get(first).thread.join(timeout=5)

