 EXECUTIONS_DIR = WORKFLOW_EXECUTIONS_DIR
+QUEUE_DIR = os.path.join(os.path.dirname(EXECUTIONS_DIR), "queue")
 EXECUTION_ID_RE = re.compile(r"^ex_[A-Za-z0-9]{6}$")
 
 
