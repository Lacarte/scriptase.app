+            if port.get("type") not in PORT_TYPES:
+                raise RuntimeError(
+                    f"Generated node {key!r} port {port.get('id')!r} has invalid type {port.get('type')!r}"
+                )
+        generated[key] = definition
+    return generated
+
+
+_NODE_TYPES.update(load_generated_node_types())
+
