+    ).run()
+    assert result.status == "partial"
+    assert result.node_statuses["work"] == "skipped"
+    assert result.node_statuses["success"] == "skipped"
+    assert result.node_statuses["independent"] == "succeeded"
+    assert "independent" in calls
+
