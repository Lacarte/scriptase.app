 class ValidationTests(unittest.TestCase):
+    def test_error_policies_are_capability_gated_and_bounded(self):
+        document = draft()
+        document["nodes"][0]["on_error"] = {
+            "policy": "retry", "max_attempts": 11, "delay_ms": -1, "backoff_multiplier": 0.5,
+        }
