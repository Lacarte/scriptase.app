+_ERROR_POLICIES = {"stop", "retry", "continue_error", "skip_optional"}
 _EDGE_FIELDS = {
     "id", "source_node", "source_port", "target_node", "target_port", "edge_type",
     "extensions",
@@ -208,6 +210,52 @@
