    "music_track", "editor_project", "export_profile", "video_file",
    "generic_json",
]

# Data types a dynamic port (workflow.output, stub.*) may resolve to.
DYNAMIC_PORT_TYPES = [t for t in PORT_TYPES if t != "control"]

