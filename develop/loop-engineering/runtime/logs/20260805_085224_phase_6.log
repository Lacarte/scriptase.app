 662:     return
 663:   }
 664:   const anchor = document.createElement('a')
 665:   anchor.href = `/api/workflows/${encodeURIComponent(store.workflowId)}/export`
 666:   anchor.download = `${store.workflowId}.json`
 667:   anchor.click()
 668: }
