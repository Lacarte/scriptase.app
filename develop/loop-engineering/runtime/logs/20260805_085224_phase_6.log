 516: // â”€â”€ Dagre tidy-up â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 517: function tidyUp() {
 518:   if (!store.nodes.length) return
 519:   const g = new dagre.graphlib.Graph()
 520:   g.setGraph({ rankdir: 'LR', nodesep: 40, ranksep: 90 })
 521:   g.setDefaultEdgeLabel(() => ({}))
 522:   for (const node of store.nodes) {
 523:     g.setNode(node.id, { width: 200, height: 60 })
 524:   }
 525:   for (const edge of store.edges) {
 526:     g.setEdge(edge.source_node, edge.target_node)
 527:   }
 528:   dagre.layout(g)
 529:   const moves = []
 530:   for (const node of store.nodes) {
 531:     const pos = g.node(node.id)
 532:     if (pos) {
 533:       moves.push({
 534:         id: node.id,
 535:         position: {
 536:           x: Math.round((pos.x - 100) / 20) * 20,
 537:           y: Math.round((pos.y - 30) / 20) * 20,
 538:         },
 539:       })
 540:     }
 541:   }
 542:   store.moveNodes(moves)
 543:   requestAnimationFrame(() => fitView({ padding: 0.15 }))
 544: }
