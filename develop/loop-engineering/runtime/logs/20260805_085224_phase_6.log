 670: async function onRun(mode = runMode.value, nodeId = store.selectedNodeId) {
 671:   const targets = targetsForMode(mode, nodeId)
 672:   if (!canRun(mode, nodeId)) {
 673:     const message = mode === 'selected'
 674:       ? 'Select one or more canvas nodes first'
 675:       : mode.startsWith('retry_')
 676:         ? 'Choose a node that failed in the current execution'
 677:         : 'Choose a node first'
 678:     toast.warning(message)
 679:     return
 680:   }
 681:   try {
 682:     await store.runWorkflow({ runMode: mode, targetNodeIds: targets })
 683:     toast.success('Workflow run started')
 684:   } catch (err) {
 685:     toast.error(store.executionError || err?.message || 'Failed to run workflow')
 686:   }
 687: }
