 548: async function onValidate() {
 549:   validating.value = true
 550:   try {
 551:     const data = await api.post('/api/workflow/validate', {
 552:       body: { workflow: store.toDocument() },
 553:     })
 554:     if (data.valid && !data.warnings.length) {
 555:       toast.success('Workflow is valid')
 556:     } else if (data.valid) {
 557:       toast.warning(`Valid, with ${data.warnings.length} warning(s): ${data.warnings[0]?.message}`)
 558:     } else {
 559:       const first = data.problems[0]?.message || 'see node badges'
 560:       toast.error(`${data.problems.length} problem(s) â€” ${first}`)
 561:     }
 562:   } catch (err) {
 563:     toast.error(err?.message || 'Validation request failed')
 564:   } finally {
 565:     validating.value = false
 566:   }
 567: }
