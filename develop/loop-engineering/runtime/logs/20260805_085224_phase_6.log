 173:         # Templates may intentionally leave required user-authored configuration
 174:         # (notably Script Input text) blank, but the graph itself must be valid.
 175:         problems = validate_workflow(template, require_identity=False, require_complete=False)
 176:         errors = validation_errors(problems)
 177:         if errors:
 178:             raise RuntimeError(f"Built-in template {template_id} is invalid: {errors}")
 179:         result.append({"template_id": template_id, "workflow": template})
 180:     return result
