 641: async function onImportFile(event) {
 642:   const file = event.target.files?.[0]
 643:   event.target.value = ''
 644:   if (!file || !confirmDiscard()) return
 645:   if (file.size > 2 * 1024 * 1024) {
 646:     toast.error('Workflow JSON exceeds the 2 MiB limit')
 647:     return
 648:   }
 649:   try {
 650:     const document = JSON.parse(await file.text())
 651:     await store.importDocument(document)
 652:     await restoreViewport()
 653:     toast.success('Workflow imported')
 654:   } catch (err) {
 655:     toast.error(store.persistenceError || err?.message || 'Invalid workflow JSON')
 656:   }
 657: }
