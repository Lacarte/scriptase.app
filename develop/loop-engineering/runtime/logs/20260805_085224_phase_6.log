 482: function targetsForMode(mode, nodeId = store.selectedNodeId) {
 483:   if (mode === 'full') return []
 484:   if (mode === 'selected') return [...canvasSelection.value]
 485:   return nodeId ? [nodeId] : []
 486: }
 487: 
 488: function canRun(mode, nodeId = store.selectedNodeId) {
 489:   if (!store.nodeCount || store.executionLoading || store.executionActive) return false
 490:   const targets = targetsForMode(mode, nodeId)
 491:   if (mode === 'full') return true
 492:   if (mode === 'selected') return targets.length > 0
 493:   if (targets.length !== 1) return false
 494:   if (mode === 'retry_failed' || mode === 'retry_failed_desc') {
 495:     return isFailedNode(targets[0])
 496:   }
 497:   return true
 498: }
