  function duplicateNode(nodeId) {
    const source = nodeById(nodeId)
    if (!source) return null
    const suffix = ' copy'
    const copyName = `${source.name.slice(0, 120 - suffix.length).trimEnd()}${suffix}`
    const copy = {
      id: nextNodeId(),
      type: source.type,
      type_version: source.type_version,
      name: copyName,
