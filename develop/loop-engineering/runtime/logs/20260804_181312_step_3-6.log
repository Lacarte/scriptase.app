+
+class FakeEventSource {
+  static latest = null
+  constructor(url) {
+    this.url = url
+    this.close = vi.fn()
+    FakeEventSource.latest = this
+  }
+  send(event) {
+    this.onmessage({ data: JSON.stringify(event) })
+  }
