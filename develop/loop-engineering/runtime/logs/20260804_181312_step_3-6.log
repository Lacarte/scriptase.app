+.status-succeeded { --status-color: #34d399; }
+.status-failed { --status-color: #fb7185; }
+.status-cancelled { --status-color: #f59e0b; }
+.status-skipped { --status-color: #94a3b8; }
+.status-stale { --status-color: #fb923c; }
