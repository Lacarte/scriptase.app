 257:     def is_configured(self, settings: dict | None = None) -> bool:
 258:         """Every `requires` key is non-empty after env fallback (Â§21.5).
 259: 
 260:         Computed from `requires`, never from key presence: the live settings file
 261:         stores present-but-empty `api_key` values (Â§14.3).
 262:         """
 263:         resolved = self.resolve_settings(settings)
 264:         return all(
 265:             not schema_tools.is_empty(resolved.get(key)) for key in self.requires
 266:         )
