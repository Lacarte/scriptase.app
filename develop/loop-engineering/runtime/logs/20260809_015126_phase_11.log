 218:         not *regress*: a provider that is registered today must not come back
 219:         excluded. An invalid edit therefore leaves the last good catalog serving
 220:         requests, while adding or removing a provider folder still takes effect.
 221:         """
 222:         report = ReloadReport()
 223:         for domain in domains or self.domains():
 224:             registry = self.registry(domain)
 225:             try:
 226:                 candidate = registry.build_snapshot(self.spec(domain).providers_base)
 227:             except Exception as e:
 228:                 logger.error("[providers] {}: reload scan failed, keeping last good: {}", domain, e)
 229:                 report.retained[domain] = ["scan failed"]
 230:                 continue
 231: 
 232:             regressions = self._regressions(registry.snapshot, candidate)
 233:             if regressions:
 234:                 logger.warning(
 235:                     "[providers] {}: reload rejected, keeping last good catalog ({})",
 236:                     domain, ", ".join(regressions),
