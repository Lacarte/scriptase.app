 149: @providers_bp.route("/api/providers/<domain>/<provider_id>/capabilities", methods=["GET"])
 150: def provider_capabilities(domain, provider_id):
 151:     """Declared capabilities plus the domain's capability vocabulary (Â§20.4).
 152: 
 153:     Answered from manifest metadata alone â€” no provider code runs.
 154:     """
 155:     denied = _require_loopback()
 156:     if denied:
 157:         return denied
 158:     provider, err = _resolve_provider(domain, provider_id)
 159:     if err is not None:
 160:         return err
 161:     spec = DOMAINS[domain]
 162:     return jsonify({
 163:         "domain": domain,
 164:         "provider_id": provider.id,
 165:         "capabilities": dict(provider.capabilities),
 166:         "vocabulary": sorted(spec.capability_vocabulary),
 167:     })
