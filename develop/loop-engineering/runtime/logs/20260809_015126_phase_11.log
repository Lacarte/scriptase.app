  59: def _resolve_provider(domain, provider_id):
  60:     """Resolve one provider by canonical id then alias (Â§19.3).
  61: 
  62:     A discovered-but-excluded provider is a `409`, not a `404`: it exists on disk
  63:     and the operator needs to know the difference (Â§21.4, Â§24.2).
  64:     """
  65:     _, err = _resolve_domain(domain)
  66:     if err is not None:
  67:         return None, err
  68:     provider = hub.get(domain, provider_id)
  69:     if provider is not None:
  70:         return provider, None
  71:     for exclusion in hub.registry(domain).excluded():
  72:         if exclusion["id"] == provider_id:
  73:             return None, _error(
  74:                 "PROVIDER_EXCLUDED",
  75:                 f"Provider '{provider_id}' was discovered but could not be loaded",
  76:                 409,
  77:                 {"reason_code": exclusion["reason_code"], "message": exclusion["message"]},
  78:             )
  79:     return None, _error("PROVIDER_NOT_FOUND", f"Provider '{provider_id}' not found", 404)
