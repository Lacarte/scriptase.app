   53: class CancellationToken:
   54:     """Cooperative cancellation over the scheduler's existing stop callable.
   55: 
   56:     A wrapper, not a new mechanism: no thread is killed and no process is
   57:     signalled. `on_cancel` callbacks run once, on the thread that first observes
   58:     cancellation, because the scheduler exposes only `threading.Event.is_set` as
   59:     a callable and there is no hook on the thread that calls `Event.set`.
   60:     """
   61: 
   62:     def __init__(self, is_cancelled: Callable[[], bool] | None = None):
   63:         self._probe = is_cancelled
   64:         self._callbacks: list[Callable[[], None]] = []
   65:         self._lock = threading.Lock()
   66:         self._fired = False
   67:         self._latched = False
   68: 
   69:     def is_cancelled(self) -> bool:
   70:         if self._latched:
   71:             return True
   72:         if self._probe is None:
   73:             return False
   74:         try:
   75:             flagged = bool(self._probe())
   76:         except Exception as exc:  # a broken probe must not fail the invocation
   77:             logger.warning("[invocation] cancellation probe raised: {}", exc)
   78:             return False
   79:         if flagged:
   80:             # Latch: cancellation is monotonic, and re-probing after the
   81:             # scheduler has torn the event down must not un-cancel the call.
   82:             self._latched = True
   83:             self._fire()
   84:         return flagged
   85: 
   86:     def raise_if_cancelled(self) -> None:
   87:         if self.is_cancelled():
   88:             raise ProviderCancelled()
   89: 
   90:     def on_cancel(self, callback: Callable[[], None]) -> None:
   91:         """Register a best-effort, idempotent cancellation callback."""
   92:         if not callable(callback):
   93:             return
   94:         with self._lock:
   95:             already = self._fired
   96:             if not already:
   97:                 self._callbacks.append(callback)
   98:         if already:
   99:             self._run(callback)
  100: 
  101:     def _fire(self) -> None:
  102:         with self._lock:
  103:             if self._fired:
  104:                 return
  105:             self._fired = True
  106:             pending = list(self._callbacks)
  107:             self._callbacks.clear()
  108:         for callback in pending:
  109:             self._run(callback)
  110: 
  111:     @staticmethod
  112:     def _run(callback: Callable[[], None]) -> None:
  113:         try:
  114:             callback()
  115:         except Exception as exc:
  116:             # Callbacks must not block or raise; exceptions are logged and
  117:             # swallowed (Â§30.3).
  118:             logger.warning("[invocation] on_cancel callback raised: {}", exc)
  119: 
  120: 
  121: NULL_CANCELLATION = CancellationToken()
