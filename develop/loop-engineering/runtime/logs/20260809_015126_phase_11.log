### studio/shared/providers_common/errors.py
    1: """Provider errors and the stable code catalog â€” step 11.4.
    2: 
    3: Implements contracts.md Â§34. `ProviderError` is the one exception type that
    4: crosses the provider boundary; every other exception is wrapped by
    5: `boundary.wrap_exception()` without ever copying `str(exc)` (Â§34.4).
    6: 
    7: This module is a leaf: it imports only the sanitizer, so `results`,
    8: `invocation`, `jobs`, and `boundary` can all build on it without a cycle. In
    9: particular it does **not** import `studio.workflows.adapters.common` â€”
   10: `as_adapter_error()` constructs the adapter carrier lazily so the provider layer
   11: and the workflow layer never import each other's module (Â§34.4).
   12: """
   13: 
   14: from __future__ import annotations
   15: 
   16: import json
   17: from dataclasses import asdict, dataclass
   18: from typing import Any
   19: 
   20: from studio.shared.providers_common.validation import sanitize_message
   21: 
   22: 
   23: # -- code catalog (contracts.md Â§34.2, frozen) ------------------------------
   24: 
   25: PROVIDER_NOT_FOUND = "PROVIDER_NOT_FOUND"
   26: PROVIDER_UNAVAILABLE = "PROVIDER_UNAVAILABLE"
   27: PROVIDER_NOT_CONFIGURED = "PROVIDER_NOT_CONFIGURED"
   28: PROVIDER_REQUEST_INVALID = "PROVIDER_REQUEST_INVALID"
   29: PROVIDER_RESULT_INVALID = "PROVIDER_RESULT_INVALID"
   30: PROVIDER_AUTH_FAILED = "PROVIDER_AUTH_FAILED"
   31: PROVIDER_RATE_LIMITED = "PROVIDER_RATE_LIMITED"
   32: PROVIDER_QUOTA_EXHAUSTED = "PROVIDER_QUOTA_EXHAUSTED"
   33: PROVIDER_TIMEOUT = "PROVIDER_TIMEOUT"
   34: PROVIDER_TRANSPORT_FAILED = "PROVIDER_TRANSPORT_FAILED"
   35: PROVIDER_RESPONSE_MALFORMED = "PROVIDER_RESPONSE_MALFORMED"
   36: PROVIDER_UNIT_FAILED = "PROVIDER_UNIT_FAILED"
   37: PROVIDER_ARTIFACT_MISSING = "PROVIDER_ARTIFACT_MISSING"
   38: PROVIDER_ARTIFACT_UNMANAGED = "PROVIDER_ARTIFACT_UNMANAGED"
   39: PROVIDER_FAILED = "PROVIDER_FAILED"
   40: CANCELLED = "CANCELLED"
   41: 
   42: # `retryable` is a property of the code, not of the provider: a provider may not
   43: # mark PROVIDER_AUTH_FAILED retryable to force retries (Â§34.3). `None` means
   44: # "per-case" â€” only PROVIDER_UNIT_FAILED, whose caller decides.
   45: RETRYABLE: dict[str, bool | None] = {
   46:     PROVIDER_NOT_FOUND: False,
   47:     PROVIDER_UNAVAILABLE: True,
   48:     PROVIDER_NOT_CONFIGURED: False,
   49:     PROVIDER_REQUEST_INVALID: False,
   50:     PROVIDER_RESULT_INVALID: False,
   51:     PROVIDER_AUTH_FAILED: False,
   52:     PROVIDER_RATE_LIMITED: True,
   53:     PROVIDER_QUOTA_EXHAUSTED: False,
   54:     PROVIDER_TIMEOUT: True,
   55:     PROVIDER_TRANSPORT_FAILED: True,
   56:     PROVIDER_RESPONSE_MALFORMED: True,
   57:     PROVIDER_UNIT_FAILED: None,
   58:     PROVIDER_ARTIFACT_MISSING: False,
   59:     PROVIDER_ARTIFACT_UNMANAGED: False,
   60:     PROVIDER_FAILED: False,
   61:     CANCELLED: False,
   62: }
   63: 
   64: PROVIDER_CODES = frozenset(RETRYABLE)
   65: 
   66: # Provider code -> the Â§7 stable workflow code. The workflow-facing set does not
   67: # grow for provider internals; the finer code travels in `details.provider_code`.
   68: WORKFLOW_CODE = {
   69:     PROVIDER_UNAVAILABLE: "PROVIDER_UNAVAILABLE",
   70:     PROVIDER_NOT_CONFIGURED: "PROVIDER_UNAVAILABLE",
   71:     PROVIDER_NOT_FOUND: "PROVIDER_UNAVAILABLE",
   72:     PROVIDER_TIMEOUT: "POLL_TIMEOUT",
   73:     CANCELLED: "CANCELLED",
   74:     PROVIDER_ARTIFACT_MISSING: "ARTIFACT_MISSING",
   75:     PROVIDER_ARTIFACT_UNMANAGED: "ARTIFACT_MISSING",
   76: }
   77: DEFAULT_WORKFLOW_CODE = "NODE_EXECUTION_FAILED"
   78: 
   79: MESSAGE_MAX = 300
   80: DETAILS_MAX_BYTES = 4096
   81: 
   82: # Generic, per-domain replacements for a wrapped unknown exception (Â§34.4 rule 2).
   83: # The original `str(exc)` is never one of these.
   84: _GENERIC_MESSAGE = {
   85:     "script": "The script provider failed while generating the story.",
   86:     "scene_blueprint": "The scene blueprint provider failed while planning scenes.",
   87:     "tts": "The speech provider failed while synthesizing audio.",
   88:     "storyboard": "The storyboard provider failed while generating images.",
   89:     "animator": "The animator provider failed while generating assets.",
   90: }
   91: _GENERIC_FALLBACK = "The provider failed while handling the request."
   92: 
   93: _RECOVERY = {
   94:     PROVIDER_NOT_CONFIGURED: "Open provider settings and fill in the required fields.",
   95:     PROVIDER_AUTH_FAILED: "Check the provider credentials in settings, then retry.",
   96:     PROVIDER_QUOTA_EXHAUSTED: "Top up the provider account or choose another provider.",
   97:     PROVIDER_RATE_LIMITED: "Wait for the provider rate limit to reset, then retry.",
   98:     PROVIDER_TIMEOUT: "Retry the node, or choose a faster provider.",
   99:     CANCELLED: "Start a new run when ready.",
  100: }
  101: _DEFAULT_RECOVERY = "Review the provider settings and inputs, then retry the node."
  102: 
  103: 
  104: def is_retryable(code: str, *, default: bool = False) -> bool:
  105:     """Retryability for a code, from the frozen table (Â§34.3)."""
  106:     value = RETRYABLE.get(code, default)
  107:     return default if value is None else value
  108: 
  109: 
  110: def workflow_code(code: str) -> str:
  111:     """Map a provider code onto the Â§7 stable workflow code."""
  112:     return WORKFLOW_CODE.get(code, DEFAULT_WORKFLOW_CODE)
  113: 
  114: 
  115: def generic_message(domain: str) -> str:
  116:     """The per-domain sentence used when an unknown exception is wrapped."""
  117:     return _GENERIC_MESSAGE.get(domain, _GENERIC_FALLBACK)
  118: 
  119: 
  120: def _safe_details(details: Any) -> dict | None:
  121:     """JSON-only, redacted, size-capped `details` (Â§34.1).
  122: 
  123:     Anything that will not serialize, or that exceeds 4 KiB, is dropped whole
  124:     rather than truncated into an unparseable fragment.
  125:     """
  126:     if details is None:
  127:         return None
  128:     if not isinstance(details, dict):
  129:         return None
  130:     from studio.workflows.redaction import redact
  131: 
  132:     scrubbed = redact(details)
  133:     try:
  134:         encoded = json.dumps(scrubbed, ensure_ascii=False, allow_nan=False)
  135:     except (TypeError, ValueError):
  136:         return None
  137:     if len(encoded.encode("utf-8")) > DETAILS_MAX_BYTES:
  138:         return {"truncated": True}
  139:     return scrubbed
  140: 
  141: 
  142: def _clip(text: object, limit: int) -> str:
  143:     message = sanitize_message(text)
  144:     if len(message) > limit:
  145:         message = message[: limit - 1].rstrip() + "\u2026"
  146:     return message
  147: 
  148: 
  149: class ProviderError(Exception):
  150:     """A provider failure that is safe to persist, log, and serialize (Â§34.1).
  151: 
  152:     `message` is sanitized on construction, so there is no way to build one that
  153:     leaks a path or a `key=value` secret â€” including through subclasses.
  154:     """
  155: 
  156:     default_code = PROVIDER_FAILED
  157: 
  158:     def __init__(
  159:         self,
  160:         code: str = "",
  161:         message: str = "",
  162:         *,
  163:         retryable: bool | None = None,
  164:         domain: str = "",
  165:         provider_id: str = "",
  166:         details: Any = None,
  167:         recovery_suggestion: str | None = None,
  168:         unit_index: int | None = None,
  169:         cause_type: str | None = None,
  170:     ):
  171:         self.code = code or self.default_code
  172:         self.message = _clip(message, MESSAGE_MAX) or generic_message(domain)
  173:         self.retryable = (
  174:             is_retryable(self.code) if retryable is None else bool(retryable)
  175:         )
  176:         self.domain = domain
  177:         self.provider_id = provider_id
  178:         self.details = _safe_details(details)
  179:         self.recovery_suggestion = recovery_suggestion or _RECOVERY.get(
  180:             self.code, _DEFAULT_RECOVERY
  181:         )
  182:         self.unit_index = unit_index
  183:         # The class name only â€” never the cause's message (Â§34.1).
  184:         self.cause_type = cause_type
  185:         super().__init__(self.message)
  186: 
  187:     @property
  188:     def workflow_code(self) -> str:
  189:         return workflow_code(self.code)
  190: 
  191:     def to_payload(self) -> dict:
  192:         """The `ProviderErrorPayload` JSON form (Â§34.1)."""
  193:         payload = {
  194:             "code": self.code,
  195:             "message": self.message,
  196:             "retryable": self.retryable,
  197:         }
  198:         if self.domain:
  199:             payload["domain"] = self.domain
  200:         if self.provider_id:
  201:             payload["provider_id"] = self.provider_id
  202:         if self.details is not None:
  203:             payload["details"] = self.details
  204:         if self.recovery_suggestion:
  205:             payload["recovery_suggestion"] = self.recovery_suggestion
  206:         if self.unit_index is not None:
  207:             payload["unit_index"] = self.unit_index
  208:         if self.cause_type:
  209:             payload["cause_type"] = self.cause_type
  210:         return payload
  211: 
  212:     def as_adapter_error(self):
  213:         """Convert to the adapterâ†’scheduler carrier (Â§34.4).
  214: 
  215:         `AdapterError` is not replaced by `ProviderError`; this is the one
  216:         mapping between the two layers, and it is imported lazily so neither
  217:         module depends on the other.
  218:         """
  219:         from studio.workflows.adapters.common import AdapterError
  220: 
  221:         details = dict(self.details or {})
  222:         # The workflow code is coarser than the provider code, so the precise
  223:         # one travels in details and a UI can still tell auth from malformed.
  224:         details.setdefault("provider_code", self.code)
  225:         details.setdefault("retryable", self.retryable)
  226:         if self.provider_id:
  227:             details.setdefault("provider_id", self.provider_id)
  228:         if self.unit_index is not None:
  229:             details.setdefault("unit_index", self.unit_index)
  230:         error = AdapterError(self.workflow_code, self.message, details=details)
  231:         error.retryable = self.retryable
  232:         error.recovery_suggestion = self.recovery_suggestion
  233:         return error
  234: 
  235:     @classmethod
  236:     def from_payload(cls, payload: dict) -> "ProviderError":
  237:         """Rebuild from a persisted `ProviderErrorPayload`."""
  238:         data = dict(payload or {})
  239:         code = data.get("code") or PROVIDER_FAILED
  240:         error_cls = ProviderCancelled if code == CANCELLED else cls
  241:         return error_cls(
  242:             code,
  243:             data.get("message", ""),
  244:             retryable=data.get("retryable"),
  245:             domain=data.get("domain", ""),
  246:             provider_id=data.get("provider_id", ""),
  247:             details=data.get("details"),
  248:             recovery_suggestion=data.get("recovery_suggestion"),
  249:             unit_index=data.get("unit_index"),
  250:             cause_type=data.get("cause_type"),
  251:         )
  252: 
  253: 
  254: class ProviderCancelled(ProviderError):
  255:     """Cooperative cancellation. The one subclass with fixed semantics (Â§34.1).
  256: 
  257:     Never a failure and never retried: it maps to workflow `CANCELLED` and node
  258:     status `cancelled`, which is the only code the scheduler recognizes (Â§35.1).
  259:     """
  260: 
  261:     default_code = CANCELLED
  262: 
  263:     def __init__(self, message: str = "Execution was cancelled", **kwargs):
  264:         kwargs.pop("code", None)
  265:         kwargs["retryable"] = False
  266:         super().__init__(CANCELLED, message, **kwargs)
  267: 
  268: 
  269: @dataclass(frozen=True)
  270: class ProviderErrorPayload:
  271:     """Typed view of the JSON error form carried by jobs and units (Â§34.1)."""
  272: 
  273:     code: str
  274:     message: str
  275:     retryable: bool = False
  276:     unit_index: int | None = None
  277:     details: dict | None = None
  278:     cause_type: str | None = None
  279:     recovery_suggestion: str | None = None
  280:     domain: str = ""
  281:     provider_id: str = ""
  282: 
  283:     @classmethod
  284:     def from_error(cls, error: ProviderError) -> "ProviderErrorPayload":
  285:         return cls(
  286:             code=error.code,
  287:             message=error.message,
  288:             retryable=error.retryable,
  289:             unit_index=error.unit_index,
  290:             details=error.details,
  291:             cause_type=error.cause_type,
  292:             recovery_suggestion=error.recovery_suggestion,
  293:             domain=error.domain,
  294:             provider_id=error.provider_id,
  295:         )
  296: 
  297:     def as_error(self) -> ProviderError:
  298:         """Rebuild the exception, re-running every Â§34.1 safety rule."""
  299:         return ProviderError.from_payload(asdict(self))
  300: 
  301:     def to_dict(self) -> dict:
  302:         return self.as_error().to_payload()
  303: 
  304: 
  305: __all__ = [
  306:     "CANCELLED",
  307:     "DEFAULT_WORKFLOW_CODE",
  308:     "DETAILS_MAX_BYTES",
  309:     "MESSAGE_MAX",
  310:     "PROVIDER_ARTIFACT_MISSING",
  311:     "PROVIDER_ARTIFACT_UNMANAGED",
  312:     "PROVIDER_AUTH_FAILED",
  313:     "PROVIDER_CODES",
  314:     "PROVIDER_FAILED",
  315:     "PROVIDER_NOT_CONFIGURED",
  316:     "PROVIDER_NOT_FOUND",
  317:     "PROVIDER_QUOTA_EXHAUSTED",
  318:     "PROVIDER_RATE_LIMITED",
  319:     "PROVIDER_REQUEST_INVALID",
  320:     "PROVIDER_RESPONSE_MALFORMED",
  321:     "PROVIDER_RESULT_INVALID",
  322:     "PROVIDER_TIMEOUT",
  323:     "PROVIDER_TRANSPORT_FAILED",
  324:     "PROVIDER_UNAVAILABLE",
  325:     "PROVIDER_UNIT_FAILED",
  326:     "RETRYABLE",
  327:     "WORKFLOW_CODE",
  328:     "ProviderCancelled",
  329:     "ProviderError",
  330:     "ProviderErrorPayload",
  331:     "generic_message",
  332:     "is_retryable",
  333:     "workflow_code",
  334: ]
