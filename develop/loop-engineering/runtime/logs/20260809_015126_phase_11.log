  157: @dataclass(frozen=True)
  158: class UnitResult:
  159:     """One requested unit of a multi-unit domain.
  160: 
  161:     Media-neutral: it replaces the storyboard `SceneResult` (`image_url` /
  162:     `image_path`) and the animator one (`video_url` / `video_path`) with the
  163:     single shape both domains produce (Â§33.1).
  164:     """
  165: 
  166:     unit_index: int
  167:     state: str = UNIT_SUCCEEDED
  168:     artifact_refs: tuple[str, ...] = ()
  169:     metadata: Mapping[str, Any] = field(default_factory=dict)
  170:     error: ProviderErrorPayload | None = None
  171: 
  172:     def to_dict(self) -> dict:
  173:         payload = {
  174:             "unit_index": self.unit_index,
  175:             "state": self.state,
  176:             "artifact_refs": list(self.artifact_refs),
  177:             "metadata": dict(self.metadata),
  178:         }
  179:         if self.error is not None:
  180:             payload["error"] = self.error.to_dict()
  181:         return payload
  182: 
  183:     @classmethod
  184:     def from_dict(cls, data: Mapping[str, Any]) -> "UnitResult":
  185:         error = data.get("error")
  186:         return cls(
  187:             unit_index=int(data.get("unit_index", 0)),
  188:             state=str(data.get("state", UNIT_SUCCEEDED)),
  189:             artifact_refs=tuple(dedupe_refs(data.get("artifact_refs") or ())),
  190:             metadata=dict(data.get("metadata") or {}),
  191:             error=(
  192:                 ProviderErrorPayload.from_error(ProviderError.from_payload(error))
  193:                 if isinstance(error, Mapping)
  194:                 else None
  195:             ),
  196:         )
  197: 
  198: 
  199: def derive_status(units: Iterable[UnitResult]) -> str:
  200:     """Envelope status from unit states â€” derived, never provider-declared.
  201: 
  202:     Â§31.5 rule 3, in its frozen precedence order. Cancellation is checked first
  203:     so a cancellation arriving after one completed scene is not misreported as
  204:     ordinary partial success. `"cancelled"` is returned as a distinct value: the
  205:     caller raises `ProviderCancelled` rather than building an envelope.
  206:     """
  207:     units = list(units)
  208:     if not units:
  209:         return SUCCEEDED
  210:     states = [unit.state for unit in units]
  211:     if UNIT_CANCELLED in states and UNIT_FAILED not in states:
  212:         return UNIT_CANCELLED
  213:     if all(state == UNIT_SUCCEEDED for state in states):
  214:         return SUCCEEDED
  215:     if any(state == UNIT_SUCCEEDED for state in states):
  216:         return PARTIAL
  217:     return FAILED
  218: 
  219: 
  220: # -- the envelope (contracts.md Â§31.1) --------------------------------------
  221: 
  222: _ENVELOPE_KEYS = frozenset({
  223:     "result_version", "domain", "provider_id", "provider_version", "contract_version",
  224:     "status", "payload", "artifact_refs", "units", "metadata", "warnings",
  225:     "provenance", "job",
  226: })
  227: 
  228: 
  229: @dataclass
  230: class ProviderResult:
  231:     """One envelope for all five domains (Â§31.1, `result_version: 1`)."""
  232: 
  233:     domain: str = ""
  234:     provider_id: str = ""
  235:     provider_version: str = ""
  236:     contract_version: int = 1
  237:     status: str = SUCCEEDED
  238:     payload: Mapping[str, Any] = field(default_factory=dict)
  239:     artifact_refs: list[str] = field(default_factory=list)
  240:     units: list[UnitResult] = field(default_factory=list)
  241:     metadata: Mapping[str, Any] = field(default_factory=dict)
  242:     warnings: list[dict] = field(default_factory=list)
  243:     provenance: Provenance = field(default_factory=Provenance)
  244:     job: Any = None
  245:     result_version: int = RESULT_VERSION
  246: 
  247:     def to_dict(self) -> dict:
  248:         return {
  249:             "result_version": self.result_version,
  250:             "domain": self.domain,
  251:             "provider_id": self.provider_id,
  252:             "provider_version": self.provider_version,
  253:             "contract_version": self.contract_version,
  254:             "status": self.status,
  255:             "payload": dict(self.payload),
  256:             "artifact_refs": list(self.artifact_refs),
  257:             "units": [unit.to_dict() for unit in self.units],
  258:             "metadata": dict(self.metadata),
  259:             "warnings": list(self.warnings),
  260:             "provenance": self.provenance.to_dict(),
  261:             "job": self.job.to_dict() if hasattr(self.job, "to_dict") else self.job,
  262:         }
  263: 
  264:     def warn(self, code: str, message: str, unit_index: int | None = None) -> None:
  265:         """Record a non-fatal warning. A warning never changes `status` (Â§31.4)."""
  266:         if len(self.warnings) >= WARNINGS_MAX:
  267:             return
  268:         entry = {"code": str(code), "message": sanitize_message(message)[:WARNING_MESSAGE_MAX]}
  269:         if unit_index is not None:
  270:             entry["unit_index"] = int(unit_index)
  271:         self.warnings.append(entry)
  272: 
  273: 
  274: def coerce_result(
  275:     returned: Any,
  276:     *,
  277:     domain: str,
  278:     provider_id: str,
  279:     provider_version: str = "",
  280:     contract_version: int = 1,
  281: ) -> ProviderResult:
  282:     """Turn what a provider returned into a validated envelope (Â§31.1).
  283: 
  284:     Unknown top-level keys are dropped with a WARN, mirroring the manifest policy
  285:     â€” a provider written against a newer build must not fail on an older one. An
  286:     invalid *known* field is `PROVIDER_RESULT_INVALID`.
  287: 
  288:     `domain` and `provider_id` are overwritten from the platform's own values, so
  289:     a provider cannot impersonate another.
  290:     """
  291:     if isinstance(returned, ProviderResult):
  292:         result = returned
  293:     elif isinstance(returned, Mapping):
  294:         result = _from_mapping(returned, provider_id=provider_id)
  295:     else:
  296:         raise ProviderError(
  297:             PROVIDER_RESULT_INVALID,
  298:             "Provider returned a non-object result",
  299:             domain=domain,
  300:             provider_id=provider_id,
  301:         )
  302: 
  303:     result.domain = domain
  304:     result.provider_id = provider_id
  305:     result.provider_version = provider_version
  306:     result.contract_version = contract_version
  307:     if result.result_version != RESULT_VERSION:
  308:         raise ProviderError(
  309:             PROVIDER_RESULT_INVALID,
  310:             f"Unsupported result_version {result.result_version}",
  311:             domain=domain,
  312:             provider_id=provider_id,
  313:         )
  314: 
  315:     result.artifact_refs = dedupe_refs(result.artifact_refs)
  316:     result.metadata = _bound_metadata(result.metadata)
  317:     result.warnings = _bound_warnings(result.warnings)
  318: 
  319:     if result.units:
  320:         derived = derive_status(result.units)
  321:         if derived == UNIT_CANCELLED:
  322:             from studio.shared.providers_common.errors import ProviderCancelled
  323: 
  324:             raise ProviderCancelled(domain=domain, provider_id=provider_id)
  325:         result.status = derived
  326:         _check_unit_rules(result, domain, provider_id)
  327:         # Envelope refs are the ordered union of unit refs plus domain-level
  328:         # artifacts; no unit-level ref may be missing from it (Â§31.5 rule 4).
  329:         result.artifact_refs = dedupe_refs(
  330:             [ref for unit in result.units for ref in unit.artifact_refs]
  331:             + result.artifact_refs
  332:         )
  333:     elif result.status not in ENVELOPE_STATES:
  334:         raise ProviderError(
  335:             PROVIDER_RESULT_INVALID,
  336:             f"Unknown result status {result.status!r}",
  337:             domain=domain,
  338:             provider_id=provider_id,
  339:         )
  340: 
  341:     if result.status == FAILED:
  342:         # A returned `failed` is equivalent to raising, and is converted to one
  343:         # at the boundary; providers should raise (Â§31.1).
  344:         raise ProviderError(
  345:             PROVIDER_RESULT_INVALID if not result.units else "PROVIDER_UNIT_FAILED",
  346:             _failed_message(result),
  347:             domain=domain,
  348:             provider_id=provider_id,
  349:             details={"units": [unit.to_dict() for unit in result.units]},
  350:         )
  351: 
  352:     problems = validate_egress(result.to_dict())
  353:     if problems:
  354:         raise ProviderError(
  355:             PROVIDER_RESULT_INVALID,
  356:             f"Result rejected at the egress boundary: {problems[0]}",
  357:             domain=domain,
  358:             provider_id=provider_id,
  359:             details={"violations": problems[:10]},
  360:         )
  361:     return result
  362: 
  363: 
  364: def _failed_message(result: ProviderResult) -> str:
  365:     if result.units:
  366:         return f"All {len(result.units)} units failed"
  367:     return "Provider reported a failed result"
  368: 
  369: 
  370: def _from_mapping(data: Mapping[str, Any], *, provider_id: str) -> ProviderResult:
  371:     unknown = sorted(set(data) - _ENVELOPE_KEYS)
  372:     for key in unknown:
  373:         logger.warning(
  374:             "[results] {}: unknown result key dropped: {}", provider_id, key
  375:         )
  376:     provenance = data.get("provenance")
  377:     job = data.get("job")
  378:     return ProviderResult(
  379:         status=str(data.get("status", SUCCEEDED)),
  380:         payload=dict(data.get("payload") or {}),
  381:         artifact_refs=list(data.get("artifact_refs") or []),
  382:         units=[
  383:             UnitResult.from_dict(unit) if isinstance(unit, Mapping) else unit
  384:             for unit in (data.get("units") or [])
  385:         ],
  386:         metadata=dict(data.get("metadata") or {}),
  387:         warnings=list(data.get("warnings") or []),
  388:         provenance=(
  389:             Provenance(**provenance) if isinstance(provenance, Mapping) else Provenance()
  390:         ),
  391:         job=job,
  392:         result_version=int(data.get("result_version", RESULT_VERSION)),
  393:     )
  394: 
  395: 
  396: def _bound_metadata(metadata: Mapping[str, Any]) -> dict:
  397:     """Small, flat, JSON-scalar values only (Â§31.1)."""
  398:     bounded: dict[str, Any] = {}
  399:     for key, value in list(dict(metadata or {}).items())[:METADATA_MAX_KEYS]:
  400:         if isinstance(value, str):
  401:             bounded[str(key)] = value[:METADATA_STRING_MAX]
  402:         elif value is None or isinstance(value, (bool, int, float)):
  403:             bounded[str(key)] = value
  404:         else:
  405:             logger.debug("[results] non-scalar metadata dropped: {}", key)
  406:     return bounded
  407: 
  408: 
  409: def _bound_warnings(warnings: Iterable[Any]) -> list[dict]:
  410:     bounded: list[dict] = []
  411:     for entry in list(warnings or [])[:WARNINGS_MAX]:
  412:         if not isinstance(entry, Mapping):
  413:             continue
  414:         item = {
  415:             "code": str(entry.get("code", "PROVIDER_WARNING")),
  416:             "message": sanitize_message(entry.get("message", ""))[:WARNING_MESSAGE_MAX],
  417:         }
  418:         if entry.get("unit_index") is not None:
  419:             item["unit_index"] = int(entry["unit_index"])
  420:         bounded.append(item)
  421:     return bounded
  422: 
  423: 
  424: def _check_unit_rules(result: ProviderResult, domain: str, provider_id: str) -> None:
  425:     """Â§31.5 rules 1, 2, and 5."""
  426:     seen: set[int] = set()
  427:     for unit in result.units:
  428:         if unit.state not in UNIT_STATES:
  429:             raise ProviderError(
  430:                 PROVIDER_RESULT_INVALID,
  431:                 f"Unknown unit state {unit.state!r}",
  432:                 domain=domain, provider_id=provider_id,
  433:             )
  434:         if unit.unit_index in seen:
  435:             raise ProviderError(
  436:                 PROVIDER_RESULT_INVALID,
  437:                 f"Duplicate unit_index {unit.unit_index}",
  438:                 domain=domain, provider_id=provider_id,
  439:             )
  440:         seen.add(unit.unit_index)
  441:         if unit.state == UNIT_FAILED and unit.error is None:
  442:             raise ProviderError(
  443:                 PROVIDER_RESULT_INVALID,
  444:                 f"Failed unit {unit.unit_index} carries no error",
  445:                 domain=domain, provider_id=provider_id,
  446:             )
