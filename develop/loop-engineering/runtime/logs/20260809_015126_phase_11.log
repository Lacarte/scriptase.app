 263:     def _rebind_new_runtimes(self, snapshot: CatalogSnapshot) -> None:
 264:         """Bind runtimes for providers that appeared after startup."""
 265:         if self._runtime_target is None:
 266:             return
 267:         app, sock = self._runtime_target
 268:         for provider in snapshot.providers.values():
 269:             self._bind_runtime(provider, app, sock)
