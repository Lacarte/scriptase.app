 449: # -- egress validator (contracts.md Â§36) ------------------------------------
 450: 
 451: # A sensitive key is a leak *unless* it holds nothing but a redaction marker.
 452: # `provenance.resolved_settings_redacted` is the one sanctioned echo of settings
 453: # (Â§31.3) and it necessarily keeps its original key names, so the rule has to be
 454: # about the value, not the key.
 455: _REDACTION_MARKERS = frozenset({"***", "[REDACTED]", ""})
 456: 
 457: 
 458: def _is_redacted(value: Any) -> bool:
 459:     return isinstance(value, str) and value in _REDACTION_MARKERS
 460: 
 461: 
 462: def validate_egress(value: Any, *, path: str = "", _depth: int = 0) -> list[str]:
 463:     """Reject the four prohibited classes, mechanically (Â§31.2, Â§36).
 464: 
 465:     Returns a list of human-readable violations; empty means the value may cross
 466:     the boundary. This runs over every `ProviderResult` and over every recorded
 467:     `expected_result.json` fixture, so a leak fails a test rather than a review.
 468:     """
 469:     from studio.workflows.redaction import is_sensitive_key
 470: 
 471:     problems: list[str] = []
 472:     if _depth > 12:
 473:         return [f"{path or '<root>'}: nesting is too deep"]
 474: 
 475:     if isinstance(value, Mapping):
 476:         for key, child in value.items():
 477:             where = f"{path}.{key}" if path else str(key)
 478:             if is_sensitive_key(key) and not _is_redacted(child):
 479:                 problems.append(f"{where}: sensitive key is not allowed in a result")
 480:                 continue
 481:             problems.extend(validate_egress(child, path=where, _depth=_depth + 1))
 482:         return problems
 483: 
 484:     if isinstance(value, (list, tuple)):
 485:         for index, child in enumerate(value):
 486:             problems.extend(
 487:                 validate_egress(child, path=f"{path}[{index}]", _depth=_depth + 1)
 488:             )
 489:         return problems
 490: 
 491:     if isinstance(value, bytes):
 492:         return [f"{path or '<root>'}: bytes are not allowed in a result"]
 493: 
 494:     if isinstance(value, str):
 495:         if _ABSOLUTE_PATH_RE.match(value.strip()):
 496:             return [f"{path or '<root>'}: absolute filesystem path"]
 497:         return problems
 498: 
 499:     if value is None or isinstance(value, (bool, int, float)):
 500:         return problems
 501: 
 502:     return [f"{path or '<root>'}: {type(value).__name__} is not JSON-serializable"]
 503: 
 504: 
 505: def assert_json_safe(value: Any) -> None:
 506:     """Raise `PROVIDER_RESULT_INVALID` unless the value round-trips as JSON."""
 507:     try:
 508:         json.dumps(value, ensure_ascii=False, allow_nan=False)
 509:     except (TypeError, ValueError) as exc:
 510:         raise ProviderError(
 511:             PROVIDER_RESULT_INVALID, f"Result is not JSON-serializable: {exc}"
 512:         ) from None
 513: 
 514: 
