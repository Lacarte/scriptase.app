 383: def _save_settings_document(data, stored=None):
 384:     """Validate, restore sentinel secrets, and persist a settings document."""
 385:     issues = settings_manager.validate_settings(data)
 386:     if any(i["severity"] == "error" for i in issues):
 387:         return _error("SETTINGS_INVALID", "Invalid settings", 400, {"issues": issues})
 388:     if stored is None:
 389:         stored = settings_manager.load_settings()
 390:     settings_manager.save_settings(
 391:         settings_manager.restore_redacted_secrets(stored, data)
 392:     )
 393:     return jsonify({"ok": True, "issues": issues})
