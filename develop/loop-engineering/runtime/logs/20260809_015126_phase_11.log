  142:             "contract_version": self.contract_version,
  143:             "settings_version": self.settings_version,
  144:             "resolved_settings_redacted": dict(self.resolved_settings_redacted),
  145:             "options": dict(self.options),
  146:             "selection_reason": self.selection_reason,
  147:             "started_at": self.started_at,
