   72: def tts_metadata_to_result(
   73:     metadata: Mapping[str, Any],
   74:     *,
   75:     audio_ref: str,
   76:     manifest_ref: str = "",
   77:     provider_id: str = "",
   78:     provider_version: str = "",
   79: ) -> ProviderResult:
   80:     """Today's `_step_tts` return -> a Â§32.3 `TTSResultPayload` envelope."""
   81:     data = dict(metadata or {})
   82:     payload = {
   83:         "audio_ref": audio_ref,
   84:         "duration_seconds": float(data.get("duration_seconds") or 0.0),
   85:         "sample_rate": int(data.get("sample_rate") or 0),
   86:         "format": "wav",
   87:         "voice": str(data.get("voice") or ""),
   88:         "characters_billed": data.get("characters_billed"),
   89:     }
   90:     leftover = {
   91:         key: value
   92:         for key, value in data.items()
   93:         if key not in TTS_PAYLOAD_KEYS and key not in TTS_DROPPED_KEYS
   94:     }
   95:     job_meta = data.get("job_meta") or {}
   96:     return ProviderResult(
   97:         domain="tts",
   98:         provider_id=provider_id or str(data.get("provider") or ""),
   99:         provider_version=provider_version or str(job_meta.get("provider_version") or ""),
  100:         payload=payload,
  101:         artifact_refs=dedupe_refs([audio_ref, manifest_ref]),
  102:         metadata=leftover,
  103:         provenance=_provenance_from_job_meta(job_meta, domain="tts"),
  104:     )
