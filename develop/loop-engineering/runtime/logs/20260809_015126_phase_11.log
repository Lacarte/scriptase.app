   57: # -- artifact references (contracts.md Â§30.2) -------------------------------
   58: 
   59: 
   60: def _managed_root(output_dir: str | None) -> str:
   61:     """The managed root, read at call time so a test can relocate OUTPUT_DIR."""
   62:     return os.path.abspath(output_dir or OUTPUT_DIR)
   63: 
   64: 
   65: def normalize_ref(path: str, *, output_dir: str | None = None) -> str:
   66:     """An absolute path becomes the relative POSIX ref that leaves a provider.
   67: 
   68:     The same rule `adapters.common.artifact_ref` applies, raised as a
   69:     `ProviderError` rather than an `AdapterError` so the provider layer does not
   70:     import the workflow layer.
   71:     """
   72:     absolute = os.path.abspath(path)
   73:     root = _managed_root(output_dir)
   74:     try:
   75:         if os.path.commonpath([root, absolute]) != root:
   76:             raise ValueError
   77:     except ValueError as exc:
   78:         raise ProviderError(
   79:             PROVIDER_ARTIFACT_UNMANAGED,
   80:             "Artifact is outside the managed output directory",
   81:         ) from exc
   82:     return os.path.relpath(absolute, root).replace("\\", "/")
   83: 
   84: 
   85: def resolve_ref(ref: str, *, output_dir: str | None = None) -> str:
   86:     """Resolve a relative ref back to an absolute path (Â§30.2).
   87: 
   88:     The one shared helper every consumer uses, so the deprecated absolute keys on
   89:     TTS port payloads have a replacement to migrate onto in 15.3.
   90:     """
   91:     from studio.security import safe_join
   92: 
   93:     if not isinstance(ref, str) or not ref.strip():
   94:         raise ProviderError(PROVIDER_RESULT_INVALID, "Empty artifact reference")
   95:     if _ABSOLUTE_PATH_RE.match(ref):
   96:         raise ProviderError(
   97:             PROVIDER_ARTIFACT_UNMANAGED, "Artifact reference must be relative"
   98:         )
   99:     return safe_join(_managed_root(output_dir), ref)
  100: 
  101: 
  102: def dedupe_refs(refs: Iterable[Any]) -> list[str]:
  103:     """Deduplicated, order-stable, POSIX-normalized refs (Â§31.1)."""
  104:     seen: list[str] = []
  105:     for ref in refs or ():
  106:         if not isinstance(ref, str):
  107:             continue
  108:         candidate = ref.replace("\\", "/").strip()
  109:         if candidate and candidate not in seen:
  110:             seen.append(candidate)
  111:     return seen
  112: 
