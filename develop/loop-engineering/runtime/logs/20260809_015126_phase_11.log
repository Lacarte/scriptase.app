   95:         "latency_ms": health.latency_ms,
   96:         "message": health.message,
   97:         # `details` is provider-authored and may echo a submitted secret (Â§21.5).
   98:         "details": settings_manager.redact_settings(health.details or {}),
   99:     }
  100: 
