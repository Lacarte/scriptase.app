  140: 
  141: # `scene_statuses` values use these strings today; `done` appears in the legacy
  142: # status route's readiness count (`storyboard/routes.py:390`).
  143: _STORYBOARD_UNIT_STATE = {
  144:     "ready": UNIT_SUCCEEDED,
  145:     "done": UNIT_SUCCEEDED,
  146:     "error": UNIT_FAILED,
  147:     "pending": UNIT_SKIPPED,
