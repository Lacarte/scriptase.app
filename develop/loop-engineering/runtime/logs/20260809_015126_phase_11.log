 352:     # -- construction (contracts.md Â§21.1) ---------------------------------
 353: 
 354:     @property
 355:     def create_callable(self) -> Any:
 356:         """The zero-argument factory, or `None` when the provider cannot be built."""
 357:         for name in self.FACTORY_NAMES:
 358:             fn = self._resolve(name)
 359:             if callable(fn):
 360:                 return fn
 361:         return None
 362: 
 363:     @property
 364:     def constructed(self) -> bool:
 365:         return self._instance is not None
 366: 
 367:     @property
 368:     def create_error(self) -> str | None:
 369:         return self._create_error
 370: 
 371:     @property
 372:     def construction_seq(self) -> int | None:
 373:         """Monotonic construction order, used to shut down in reverse."""
 374:         return self._construction_seq
 375: 
 376:     def create(self) -> Any:
 377:         """Construct the provider at most once per process.
 378: 
 379:         Never called at import time or during discovery, and never while the
 380:         registry lock is held: the lock taken here belongs to this instance alone.
 381:         """
 382:         if self._instance is not None:
 383:             return self._instance
 384:         with self._create_lock:
 385:             if self._instance is not None:
 386:                 return self._instance
 387:             if self._retired:
 388:                 raise ProviderConstructionError(self.domain, self.id, "provider was retired")
 389:             if self._create_error is not None:
 390:                 raise ProviderConstructionError(self.domain, self.id, self._create_error)
 391:             factory = self.create_callable
 392:             if factory is None:
 393:                 self._create_error = "no create() factory found in the provider package"
 394:                 self.add_warning(self._create_error)
 395:                 raise ProviderConstructionError(self.domain, self.id, self._create_error)
 396:             try:
 397:                 instance = factory()
 398:             except Exception as e:
 399:                 self._create_error = v.sanitize_message(f"create() raised: {e}")
 400:                 self.add_warning(self._create_error)
 401:                 logger.error("[registry] create() failed for {}/{}: {}", self.domain, self.id, e)
 402:                 raise ProviderConstructionError(self.domain, self.id, self._create_error) from None
 403:             if instance is None:
 404:                 self._create_error = "create() returned None"
 405:                 self.add_warning(self._create_error)
 406:                 raise ProviderConstructionError(self.domain, self.id, self._create_error)
 407:             self._instance = instance
 408:             self._construction_seq = next(_construction_counter)
 409:             logger.info("[registry] Constructed provider '{}' in {}", self.id, self.domain)
 410:             return instance
 411: 
 412:     # -- invocation leases (contracts.md Â§21.2 item 6) ---------------------
 413: 
 414:     @contextmanager
 415:     def lease(self):
 416:         """Hold the provider open for one invocation.
 417: 
 418:         A snapshot swap may drop this provider while a request is still using it;
 419:         `retire()` waits for outstanding leases before calling `shutdown()`.
 420:         """
 421:         with self._lease_state:
 422:             if self._retired:
 423:                 raise ProviderConstructionError(self.domain, self.id, "provider was retired")
 424:             self._leases += 1
 425:         try:
 426:             yield self
 427:         finally:
 428:             with self._lease_state:
 429:                 self._leases -= 1
 430:                 if self._leases <= 0:
 431:                     self._lease_state.notify_all()
 432: 
 433:     @property
 434:     def active_leases(self) -> int:
 435:         with self._lease_state:
 436:             return self._leases
 437: 
 438:     def retire(self, timeout: float = 5.0) -> None:
 439:         """Stop new leases, wait for in-flight ones, then shut down."""
 440:         with self._lease_state:
 441:             self._retired = True
 442:             if self._leases > 0:
 443:                 drained = self._lease_state.wait_for(lambda: self._leases <= 0, timeout=timeout)
 444:                 if not drained:
 445:                     logger.warning(
 446:                         "[registry] {}/{}: {} lease(s) still active after {}s; shutting down anyway",
 447:                         self.domain, self.id, self._leases, timeout,
 448:                     )
 449:         self.shutdown()
 450: 
 451:     def shutdown(self) -> None:
 452:         """Release a constructed provider. Best-effort and idempotent (Â§21.1)."""
 453:         with self._create_lock:
 454:             if self._shutdown_done:
 455:                 return
 456:             self._shutdown_done = True
 457:             instance = self._instance
 458:             self._instance = None
 459:         if instance is None:
 460:             return
 461:         hook = getattr(instance, "shutdown", None)
 462:         if not callable(hook):
 463:             return
 464:         try:
 465:             hook()
 466:             logger.debug("[registry] Shut down provider '{}' in {}", self.id, self.domain)
 467:         except Exception as e:
 468:             # Never raised: one provider's teardown may not abort the rest (Â§21.1).
 469:             self.add_warning(f"shutdown() failed: {e}")
 470:             logger.error("[registry] shutdown() failed for {}/{}: {}", self.domain, self.id, e)
 471: 
 472:     # -- serialization (contracts.md Â§25) ----------------------------------
 473: 
 474:     def to_dict(self, settings: dict | None = None) -> dict:
 475:         """Browser-safe projection (contracts.md Â§25).
 476: 
 477:         Never exposes modules, paths, settings values, or the manifest's internal
 478:         `environment` map. `settings` is read only to compute `availability` and
 479:         is never echoed back.
 480:         """
 481:         payload = self.manifest.public_dict()
 482:         payload.update({
 483:             'has_settings': self.settings_schema() is not None,
 484:             'availability': self.availability(settings),
 485:             'warnings': list(self.warnings),
 486:         })
 487:         return payload
