 106: @providers_bp.route("/api/providers", methods=["GET"])
 107: def list_providers():
 108:     """The one versioned catalog: every healthy, unavailable, deprecated, and
 109:     broken provider, grouped by domain.
 110: 
 111:     Registered providers carry an `availability` of `available`,
 112:     `needs_configuration`, or `degraded`; a provider that failed discovery is an
 113:     `excluded[]` entry with its reason code (Â§21.4, Â§21.5).
 114:     """
 115:     denied = _require_loopback()
 116:     if denied:
 117:         return denied
 118:     catalog = build_catalog()
 119:     return jsonify({"catalog_version": catalog_version(catalog), "domains": catalog})
 120: 
 121: 
 122: @providers_bp.route("/api/providers/<domain>", methods=["GET"])
 123: def domain_detail(domain):
 124:     """One domain's slice of the catalog."""
 125:     denied = _require_loopback()
 126:     if denied:
 127:         return denied
 128:     _, err = _resolve_domain(domain)
 129:     if err is not None:
 130:         return err
 131:     return jsonify(build_catalog()[domain])
 132: 
 133: 
 134: @providers_bp.route("/api/providers/<domain>/<provider_id>", methods=["GET"])
 135: def provider_detail(domain, provider_id):
 136:     """One provider's browser-safe metadata, plus whether it is the selection."""
 137:     denied = _require_loopback()
 138:     if denied:
 139:         return denied
 140:     provider, err = _resolve_provider(domain, provider_id)
 141:     if err is not None:
 142:         return err
 143:     stored = settings_manager.get_provider_settings(domain, provider.id)
 144:     payload = provider.to_dict(stored)
 145:     payload["selected"] = selected_providers().get(domain) == provider.id
 146:     return jsonify(payload)
