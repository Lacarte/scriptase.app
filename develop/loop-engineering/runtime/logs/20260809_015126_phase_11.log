 490: @dataclass(frozen=True)
---
 491: class CatalogSnapshot:
 492:     """An immutable, fully validated view of one domain's providers.
 493: 
 494:     Published by a single attribute assignment so readers see either the complete
 495:     old catalog or the complete new one (contracts.md Â§21.2 item 6).
 496:     """
 497: 
 498:     providers: dict[str, ProviderInstance] = field(default_factory=dict)
 499:     aliases: dict[str, str] = field(default_factory=dict)
 500:     exclusions: tuple[ProviderExclusion, ...] = ()
 501: 
 502:     def resolve(self, provider_id: str) -> ProviderInstance | None:
 503:         """Exact id first, then alias â€” a real id always wins (contracts.md Â§19.3)."""
 504:         found = self.providers.get(provider_id)
 505:         if found is not None:
 506:             return found
 507:         canonical = self.aliases.get(provider_id)
 508:         return self.providers.get(canonical) if canonical else None
 509: 
 510: 
 511: EMPTY_SNAPSHOT = CatalogSnapshot()
 512: 
 513: 
 514: class _CatalogBuilder:
 515:     """Accumulates a private snapshot during discovery; nothing is visible yet."""
 516: 
 517:     def __init__(self, domain: str):
 518:         self.domain = domain
 519:         self.providers: dict[str, ProviderInstance] = {}
 520:         self.exclusions: list[ProviderExclusion] = []
 521: 
 522:     def exclude(self, provider_id: str, reason_code: str, message: str) -> None:
 523:         safe = v.sanitize_message(message)
 524:         self.exclusions.append(ProviderExclusion(provider_id, reason_code, safe))
 525:         logger.warning("[registry] [EXCLUDED] {} ({}): {}", provider_id, reason_code, safe)
 526: 
 527:     def add(self, instance: ProviderInstance) -> bool:
 528:         if instance.domain != self.domain:
 529:             self.exclude(
 530:                 instance.id,
 531:                 v.MANIFEST_DOMAIN_MISMATCH,
 532:                 f"declares domain {instance.domain!r}, registered under {self.domain!r}",
 533:             )
 534:             return False
 535:         if instance.id in self.providers:
 536:             # First registration wins; the later one never replaces the incumbent.
 537:             self.exclude(
 538:                 instance.id, v.DUPLICATE_ID, f"id already registered in domain {self.domain!r}"
 539:             )
 540:             return False
 541:         self.providers[instance.id] = instance
 542:         logger.info(
 543:             "[registry] Registered provider '{}' ({}) in {}",
 544:             instance.id, instance.label, self.domain,
 545:         )
 546:         return True
 547: 
 548:     def build(self) -> CatalogSnapshot:
 549:         """Resolve aliases last, so a real id always beats an alias (Â§19.3)."""
 550:         aliases: dict[str, str] = {}
 551:         for provider in self.providers.values():
 552:             for alias in provider.aliases:
 553:                 if alias in self.providers:
 554:                     provider.add_warning(f"alias dropped (collides with provider id): {alias}")
 555:                     continue
 556:                 incumbent = aliases.get(alias)
 557:                 if incumbent is not None:
 558:                     # Both sides are warned; neither provider is excluded (Â§19.3).
 559:                     provider.add_warning(f"alias dropped (claimed by '{incumbent}'): {alias}")
 560:                     self.providers[incumbent].add_warning(
 561:                         f"alias also claimed by '{provider.id}': {alias}"
 562:                     )
 563:                     continue
 564:                 aliases[alias] = provider.id
 565:         return CatalogSnapshot(
 566:             providers=dict(self.providers),
 567:             aliases=aliases,
 568:             exclusions=tuple(self.exclusions),
 569:         )
 570: 
 571: 
 572: class ProviderRegistry:
 573:     """Domain-scoped provider registry with discovery."""
 574: 
 575:     # Derived from the domain catalog â€” never write a domain name here (Â§19.1).
 576:     VALID_DOMAINS = DOMAIN_IDS
 577: 
 578:     def __init__(
 579:         self,
 580:         domain: str,
 581:         valid_domains: frozenset[str] | None = None,
 582:         capability_vocabulary: frozenset[str] | None = None,
 583:     ):
 584:         allowed = self.VALID_DOMAINS if valid_domains is None else valid_domains
 585:         if domain not in allowed:
 586:             raise ValueError(f"Invalid domain: {domain}. Must be one of {sorted(allowed)}")
 587:         self.domain = domain
 588:         self.capability_vocabulary = capability_vocabulary
 589:         self._snapshot: CatalogSnapshot = EMPTY_SNAPSHOT
 590:         self._lock = threading.RLock()
 591:         self._discovered = False
 592: 
 593:     # -- reads (lock-free: one attribute read of an immutable snapshot) ----
 594: 
 595:     @property
 596:     def snapshot(self) -> CatalogSnapshot:
 597:         return self._snapshot
 598: 
 599:     def get(self, provider_id: str) -> ProviderInstance | None:
 600:         """Get a provider by canonical id, then by alias."""
 601:         return self._snapshot.resolve(provider_id)
 602: 
 603:     def list_providers(self) -> list[ProviderInstance]:
 604:         """List all registered providers."""
 605:         return list(self._snapshot.providers.values())
 606: 
 607:     def list_ids(self) -> list[str]:
 608:         """List all provider IDs."""
 609:         return list(self._snapshot.providers)
 610: 
 611:     def excluded(self) -> list[dict]:
 612:         """Providers discovery refused, as data rather than only a log line (Â§21.4)."""
 613:         return [e.to_dict() for e in self._snapshot.exclusions]
 614: 
 615:     def aliases(self) -> dict[str, str]:
 616:         """`alias -> canonical id` for this domain."""
 617:         return dict(self._snapshot.aliases)
 618: 
 619:     def __len__(self) -> int:
 620:         return len(self._snapshot.providers)
 621: 
 622:     # -- writes ------------------------------------------------------------
 623: 
 624:     def publish(self, snapshot: CatalogSnapshot) -> list[ProviderInstance]:
 625:         """Swap in a new snapshot atomically; return the providers it dropped."""
 626:         with self._lock:
 627:             previous = self._snapshot
 628:             self._snapshot = snapshot
 629:         return [
 630:             provider
 631:             for provider_id, provider in previous.providers.items()
 632:             if snapshot.providers.get(provider_id) is not provider
 633:         ]
 634: 
 635:     def register(
 636:         self,
 637:         provider_id: str,
 638:         module: Any,
 639:         manifest: ProviderManifest,
 640:         provider_module: Any = None,
 641:         schema_module: Any = None,
 642:     ) -> None:
 643:         """Register one provider outside of a discovery scan (copy-on-write)."""
 644:         with self._lock:
 645:             builder = _CatalogBuilder(self.domain)
 646:             builder.providers.update(self._snapshot.providers)
 647:             builder.exclusions.extend(self._snapshot.exclusions)
 648:             builder.add(ProviderInstance(
 649:                 provider_id, module, manifest,
 650:                 provider_module=provider_module,
 651:                 schema_module=schema_module,
 652:             ))
 653:             self._snapshot = builder.build()
 654: 
 655:     def reset(self) -> None:
 656:         """Drop every registration so the next discovery re-scans from disk.
 657: 
 658:         Clears in place: the per-module compatibility facades hold this object.
 659:         """
 660:         with self._lock:
 661:             dropped = self.publish(EMPTY_SNAPSHOT)
 662:             self._discovered = False
 663:         for provider in dropped:
 664:             provider.retire()
 665: 
 666:     def shutdown_instances(self) -> None:
 667:         """Shut down every constructed provider in reverse construction order (Â§21.1)."""
 668:         constructed = [p for p in self.list_providers() if p.construction_seq is not None]
 669:         for provider in sorted(constructed, key=lambda p: p.construction_seq, reverse=True):
 670:             provider.shutdown()
 671: 
 672:     # -- discovery ---------------------------------------------------------
 673: 
 674:     def discovery_scan(self, providers_base: str) -> None:
 675:         """Scan provider folders and publish the result as one atomic swap."""
 676:         # Marked before the scan, not after: a provider module that imports its own
 677:         # package (e.g. `from studio.tts.providers.base import ...`) re-enters
 678:         # discovery, and the second scan would re-register every provider.
 679:         self._discovered = True
 680:         dropped = self.publish(self.build_snapshot(providers_base))
 681:         for provider in dropped:
 682:             provider.retire()
 683: 
 684:     def build_snapshot(self, providers_base: str) -> CatalogSnapshot:
 685:         """Scan `providers_base` into a private snapshot without publishing it."""
 686:         builder = _CatalogBuilder(self.domain)
 687: 
 688:         if not os.path.isdir(providers_base):
 689:             logger.debug("[registry] Provider base not found: {}", providers_base)
 690:             return builder.build()
 691: 
 692:         # sorted() so discovery logs, catalog responses, and "first wins" duplicate
 693:         # resolution are deterministic (contracts.md Â§21.2 item 2).
 694:         for entry in sorted(os.listdir(providers_base)):
 695:             provider_path = os.path.join(providers_base, entry)
 696:             if not os.path.isdir(provider_path):
 697:                 continue
 698:             if entry.startswith('_') or entry.startswith('.'):
 699:                 continue
 700: 
 701:             manifest_file = os.path.join(provider_path, 'manifest.py')
 702:             if not os.path.isfile(manifest_file):
 703:                 logger.debug("[registry] No manifest.py in {}, skipping", entry)
 704:                 continue
 705: 
 706:             instance = self._load_provider(builder, entry, provider_path, manifest_file)
 707:             if instance is not None:
 708:                 builder.add(instance)
 709: 
 710:         return builder.build()
---
 711: 
 712:     def _load_module_from_file(self, file_path: str, module_name: str) -> Any:
 713:         """Load a Python module from a file path. Returns module or None on failure."""
 714:         try:
 715:             spec = importlib.util.spec_from_file_location(module_name, file_path)
 716:             if spec is None or spec.loader is None:
 717:                 return None
 718:             module = importlib.util.module_from_spec(spec)
 719:             spec.loader.exec_module(module)
 720:             return module
 721:         except Exception as e:
 722:             logger.warning("[registry] Failed to load {}: {}", file_path, e)
 723:             return None
 724: 
 725:     def _load_provider(
 726:         self,
 727:         builder: _CatalogBuilder,
 728:         provider_id: str,
 729:         provider_path: str,
 730:         manifest_file: str,
 731:     ) -> ProviderInstance | None:
 732:         """Validate one provider package.
 733: 
 734:         Records an exclusion and returns `None` on failure; the caller adds the
 735:         instance to the private snapshot on success.
 736:         """
 737:         module_prefix = f"_sts_provider_{self.domain}_{provider_id}"
 738: 
 739:         try:
 740:             spec = importlib.util.spec_from_file_location(
 741:                 f"{module_prefix}_manifest", manifest_file
 742:             )
 743:             if spec is None or spec.loader is None:
 744:                 builder.exclude(
 745:                     provider_id, v.MANIFEST_LOAD_FAILED, "could not load manifest.py (spec failed)"
 746:                 )
 747:                 return None
 748:             module = importlib.util.module_from_spec(spec)
 749:             spec.loader.exec_module(module)
 750:         except Exception as e:
 751:             builder.exclude(
 752:                 provider_id, v.MANIFEST_LOAD_FAILED, f"{type(e).__name__} in manifest.py: {e}"
 753:             )
 754:             return None
 755: 
 756:         manifest_fn = getattr(module, 'manifest', None)
 757:         if not callable(manifest_fn):
 758:             builder.exclude(provider_id, v.MANIFEST_MISSING, "manifest() function not found")
 759:             return None
 760: 
 761:         try:
 762:             payload = manifest_fn()
 763:         except Exception as e:
 764:             builder.exclude(provider_id, v.MANIFEST_RAISED, f"manifest() raised: {e}")
 765:             return None
 766: 
 767:         result = v.validate_manifest(
 768:             folder_id=provider_id,
 769:             domain=self.domain,
 770:             payload=payload,
 771:             manifest_cls=ProviderManifest,
 772:             capability_vocabulary=self.capability_vocabulary,
 773:         )
 774:         if not result.ok:
 775:             builder.exclude(provider_id, result.reason_code, result.message)
 776:             return None
 777: 
 778:         instance = ProviderInstance(
 779:             provider_id, module, result.manifest, warnings=result.warnings
 780:         )
 781: 
 782:         provider_file = os.path.join(provider_path, 'provider.py')
 783:         if os.path.isfile(provider_file):
 784:             provider_module = self._load_module_from_file(
 785:                 provider_file, f"{module_prefix}_provider"
 786:             )
 787:             if provider_module is None:
 788:                 # Not fatal on its own: callables may live in manifest.py and
 789:                 # `_resolve` falls back across modules (Â§21.4 partial degradation).
 790:                 instance.add_warning("provider.py failed to load")
 791:             instance.provider_module = provider_module
 792: 
 793:         schema_file = os.path.join(provider_path, 'settings_schema.py')
 794:         if os.path.isfile(schema_file):
 795:             schema_module = self._load_module_from_file(
 796:                 schema_file, f"{module_prefix}_schema"
 797:             )
 798:             if schema_module is None:
 799:                 instance.add_warning("settings_schema.py failed to load")
 800:             instance.schema_module = schema_module
 801: 
 802:         if instance.create_callable is None:
 803:             instance.add_warning("no create() factory found in the provider package")
 804: 
 805:         return instance
 806: 
 807:     def to_dict(
 808:         self,
 809:         selected_provider: str | None = None,
 810:         settings_for: Any = None,
 811:     ) -> dict:
 812:         """Serialize registry state for API response (contracts.md Â§25).
 813: 
 814:         `settings_for` is an optional `(provider_id) -> dict` lookup used only to
 815:         compute each provider's availability. Injected rather than imported so the
 816:         registry stays independent of the settings store.
 817:         """
 818:         return {
 819:             'domain': self.domain,
 820:             'providers': [
 821:                 p.to_dict(settings_for(p.id) if settings_for is not None else None)
 822:                 for p in self.list_providers()
 823:             ],
 824:             'selected': selected_provider,
 825:             'count': len(self),
 826:             'excluded': self.excluded(),
 827:         }

