  182: # -- animator (contracts.md Â§32.5) ------------------------------------------
  183: 
  184: _ANIMATOR_UNIT_STATE = {
  185:     "ready": UNIT_SUCCEEDED,
  186:     "error": UNIT_FAILED,
  187:     "pending": UNIT_SKIPPED,
  188:     "generating": UNIT_SKIPPED,
  189:     "waiting": UNIT_SKIPPED,
  190: }
  191: 
  192: 
  193: def animator_manifest_to_units(manifest: Mapping[str, Any]) -> list[UnitResult]:
  194:     """`grabber_job.json` `scene_statuses` -> ordered `UnitResult`s (Â§31.5).
  195: 
  196:     The remote `urls` list is provider-specific response data and is dropped;
  197:     the downloaded `local_files` are the output (Â§32.5, Â§36 L9).
  198:     """
  199:     statuses = dict(manifest.get("scene_statuses") or {})
  200:     units: list[UnitResult] = []
  201:     for key in sorted(statuses, key=_as_index):
  202:         entry = statuses[key] if isinstance(statuses[key], Mapping) else {}
  203:         state = _ANIMATOR_UNIT_STATE.get(str(entry.get("status", "")), UNIT_SKIPPED)
  204:         refs = dedupe_refs(
  205:             ref_from_output_url(item) for item in (entry.get("local_files") or [])
  206:         )
  207:         units.append(UnitResult(
  208:             unit_index=_as_index(key),
  209:             state=state,
  210:             artifact_refs=tuple(refs),
  211:             # `kind` describes the media that was produced, so a unit that
  212:             # produced none does not claim one.
  213:             metadata=(
  214:                 {"kind": "video" if _looks_like_video(refs) else "image"} if refs else {}
  215:             ),
  216:             error=_unit_error(entry, state),
  217:         ))
  218:     return units
  219: 
  220: 
  221: def _looks_like_video(refs: list[str]) -> bool:
  222:     return any(ref.lower().endswith((".mp4", ".webm", ".mov")) for ref in refs)
  223: 
  224: 
  225: def _as_index(key: Any) -> int:
  226:     try:
  227:         return int(key)
  228:     except (TypeError, ValueError):
  229:         return 0
  230: 
  231: 
  232: def _unit_error(entry: Mapping[str, Any], state: str) -> ProviderErrorPayload | None:
  233:     """A failed unit must carry an error (Â§31.5 rule 5), and it must be safe."""
  234:     if state != UNIT_FAILED:
  235:         return None
  236:     # `ProviderError` sanitizes on construction, so the raw `str(e)` the legacy
  237:     # route persisted is stripped of paths and key=value secrets here.
  238:     return ProviderErrorPayload.from_error(ProviderError(
  239:         PROVIDER_UNIT_FAILED,
  240:         str(entry.get("error") or "The provider failed to produce this unit"),
  241:         retryable=True,
  242:     ))
  243: 
