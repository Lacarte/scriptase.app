  110:     `audio_path` becomes `audio_ref` (relative, not absolute) and is supplied by
  111:     the caller, because only the caller knows the managed output root.
  112:     """
  113:     return {
  114:         "audio_ref": audio_ref,
  115:         "duration_seconds": float(getattr(result, "duration_seconds", 0.0) or 0.0),
  116:         "sample_rate": int(getattr(result, "sample_rate", 0) or 0),
  117:         "format": str(getattr(result, "format", "wav") or "wav"),
  118:         "voice": str((getattr(result, "metadata", None) or {}).get("voice", "")),
  119:         "characters_billed": (getattr(result, "metadata", None) or {}).get(
  120:             "characters_billed"
