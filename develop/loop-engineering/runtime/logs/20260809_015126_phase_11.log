 384:     """Wraps the scheduler's `stage_path` and remembers what was staged.
 385: 
 386:     Provider output is staged and validated before promotion, so a failed
 387:     invocation publishes nothing. The recorded destinations are what let the
 388:     boundary tell "the provider never produced this artifact" apart from "the
 389:     artifact exists but has not been promoted yet" â€” without them every staged
 390:     write would look like `PROVIDER_ARTIFACT_MISSING`.
 391:     """
 392: 
 393:     def __init__(self, stage: Callable[[str], str] | None = None):
 394:         self._stage = stage
 395:         self.destinations: list[str] = []
 396: 
 397:     def __call__(self, destination: str) -> str:
 398:         self.destinations.append(os.path.abspath(destination))
 399:         return self._stage(destination) if self._stage is not None else destination
 400: 
 401:     def staged(self, absolute_path: str) -> bool:
 402:         return os.path.abspath(absolute_path) in self.destinations
