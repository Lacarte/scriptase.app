  29: 
  30: def _error(code, message, status, details=None):
  31:     body = {"error": {"code": code, "message": message}}
  32:     if details is not None:
  33:         body["error"]["details"] = details
  34:     return jsonify(body), status
  35: 
  36: 
  37: def _require_loopback():
  38:     if not is_loopback_remote(request.remote_addr):
  39:         return _error("FORBIDDEN", "Provider endpoints are local-only", 403)
  40:     return None
  41: 
  42: 
  43: def _json_object():
  44:     """Return `(payload, None)` for a JSON object body, else `(None, error)`."""
  45:     data = request.get_json(silent=True)
  46:     if not isinstance(data, dict):
  47:         return None, _error("INVALID_REQUEST", "Expected JSON object", 400)
  48:     return data, None
  49: 
