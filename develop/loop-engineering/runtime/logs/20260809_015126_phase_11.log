### studio/shared/providers_common/jobs.py
    1: """The one asynchronous job contract â€” step 11.4.
    2: 
    3: Implements contracts.md Â§33, replacing the two field-for-field duplicate
    4: `JobHandle`/`JobStatus`/`SceneResult` definitions that lived in
    5: `studio/storyboard/providers/base.py` and `studio/animator/providers/base.py`
    6: (Â§14.6). Those modules now re-export these types.
    7: 
    8: Two deliberate changes from the duplicated dataclasses:
    9: 
   10:   * `status: str` becomes `state` with a closed vocabulary â€” the old field held
   11:     provider-defined strings, so no caller could branch on it safely;
   12:   * `result: dict | None` becomes `units: tuple[UnitResult, ...]`, so a partial
   13:     result is expressible while the job is still running.
   14: 
   15: Every terminal state maps to exactly one invocation outcome, which is what makes
   16: a synchronous and an asynchronous provider indistinguishable to the caller.
   17: """
   18: 
   19: from __future__ import annotations
   20: 
   21: import re
   22: from dataclasses import dataclass, replace
   23: from typing import Any, Mapping
   24: 
   25: from studio.io_utils import now_iso
   26: from studio.shared.providers_common.errors import (
   27:     CANCELLED,
   28:     PROVIDER_NOT_FOUND,
   29:     PROVIDER_TIMEOUT,
   30:     PROVIDER_UNIT_FAILED,
   31:     ProviderCancelled,
   32:     ProviderError,
   33:     ProviderErrorPayload,
   34: )
   35: from studio.shared.providers_common.results import (
   36:     FAILED,
   37:     PARTIAL,
   38:     SUCCEEDED,
   39:     UnitResult,
   40: )
   41: from studio.shared.providers_common.validation import sanitize_message
   42: 
   43: 
   44: JOB_ID_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,128}$")
   45: 
   46: # -- state machine (contracts.md Â§33.2, frozen) -----------------------------
   47: 
   48: SUBMITTED = "submitted"
   49: RUNNING = "running"
   50: TIMED_OUT = "timed_out"
   51: # The job-state spelling of the `CANCELLED` error code.
   52: JOB_CANCELLED = CANCELLED.lower()
   53: 
   54: JOB_STATES = (SUBMITTED, RUNNING, SUCCEEDED, PARTIAL, FAILED, JOB_CANCELLED, TIMED_OUT)
   55: TERMINAL_STATES = frozenset({SUCCEEDED, PARTIAL, FAILED, JOB_CANCELLED, TIMED_OUT})
   56: JOB_STATE_SET = frozenset(JOB_STATES)
   57: 
   58: # Poll cadence (Â§33.3). The first poll is early so a fast job is not held for a
   59: # whole interval; the push watchdog is what stops a lost callback hanging a job.
   60: FIRST_POLL_DELAY_S = 2.0
   61: POLL_JITTER = 0.10
   62: DOMAIN_POLL_INTERVAL_S = {"storyboard": 10.0, "animator": 10.0}
   63: PUSH_WATCHDOG_INTERVAL_S = 60.0
   64: # The current loop swallows every poll exception forever, which turns a
   65: # permanently broken provider into a 30-minute wait (Â§33.3).
   66: MAX_CONSECUTIVE_POLL_FAILURES = 3
   67: 
   68: 
   69: def poll_interval(domain: str, *, push: bool = False) -> float:
   70:     """The frozen poll cadence for a domain (Â§33.3)."""
   71:     if push:
   72:         return PUSH_WATCHDOG_INTERVAL_S
   73:     return DOMAIN_POLL_INTERVAL_S.get(domain, 10.0)
   74: 
   75: 
   76: @dataclass(frozen=True)
   77: class JobHandle:
   78:     """Stable identity only. Live state belongs exclusively to `JobStatus`.
   79: 
   80:     Putting `state` on the frozen handle would either go stale at the first
   81:     transition or force replacing the identity object on every poll (Â§33.1).
   82:     """
   83: 
   84:     job_id: str
   85:     domain: str = ""
   86:     provider_id: str = ""
   87:     project_id: str = ""
   88:     invocation_id: str = ""
   89:     created_at: str = ""
   90: 
   91:     def __post_init__(self):
   92:         if not JOB_ID_RE.fullmatch(str(self.job_id or "")):
   93:             raise ProviderError(
   94:                 "PROVIDER_RESULT_INVALID",
   95:                 "Job id must match ^[A-Za-z0-9_.:-]{1,128}$",
   96:                 domain=self.domain,
   97:                 provider_id=self.provider_id,
   98:             )
   99:         if not self.created_at:
  100:             object.__setattr__(self, "created_at", now_iso())
  101: 
  102:     @property
  103:     def correlation(self) -> tuple[str, str, str, str]:
  104:         """The frozen push-correlation tuple (Â§33.3).
  105: 
  106:         A pushed status whose tuple does not match a live job is dropped and
  107:         warned, never applied.
  108:         """
  109:         return (self.domain, self.provider_id, self.project_id, self.job_id)
  110: 
  111:     def to_dict(self) -> dict:
  112:         return {
  113:             "job_id": self.job_id,
  114:             "domain": self.domain,
  115:             "provider_id": self.provider_id,
  116:             "project_id": self.project_id,
  117:             "invocation_id": self.invocation_id,
  118:             "created_at": self.created_at,
  119:         }
  120: 
  121:     @classmethod
  122:     def from_dict(cls, data: Mapping[str, Any]) -> "JobHandle":
  123:         return cls(
  124:             job_id=str(data.get("job_id", "")),
  125:             domain=str(data.get("domain", "")),
  126:             provider_id=str(data.get("provider_id", "")),
  127:             project_id=str(data.get("project_id", "")),
  128:             invocation_id=str(data.get("invocation_id", "")),
  129:             created_at=str(data.get("created_at", "")),
  130:         )
  131: 
  132: 
  133: @dataclass(frozen=True)
  134: class JobStatus:
  135:     """A point-in-time snapshot of one job (Â§33.1)."""
  136: 
  137:     job_id: str
  138:     state: str = SUBMITTED
  139:     ready: int = 0
  140:     total: int = 0
  141:     fraction: float | None = None
  142:     message: str | None = None
  143:     units: tuple[UnitResult, ...] = ()
  144:     error: ProviderErrorPayload | None = None
  145:     updated_at: str = ""
  146: 
  147:     def __post_init__(self):
  148:         if self.state not in JOB_STATE_SET:
  149:             raise ProviderError(
  150:                 "PROVIDER_RESULT_INVALID", f"Unknown job state {self.state!r}"
  151:             )
  152:         if self.message is not None:
  153:             object.__setattr__(self, "message", sanitize_message(self.message))
  154:         if self.fraction is not None:
  155:             object.__setattr__(self, "fraction", min(1.0, max(0.0, float(self.fraction))))
  156:         if not self.updated_at:
  157:             object.__setattr__(self, "updated_at", now_iso())
  158:         if self.state == FAILED and self.error is None:
  159:             object.__setattr__(self, "error", ProviderErrorPayload.from_error(
  160:                 ProviderError(PROVIDER_UNIT_FAILED, "The provider job failed")
  161:             ))
  162: 
  163:     @property
  164:     def terminal(self) -> bool:
  165:         return self.state in TERMINAL_STATES
  166: 
  167:     def advance(self, **changes) -> "JobStatus":
  168:         """Return the next snapshot, enforcing the monotonic rules of Â§33.2.
  169: 
  170:         A terminal job never returns to `running`, and `total` may only be set
  171:         once, at or before the first `running` status.
  172:         """
  173:         if self.terminal and changes.get("state", self.state) != self.state:
  174:             raise ProviderError(
  175:                 "PROVIDER_RESULT_INVALID",
  176:                 f"Job {self.job_id} is terminal in state {self.state!r}",
  177:             )
  178:         if "total" in changes and self.total and changes["total"] != self.total:
  179:             changes.pop("total")
  180:         if "ready" in changes:
  181:             changes["ready"] = max(int(changes["ready"]), self.ready)
  182:         changes.setdefault("updated_at", now_iso())
  183:         return replace(self, **changes)
  184: 
  185:     def to_dict(self) -> dict:
  186:         return {
  187:             "job_id": self.job_id,
  188:             "state": self.state,
  189:             "ready": self.ready,
  190:             "total": self.total,
  191:             "fraction": self.fraction,
  192:             "message": self.message,
  193:             "units": [unit.to_dict() for unit in self.units],
  194:             "error": self.error.to_dict() if self.error is not None else None,
  195:             "updated_at": self.updated_at,
  196:         }
  197: 
  198:     @classmethod
  199:     def from_dict(cls, data: Mapping[str, Any]) -> "JobStatus":
  200:         error = data.get("error")
  201:         return cls(
  202:             job_id=str(data.get("job_id", "")),
  203:             state=str(data.get("state", SUBMITTED)),
  204:             ready=int(data.get("ready", 0)),
  205:             total=int(data.get("total", 0)),
  206:             fraction=data.get("fraction"),
  207:             message=data.get("message"),
  208:             units=tuple(
  209:                 UnitResult.from_dict(unit)
  210:                 for unit in (data.get("units") or [])
  211:                 if isinstance(unit, Mapping)
  212:             ),
  213:             error=(
  214:                 ProviderErrorPayload.from_error(ProviderError.from_payload(error))
  215:                 if isinstance(error, Mapping)
  216:                 else None
  217:             ),
  218:             updated_at=str(data.get("updated_at", "")),
  219:         )
  220: 
  221: 
  222: # The per-scene status vocabulary both visual domains actually persist
  223: # (`storyboard/routes.py:390`, `animator/routes.py:365-410`). All five shipped
  224: # `poll()` bodies counted `"complete"`, which neither domain has ever written.
  225: SCENE_DONE = frozenset({"ready", "done"})
  226: SCENE_FAILED = frozenset({"error", "failed"})
  227: 
  228: 
  229: def status_from_scenes(job_id: str, scenes: Mapping[str, Any]) -> JobStatus:
  230:     """Derive a `JobStatus` from a persisted per-scene status map.
  231: 
  232:     One definition for both visual domains, so the two `poll()` bodies cannot
  233:     disagree about what "done" means â€” and so Â§33.2's rule that zero produced
  234:     units can never be `succeeded` is applied in exactly one place.
  235:     """
  236:     entries = [
  237:         entry if isinstance(entry, Mapping) else {}
  238:         for entry in (scenes or {}).values()
  239:     ]
  240:     total = len(entries)
  241:     ready = sum(1 for entry in entries if entry.get("status") in SCENE_DONE)
  242:     failed = sum(1 for entry in entries if entry.get("status") in SCENE_FAILED)
  243: 
  244:     if not total or ready + failed < total:
  245:         state = RUNNING
  246:     elif ready == 0:
  247:         state = FAILED
  248:     elif failed:
  249:         state = PARTIAL
  250:     else:
  251:         state = SUCCEEDED
  252:     return JobStatus(
  253:         job_id=job_id,
  254:         state=state,
  255:         ready=ready,
  256:         total=total,
  257:         fraction=(ready + failed) / total if total else 0.0,
  258:         error=(
  259:             ProviderErrorPayload.from_error(ProviderError(
  260:                 PROVIDER_UNIT_FAILED, f"All {total} units failed"
  261:             ))
  262:             if state == FAILED
  263:             else None
  264:         ),
  265:     )
  266: 
  267: 
  268: def unknown_job_status(job_id: str) -> JobStatus:
  269:     """The status of a job the provider has no record of.
  270: 
  271:     The pre-11.4 dataclasses answered the provider-defined string `"unknown"`,
  272:     which no caller could branch on: a poll loop treated it as neither done nor
  273:     failed and waited out the whole deadline. `state` is a closed vocabulary now
  274:     (Â§33.1) and a job the provider cannot find will never complete, so it is
  275:     `failed` with `PROVIDER_NOT_FOUND` â€” the rule Â§33.4 already applies to a
  276:     rehydrated job whose provider is gone.
  277:     """
  278:     return JobStatus(
  279:         job_id=job_id,
  280:         state=FAILED,
  281:         error=ProviderErrorPayload.from_error(ProviderError(
  282:             PROVIDER_NOT_FOUND, "The provider has no record of this job"
  283:         )),
  284:     )
  285: 
  286: 
  287: def terminal_outcome(status: JobStatus, *, domain: str = "", provider_id: str = "") -> str:
  288:     """Map a terminal job state onto its one invocation outcome (Â§33.2).
  289: 
  290:     Returns `succeeded` or `partial`; raises for the three failure states, so a
  291:     caller never has to re-derive the mapping.
  292:     """
  293:     if not status.terminal:
  294:         raise ProviderError(
  295:             "PROVIDER_RESULT_INVALID",
  296:             f"Job {status.job_id} is not terminal ({status.state})",
  297:             domain=domain, provider_id=provider_id,
  298:         )
  299:     if status.state == JOB_CANCELLED:
  300:         raise ProviderCancelled(domain=domain, provider_id=provider_id)
  301:     if status.state == TIMED_OUT:
  302:         raise ProviderError(
  303:             PROVIDER_TIMEOUT,
  304:             "The provider job exceeded its deadline",
  305:             retryable=True,
  306:             domain=domain, provider_id=provider_id,
  307:             details=_partial_diagnostic(status),
  308:         )
  309:     if status.state == FAILED:
  310:         error = status.error.as_error() if status.error is not None else None
  311:         raise ProviderError(
  312:             error.code if error else PROVIDER_UNIT_FAILED,
  313:             error.message if error else "The provider job failed",
  314:             retryable=error.retryable if error else False,
  315:             domain=domain, provider_id=provider_id,
  316:             details=_partial_diagnostic(status),
  317:         )
  318:     # Zero produced units can never be `succeeded` (Â§33.2) â€” the defect class
  319:     # currently guarded by hand in both visual adapters.
  320:     if status.state == SUCCEEDED and status.units and not any(
  321:         unit.state == "succeeded" for unit in status.units
  322:     ):
  323:         raise ProviderError(
  324:             PROVIDER_UNIT_FAILED,
  325:             f"All {len(status.units)} units failed",
  326:             domain=domain, provider_id=provider_id,
  327:             details=_partial_diagnostic(status),
  328:         )
  329:     return status.state
  330: 
  331: 
  332: def _partial_diagnostic(status: JobStatus) -> dict:
  333:     """Units already terminal, preserved as diagnostics on a failed job (Â§35.3)."""
  334:     return {
  335:         "ready": status.ready,
  336:         "total": status.total,
  337:         "units": [unit.to_dict() for unit in status.units],
  338:     }
  339: 
  340: 
  341: @dataclass
  342: class JobRecord:
  343:     """`JobHandle` + last `JobStatus`, the unit of job persistence (Â§33.4)."""
  344: 
  345:     handle: JobHandle
  346:     status: JobStatus
  347: 
  348:     def to_dict(self) -> dict:
  349:         return {"handle": self.handle.to_dict(), "status": self.status.to_dict()}
  350: 
  351:     @classmethod
  352:     def from_dict(cls, data: Mapping[str, Any]) -> "JobRecord":
  353:         return cls(
  354:             handle=JobHandle.from_dict(data.get("handle") or {}),
  355:             status=JobStatus.from_dict(data.get("status") or {}),
  356:         )
  357: 
