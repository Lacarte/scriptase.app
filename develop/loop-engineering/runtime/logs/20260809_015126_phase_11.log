 274: def coerce_result(
 275:     returned: Any,
 276:     *,
 277:     domain: str,
 278:     provider_id: str,
 279:     provider_version: str = "",
 280:     contract_version: int = 1,
 281: ) -> ProviderResult:
 282:     """Turn what a provider returned into a validated envelope (Â§31.1).
 283: 
 284:     Unknown top-level keys are dropped with a WARN, mirroring the manifest policy
 285:     â€” a provider written against a newer build must not fail on an older one. An
 286:     invalid *known* field is `PROVIDER_RESULT_INVALID`.
 287: 
 288:     `domain` and `provider_id` are overwritten from the platform's own values, so
 289:     a provider cannot impersonate another.
 290:     """
 291:     if isinstance(returned, ProviderResult):
 292:         result = returned
 293:     elif isinstance(returned, Mapping):
 294:         result = _from_mapping(returned, provider_id=provider_id)
 295:     else:
 296:         raise ProviderError(
 297:             PROVIDER_RESULT_INVALID,
 298:             "Provider returned a non-object result",
 299:             domain=domain,
 300:             provider_id=provider_id,
 301:         )
 302: 
 303:     result.domain = domain
 304:     result.provider_id = provider_id
 305:     result.provider_version = provider_version
 306:     result.contract_version = contract_version
 307:     if result.result_version != RESULT_VERSION:
 308:         raise ProviderError(
 309:             PROVIDER_RESULT_INVALID,
 310:             f"Unsupported result_version {result.result_version}",
 311:             domain=domain,
 312:             provider_id=provider_id,
 313:         )
 314: 
 315:     result.artifact_refs = dedupe_refs(result.artifact_refs)
 316:     result.metadata = _bound_metadata(result.metadata)
 317:     result.warnings = _bound_warnings(result.warnings)
 318: 
 319:     if result.units:
 320:         derived = derive_status(result.units)
 321:         if derived == UNIT_CANCELLED:
 322:             from studio.shared.providers_common.errors import ProviderCancelled
 323: 
 324:             raise ProviderCancelled(domain=domain, provider_id=provider_id)
 325:         result.status = derived
 326:         _check_unit_rules(result, domain, provider_id)
 327:         # Envelope refs are the ordered union of unit refs plus domain-level
 328:         # artifacts; no unit-level ref may be missing from it (Â§31.5 rule 4).
 329:         result.artifact_refs = dedupe_refs(
 330:             [ref for unit in result.units for ref in unit.artifact_refs]
 331:             + result.artifact_refs
 332:         )
 333:     elif result.status not in ENVELOPE_STATES:
 334:         raise ProviderError(
 335:             PROVIDER_RESULT_INVALID,
 336:             f"Unknown result status {result.status!r}",
 337:             domain=domain,
 338:             provider_id=provider_id,
 339:         )
 340: 
 341:     if result.status == FAILED:
 342:         # A returned `failed` is equivalent to raising, and is converted to one
 343:         # at the boundary; providers should raise (Â§31.1).
 344:         raise ProviderError(
