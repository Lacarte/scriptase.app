 396: def _bound_metadata(metadata: Mapping[str, Any]) -> dict:
 397:     """Small, flat, JSON-scalar values only (Â§31.1)."""
 398:     bounded: dict[str, Any] = {}
 399:     for key, value in list(dict(metadata or {}).items())[:METADATA_MAX_KEYS]:
 400:         if isinstance(value, str):
 401:             bounded[str(key)] = value[:METADATA_STRING_MAX]
 402:         elif value is None or isinstance(value, (bool, int, float)):
 403:             bounded[str(key)] = value
 404:         else:
 405:             logger.debug("[results] non-scalar metadata dropped: {}", key)
 406:     return bounded
 407: 
 408: 
 409: def _bound_warnings(warnings: Iterable[Any]) -> list[dict]:
 410:     bounded: list[dict] = []
 411:     for entry in list(warnings or [])[:WARNINGS_MAX]:
 412:         if not isinstance(entry, Mapping):
 413:             continue
 414:         item = {
 415:             "code": str(entry.get("code", "PROVIDER_WARNING")),
 416:             "message": sanitize_message(entry.get("message", ""))[:WARNING_MESSAGE_MAX],
 417:         }
 418:         if entry.get("unit_index") is not None:
 419:             item["unit_index"] = int(entry["unit_index"])
 420:         bounded.append(item)
 421:     return bounded
