  331: # ---------------------------------------------------------------------------
  332: # Whole settings document
  333: # ---------------------------------------------------------------------------
  334: 
  335: @providers_bp.route("/api/settings/v2", methods=["GET"])
  336: def get_settings_v2():
  337:     """Return the nested settings document, with secrets redacted.
  338: 
  339:     Secret values are write-only (contracts.md Â§22.6): they leave the process only
  340:     as the `"***"` sentinel, which `PUT`/`PATCH` treat as "unchanged".
  341:     """
  342:     denied = _require_loopback()
  343:     if denied:
  344:         return denied
  345:     settings = settings_manager.load_settings()
  346:     return jsonify(settings_manager.redact_settings(settings))
  347: 
  348: 
  349: @providers_bp.route("/api/settings/v2", methods=["PUT"])
  350: def put_settings_v2():
  351:     """Replace the whole settings document â€” import and reset only.
  352: 
  353:     Changing a selection goes through `PUT /api/providers/<domain>/selection`
  354:     instead (Â§24.2). The client round-trips the redacted document, so every secret
  355:     submitted as the sentinel is restored from the stored value (Â§22.6).
  356:     """
  357:     denied = _require_loopback()
  358:     if denied:
  359:         return denied
  360:     data, err = _json_object()
  361:     if err is not None:
  362:         return err
  363:     return _save_settings_document(data)
  364: 
  365: 
  366: @providers_bp.route("/api/settings/v2", methods=["PATCH"])
  367: def patch_settings_v2():
  368:     """Deep-merge a partial settings document (Â§24.2).
  369: 
  370:     Field-level replacement for everything the targeted selection endpoint does
  371:     not cover, without the lost-update window of a whole-document round trip.
  372:     """
  373:     denied = _require_loopback()
  374:     if denied:
  375:         return denied
  376:     patch, err = _json_object()
  377:     if err is not None:
  378:         return err
  379:     stored = settings_manager.load_settings()
  380:     return _save_settings_document(_deep_merge(stored, patch), stored=stored)
  381: 
  382: 
  383: def _save_settings_document(data, stored=None):
  384:     """Validate, restore sentinel secrets, and persist a settings document."""
  385:     issues = settings_manager.validate_settings(data)
  386:     if any(i["severity"] == "error" for i in issues):
  387:         return _error("SETTINGS_INVALID", "Invalid settings", 400, {"issues": issues})
  388:     if stored is None:
  389:         stored = settings_manager.load_settings()
  390:     settings_manager.save_settings(
  391:         settings_manager.restore_redacted_secrets(stored, data)
  392:     )
  393:     return jsonify({"ok": True, "issues": issues})
  394: 
  395: 
  396: def _deep_merge(base, patch):
  397:     """Recursively merge `patch` over `base`; a non-dict value replaces wholesale."""
  398:     merged = dict(base)
  399:     for key, value in patch.items():
  400:         current = merged.get(key)
  401:         if isinstance(value, dict) and isinstance(current, dict):
  402:             merged[key] = _deep_merge(current, value)
  403:         else:
  404:             merged[key] = value
  405:     return merged
### studio/providers/catalog.py
    1: """Catalog assembly and versioning for the provider API (contracts.md Â§25).
    2: 
    3: The catalog is *content*-versioned rather than URL-versioned: `catalog_version` is
    4: a digest of the browser-safe payload, so a client can cache by it and refetch when
    5: a provider is added, removed, relabeled, excluded, or changes availability.
    6: """
    7: 
    8: import hashlib
    9: import json
   10: 
   11: from studio.shared.providers_common import hub, settings_manager
   12: from studio.shared.providers_common.domains import DOMAINS
   13: 
   14: 
   15: def selected_providers() -> dict[str, str | None]:
   16:     """`domain -> selected_provider_id` from the one authoritative store (Â§24)."""
   17:     stored = settings_manager.load_settings().get("domains", {})
   18:     return {
   19:         domain: (stored.get(domain) or {}).get("selected_provider")
   20:         for domain in hub.domains()
   21:     }
   22: 
   23: 
   24: def build_catalog() -> dict:
   25:     """The full `domain -> serialized registry` map, enriched with catalog data."""
   26:     catalog = hub.catalog(selected=selected_providers())
   27:     for domain, payload in catalog.items():
   28:         spec = DOMAINS.get(domain)
   29:         if spec is not None:
   30:             payload["label"] = spec.label
   31:             payload["default_provider"] = spec.default_provider
   32:     return catalog
   33: 
   34: 
   35: def catalog_version(catalog: dict) -> str:
   36:     """A stable digest of the catalog payload.
   37: 
   38:     Deterministic across processes: the payload is dumped with sorted keys, so an
   39:     unchanged catalog always hashes to the same value.
   40:     """
   41:     canonical = json.dumps(catalog, sort_keys=True, separators=(",", ":"))
   42:     return hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:16]
### studio/shared/providers_common/boundary.py
    1: """The single provider exception boundary â€” step 11.4.
    2: 
    3: Implements contracts.md Â§34.4 and Â§35.3. Exactly one place wraps provider
    4: exceptions, and the substantive rule is rule 3: **the original exception's
    5: `str(exc)` is never copied into `message` or `details`.** The full traceback goes
    6: to the redacted logger tagged internal-only, so Â§30.5 cannot promote it into an
    7: execution-record entry, an SSE frame, or an API response.
    8: 
    9: `invoke()` is the entry point every domain call goes through. It owns the
   10: deadline, the cancellation checks around dispatch, result coercion, provenance,
   11: and the wrap â€” so no domain re-implements any of them.
   12: """
   13: 
   14: from __future__ import annotations
   15: 
   16: import os
   17: import time
   18: import traceback
   19: from typing import Any, Callable
   20: 
   21: from studio.io_utils import now_iso
   22: from studio.shared.providers_common import errors as E
   23: from studio.shared.providers_common.errors import (
   24:     ProviderCancelled,
   25:     ProviderError,
   26: )
   27: from studio.shared.providers_common.invocation import ProviderInvocation
   28: from studio.shared.providers_common.results import (
   29:     Provenance,
   30:     ProviderResult,
   31:     coerce_result,
   32:     resolve_ref,
   33:     validate_egress,
   34: )
   35: 
   36: 
   37: # Exception classes whose meaning is unambiguous enough to classify without the
   38: # provider's cooperation. Everything else becomes PROVIDER_FAILED (Â§34.4).
   39: _CLASSIFIED: tuple[tuple[tuple[type, ...], str], ...] = (
   40:     ((TimeoutError,), E.PROVIDER_TIMEOUT),
   41:     ((ConnectionError,), E.PROVIDER_TRANSPORT_FAILED),
   42:     ((ValueError, TypeError, KeyError), E.PROVIDER_RESPONSE_MALFORMED),
   43: )
   44: 
   45: 
   46: def classify(exc: BaseException) -> str:
   47:     """The provider code for an unclassified exception (Â§34.2)."""
   48:     for types, code in _CLASSIFIED:
   49:         if isinstance(exc, types):
   50:             return code
   51:     return E.PROVIDER_FAILED
   52: 
   53: 
   54: def wrap_exception(
   55:     exc: BaseException,
   56:     *,
   57:     domain: str = "",
   58:     provider_id: str = "",
   59:     log=None,
   60:     code: str | None = None,
   61: ) -> ProviderError:
   62:     """Convert any exception into a safe `ProviderError` (Â§34.4).
   63: 
   64:     1. the full traceback goes to the redacted logger, marked internal-only;
   65:     2. a generic per-domain sentence becomes the message;
   66:     3. `str(exc)` is never copied into `message` or `details`.
   67:     """
   68:     if isinstance(exc, ProviderError):
   69:         return exc
   70: 
   71:     resolved = code or classify(exc)
   72:     if log is not None:
   73:         log.internal(
   74:             "provider invocation failed",
   75:             cause_type=type(exc).__name__,
   76:             traceback="".join(
   77:                 traceback.format_exception(type(exc), exc, exc.__traceback__)
   78:             ),
   79:         )
   80:     return ProviderError(
   81:         resolved,
   82:         E.generic_message(domain),
   83:         retryable=E.is_retryable(resolved),
   84:         domain=domain,
   85:         provider_id=provider_id,
   86:         cause_type=type(exc).__name__,
   87:     )
   88: 
   89: 
   90: class Deadline:
   91:     """A platform-owned wall clock for one invocation (Â§35.3).
   92: 
   93:     A provider never decides how long the caller waits; it may read
   94:     `remaining()` to size its own waits and must poll `check()` while waiting.
   95:     """
   96: 
   97:     def __init__(self, seconds: float, *, clock: Callable[[], float] = time.monotonic):
   98:         self._clock = clock
   99:         self._started = clock()
  100:         self.seconds = float(seconds)
  101: 
  102:     def remaining(self) -> float:
  103:         return max(0.0, self.seconds - (self._clock() - self._started))
  104: 
  105:     def expired(self) -> bool:
  106:         return self.remaining() <= 0.0
  107: 
  108:     def check(self, *, domain: str = "", provider_id: str = "", details: Any = None) -> None:
  109:         """Raise `PROVIDER_TIMEOUT` once the deadline has passed."""
  110:         if self.expired():
  111:             raise ProviderError(
  112:                 E.PROVIDER_TIMEOUT,
  113:                 f"The provider exceeded its {int(self.seconds)}s deadline",
  114:                 retryable=True,
  115:                 domain=domain,
  116:                 provider_id=provider_id,
  117:                 details=details if isinstance(details, dict) else None,
  118:             )
  119: 
  120: 
  121: def wait_until(
  122:     predicate: Callable[[], Any],
  123:     *,
  124:     invocation: ProviderInvocation,
  125:     interval_s: float = 1.0,
  126:     sleeper: Callable[[float], None] = time.sleep,
  127:     clock: Callable[[], float] = time.monotonic,
  128:     details: Callable[[], dict] | None = None,
  129: ) -> Any:
  130:     """Poll `predicate` until it is truthy, honoring cancellation and deadline.
  131: 
  132:     Replaces the hand-written `while time.monotonic() < deadline:` loops in the
  133:     two visual adapters, including their two wrong error codes: cancellation
  134:     raises `ProviderCancelled` (workflow `CANCELLED`) and expiry raises
  135:     `PROVIDER_TIMEOUT` (workflow `POLL_TIMEOUT`), not `EXECUTION_CANCELLED` and
  136:     `NODE_TIMEOUT` (Â§35.1, Â§35.3).
  137:     """
  138:     deadline = Deadline(invocation.deadline, clock=clock)
  139:     while True:
  140:         invocation.cancel.raise_if_cancelled()
  141:         outcome = predicate()
  142:         if outcome:
  143:             return outcome
  144:         invocation.cancel.raise_if_cancelled()
  145:         if deadline.expired():
  146:             deadline.check(
  147:                 domain=invocation.domain,
  148:                 provider_id=invocation.provider_id,
  149:                 details=details() if details is not None else None,
  150:             )
  151:         sleeper(max(0.01, min(interval_s, deadline.remaining())))
  152: 
  153: 
  154: def invoke(
  155:     call: Callable[[ProviderInvocation], Any],
  156:     invocation: ProviderInvocation,
  157:     *,
  158:     provider_version: str = "",
  159:     contract_version: int = 1,
  160:     settings_version: int = 0,
  161:     cache_hit: bool = False,
  162:     verify_artifacts: bool = True,
  163: ) -> ProviderResult:
  164:     """Run one provider call behind the boundary and return a valid envelope.
  165: 
  166:     Every failure leaves here as a `ProviderError` whose message is safe to
  167:     persist. Cancellation is checked before dispatch and after return, matching
  168:     the scheduler's own behavior for providers that do not declare `cancel`.
  169:     """
  170:     started_at = now_iso()
  171:     started = time.perf_counter()
  172:     invocation.cancel.raise_if_cancelled()
  173: 
  174:     try:
  175:         returned = call(invocation)
  176:         invocation.cancel.raise_if_cancelled()
  177:         result = coerce_result(
  178:             returned,
  179:             domain=invocation.domain,
  180:             provider_id=invocation.provider_id,
  181:             provider_version=provider_version,
  182:             contract_version=contract_version,
  183:         )
  184:         if verify_artifacts:
  185:             check_artifacts(result, invocation)
  186:     except ProviderCancelled:
  187:         raise
  188:     except BaseException as exc:  # a provider is a plugin boundary
  189:         raise wrap_exception(
  190:             exc,
  191:             domain=invocation.domain,
  192:             provider_id=invocation.provider_id,
  193:             log=invocation.log,
  194:         ) from None
  195:     finally:
  196:         invocation.progress.flush()
  197: 
  198:     result.provenance = build_provenance(
  199:         invocation,
  200:         provider_version=provider_version,
  201:         contract_version=contract_version,
  202:         settings_version=settings_version,
  203:         started_at=started_at,
  204:         duration_ms=max(0, round((time.perf_counter() - started) * 1000)),
  205:         cache_hit=cache_hit,
  206:     )
  207:     # Provenance is platform-authored but still crosses the same boundary, and
  208:     # it is the one place a settings value is echoed at all (Â§31.3, Â§36 L6).
  209:     leaks = validate_egress(result.provenance.to_dict(), path="provenance")
  210:     if leaks:
  211:         raise ProviderError(
  212:             E.PROVIDER_RESULT_INVALID,
  213:             f"Provenance rejected at the egress boundary: {leaks[0]}",
  214:             domain=invocation.domain,
  215:             provider_id=invocation.provider_id,
  216:         )
  217:     return result
  218: 
  219: 
  220: def check_artifacts(result: ProviderResult, invocation: ProviderInvocation) -> None:
  221:     """Every declared artifact must actually exist (Â§34.2 `PROVIDER_ARTIFACT_MISSING`).
  222: 
  223:     A ref whose destination was handed to `stage_artifact()` counts as produced:
  224:     it lives in the staging directory until the node succeeds and is only then
  225:     promoted, so checking the final path would fail every staged write.
  226:     """
  227:     stager = invocation.stage_artifact
  228:     staged = getattr(stager, "staged", None)
  229:     missing = []
  230:     for ref in result.artifact_refs:
  231:         absolute = resolve_ref(ref)
  232:         if os.path.exists(absolute):
  233:             continue
  234:         if callable(staged) and staged(absolute):
  235:             continue
  236:         missing.append(os.path.basename(ref))
  237:     if missing:
  238:         raise ProviderError(
  239:             E.PROVIDER_ARTIFACT_MISSING,
  240:             f"The provider declared {len(missing)} artifact(s) it did not produce",
  241:             domain=invocation.domain,
  242:             provider_id=invocation.provider_id,
  243:             details={"artifacts": missing[:20]},
  244:         )
  245: 
  246: 
  247: def build_provenance(
  248:     invocation: ProviderInvocation,
  249:     *,
  250:     provider_version: str = "",
  251:     contract_version: int = 1,
  252:     settings_version: int = 0,
  253:     started_at: str = "",
  254:     duration_ms: int = 0,
  255:     cache_hit: bool = False,
  256: ) -> Provenance:
  257:     """Fill Â§31.3 provenance. A provider can never write this."""
  258:     from studio.shared.providers_common import settings_manager
  259: 
  260:     return Provenance(
  261:         invocation_id=invocation.invocation_id,
  262:         domain=invocation.domain,
  263:         provider_id=invocation.provider_id,
  264:         provider_version=provider_version,
  265:         contract_version=contract_version,
  266:         settings_version=settings_version,
  267:         # The only echo of settings a result may carry (Â§36 L6).
  268:         resolved_settings_redacted=settings_manager.redact_settings(
  269:             dict(invocation.settings)
  270:         ),
  271:         options=dict(invocation.options),
  272:         selection_reason=invocation.selection_reason,
  273:         started_at=started_at,
  274:         finished_at=now_iso(),
  275:         duration_ms=duration_ms,
  276:         cache_hit=cache_hit,
  277:     )
  278: 
  279: 
