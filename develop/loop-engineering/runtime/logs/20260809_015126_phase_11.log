   44: # The persisted manifests store browser URLs (`/output/storyboard/pm_X/0/image.png`);
   45: # an envelope ref is the same value relative to OUTPUT_DIR.
   46: _OUTPUT_URL_PREFIX = "/output/"
   47: 
   48: 
   49: def ref_from_output_url(value: Any) -> str:
   50:     """`/output/a/b.png` -> `a/b.png`. Anything else becomes `""`."""
   51:     if not isinstance(value, str) or not value.strip():
   52:         return ""
   53:     normalized = value.replace("\\", "/").strip()
   54:     if normalized.startswith(_OUTPUT_URL_PREFIX):
   55:         return normalized[len(_OUTPUT_URL_PREFIX):]
   56:     return normalized.lstrip("/")
