### studio/shared/providers_common/results.py
    1: """The provider result envelope and the egress validator â€” step 11.4.
    2: 
    3: Implements contracts.md Â§31 (`ProviderResult`, `UnitResult`, provenance, partial
    4: results) and the mechanical half of Â§36: `validate_egress()` rejects absolute
    5: paths, sensitive keys, `bytes`, non-JSON types, and oversized fields *at the
    6: boundary*, so no raw provider exception, credential, arbitrary filesystem path,
    7: or provider-specific response can reach a workflow record or an API response.
    8: 
    9: One envelope serves all five domains; only `payload` varies by domain.
   10: """
   11: 
   12: from __future__ import annotations
   13: 
   14: import json
   15: import os
   16: import re
   17: from dataclasses import dataclass, field
   18: from typing import Any, Iterable, Mapping
   19: 
   20: from loguru import logger
   21: 
   22: from config import OUTPUT_DIR
   23: from studio.shared.providers_common.errors import (
   24:     PROVIDER_ARTIFACT_UNMANAGED,
   25:     PROVIDER_RESULT_INVALID,
   26:     ProviderError,
   27:     ProviderErrorPayload,
   28: )
   29: from studio.shared.providers_common.validation import sanitize_message
   30: 
   31: 
   32: RESULT_VERSION = 1
   33: 
   34: SUCCEEDED = "succeeded"
   35: PARTIAL = "partial"
   36: FAILED = "failed"
   37: ENVELOPE_STATES = frozenset({SUCCEEDED, PARTIAL, FAILED})
   38: 
   39: UNIT_SUCCEEDED = "succeeded"
   40: UNIT_FAILED = "failed"
   41: UNIT_SKIPPED = "skipped"
   42: UNIT_CANCELLED = "cancelled"
   43: UNIT_STATES = frozenset({UNIT_SUCCEEDED, UNIT_FAILED, UNIT_SKIPPED, UNIT_CANCELLED})
   44: 
   45: # Â§31.1 caps.
   46: METADATA_MAX_KEYS = 40
   47: METADATA_STRING_MAX = 500
   48: WARNINGS_MAX = 50
   49: WARNING_MESSAGE_MAX = 200
   50: 
   51: # A result field may not carry an absolute or UNC path (Â§31.2). POSIX absolute,
   52: # drive-letter, and UNC forms all count, on every platform: the check must not
   53: # depend on which OS produced the string.
   54: _ABSOLUTE_PATH_RE = re.compile(r"^(?:[A-Za-z]:[\\/]|\\\\|//[^/]|/(?!/))")
   55: 
