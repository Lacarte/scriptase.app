   39:         return _error("FORBIDDEN", "Provider endpoints are local-only", 403)
   40:     return None
   41: 
   42: 
   43: def _json_object():
   44:     """Return `(payload, None)` for a JSON object body, else `(None, error)`."""
   45:     data = request.get_json(silent=True)
   46:     if not isinstance(data, dict):
   47:         return None, _error("INVALID_REQUEST", "Expected JSON object", 400)
   48:     return data, None
   49: 
   50: 
   51: def _resolve_domain(domain):
   52:     """Return `(spec, None)` or `(None, error)` for an unknown domain."""
   53:     spec = DOMAINS.get(domain)
   54:     if spec is None:
   55:         return None, _error("UNKNOWN_DOMAIN", f"Unknown domain: {domain}", 400)
   56:     return spec, None
