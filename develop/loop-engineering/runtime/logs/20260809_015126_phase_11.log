  153: def storyboard_manifest_to_units(manifest: Mapping[str, Any]) -> list[UnitResult]:
  154:     """`storyboard.json` `scene_statuses` -> ordered `UnitResult`s (Â§31.5).
  155: 
  156:     Two egress rules are applied here rather than left to the caller: the remote
  157:     `image_url` is dropped (Â§36 L9) and the raw `str(e)` the route persists
  158:     becomes a `ProviderErrorPayload` (Â§31.5 rule 6, Â§36 L3).
  159:     """
  160:     statuses = dict(manifest.get("scene_statuses") or {})
  161:     units: list[UnitResult] = []
  162:     for key in sorted(statuses, key=_as_index):
  163:         if key == "-1":  # the single-scene sentinel the legacy route writes
  164:             continue
  165:         entry = statuses[key] if isinstance(statuses[key], Mapping) else {}
  166:         state = _STORYBOARD_UNIT_STATE.get(str(entry.get("status", "")), UNIT_SKIPPED)
  167:         refs = dedupe_refs([ref_from_output_url(entry.get("local_path"))])
  168:         metadata = {}
  169:         thumb = ref_from_output_url(entry.get("thumb_path"))
  170:         if thumb:
  171:             metadata["thumbnail_ref"] = thumb
  172:         units.append(UnitResult(
  173:             unit_index=_as_index(key),
  174:             state=state,
  175:             artifact_refs=tuple(refs),
  176:             metadata=metadata,
  177:             error=_unit_error(entry, state),
  178:         ))
  179:     return units
  180: 
