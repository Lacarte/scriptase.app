  293: @providers_bp.route("/api/providers/<domain>/selection", methods=["PUT"])
  294: def put_domain_selection(domain):
  295:     """Set the selected provider for one domain.
  296: 
  297:     The targeted replacement for the read-modify-write of the whole settings
  298:     document, which had a genuine lost-update window. Selection is never blocked
  299:     by availability or health: a `needs_configuration` or failing provider may be
  300:     selected and the issues travel back so the caller can prompt (Â§21.5, Â§24.2).
  301:     """
  302:     denied = _require_loopback()
  303:     if denied:
  304:         return denied
  305:     _, err = _resolve_domain(domain)
  306:     if err is not None:
  307:         return err
  308:     body, err = _json_object()
  309:     if err is not None:
  310:         return err
  311: 
  312:     provider_id = body.get("provider_id")
  313:     if not isinstance(provider_id, str) or not provider_id:
  314:         return _error("INVALID_REQUEST", "provider_id must be a non-empty string", 400)
  315: 
  316:     provider, err = _resolve_provider(domain, provider_id)
  317:     if err is not None:
  318:         return err
  319: 
  320:     stored = settings_manager.get_provider_settings(domain, provider.id)
  321:     # Always the canonical id â€” an alias is never written to settings (Â§19.3).
  322:     settings_manager.set_selected_provider(domain, provider.id)
  323:     return jsonify({
  324:         "domain": domain,
  325:         "selected": provider.id,
  326:         "availability": provider.availability(stored),
  327:         "issues": _issue_dicts(provider.validate_settings(stored)),
  328:     })
