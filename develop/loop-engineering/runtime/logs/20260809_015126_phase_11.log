 395: 
 396: def _deep_merge(base, patch):
 397:     """Recursively merge `patch` over `base`; a non-dict value replaces wholesale."""
 398:     merged = dict(base)
 399:     for key, value in patch.items():
 400:         current = merged.get(key)
 401:         if isinstance(value, dict) and isinstance(current, dict):
 402:             merged[key] = _deep_merge(current, value)
 403:         else:
 404:             merged[key] = value
 405:     return merged

