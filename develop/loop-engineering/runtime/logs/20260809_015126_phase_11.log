   61: # Keys of today's `_step_tts` metadata dict that become first-class payload
   62: # fields. Everything else stays in `metadata`, so `tts.json` consumers are
   63: # unaffected (Â§32.3).
   64: TTS_PAYLOAD_KEYS = frozenset({
   65:     "duration_seconds", "sample_rate", "voice", "characters_billed",
   66: })
   67: # Never copied into the envelope: `wav_path` is an absolute path (Â§36 L7) and
   68: # `job_meta` is superseded by `provenance` (Â§31.3, D39).
   69: TTS_DROPPED_KEYS = frozenset({"wav_path", "job_meta", "artifact_refs"})
