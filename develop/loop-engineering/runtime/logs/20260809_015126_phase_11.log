  51: def _resolve_domain(domain):
  52:     """Return `(spec, None)` or `(None, error)` for an unknown domain."""
  53:     spec = DOMAINS.get(domain)
  54:     if spec is None:
  55:         return None, _error("UNKNOWN_DOMAIN", f"Unknown domain: {domain}", 400)
  56:     return spec, None
