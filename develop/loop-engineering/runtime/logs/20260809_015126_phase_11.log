 249:     @staticmethod
 250:     def _regressions(live: CatalogSnapshot, candidate: CatalogSnapshot) -> list[str]:
 251:         """Providers that are registered now but excluded in the candidate snapshot.
 252: 
 253:         Pre-existing exclusions do not block a swap â€” otherwise one permanently
 254:         broken folder on disk would freeze the catalog forever.
 255:         """
 256:         excluded_now = {e.id for e in candidate.exclusions}
 257:         return sorted(
 258:             f"{provider_id} would be excluded"
 259:             for provider_id in live.providers
 260:             if provider_id in excluded_now
 261:         )
