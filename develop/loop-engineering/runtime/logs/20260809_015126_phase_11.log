  151:         self.module = module
  152:         self.provider_module = provider_module
  153:         self.schema_module = schema_module
  154:         self.manifest = manifest
  155:         self.warnings: list[str] = list(warnings or [])
  156:         self._settings_schema = None
  157:         self._schema_loaded = False
  158: 
  159:         self._create_lock = threading.RLock()
  160:         self._instance: Any = None
  161:         self._create_error: str | None = None
  162:         self._construction_seq: int | None = None
  163: 
  164:         self._lease_state = threading.Condition(threading.Lock())
  165:         self._leases = 0
  166:         self._retired = False
  167:         self._shutdown_done = False
  168: 
  169:     # -- metadata ----------------------------------------------------------
  170: 
  171:     def _resolve(self, attr_name: str) -> Any:
  172:         """Find a callable named `attr_name` across the loaded modules.
  173: 
  174:         Precedence: provider_module > schema_module > module (manifest).
  175:         """
  176:         for mod in (self.provider_module, self.schema_module, self.module):
  177:             if mod is not None and hasattr(mod, attr_name):
  178:                 return getattr(mod, attr_name)
  179:         return None
  180: 
  181:     @property
  182:     def label(self) -> str:
  183:         return self.manifest.label
  184: 
  185:     @property
  186:     def domain(self) -> str:
  187:         return self.manifest.domain
  188: 
  189:     @property
  190:     def kind(self) -> str:
  191:         return self.manifest.kind
  192: 
  193:     @property
  194:     def version(self) -> str:
  195:         return self.manifest.version
  196: 
  197:     @property
  198:     def contract_version(self) -> int:
  199:         return self.manifest.contract_version
  200: 
  201:     @property
  202:     def aliases(self) -> list[str]:
  203:         return list(self.manifest.aliases)
  204: 
  205:     @property
  206:     def capabilities(self) -> dict[str, bool]:
  207:         return self.manifest.capabilities
  208: 
  209:     @property
  210:     def requires(self) -> list[str]:
  211:         return self.manifest.requires
  212: 
  213:     @property
  214:     def schema_failed(self) -> bool:
  215:         """True when a `settings_schema.py` is present but produced no schema."""
  216:         return self.schema_module is not None and self.settings_schema() is None
  217: 
  218:     def add_warning(self, message: str) -> None:
  219:         """Record a browser-safe warning, de-duplicated (contracts.md Â§25)."""
  220:         safe = v.sanitize_message(message)
  221:         if safe and safe not in self.warnings:
  222:             self.warnings.append(safe)
  223: 
  224:     def settings_schema(self) -> dict | None:
  225:         """Lazy-load and memoize the settings schema (contracts.md Â§21.1)."""
  226:         if not self._schema_loaded:
  227:             self._schema_loaded = True
  228:             fn = self._resolve('settings_schema')
  229:             if fn is not None:
  230:                 try:
  231:                     self._settings_schema = fn()
  232:                 except Exception as e:
  233:                     logger.warning("[registry] Failed to get settings_schema for {}: {}", self.id, e)
  234:                     self.add_warning(f"settings_schema() failed: {e}")
  235:                     self._settings_schema = None
  236:         return self._settings_schema
  237: 
  238:     # -- settings (contracts.md Â§22) ---------------------------------------
  239: 
  240:     def resolve_settings(self, settings: dict | None) -> dict:
  241:         """Apply the manifest's environment fallbacks for provider-internal use.
  242: 
  243:         `settings[key] or os.environ[manifest.environment[key]]` (Â§22.6). The
  244:         resolved value is never written back to `settings.json` and never
  245:         returned to a caller that serializes it â€” only provider validation,
  246:         health, and invocation see it.
  247:         """
  248:         resolved = dict(settings or {})
  249:         for key, env_name in self.manifest.environment.items():
  250:             if not schema_tools.is_empty(resolved.get(key)):
  251:                 continue
  252:             from_env = os.environ.get(env_name)
  253:             if from_env:
  254:                 resolved[key] = from_env
  255:         return resolved
  256: 
  257:     def is_configured(self, settings: dict | None = None) -> bool:
  258:         """Every `requires` key is non-empty after env fallback (Â§21.5).
  259: 
  260:         Computed from `requires`, never from key presence: the live settings file
  261:         stores present-but-empty `api_key` values (Â§14.3).
  262:         """
  263:         resolved = self.resolve_settings(settings)
  264:         return all(
  265:             not schema_tools.is_empty(resolved.get(key)) for key in self.requires
  266:         )
  267: 
  268:     def availability(self, settings: dict | None = None) -> str:
  269:         """Cheap, synchronous availability state (contracts.md Â§21.5)."""
  270:         if self.create_callable is None or self._create_error is not None:
  271:             return DEGRADED
  272:         if self.schema_failed:
  273:             return DEGRADED
  274:         if not self.is_configured(settings):
  275:             return NEEDS_CONFIGURATION
  276:         return AVAILABLE
  277: 
  278:     def validate_settings(self, settings: dict | None) -> list[ValidationIssue]:
  279:         """Validate settings against the schema, then through the provider hook.
  280: 
  281:         Never cached â€” the settings differ per call. Schema validation is the
  282:         server-side half the provider cannot skip; the hook adds whatever the
  283:         provider knows that the schema cannot express.
  284:         """
  285:         resolved = self.resolve_settings(settings)
  286:         issues = [
  287:             ValidationIssue(**issue)
  288:             for issue in schema_tools.validate_against_schema(
  289:                 self.settings_schema(), resolved
  290:             )
  291:         ]
  292: 
  293:         fn = self._resolve('validate_settings')
  294:         if fn is None:
  295:             return issues
  296: 
  297:         try:
  298:             raw_issues = fn(resolved)
  299:         except Exception as e:
  300:             # Never `str(e)`: a provider exception can contain a submitted secret
  301:             # (Â§22.5). The raw exception goes only to the redacted logger.
  302:             logger.warning("[registry] validate_settings failed for {}: {}", self.id, e)
  303:             issues.append(ValidationIssue(
  304:                 field='root', severity='error', message='Settings validation failed'
  305:             ))
  306:             return issues
  307: 
  308:         seen = {(i.field, i.severity, i.message) for i in issues}
  309:         for raw in raw_issues or []:
  310:             issue = (
  311:                 ValidationIssue(
  312:                     field=raw.get('field', ''),
  313:                     severity=raw.get('severity', 'warning'),
  314:                     message=raw.get('message', ''),
  315:                 )
  316:                 if isinstance(raw, dict)
  317:                 else raw
  318:             )
  319:             key = (issue.field, issue.severity, issue.message)
  320:             if key not in seen:
  321:                 seen.add(key)
  322:                 issues.append(issue)
  323:         return issues
  324: 
  325:     def health_check(self, settings: dict | None) -> HealthResult:
  326:         """Check provider health. May perform I/O; runs on explicit user action."""
  327:         fn = self._resolve('health_check')
  328:         if fn is None:
  329:             # A provider with no hook is `unknown`, not `ok` (Â§21.5, frozen
  330:             # correction): claiming health it never reported is a lie.
  331:             return HealthResult(status='unknown', message='No health check implemented')
  332:         try:
  333:             result = fn(self.resolve_settings(settings))
  334:         except Exception as e:
  335:             logger.warning("[registry] health_check failed for {}: {}", self.id, e)
  336:             return HealthResult(status='fail', message=v.sanitize_message(e))
  337:         if isinstance(result, dict):
  338:             message = result.get('message')
  339:             return HealthResult(
  340:                 status=result.get('status', 'unknown'),
  341:                 latency_ms=result.get('latency_ms'),
  342:                 # A *returned* message is as untrusted as a raised one: several
  343:                 # shipped hooks answer `{"status": "fail", "message": str(e)}`,
  344:                 # which can carry a URL, a path, or a response body (Â§36 L4).
  345:                 message=v.sanitize_message(message) if message else message,
  346:                 details=result.get('details'),
  347:             )
  348:         if isinstance(result, str):
  349:             return HealthResult(status=result)
  350:         return result
  351: 
  352:     # -- construction (contracts.md Â§21.1) ---------------------------------
  353: 
  354:     @property
  355:     def create_callable(self) -> Any:
  356:         """The zero-argument factory, or `None` when the provider cannot be built."""
  357:         for name in self.FACTORY_NAMES:
  358:             fn = self._resolve(name)
  359:             if callable(fn):
  360:                 return fn
  361:         return None
  362: 
  363:     @property
  364:     def constructed(self) -> bool:
  365:         return self._instance is not None
  366: 
  367:     @property
  368:     def create_error(self) -> str | None:
  369:         return self._create_error
  370: 
  371:     @property
  372:     def construction_seq(self) -> int | None:
  373:         """Monotonic construction order, used to shut down in reverse."""
  374:         return self._construction_seq
  375: 
  376:     def create(self) -> Any:
  377:         """Construct the provider at most once per process.
  378: 
  379:         Never called at import time or during discovery, and never while the
  380:         registry lock is held: the lock taken here belongs to this instance alone.
  381:         """
  382:         if self._instance is not None:
  383:             return self._instance
  384:         with self._create_lock:
  385:             if self._instance is not None:
  386:                 return self._instance
  387:             if self._retired:
  388:                 raise ProviderConstructionError(self.domain, self.id, "provider was retired")
  389:             if self._create_error is not None:
  390:                 raise ProviderConstructionError(self.domain, self.id, self._create_error)
  391:             factory = self.create_callable
  392:             if factory is None:
  393:                 self._create_error = "no create() factory found in the provider package"
  394:                 self.add_warning(self._create_error)
  395:                 raise ProviderConstructionError(self.domain, self.id, self._create_error)
  396:             try:
  397:                 instance = factory()
  398:             except Exception as e:
  399:                 self._create_error = v.sanitize_message(f"create() raised: {e}")
  400:                 self.add_warning(self._create_error)
  401:                 logger.error("[registry] create() failed for {}/{}: {}", self.domain, self.id, e)
  402:                 raise ProviderConstructionError(self.domain, self.id, self._create_error) from None
  403:             if instance is None:
  404:                 self._create_error = "create() returned None"
  405:                 self.add_warning(self._create_error)
  406:                 raise ProviderConstructionError(self.domain, self.id, self._create_error)
  407:             self._instance = instance
  408:             self._construction_seq = next(_construction_counter)
  409:             logger.info("[registry] Constructed provider '{}' in {}", self.id, self.domain)
  410:             return instance
  411: 
  412:     # -- invocation leases (contracts.md Â§21.2 item 6) ---------------------
  413: 
  414:     @contextmanager
  415:     def lease(self):
  416:         """Hold the provider open for one invocation.
  417: 
  418:         A snapshot swap may drop this provider while a request is still using it;
  419:         `retire()` waits for outstanding leases before calling `shutdown()`.
  420:         """
  421:         with self._lease_state:
  422:             if self._retired:
  423:                 raise ProviderConstructionError(self.domain, self.id, "provider was retired")
  424:             self._leases += 1
  425:         try:
  426:             yield self
  427:         finally:
  428:             with self._lease_state:
  429:                 self._leases -= 1
  430:                 if self._leases <= 0:
  431:                     self._lease_state.notify_all()
  432: 
  433:     @property
  434:     def active_leases(self) -> int:
  435:         with self._lease_state:
  436:             return self._leases
  437: 
  438:     def retire(self, timeout: float = 5.0) -> None:
  439:         """Stop new leases, wait for in-flight ones, then shut down."""
  440:         with self._lease_state:
  441:             self._retired = True
  442:             if self._leases > 0:
  443:                 drained = self._lease_state.wait_for(lambda: self._leases <= 0, timeout=timeout)
  444:                 if not drained:
  445:                     logger.warning(
  446:                         "[registry] {}/{}: {} lease(s) still active after {}s; shutting down anyway",
  447:                         self.domain, self.id, self._leases, timeout,
  448:                     )
  449:         self.shutdown()
  450: 
  451:     def shutdown(self) -> None:
  452:         """Release a constructed provider. Best-effort and idempotent (Â§21.1)."""
  453:         with self._create_lock:
  454:             if self._shutdown_done:
  455:                 return
  456:             self._shutdown_done = True
  457:             instance = self._instance
  458:             self._instance = None
  459:         if instance is None:
  460:             return
  461:         hook = getattr(instance, "shutdown", None)
  462:         if not callable(hook):
  463:             return
  464:         try:
  465:             hook()
  466:             logger.debug("[registry] Shut down provider '{}' in {}", self.id, self.domain)
  467:         except Exception as e:
  468:             # Never raised: one provider's teardown may not abort the rest (Â§21.1).
  469:             self.add_warning(f"shutdown() failed: {e}")
  470:             logger.error("[registry] shutdown() failed for {}/{}: {}", self.domain, self.id, e)
  471: 
  472:     # -- serialization (contracts.md Â§25) ----------------------------------
  473: 
  474:     def to_dict(self, settings: dict | None = None) -> dict:
  475:         """Browser-safe projection (contracts.md Â§25).
  476: 
  477:         Never exposes modules, paths, settings values, or the manifest's internal
  478:         `environment` map. `settings` is read only to compute `availability` and
  479:         is never echoed back.
  480:         """
  481:         payload = self.manifest.public_dict()
  482:         payload.update({
  483:             'has_settings': self.settings_schema() is not None,
  484:             'availability': self.availability(settings),
  485:             'warnings': list(self.warnings),
  486:         })
  487:         return payload
  488: 
  489: 
  490: @dataclass(frozen=True)
  491: class CatalogSnapshot:
  492:     """An immutable, fully validated view of one domain's providers.
  493: 
  494:     Published by a single attribute assignment so readers see either the complete
  495:     old catalog or the complete new one (contracts.md Â§21.2 item 6).
  496:     """
  497: 
  498:     providers: dict[str, ProviderInstance] = field(default_factory=dict)
  499:     aliases: dict[str, str] = field(default_factory=dict)
  500:     exclusions: tuple[ProviderExclusion, ...] = ()
  501: 
  502:     def resolve(self, provider_id: str) -> ProviderInstance | None:
  503:         """Exact id first, then alias â€” a real id always wins (contracts.md Â§19.3)."""
  504:         found = self.providers.get(provider_id)
  505:         if found is not None:
  506:             return found
  507:         canonical = self.aliases.get(provider_id)
  508:         return self.providers.get(canonical) if canonical else None
  509: 
  510: 
  511: EMPTY_SNAPSHOT = CatalogSnapshot()
  512: 
  513: 
  514: class _CatalogBuilder:
  515:     """Accumulates a private snapshot during discovery; nothing is visible yet."""
  516: 
  517:     def __init__(self, domain: str):
  518:         self.domain = domain
  519:         self.providers: dict[str, ProviderInstance] = {}
  520:         self.exclusions: list[ProviderExclusion] = []
  521: 
  522:     def exclude(self, provider_id: str, reason_code: str, message: str) -> None:
  523:         safe = v.sanitize_message(message)
  524:         self.exclusions.append(ProviderExclusion(provider_id, reason_code, safe))
  525:         logger.warning("[registry] [EXCLUDED] {} ({}): {}", provider_id, reason_code, safe)
  526: 
  527:     def add(self, instance: ProviderInstance) -> bool:
  528:         if instance.domain != self.domain:
  529:             self.exclude(
  530:                 instance.id,
  531:                 v.MANIFEST_DOMAIN_MISMATCH,
  532:                 f"declares domain {instance.domain!r}, registered under {self.domain!r}",
  533:             )
  534:             return False
  535:         if instance.id in self.providers:
  536:             # First registration wins; the later one never replaces the incumbent.
  537:             self.exclude(
  538:                 instance.id, v.DUPLICATE_ID, f"id already registered in domain {self.domain!r}"
  539:             )
  540:             return False
  541:         self.providers[instance.id] = instance
  542:         logger.info(
  543:             "[registry] Registered provider '{}' ({}) in {}",
  544:             instance.id, instance.label, self.domain,
  545:         )
  546:         return True
  547: 
  548:     def build(self) -> CatalogSnapshot:
  549:         """Resolve aliases last, so a real id always beats an alias (Â§19.3)."""
  550:         aliases: dict[str, str] = {}
  551:         for provider in self.providers.values():
  552:             for alias in provider.aliases:
  553:                 if alias in self.providers:
  554:                     provider.add_warning(f"alias dropped (collides with provider id): {alias}")
  555:                     continue
  556:                 incumbent = aliases.get(alias)
  557:                 if incumbent is not None:
  558:                     # Both sides are warned; neither provider is excluded (Â§19.3).
  559:                     provider.add_warning(f"alias dropped (claimed by '{incumbent}'): {alias}")
  560:                     self.providers[incumbent].add_warning(
  561:                         f"alias also claimed by '{provider.id}': {alias}"
  562:                     )
  563:                     continue
  564:                 aliases[alias] = provider.id
  565:         return CatalogSnapshot(
  566:             providers=dict(self.providers),
  567:             aliases=aliases,
  568:             exclusions=tuple(self.exclusions),
  569:         )
  570: 
  571: 
  572: class ProviderRegistry:
  573:     """Domain-scoped provider registry with discovery."""
  574: 
  575:     # Derived from the domain catalog â€” never write a domain name here (Â§19.1).
  576:     VALID_DOMAINS = DOMAIN_IDS
  577: 
  578:     def __init__(
  579:         self,
  580:         domain: str,
  581:         valid_domains: frozenset[str] | None = None,
  582:         capability_vocabulary: frozenset[str] | None = None,
  583:     ):
  584:         allowed = self.VALID_DOMAINS if valid_domains is None else valid_domains
  585:         if domain not in allowed:
  586:             raise ValueError(f"Invalid domain: {domain}. Must be one of {sorted(allowed)}")
  587:         self.domain = domain
  588:         self.capability_vocabulary = capability_vocabulary
  589:         self._snapshot: CatalogSnapshot = EMPTY_SNAPSHOT
  590:         self._lock = threading.RLock()
  591:         self._discovered = False
  592: 
  593:     # -- reads (lock-free: one attribute read of an immutable snapshot) ----
  594: 
  595:     @property
  596:     def snapshot(self) -> CatalogSnapshot:
  597:         return self._snapshot
  598: 
  599:     def get(self, provider_id: str) -> ProviderInstance | None:
  600:         """Get a provider by canonical id, then by alias."""
  601:         return self._snapshot.resolve(provider_id)
  602: 
  603:     def list_providers(self) -> list[ProviderInstance]:
  604:         """List all registered providers."""
  605:         return list(self._snapshot.providers.values())
  606: 
  607:     def list_ids(self) -> list[str]:
  608:         """List all provider IDs."""
  609:         return list(self._snapshot.providers)
  610: 
  611:     def excluded(self) -> list[dict]:
  612:         """Providers discovery refused, as data rather than only a log line (Â§21.4)."""
  613:         return [e.to_dict() for e in self._snapshot.exclusions]
  614: 
  615:     def aliases(self) -> dict[str, str]:
  616:         """`alias -> canonical id` for this domain."""
  617:         return dict(self._snapshot.aliases)
  618: 
  619:     def __len__(self) -> int:
  620:         return len(self._snapshot.providers)
  621: 
  622:     # -- writes ------------------------------------------------------------
  623: 
  624:     def publish(self, snapshot: CatalogSnapshot) -> list[ProviderInstance]:
  625:         """Swap in a new snapshot atomically; return the providers it dropped."""
  626:         with self._lock:
  627:             previous = self._snapshot
  628:             self._snapshot = snapshot
  629:         return [
  630:             provider
  631:             for provider_id, provider in previous.providers.items()
  632:             if snapshot.providers.get(provider_id) is not provider
  633:         ]
  634: 
  635:     def register(
  636:         self,
  637:         provider_id: str,
  638:         module: Any,
  639:         manifest: ProviderManifest,
  640:         provider_module: Any = None,
  641:         schema_module: Any = None,
  642:     ) -> None:
  643:         """Register one provider outside of a discovery scan (copy-on-write)."""
  644:         with self._lock:
  645:             builder = _CatalogBuilder(self.domain)
  646:             builder.providers.update(self._snapshot.providers)
  647:             builder.exclusions.extend(self._snapshot.exclusions)
  648:             builder.add(ProviderInstance(
  649:                 provider_id, module, manifest,
  650:                 provider_module=provider_module,
  651:                 schema_module=schema_module,
  652:             ))
  653:             self._snapshot = builder.build()
  654: 
  655:     def reset(self) -> None:
  656:         """Drop every registration so the next discovery re-scans from disk.
  657: 
  658:         Clears in place: the per-module compatibility facades hold this object.
  659:         """
  660:         with self._lock:
  661:             dropped = self.publish(EMPTY_SNAPSHOT)
  662:             self._discovered = False
  663:         for provider in dropped:
  664:             provider.retire()
  665: 
  666:     def shutdown_instances(self) -> None:
  667:         """Shut down every constructed provider in reverse construction order (Â§21.1)."""
  668:         constructed = [p for p in self.list_providers() if p.construction_seq is not None]
  669:         for provider in sorted(constructed, key=lambda p: p.construction_seq, reverse=True):
  670:             provider.shutdown()
  671: 
  672:     # -- discovery ---------------------------------------------------------
  673: 
  674:     def discovery_scan(self, providers_base: str) -> None:
  675:         """Scan provider folders and publish the result as one atomic swap."""
  676:         # Marked before the scan, not after: a provider module that imports its own
  677:         # package (e.g. `from studio.tts.providers.base import ...`) re-enters
  678:         # discovery, and the second scan would re-register every provider.
  679:         self._discovered = True
  680:         dropped = self.publish(self.build_snapshot(providers_base))
  681:         for provider in dropped:
  682:             provider.retire()
  683: 
  684:     def build_snapshot(self, providers_base: str) -> CatalogSnapshot:
  685:         """Scan `providers_base` into a private snapshot without publishing it."""
  686:         builder = _CatalogBuilder(self.domain)
  687: 
  688:         if not os.path.isdir(providers_base):
  689:             logger.debug("[registry] Provider base not found: {}", providers_base)
  690:             return builder.build()
  691: 
  692:         # sorted() so discovery logs, catalog responses, and "first wins" duplicate
  693:         # resolution are deterministic (contracts.md Â§21.2 item 2).
  694:         for entry in sorted(os.listdir(providers_base)):
  695:             provider_path = os.path.join(providers_base, entry)
  696:             if not os.path.isdir(provider_path):
  697:                 continue
  698:             if entry.startswith('_') or entry.startswith('.'):
  699:                 continue
  700: 
  701:             manifest_file = os.path.join(provider_path, 'manifest.py')
  702:             if not os.path.isfile(manifest_file):
  703:                 logger.debug("[registry] No manifest.py in {}, skipping", entry)
  704:                 continue
  705: 
  706:             instance = self._load_provider(builder, entry, provider_path, manifest_file)
  707:             if instance is not None:
  708:                 builder.add(instance)
  709: 
  710:         return builder.build()
  711: 
  712:     def _load_module_from_file(self, file_path: str, module_name: str) -> Any:
  713:         """Load a Python module from a file path. Returns module or None on failure."""
  714:         try:
  715:             spec = importlib.util.spec_from_file_location(module_name, file_path)
  716:             if spec is None or spec.loader is None:
  717:                 return None
  718:             module = importlib.util.module_from_spec(spec)
  719:             spec.loader.exec_module(module)
  720:             return module
  721:         except Exception as e:
  722:             logger.warning("[registry] Failed to load {}: {}", file_path, e)
  723:             return None
  724: 
  725:     def _load_provider(
  726:         self,
  727:         builder: _CatalogBuilder,
  728:         provider_id: str,
  729:         provider_path: str,
  730:         manifest_file: str,
  731:     ) -> ProviderInstance | None:
  732:         """Validate one provider package.
  733: 
  734:         Records an exclusion and returns `None` on failure; the caller adds the
  735:         instance to the private snapshot on success.
  736:         """
  737:         module_prefix = f"_sts_provider_{self.domain}_{provider_id}"
  738: 
  739:         try:
  740:             spec = importlib.util.spec_from_file_location(
  741:                 f"{module_prefix}_manifest", manifest_file
  742:             )
  743:             if spec is None or spec.loader is None:
  744:                 builder.exclude(
  745:                     provider_id, v.MANIFEST_LOAD_FAILED, "could not load manifest.py (spec failed)"
  746:                 )
  747:                 return None
  748:             module = importlib.util.module_from_spec(spec)
  749:             spec.loader.exec_module(module)
  750:         except Exception as e:
  751:             builder.exclude(
  752:                 provider_id, v.MANIFEST_LOAD_FAILED, f"{type(e).__name__} in manifest.py: {e}"
  753:             )
  754:             return None
  755: 
  756:         manifest_fn = getattr(module, 'manifest', None)
  757:         if not callable(manifest_fn):
  758:             builder.exclude(provider_id, v.MANIFEST_MISSING, "manifest() function not found")
  759:             return None
  760: 
  761:         try:
  762:             payload = manifest_fn()
  763:         except Exception as e:
  764:             builder.exclude(provider_id, v.MANIFEST_RAISED, f"manifest() raised: {e}")
  765:             return None
  766: 
  767:         result = v.validate_manifest(
  768:             folder_id=provider_id,
  769:             domain=self.domain,
  770:             payload=payload,
  771:             manifest_cls=ProviderManifest,
  772:             capability_vocabulary=self.capability_vocabulary,
  773:         )
  774:         if not result.ok:
  775:             builder.exclude(provider_id, result.reason_code, result.message)
  776:             return None
  777: 
  778:         instance = ProviderInstance(
  779:             provider_id, module, result.manifest, warnings=result.warnings
  780:         )
  781: 
  782:         provider_file = os.path.join(provider_path, 'provider.py')
  783:         if os.path.isfile(provider_file):
  784:             provider_module = self._load_module_from_file(
  785:                 provider_file, f"{module_prefix}_provider"
  786:             )
  787:             if provider_module is None:
  788:                 # Not fatal on its own: callables may live in manifest.py and
  789:                 # `_resolve` falls back across modules (Â§21.4 partial degradation).
  790:                 instance.add_warning("provider.py failed to load")
  791:             instance.provider_module = provider_module
  792: 
  793:         schema_file = os.path.join(provider_path, 'settings_schema.py')
  794:         if os.path.isfile(schema_file):
  795:             schema_module = self._load_module_from_file(
  796:                 schema_file, f"{module_prefix}_schema"
  797:             )
  798:             if schema_module is None:
  799:                 instance.add_warning("settings_schema.py failed to load")
  800:             instance.schema_module = schema_module
  801: 
  802:         if instance.create_callable is None:
  803:             instance.add_warning("no create() factory found in the provider package")
  804: 
  805:         return instance
  806: 
  807:     def to_dict(
  808:         self,
  809:         selected_provider: str | None = None,
  810:         settings_for: Any = None,
  811:     ) -> dict:
  812:         """Serialize registry state for API response (contracts.md Â§25).
  813: 
  814:         `settings_for` is an optional `(provider_id) -> dict` lookup used only to
  815:         compute each provider's availability. Injected rather than imported so the
  816:         registry stays independent of the settings store.
  817:         """
  818:         return {
  819:             'domain': self.domain,
  820:             'providers': [
  821:                 p.to_dict(settings_for(p.id) if settings_for is not None else None)
  822:                 for p in self.list_providers()
  823:             ],
  824:             'selected': selected_provider,
  825:             'count': len(self),
  826:             'excluded': self.excluded(),
  827:         }
### studio/shared/providers_common/settings_manager.py
    1: """Settings Manager â€” load, save, validate, atomic writes, redaction.
    2: 
    3: Canonical source of truth for nested provider settings at settings/settings.json,
    4: and the single authority for `domains.<domain>.selected_provider` (contracts.md
    5: Â§24). Thread-safe with file locking.
    6: 
    7: Step 11.3 moved the secret vocabulary into `settings_schema` and made environment
    8: variables a read-time fallback rather than a seed (Â§22.6): nothing here copies an
    9: API key out of the environment, and first-run seeding never writes a selection.
   10: """
   11: 
   12: import json
   13: import os
   14: import tempfile
   15: import threading
   16: from typing import Any
   17: 
   18: from loguru import logger
   19: 
   20: from config import APP_CONFIG_PATH, ROOT_DIR
   21: from studio.shared.providers_common.domains import DOMAINS
   22: from studio.shared.providers_common.settings_migrations import (
   23:     SETTINGS_VERSION,
   24:     apply_migrations,
   25: )
   26: from studio.shared.providers_common.settings_schema import (
   27:     REDACTION_SENTINEL,
   28:     SENSITIVE_KEYS_RE,
   29:     apply_settings_patch,
   30:     redact,
   31:     split_settings,
   32: )
   33: 
   34: 
   35: SETTINGS_DIR = os.path.join(ROOT_DIR, "settings")
   36: SETTINGS_PATH = os.path.join(SETTINGS_DIR, "settings.json")
   37: 
   38: _lock = threading.RLock()
   39: 
   40: 
   41: def _ensure_settings_dir() -> None:
   42:     """Ensure the settings directory exists."""
   43:     os.makedirs(SETTINGS_DIR, exist_ok=True)
   44: 
   45: 
   46: _settings_seeded = False
   47: 
   48: 
   49: def _read_legacy_user_settings() -> dict:
   50:     """Read `app-config.json["user"]` â€” the retired selection store (Â§24.3).
   51: 
   52:     Injected into the migration boundary here rather than imported from the editor
   53:     blueprint's private helper, so migrations never depend on a route module.
   54:     """
   55:     try:
   56:         with open(APP_CONFIG_PATH, "r", encoding="utf-8") as handle:
   57:             config = json.load(handle)
   58:     except (FileNotFoundError, json.JSONDecodeError, OSError):
   59:         return {}
   60:     user = config.get("user") if isinstance(config, dict) else None
   61:     return user if isinstance(user, dict) else {}
   62: 
   63: 
   64: def load_settings() -> dict:
   65:     """Load settings from settings/settings.json, applying migrations if needed.
   66: 
   67:     On first load, seeds non-secret defaults from environment variables if
   68:     settings.json does not exist. Returns the full settings dict with version,
   69:     general, and domains keys.
   70:     """
   71:     global _settings_seeded
   72: 
   73:     _ensure_settings_dir()
   74: 
   75:     with _lock:
   76:         try:
   77:             with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
   78:                 data = json.load(f)
   79:         except FileNotFoundError:
   80:             logger.warning("[settings] settings.json not found, seeding defaults")
   81:             data = _seed_from_env()
   82:             save_settings(data)
   83:             _settings_seeded = True
   84:             return data
   85:         except json.JSONDecodeError as e:
   86:             logger.error("[settings] Corrupted settings.json: {}, returning defaults", e)
   87:             return _default_settings()
   88: 
   89:     migrated, changed = apply_migrations(data, _read_legacy_user_settings())
   90:     if changed:
   91:         logger.info("[settings] Applied migrations, version now {}", migrated.get("version"))
   92:         # The version stamp and the adopted values are written in one atomic
   93:         # replace; an interrupted write leaves the old version on disk and the
   94:         # next load retries the migration (Â§24.3).
   95:         save_settings(migrated)
   96: 
   97:     return migrated
   98: 
   99: 
  100: def _seed_from_env() -> dict:
  101:     """Seed default settings from environment variables.
  102: 
  103:     Secrets are deliberately **not** seeded: an API key in the environment is a
  104:     read-time fallback resolved from the provider manifest's `environment` map,
  105:     never a value copied into settings.json (Â§22.6). Seeding also never writes a
  106:     `selected_provider` â€” the `INWORLD_API_KEY` selection side effect is removed
  107:     (Â§14.3, Â§22.6).
  108:     """
  109:     def env(key: str, default: str = "") -> str:
  110:         return os.environ.get(key) or default
  111: 
  112:     settings = _default_settings()
  113: 
  114:     sync_folder = env("STS_SYNC_FOLDER")
  115:     if sync_folder:
  116:         settings["general"]["sync_folder"] = sync_folder
  117: 
  118:     settings["general"]["auto_sync"] = env("STS_AUTO_SYNC", "true").lower() in (
  119:         "true", "1", "yes"
  120:     )
  121: 
  122:     logger.info("[settings] Seeded settings from environment variables")
  123:     return settings
  124: 
  125: 
  126: def save_settings(data: dict) -> None:
  127:     """Save settings to settings/settings.json atomically.
  128: 
  129:     Uses write-to-temp-then-rename for atomicity.
  130:     """
  131:     _ensure_settings_dir()
  132: 
  133:     with _lock:
  134:         temp_fd, temp_path = tempfile.mkstemp(
  135:             dir=SETTINGS_DIR,
  136:             prefix=".settings_",
  137:             suffix=".tmp"
  138:         )
  139:         try:
  140:             with os.fdopen(temp_fd, "w", encoding="utf-8", newline="\n") as f:
  141:                 json.dump(data, f, indent=2, ensure_ascii=False)
  142:                 f.write("\n")
  143:                 f.flush()
  144:                 os.fsync(f.fileno())
  145:             os.replace(temp_path, SETTINGS_PATH)
  146:             logger.debug("[settings] Saved settings.json")
  147:         except Exception:
  148:             if os.path.exists(temp_path):
  149:                 os.unlink(temp_path)
  150:             raise
  151: 
  152: 
  153: def _default_settings() -> dict:
  154:     """Return the default settings structure at the current version.
  155: 
  156:     The `domains` block is generated from the domain catalog (Â§19.1) so it can never
  157:     drift from `ProviderRegistry.VALID_DOMAINS` or `validate_settings`.
  158:     """
  159:     return {
  160:         "version": SETTINGS_VERSION,
  161:         "general": {
  162:             "default_style": "cinematic",
  163:             "sync_folder": "",
  164:             "auto_sync": False
  165:         },
  166:         "domains": {
  167:             spec.id: {
  168:                 "selected_provider": spec.default_provider,
  169:                 "per_provider": {}
  170:             }
  171:             for spec in DOMAINS.values()
  172:         }
  173:     }
  174: 
  175: 
  176: def get_domain_settings(domain: str) -> dict:
  177:     """Get settings for a specific domain."""
  178:     settings = load_settings()
  179:     return settings.get("domains", {}).get(domain, {})
  180: 
  181: 
  182: def get_provider_settings(domain: str, provider_id: str) -> dict:
  183:     """Get stored settings for a specific provider.
  184: 
  185:     Values are returned exactly as stored â€” never resolved against the
  186:     environment. Environment fallbacks are provider-internal (Â§22.6).
  187:     """
  188:     domain_settings = get_domain_settings(domain)
  189:     return domain_settings.get("per_provider", {}).get(provider_id, {})
  190: 
  191: 
  192: def set_provider_settings(domain: str, provider_id: str, provider_settings: dict) -> None:
  193:     """Set settings for a specific provider."""
  194:     settings = load_settings()
  195:     if "domains" not in settings:
  196:         settings["domains"] = {}
  197:     if domain not in settings["domains"]:
  198:         settings["domains"][domain] = {"selected_provider": None, "per_provider": {}}
  199:     if "per_provider" not in settings["domains"][domain]:
  200:         settings["domains"][domain]["per_provider"] = {}
  201: 
  202:     settings["domains"][domain]["per_provider"][provider_id] = provider_settings
  203:     save_settings(settings)
  204: 
  205: 
  206: def set_selected_provider(domain: str, provider_id: str) -> None:
  207:     """Set the selected provider for a domain."""
  208:     settings = load_settings()
  209:     if "domains" not in settings:
  210:         settings["domains"] = {}
  211:     if domain not in settings["domains"]:
  212:         settings["domains"][domain] = {"selected_provider": None, "per_provider": {}}
  213: 
  214:     settings["domains"][domain]["selected_provider"] = provider_id
  215:     save_settings(settings)
  216: 
  217: 
  218: def get_general_settings() -> dict:
  219:     """Get general settings."""
  220:     settings = load_settings()
  221:     return settings.get("general", {})
  222: 
  223: 
  224: def set_general_settings(general_settings: dict) -> None:
  225:     """Set general settings."""
  226:     settings = load_settings()
  227:     settings["general"] = general_settings
  228:     save_settings(settings)
  229: 
  230: 
  231: def redact_settings(data: dict, schema: dict | None = None) -> dict:
  232:     """Redact secret fields from a settings payload before it leaves the process.
  233: 
  234:     A field is secret when its key matches `SENSITIVE_KEYS_RE` or, when a provider
  235:     settings schema is supplied, when its widget is a password input (Â§22.6).
  236:     """
  237:     return redact(data, schema)
  238: 
  239: 
  240: def redacted_provider_settings(domain: str, provider_id: str, schema: dict | None = None) -> dict:
  241:     """Get redacted settings for a specific provider."""
  242:     return redact_settings(get_provider_settings(domain, provider_id), schema)
  243: 
  244: 
  245: def portable_provider_settings(domain: str, provider_id: str, schema: dict | None = None) -> dict:
  246:     """The non-secret half of a provider's settings.
  247: 
  248:     Durable secrets stay in `settings.json`; only these portable options may be
  249:     copied into a job manifest, a workflow snapshot, or an export (Â§22.6).
  250:     """
  251:     _, options = split_settings(schema, get_provider_settings(domain, provider_id))
  252:     return options
  253: 
  254: 
  255: def merge_provider_settings(
  256:     domain: str, provider_id: str, patch: dict, schema: dict | None = None
  257: ) -> dict:
  258:     """Merge a client patch over stored provider settings, honoring the sentinel.
  259: 
  260:     A secret field submitted as exactly `"***"` is the redacted value the client
  261:     was served and leaves the stored secret untouched (Â§22.6).
  262:     """
  263:     return apply_settings_patch(get_provider_settings(domain, provider_id), patch, schema)
  264: 
  265: 
  266: def restore_redacted_secrets(stored: Any, incoming: Any) -> Any:
  267:     """Recursively drop sentinel secrets from a whole-document settings write.
  268: 
  269:     `PUT /api/settings/v2` round-trips the entire document, so a redacted read
  270:     would otherwise write `"***"` over every stored secret.
  271:     """
  272:     if not isinstance(incoming, dict):
  273:         return incoming
  274:     stored = stored if isinstance(stored, dict) else {}
  275:     result: dict = {}
  276:     for key, value in incoming.items():
  277:         if value == REDACTION_SENTINEL and SENSITIVE_KEYS_RE.search(key):
  278:             if key in stored:
  279:                 result[key] = stored[key]
  280:             continue
  281:         if isinstance(value, dict):
  282:             result[key] = restore_redacted_secrets(stored.get(key), value)
  283:         else:
  284:             result[key] = value
  285:     return result
  286: 
  287: 
  288: def validate_settings(data: dict) -> list[dict]:
  289:     """Validate the settings document structure.
  290: 
  291:     Returns list of ValidationIssue dicts with 'field', 'severity', 'message'.
  292:     """
  293:     issues = []
  294: 
  295:     if not isinstance(data, dict):
  296:         return [{"field": "root", "severity": "error", "message": "Settings must be a JSON object"}]
  297: 
  298:     version = data.get("version")
  299:     if version is None:
  300:         issues.append({"field": "version", "severity": "warning", "message": "version field missing, assuming v1"})
  301: 
  302:     domains = data.get("domains")
  303:     if not isinstance(domains, dict):
  304:         issues.append({"field": "domains", "severity": "error", "message": "domains must be an object"})
  305:     else:
  306:         for domain in domains:
  307:             if domain not in DOMAINS:
  308:                 issues.append({
  309:                     "field": f"domains.{domain}",
  310:                     "severity": "warning",
  311:                     "message": f"Unknown domain '{domain}'"
  312:                 })
  313: 
  314:     return issues
### studio/shared/providers_common/settings_schema.py
    1: """Provider settings schemas â€” validation, secrets, and visibility (step 11.3).
    2: 
    3: Implements the frozen settings contract of contracts.md Â§22:
    4: 
    5:   - Â§22.1 the JSON-Schema subset a provider's `settings_schema()` returns
    6:   - Â§22.2 the widget vocabulary, where an unrecognized `ui.type` is a warning
    7:   - Â§22.3 `ui.show_if`, where a hidden field keeps its value, is never required,
    8:     and never reaches the invocation config
    9:   - Â§22.4 `ui.options` and `ui.options_source` are mutually exclusive
   10:   - Â§22.5 issue shape `{field, severity, message}`, unknown saved keys preserved
   11:     and warned, required-but-empty is an error
   12:   - Â§22.6 what counts as a secret, and the `"***"` sentinel that makes a secret
   13:     field write-only
   14: 
   15: This module is the leaf of the settings import chain: it imports nothing from the
   16: rest of the package, so `settings_manager` and `registry` can both build on it.
   17: """
   18: 
   19: from __future__ import annotations
   20: 
   21: import re
   22: 
   23: 
   24: # -- secrets (contracts.md Â§22.6) -------------------------------------------
   25: 
   26: # A field is a secret if `ui.type == "password"` or its key matches this pattern.
   27: SENSITIVE_KEYS_RE = re.compile(
   28:     r"(api_key|token|secret|password|auth|bearer|credential)",
   29:     re.IGNORECASE,
   30: )
   31: 
   32: # What a redacted secret is replaced with on the way out, and the exact value the
   33: # client may send back to mean "leave the stored secret alone".
   34: REDACTION_SENTINEL = "***"
   35: 
   36: 
   37: # -- widget vocabulary (contracts.md Â§22.2) ---------------------------------
   38: 
   39: # `textarea` is frozen here even though 12.4 owns rendering it; `text` and
   40: # `number` are the explicit spellings of the absent-`ui.type` fallback and are
   41: # already used by shipped schemas.
   42: WIDGET_TYPES = frozenset({
   43:     "text",
   44:     "number",
   45:     "password",
   46:     "dropdown",
   47:     "select",
   48:     "slider",
   49:     "toggle",
   50:     "textarea",
   51: })
   52: 
   53: SEVERITIES = ("error", "warning", "info")
   54: _SEVERITY_RANK = {severity: index for index, severity in enumerate(SEVERITIES)}
   55: 
   56: _TYPE_CHECKS = {
   57:     "string": lambda value: isinstance(value, str),
   58:     "boolean": lambda value: isinstance(value, bool),
   59:     "integer": lambda value: isinstance(value, int) and not isinstance(value, bool),
   60:     "number": lambda value: isinstance(value, (int, float)) and not isinstance(value, bool),
   61: }
   62: 
   63: 
   64: def _issue(field: str, severity: str, message: str) -> dict:
   65:     return {"field": field, "severity": severity, "message": message}
   66: 
   67: 
   68: def properties(schema: dict | None) -> dict:
   69:     """The `properties` block of a schema, or `{}` for an absent/odd schema."""
   70:     if not isinstance(schema, dict):
   71:         return {}
   72:     props = schema.get("properties")
   73:     return props if isinstance(props, dict) else {}
   74: 
   75: 
   76: def _ui(prop: object) -> dict:
   77:     if not isinstance(prop, dict):
   78:         return {}
   79:     ui = prop.get("ui")
   80:     return ui if isinstance(ui, dict) else {}
   81: 
   82: 
   83: # -- visibility (contracts.md Â§22.3) ----------------------------------------
   84: 
   85: 
   86: def is_visible(prop: object, values: dict) -> bool:
   87:     """Evaluate `ui.show_if`: AND across keys, OR within each list of values."""
   88:     show_if = _ui(prop).get("show_if")
   89:     if not isinstance(show_if, dict) or not show_if:
   90:         return True
   91:     for field_name, allowed in show_if.items():
   92:         candidates = allowed if isinstance(allowed, list) else [allowed]
   93:         if values.get(field_name) not in candidates:
   94:             return False
   95:     return True
   96: 
   97: 
   98: def visible_fields(schema: dict | None, values: dict) -> set[str]:
   99:     """Schema property names whose `ui.show_if` condition currently holds."""
  100:     return {
  101:         key for key, prop in properties(schema).items() if is_visible(prop, values)
  102:     }
  103: 
  104: 
  105: # -- secrets ----------------------------------------------------------------
  106: 
  107: 
  108: def is_secret_field(key: str, prop: object = None) -> bool:
  109:     """True when `key` is a secret by widget type or by name (Â§22.6)."""
  110:     if _ui(prop).get("type") == "password":
  111:         return True
  112:     return bool(SENSITIVE_KEYS_RE.search(key))
  113: 
  114: 
  115: def secret_keys(schema: dict | None) -> set[str]:
  116:     """Every schema property that is a secret."""
  117:     return {
  118:         key for key, prop in properties(schema).items() if is_secret_field(key, prop)
  119:     }
  120: 
  121: 
  122: def split_settings(schema: dict | None, values: dict) -> tuple[dict, dict]:
  123:     """Split stored settings into `(secrets, options)`.
  124: 
  125:     Secrets are durable and machine-local; options are portable and safe to carry
  126:     into a workflow snapshot, an export, or a per-run config.
  127:     """
  128:     props = properties(schema)
  129:     secrets: dict = {}
  130:     options: dict = {}
  131:     for key, value in values.items():
  132:         target = secrets if is_secret_field(key, props.get(key)) else options
  133:         target[key] = value
  134:     return secrets, options
  135: 
  136: 
  137: def redact(values: dict, schema: dict | None = None) -> dict:
  138:     """Replace every secret value with the sentinel, recursing into nested dicts."""
  139:     if not isinstance(values, dict):
  140:         return values
  141:     props = properties(schema)
  142:     redacted: dict = {}
  143:     for key, value in values.items():
  144:         if is_secret_field(key, props.get(key)):
  145:             redacted[key] = REDACTION_SENTINEL
  146:         elif isinstance(value, dict):
  147:             redacted[key] = redact(value)
  148:         elif isinstance(value, list):
  149:             redacted[key] = [
  150:                 redact(item) if isinstance(item, dict) else item for item in value
  151:             ]
  152:         else:
  153:             redacted[key] = value
  154:     return redacted
  155: 
  156: 
  157: def apply_settings_patch(stored: dict, patch: dict, schema: dict | None = None) -> dict:
  158:     """Merge a client patch over stored settings, honoring the secret sentinel.
  159: 
  160:     A secret field whose submitted value is exactly `"***"` is the redacted value
  161:     the client was served; it means "unchanged" and must never overwrite the real
  162:     stored secret (Â§22.6).
  163:     """
  164:     props = properties(schema)
  165:     merged = dict(stored)
  166:     for key, value in (patch or {}).items():
  167:         if value == REDACTION_SENTINEL and is_secret_field(key, props.get(key)):
  168:             continue
  169:         merged[key] = value
  170:     return merged
  171: 
  172: 
  173: # -- invocation config (contracts.md Â§22.3) ---------------------------------
  174: 
  175: 
  176: def invocation_config(schema: dict | None, values: dict) -> dict:
  177:     """The settings a provider invocation may see.
  178: 
  179:     Hidden fields keep their stored value but are not sent. Keys with no schema
  180:     property are passed through: an unknown key is preserved, not dropped (Â§22.5).
  181:     """
  182:     props = properties(schema)
  183:     return {
  184:         key: value
  185:         for key, value in values.items()
  186:         if key not in props or is_visible(props[key], values)
  187:     }
  188: 
  189: 
  190: # -- validation (contracts.md Â§22.5) ----------------------------------------
  191: 
  192: 
  193: def is_empty(value: object) -> bool:
  194:     """Empty for the purposes of `required`. `False` and `0` are *not* empty."""
  195:     if value is None:
  196:         return True
  197:     if isinstance(value, str):
  198:         return not value.strip()
  199:     if isinstance(value, (list, dict, tuple, set)):
  200:         return not value
  201:     return False
  202: 
  203: 
  204: def _validate_ui_hints(key: str, prop: dict) -> list[dict]:
  205:     """Schema-authoring problems. Never errors â€” they must not block saving."""
  206:     issues: list[dict] = []
  207:     ui = _ui(prop)
  208:     widget = ui.get("type")
  209:     if widget is not None and widget not in WIDGET_TYPES:
  210:         issues.append(_issue(
  211:             key, "warning", f"Unknown widget type '{widget}'; rendered as a text input"
  212:         ))
  213:     if ui.get("options") is not None and ui.get("options_source") is not None:
  214:         issues.append(_issue(
  215:             key, "warning", "Both options and options_source are set; options_source wins"
  216:         ))
  217:     return issues
  218: 
  219: 
  220: def _validate_value(key: str, prop: dict, value: object) -> list[dict]:
  221:     issues: list[dict] = []
  222: 
  223:     declared = prop.get("type")
  224:     check = _TYPE_CHECKS.get(declared) if isinstance(declared, str) else None
  225:     if check is not None and not check(value):
  226:         return [_issue(
  227:             key,
  228:             "error",
  229:             f"{prop.get('label') or key} must be of type {declared}",
  230:         )]
  231: 
  232:     choices = prop.get("enum")
  233:     if isinstance(choices, list) and choices and value not in choices:
  234:         issues.append(_issue(
  235:             key, "error", f"{prop.get('label') or key} must be one of: {', '.join(map(str, choices))}"
  236:         ))
  237: 
  238:     if isinstance(value, (int, float)) and not isinstance(value, bool):
  239:         minimum = prop.get("minimum")
  240:         maximum = prop.get("maximum")
  241:         if isinstance(minimum, (int, float)) and value < minimum:
  242:             issues.append(_issue(
  243:                 key, "error", f"{prop.get('label') or key} must be at least {minimum}"
  244:             ))
  245:         if isinstance(maximum, (int, float)) and value > maximum:
  246:             issues.append(_issue(
  247:                 key, "error", f"{prop.get('label') or key} must be at most {maximum}"
  248:             ))
  249: 
  250:     return issues
  251: 
  252: 
  253: def validate_against_schema(schema: dict | None, values: dict) -> list[dict]:
  254:     """Validate stored settings against a provider settings schema.
  255: 
  256:     Returns `{field, severity, message}` dicts in a deterministic order. An absent
  257:     schema validates nothing â€” a provider without `settings_schema.py` is valid by
  258:     construction.
  259:     """
  260:     props = properties(schema)
  261:     if not props:
  262:         return []
  263: 
  264:     values = values if isinstance(values, dict) else {}
  265:     required = schema.get("required") if isinstance(schema, dict) else None
  266:     required = set(required) if isinstance(required, list) else set()
  267:     visible = visible_fields(schema, values)
  268: 
  269:     issues: list[dict] = []
  270: 
  271:     # Unknown saved keys are preserved and warned â€” dropping them would silently
  272:     # destroy configuration on a provider downgrade (Â§22.5).
  273:     for key in values:
  274:         if key not in props:
  275:             issues.append(_issue(
  276:                 key, "warning", f"Unknown setting '{key}' is kept but not used by this provider"
  277:             ))
  278: 
  279:     for key, prop in props.items():
  280:         if not isinstance(prop, dict):
  281:             issues.append(_issue(key, "warning", "Schema property is not an object; ignored"))
  282:             continue
  283:         if key not in visible:
  284:             # Hidden fields keep their value and are exempt from required (Â§22.3).
  285:             continue
  286: 
  287:         issues.extend(_validate_ui_hints(key, prop))
  288: 
  289:         value = values.get(key)
  290:         if is_empty(value):
  291:             if key in required:
  292:                 issues.append(_issue(
  293:                     key, "error", f"{prop.get('label') or key} is required"
  294:                 ))
  295:             continue
  296: 
  297:         issues.extend(_validate_value(key, prop, value))
  298: 
  299:     issues.sort(key=lambda i: (i["field"], _SEVERITY_RANK.get(i["severity"], len(SEVERITIES))))
  300:     return issues
  301: 
  302: 
