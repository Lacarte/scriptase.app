  245: # -- visual-domain envelopes -------------------------------------------------
  246: 
  247: 
  248: def visual_manifest_to_result(
  249:     manifest: Mapping[str, Any],
  250:     *,
  251:     domain: str,
  252:     provider_id: str,
  253:     manifest_ref: str,
  254:     provider_version: str = "",
  255: ) -> ProviderResult:
  256:     """A storyboard/animator manifest -> the Â§32.4/Â§32.5 envelope.
  257: 
  258:     `payload` carries only the counts and the manifest ref; per-scene detail
  259:     lives in `units[]`, which is what retires `scene_statuses` as a
  260:     provider-facing shape.
  261:     """
  262:     units = (
  263:         storyboard_manifest_to_units(manifest)
  264:         if domain == "storyboard"
  265:         else animator_manifest_to_units(manifest)
  266:     )
  267:     ready = sum(1 for unit in units if unit.state == UNIT_SUCCEEDED)
  268:     errors = sum(1 for unit in units if unit.state == UNIT_FAILED)
  269:     return ProviderResult(
  270:         domain=domain,
  271:         provider_id=provider_id,
  272:         provider_version=provider_version,
  273:         payload={
  274:             "total": len(units),
  275:             "ready": ready,
  276:             "errors": errors,
  277:             "manifest_ref": manifest_ref,
  278:         },
  279:         artifact_refs=dedupe_refs([manifest_ref]),
  280:         units=units,
  281:     )
  282: 
