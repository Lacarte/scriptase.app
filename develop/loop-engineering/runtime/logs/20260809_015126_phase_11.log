 278:     def validate_settings(self, settings: dict | None) -> list[ValidationIssue]:
 279:         """Validate settings against the schema, then through the provider hook.
 280: 
 281:         Never cached â€” the settings differ per call. Schema validation is the
 282:         server-side half the provider cannot skip; the hook adds whatever the
 283:         provider knows that the schema cannot express.
 284:         """
 285:         resolved = self.resolve_settings(settings)
 286:         issues = [
 287:             ValidationIssue(**issue)
 288:             for issue in schema_tools.validate_against_schema(
 289:                 self.settings_schema(), resolved
 290:             )
 291:         ]
 292: 
 293:         fn = self._resolve('validate_settings')
 294:         if fn is None:
 295:             return issues
 296: 
 297:         try:
 298:             raw_issues = fn(resolved)
 299:         except Exception as e:
 300:             # Never `str(e)`: a provider exception can contain a submitted secret
 301:             # (Â§22.5). The raw exception goes only to the redacted logger.
 302:             logger.warning("[registry] validate_settings failed for {}: {}", self.id, e)
 303:             issues.append(ValidationIssue(
 304:                 field='root', severity='error', message='Settings validation failed'
 305:             ))
 306:             return issues
 307: 
 308:         seen = {(i.field, i.severity, i.message) for i in issues}
 309:         for raw in raw_issues or []:
 310:             issue = (
 311:                 ValidationIssue(
 312:                     field=raw.get('field', ''),
 313:                     severity=raw.get('severity', 'warning'),
 314:                     message=raw.get('message', ''),
 315:                 )
 316:                 if isinstance(raw, dict)
 317:                 else raw
 318:             )
 319:             key = (issue.field, issue.severity, issue.message)
 320:             if key not in seen:
 321:                 seen.add(key)
 322:                 issues.append(issue)
 323:         return issues
 324: 
 325:     def health_check(self, settings: dict | None) -> HealthResult:
 326:         """Check provider health. May perform I/O; runs on explicit user action."""
 327:         fn = self._resolve('health_check')
 328:         if fn is None:
 329:             # A provider with no hook is `unknown`, not `ok` (Â§21.5, frozen
 330:             # correction): claiming health it never reported is a lie.
 331:             return HealthResult(status='unknown', message='No health check implemented')
 332:         try:
 333:             result = fn(self.resolve_settings(settings))
 334:         except Exception as e:
 335:             logger.warning("[registry] health_check failed for {}: {}", self.id, e)
 336:             return HealthResult(status='fail', message=v.sanitize_message(e))
 337:         if isinstance(result, dict):
 338:             message = result.get('message')
 339:             return HealthResult(
 340:                 status=result.get('status', 'unknown'),
 341:                 latency_ms=result.get('latency_ms'),
 342:                 # A *returned* message is as untrusted as a raised one: several
 343:                 # shipped hooks answer `{"status": "fail", "message": str(e)}`,
 344:                 # which can carry a URL, a path, or a response body (Â§36 L4).
 345:                 message=v.sanitize_message(message) if message else message,
 346:                 details=result.get('details'),
 347:             )
 348:         if isinstance(result, str):
 349:             return HealthResult(status=result)
 350:         return result
