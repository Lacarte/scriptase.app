  308: class ProviderLogger:
  309:     """The only logging surface a provider may use (Â§30.5).
  310: 
  311:     Every message and every field value passes through workflow redaction seeded
  312:     with the invocation's secrets before it reaches loguru, and every record is
  313:     tagged with the invocation identity so a provider never formats it itself.
  314:     """
  315: 
  316:     LEVELS = ("debug", "info", "warning", "error")
  317: 
  318:     def __init__(self, tags: Mapping[str, Any] | None = None, *, secrets: Any = ()):
  319:         self.tags = dict(tags or {})
  320:         self._secrets = set(secrets or ())
  321:         self.records: list[dict] = []
  322: 
  323:     def bind(self, **tags) -> "ProviderLogger":
  324:         merged = dict(self.tags)
  325:         merged.update(tags)
  326:         return ProviderLogger(merged, secrets=self._secrets)
  327: 
  328:     def debug(self, message: str, **fields) -> None:
  329:         self._write("debug", message, fields)
  330: 
  331:     def info(self, message: str, **fields) -> None:
  332:         self._write("info", message, fields)
  333: 
  334:     def warning(self, message: str, **fields) -> None:
  335:         self._write("warning", message, fields)
  336: 
  337:     def error(self, message: str, **fields) -> None:
  338:         """Write a log line. This does not fail the invocation (Â§30.5)."""
  339:         self._write("error", message, fields)
