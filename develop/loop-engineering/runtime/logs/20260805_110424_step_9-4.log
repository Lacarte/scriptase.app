+    if len(inventory) > MAX_ARCHIVE_FILES or total > MAX_ARCHIVE_BYTES:
+        raise ProjectArchiveError("ARCHIVE_TOO_LARGE", "Project archive exceeds safety limits")
+    manifest = {
+        "archive_schema_version": ARCHIVE_SCHEMA_VERSION,
+        "created_at": now_iso(),
