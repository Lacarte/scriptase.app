@@ -0,0 +1,154 @@
+"""Step 9.4: portable project archive and restore."""
+
+from __future__ import annotations
+
+import io
+import json
+import os
+import zipfile
+
+from flask import Flask
+
+import studio.workflows.persistence as persistence
+import studio.workflows.routes as workflow_routes
+from studio.workflows import workflows_bp
+from studio.workflows.execution import ExecutionManager
+from studio.workflows.project_archive import ProjectArchiveError, create_archive, restore_archive
+from studio.workflows.scheduler import WorkflowScheduler
+from studio.workflows.validation import validate_workflow, validation_errors
+
+
+def _workflow():
+    return {
+        "schema_version": 1,
+        "workflow_id": "wf_ABC123",
