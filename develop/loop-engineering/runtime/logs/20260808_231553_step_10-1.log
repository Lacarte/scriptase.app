  853: # --- TTS preview cache ---
  854: def _cache_key(text: str, voice: str, speed: float) -> str:
  855:     """Deterministic hash from (text, voice, speed)."""
  856:     raw = f"{text}|{voice}|{speed:.2f}"
  857:     return hashlib.sha256(raw.encode()).hexdigest()[:16]
  858: 
  859: 
  860: def _cache_path(key: str) -> str:
  861:     return os.path.join(TTS_CACHE_DIR, f"{key}.wav")
  862: 
