  853: # --- TTS preview cache ---
  854: def _cache_key(text: str, voice: str, speed: float) -> str:
  855:     """Deterministic hash from (text, voice, speed)."""
  856:     raw = f"{text}|{voice}|{speed:.2f}"
  857:     return hashlib.sha256(raw.encode()).hexdigest()[:16]
  858: 
  859: 
  860: def _cache_path(key: str) -> str:
  861:     return os.path.join(TTS_CACHE_DIR, f"{key}.wav")
  862: 
  863: 
  864: @tts_bp.route("/api/tts/cache/check", methods=["POST"])
  865: def cache_check():
  866:     """Check if a cached preview WAV exists for (text, voice, speed)."""
  867:     data = request.get_json(silent=True) or {}
  868:     text = (data.get("prompt") or "").strip()
  869:     voice = data.get("voice", "af_bella")
  870:     try:
  871:         speed = round(max(0.5, min(2.0, float(data.get("speed", 1.0)))), 2)
  872:     except (TypeError, ValueError):
  873:         speed = 1.0
  874:     if not text:
  875:         return jsonify({"cached": False})
  876:     key = _cache_key(text, voice, speed)
  877:     path = _cache_path(key)
  878:     if os.path.isfile(path):
  879:         return jsonify({"cached": True, "key": key})
  880:     return jsonify({"cached": False})
  881: 
  882: 
  883: @tts_bp.route("/api/tts/cache/<key>")
  884: def cache_serve(key):
  885:     """Serve a cached preview WAV file."""
  886:     key = re.sub(r'[^a-f0-9]', '', key)[:16]
  887:     path = _cache_path(key)
  888:     if not os.path.isfile(path):
  889:         return jsonify({"error": "Not found"}), 404
  890:     return send_from_directory(TTS_CACHE_DIR, f"{key}.wav", mimetype="audio/wav")
