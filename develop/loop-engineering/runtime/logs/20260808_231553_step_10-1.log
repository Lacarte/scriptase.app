  883: @tts_bp.route("/api/tts/cache/<key>")
  884: def cache_serve(key):
  885:     """Serve a cached preview WAV file."""
  886:     key = re.sub(r'[^a-f0-9]', '', key)[:16]
  887:     path = _cache_path(key)
  888:     if not os.path.isfile(path):
  889:         return jsonify({"error": "Not found"}), 404
  890:     return send_from_directory(TTS_CACHE_DIR, f"{key}.wav", mimetype="audio/wav")
