   59: def _step_tts(config, project_id):
   60:     """Generate TTS audio and return metadata dict (includes wav_path).
   61: 
   62:     Uses provider registry to resolve provider, load settings, and dispatch.
   63:     Resolution order:
   64:       1. config.provider_override if set
   65:       2. settings.json â†’ domains.tts.selected_provider
   66:       3. default: kokoro
   67:     """
   68:     from studio.tts.routes import _tts_job_dir
   69:     from studio.tts.normalize import clean_for_tts
   70:     from studio.tts.audio import run_loudnorm
   71:     from studio.tts.providers import registry as tts_registry
   72:     from studio.shared.providers_common import settings_manager, redact_settings
   73: 
   74:     text = config["text"]
   75:     speed = float(config.get("speed", 1.0))
   76: 
   77:     provider_id = (
   78:         config.get("tts_provider_override")
   79:         or config.get("tts_provider")
   80:         or settings_manager.get_domain_settings("tts").get("selected_provider")
   81:         or "kokoro"
   82:     )
   83: 
   84:     provider = tts_registry.get(provider_id)
   85:     if provider is None:
   86:         raise ValueError(f"TTS provider '{provider_id}' not found. Available: {tts_registry.list_ids()}")
   87: 
   88:     # Pick the voice that matches the resolved provider â€” the frontend sends
   89:     # both `voice` (kokoro) and `tts_voice` (inworld) so the wrong one must be
   90:     # ignored, otherwise Inworld rejects kokoro voice IDs like 'am_fenrir'.
   91:     if provider_id == "inworld":
   92:         voice = config.get("tts_voice") or config.get("voice") or "Carter"
   93:     else:
   94:         voice = config.get("voice") or "af_bella"
   95: 
   96:     provider_settings = settings_manager.get_provider_settings("tts", provider_id)
   97:     merged_settings = {**provider_settings, **config.get("tts_provider_options", {})}
   98: 
   99:     job_dir = _tts_job_dir(project_id)
  100:     os.makedirs(job_dir, exist_ok=True)
  101:     wav_path = os.path.join(job_dir, "voice.wav")
  102: 
  103:     if provider_id == "inworld":
  104:         return _step_tts_inworld_pipeline(
  105:             config, project_id, text, voice, speed, job_dir, wav_path,
  106:             provider_id, provider_version=provider.version, provider_kind=provider.kind,
  107:             provider_settings=merged_settings,
  108:         )
  109: 
  110:     return _step_tts_kokoro_pipeline(
  111:         config, project_id, text, voice, speed, job_dir, wav_path,
  112:         provider_id, provider_version=provider.version, provider_kind=provider.kind,
  113:         provider_settings=merged_settings,
  114:     )
