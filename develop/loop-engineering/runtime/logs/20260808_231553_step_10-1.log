  658: 
  659:         kokoro_inst = load_model()
  660:         voice_param = _blend_voices(kokoro_inst, voice_a, voice_b, ratio, method)
  661:         pct = int(round(ratio * 100))
  662:         voice_for_metadata = f"{voice_a} + {voice_b} ({pct}% {method.upper()})"
  663:         voice = voice_a
  664:         blend_meta = {"voice_a": voice_a, "voice_b": voice_b,
  665:                       "ratio": ratio, "method": method}
