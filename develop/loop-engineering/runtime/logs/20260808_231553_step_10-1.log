  864: @tts_bp.route("/api/tts/cache/check", methods=["POST"])
  865: def cache_check():
  866:     """Check if a cached preview WAV exists for (text, voice, speed)."""
  867:     data = request.get_json(silent=True) or {}
  868:     text = (data.get("prompt") or "").strip()
  869:     voice = data.get("voice", "af_bella")
  870:     try:
  871:         speed = round(max(0.5, min(2.0, float(data.get("speed", 1.0)))), 2)
  872:     except (TypeError, ValueError):
  873:         speed = 1.0
  874:     if not text:
  875:         return jsonify({"cached": False})
  876:     key = _cache_key(text, voice, speed)
  877:     path = _cache_path(key)
  878:     if os.path.isfile(path):
  879:         return jsonify({"cached": True, "key": key})
  880:     return jsonify({"cached": False})
  881: 
