  622: # --- Generate audio ---
  623: @tts_bp.route("/api/tts/generate", methods=["POST"])
  624: @validate_json(TtsGenerateRequest)
  625: def generate(data: TtsGenerateRequest):
  626:     provider = data.provider or "kokoro"
