  629:     if provider == "inworld":
  630:         return _generate_inworld(data)
  631: 
  632:     # â”€â”€ Kokoro provider (default) â”€â”€
  633:     model_id = data.model
  634:     voice = data.voice
  635:     prompt = data.prompt
  636:     speed = data.speed
  637:     max_silence_ms = data.max_silence_ms
  638:     blend = data.blend
  639: 
  640:     if model_id not in MODELS:
  641:         return jsonify({"error": "Unknown model"}), 404
  642: 
  643:     voice_for_metadata = voice
  644:     voice_param = voice
  645:     blend_meta = None
  646: 
  647:     if blend:
  648:         voice_a = blend.voice_a
  649:         voice_b = blend.voice_b
  650:         ratio = blend.ratio
  651:         method = blend.method
  652:         if method not in ("slerp", "lerp"):
  653:             method = "slerp"
  654:         if voice_a not in VOICES:
  655:             return jsonify({"error": f"Unknown voice_a: {voice_a}"}), 400
  656:         if voice_b not in VOICES:
