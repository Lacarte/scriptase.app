  91: def _artifact_refs(value: Any, output_dir: str, *, branding_strings: bool = False) -> set[str]:
  92:     refs: set[str] = set()
  93:     if isinstance(value, Mapping):
  94:         explicit = value.get("artifact_refs")
  95:         if isinstance(explicit, list):
  96:             for item in explicit:
  97:                 if isinstance(item, str):
  98:                     ref = _managed_ref(item, output_dir)
  99:                     if ref:
 100:                         refs.add(ref)
 101:         for child in value.values():
 102:             refs.update(_artifact_refs(child, output_dir, branding_strings=branding_strings))
 103:     elif isinstance(value, list):
 104:         for child in value:
 105:             refs.update(_artifact_refs(child, output_dir, branding_strings=branding_strings))
 106:     elif branding_strings and isinstance(value, str):
 107:         ref = _managed_ref(value, output_dir)
 108:         if ref and PurePosixPath(ref).parts[:1] == ("branding",):
 109:             refs.add(ref)
 110:     return refs
