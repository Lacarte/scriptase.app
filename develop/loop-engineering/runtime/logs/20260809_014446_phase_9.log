 135: def scan_orphans(
 136:     *, output_dir: str = OUTPUT_DIR, protected_paths: Iterable[str] = DEFAULT_PROTECTED_PATHS
 137: ) -> list[OrphanArtifact]:
 138:     output_dir = os.path.abspath(output_dir)
 139:     protected = tuple(protected_paths)
 140:     referenced = referenced_artifacts(output_dir=output_dir)
 141:     orphans: list[OrphanArtifact] = []
 142:     if not os.path.isdir(output_dir):
 143:         return orphans
 144:     for root, dirs, files in os.walk(output_dir, topdown=True, followlinks=False):
 145:         relative_root = os.path.relpath(root, output_dir)
 146:         root_parts = () if relative_root == "." else PurePosixPath(relative_root.replace("\\", "/")).parts
 147:         dirs[:] = [
 148:             name for name in dirs
 149:             if not os.path.islink(os.path.join(root, name))
 150:             and not _protected(PurePosixPath(*root_parts, name), protected)
 151:         ]
 152:         for name in files:
 153:             absolute = os.path.join(root, name)
 154:             if os.path.islink(absolute):
 155:                 continue
 156:             relative = PurePosixPath(*root_parts, name)
 157:             ref = relative.as_posix()
 158:             if _protected(relative, protected) or ref in referenced:
 159:                 continue
 160:             try:
 161:                 stat = os.stat(absolute, follow_symlinks=False)
 162:             except OSError:
 163:                 continue
 164:             orphans.append(OrphanArtifact(ref, stat.st_size, stat.st_mtime))
 165:     return sorted(orphans, key=lambda item: item.path)
 166: 
