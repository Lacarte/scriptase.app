 168: def collect_orphans(
 169:     *, output_dir: str = OUTPUT_DIR, paths: Iterable[str] | None = None,
 170:     dry_run: bool = True, protected_paths: Iterable[str] = DEFAULT_PROTECTED_PATHS,
 171: ) -> dict[str, Any]:
 172:     """Report or delete requested files that are still present in a fresh orphan scan."""
 173:     scanned = scan_orphans(output_dir=output_dir, protected_paths=protected_paths)
 174:     by_path = {item.path: item for item in scanned}
 175:     requested = sorted(set(paths)) if paths is not None else sorted(by_path)
 176:     invalid = [path for path in requested if not isinstance(path, str) or path not in by_path]
 177:     if invalid:
 178:         raise ValueError("Only paths from the current orphan scan may be collected")
 179:     selected = [by_path[path] for path in requested]
 180:     deleted: list[str] = []
 181:     failures: list[dict[str, str]] = []
 182:     if not dry_run:
 183:         root = os.path.abspath(output_dir)
 184:         for item in selected:
 185:             absolute = os.path.abspath(os.path.join(root, *PurePosixPath(item.path).parts))
 186:             try:
 187:                 if os.path.commonpath([root, absolute]) != root or os.path.islink(absolute):
 188:                     raise OSError("unsafe artifact path")
 189:                 os.remove(absolute)
 190:                 deleted.append(item.path)
 191:             except OSError as exc:
 192:                 failures.append({"path": item.path, "message": str(exc)})
 193:     return {
 194:         "dry_run": dry_run,
 195:         "orphans": [asdict(item) for item in selected],
 196:         "count": len(selected),
 197:         "bytes": sum(item.size for item in selected),
 198:         "deleted": deleted,
 199:         "failures": failures,
 200:         "protected_paths": list(protected_paths),
 201:     }
 202: 
 203: 
 204: def main(argv: list[str] | None = None) -> int:
 205:     parser = argparse.ArgumentParser(description="Find and optionally delete orphaned output assets.")
 206:     parser.add_argument("--output-dir", default=OUTPUT_DIR, help="managed output directory")
 207:     parser.add_argument("--delete", action="store_true", help="delete current orphans (default: dry run)")
 208:     parser.add_argument("--json", action="store_true", help="print the machine-readable report")
 209:     args = parser.parse_args(argv)
 210:     report = collect_orphans(output_dir=args.output_dir, dry_run=not args.delete)
 211:     if args.json:
 212:         print(json.dumps(report, indent=2))
 213:     else:
 214:         mode = "DRY RUN" if report["dry_run"] else "DELETED"
 215:         print(f"{mode}: {report['count']} orphan(s), {report['bytes']} byte(s)")
 216:         for item in report["orphans"]:
 217:             print(f"  {item['path']} ({item['size']} bytes)")
 218:         for failure in report["failures"]:
 219:             print(f"  FAILED {failure['path']}: {failure['message']}")
 220:     return 1 if report["failures"] else 0
