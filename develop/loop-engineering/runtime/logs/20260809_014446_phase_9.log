 103: def test_restore_rejects_traversal_and_checksum_tampering(tmp_path):
 104:     _seed(tmp_path)
 105:     source = io.BytesIO()
 106:     create_archive("wf_ABC123", "pm_ABC123", source, output_dir=str(tmp_path))
 107:     source.seek(0)
 108:     tampered = io.BytesIO()
 109:     with zipfile.ZipFile(source) as original, zipfile.ZipFile(tampered, "w") as changed:
 110:         for info in original.infolist():
 111:             data = original.read(info.filename)
 112:             if info.filename == "workflow.json":
 113:                 data += b" "
 114:             changed.writestr(info.filename, data)
 115:         changed.writestr("../escape", b"bad")
 116:     tampered.seek(0)
 117:     try:
 118:         restore_archive(tampered, output_dir=str(tmp_path))
 119:     except ProjectArchiveError as exc:
 120:         assert exc.code == "ARCHIVE_INVALID"
 121:     else:
 122:         raise AssertionError("unsafe archive was accepted")
 123:     assert not (tmp_path.parent / "escape").exists()
