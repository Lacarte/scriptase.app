  68: def _managed_ref(value: str, output_dir: str) -> str | None:
  69:     raw = value.strip().replace("\\", "/")
  70:     if raw.startswith("/output/"):
  71:         raw = raw[8:]
  72:     elif raw.startswith("output/"):
  73:         raw = raw[7:]
  74:     elif os.path.isabs(value):
  75:         try:
  76:             raw = os.path.relpath(os.path.abspath(value), os.path.abspath(output_dir)).replace("\\", "/")
  77:         except ValueError:
  78:             return None
  79:     path = PurePosixPath(raw)
  80:     if not raw or path.is_absolute() or ".." in path.parts:
  81:         return None
  82:     target = os.path.abspath(os.path.join(output_dir, *path.parts))
  83:     try:
  84:         if os.path.commonpath([os.path.abspath(output_dir), target]) != os.path.abspath(output_dir):
  85:             return None
  86:     except ValueError:
  87:         return None
  88:     return path.as_posix()
