 127: def _protected(path: PurePosixPath, protected_paths: tuple[str, ...]) -> bool:
 128:     for prefix in protected_paths:
 129:         protected = PurePosixPath(prefix.replace("\\", "/").strip("/"))
 130:         if protected.parts and path.parts[:len(protected.parts)] == protected.parts:
 131:             return True
 132:     return False
