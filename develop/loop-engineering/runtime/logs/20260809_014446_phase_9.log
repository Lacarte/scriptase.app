 113: def _pinned_workflow_refs(workflow: Mapping[str, Any], output_dir: str) -> set[str]:
 114:     """Collect direct managed paths held by pinned Result Viewer payloads."""
 115:     refs: set[str] = set()
 116:     for node in workflow.get("nodes", []):
 117:         if not isinstance(node, Mapping) or node.get("type") != "stub.output":
 118:             continue
 119:         config = node.get("configuration")
 120:         if not isinstance(config, Mapping) or config.get("pinned") is not True:
 121:             continue
 122:         pending = [config.get("payload")]
 123:         while pending:
 124:             value = pending.pop()
 125:             if isinstance(value, Mapping):
 126:                 pending.extend(value.values())
 127:             elif isinstance(value, list):
 128:                 pending.extend(value)
 129:             elif isinstance(value, str):
 130:                 ref = _managed_ref(value, output_dir)
 131:                 if ref and os.path.isfile(os.path.join(output_dir, *PurePosixPath(ref).parts)):
 132:                     refs.add(ref)
 133:     return refs
