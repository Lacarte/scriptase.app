 130: class ExecutionManager:
 131:     def __init__(
 132:         self,
 133:         *,
 134:         output_dir: str = OUTPUT_DIR,
 135:         max_events: int = 1000,
 136:         executor_resolver=resolve_executor,
 137:     ):
 138:         self.output_dir = output_dir
 139:         self.execution_root = os.path.join(output_dir, "workflows", "executions")
 140:         self.queue_root = os.path.join(output_dir, "workflows", "queue")
 141:         self.active = JobStore()
 142:         self.events = EventBroker(max_events=max_events)
 143:         self.executor_resolver = executor_resolver
 144:         self._queue_lock = threading.Lock()
 145:         self._project_queues: dict[str, deque[ActiveExecution]] = {}
 146:         self._project_workers: dict[str, threading.Thread] = {}
 147: 
 148:     def start(
 149:         self,
 150:         workflow: Mapping[str, Any],
 151:         *,
 152:         run_mode: str,
 153:         target_node_ids: list[str],
 154:         project_id: str | None = None,
 155:         force: bool = False,
 156:         source: str = "manual",
 157:         input_overrides: Mapping[str, Mapping[str, Any]] | None = None,
 158:     ) -> tuple[str, str]:
 159:         if source not in {"manual", "schedule", "watch", "webhook"}:
 160:             raise ExecutionRequestError("BAD_REQUEST", "Unsupported run source")
 161:         overrides = self._validate_input_overrides(workflow, input_overrides or {})
 162:         snapshot = prepare_snapshot(workflow, input_overrides=overrides)
 163:         scope = resolve_scope(snapshot, run_mode, target_node_ids)
 164:         resolved_project = resolve_project_id(snapshot, project_id)
 165:         execution_id = generate_execution_id(root=self.execution_root)
 166:         stream = self.events.create(execution_id)
 167:         stop_event = threading.Event()
 168:         queue_record = QueueRecord(
 169:             execution_id=execution_id,
 170:             workflow_id=snapshot["workflow_id"],
 171:             project_id=resolved_project,
 172:             source=source,
 173:             requested_run_mode=run_mode,
 174:             target_node_ids=list(target_node_ids),
 175:             requested_at=now_iso(),
 176:         )
 177: 
 178:         def emit(event: dict[str, Any]) -> None:
 179:             # Persist the queue transition before publishing the terminal SSE;
 180:             # clients may refresh the queue as soon as they receive it.
 181:             if event.get("node_id") is None and event.get("status") in TERMINAL_STATUSES:
 182:                 status = event["status"]
 183:                 queue_record.status = (
 184:                     "done" if status in {"succeeded", "partial"}
 185:                     else "cancelled" if status == "cancelled"
 186:                     else "failed"
 187:                 )
 188:                 queue_record.finished_at = now_iso()
 189:                 save_queue_record(queue_record, root=self.queue_root)
 190:             stream.emit(event)
 191: 
 192:         scheduler = WorkflowScheduler(
 193:             snapshot,
 194:             project_id=resolved_project,
 195:             execution_id=execution_id,
 196:             output_dir=self.output_dir,
 197:             run_mode=run_mode,
 198:             scope_node_ids=scope,
 199:             stop_requested=stop_event.is_set,
 200:             on_event=emit,
 201:             executor_resolver=self.executor_resolver,
 202:             force=force,
 203:             input_overrides=overrides,
 204:         )
 205:         scheduler.record.status = "queued"
 206:         save_execution(scheduler.record, root=self.execution_root, secrets=scheduler.redactor.secrets)
 207:         stream.emit({"type": "execution_status", "node_id": None, "status": "queued"})
 208:         save_queue_record(queue_record, root=self.queue_root)
 209:         handle = ActiveExecution(
 210:             scheduler=scheduler, stop_event=stop_event, queue_record=queue_record
 211:         )
 212:         self.active.set(execution_id, handle)
 213:         with self._queue_lock:
 214:             queue = self._project_queues.setdefault(resolved_project, deque())
 215:             queue.append(handle)
 216:             worker = self._project_workers.get(resolved_project)
 217:             if worker is None or not worker.is_alive():
 218:                 worker = threading.Thread(
 219:                     target=self._drain_project,
 220:                     args=(resolved_project,),
 221:                     name=f"workflow-queue-{resolved_project}",
 222:                     daemon=True,
 223:                 )
 224:                 self._project_workers[resolved_project] = worker
 225:                 handle.thread = worker
 226:                 worker.start()
 227:             else:
 228:                 handle.thread = worker
 229:         return execution_id, resolved_project
 230: 
 231:     @staticmethod
 232:     def _validate_input_overrides(
 233:         workflow: Mapping[str, Any],
 234:         supplied: Mapping[str, Mapping[str, Any]],
 235:     ) -> dict[str, dict[str, Any]]:
 236:         if not isinstance(supplied, Mapping):
 237:             raise ExecutionRequestError("BAD_REQUEST", "input_overrides must be an object")
 238:         nodes = {node.get("id"): node for node in workflow.get("nodes", []) if isinstance(node, Mapping)}
 239:         result: dict[str, dict[str, Any]] = {}
 240:         for node_id, ports in supplied.items():
 241:             node = nodes.get(node_id)
 242:             if node is None or node.get("disabled"):
 243:                 raise ExecutionRequestError("BAD_REQUEST", f"Input override node is unavailable: {node_id}")
 244:             if not isinstance(ports, Mapping):
 245:                 raise ExecutionRequestError("BAD_REQUEST", "Input override ports must be an object")
 246:             definition = get_node_type(node.get("type")) or {}
 247:             known = {port.get("id"): port for port in definition.get("inputs", [])}
 248:             result[str(node_id)] = {}
 249:             for port_id, value in ports.items():
 250:                 port = known.get(port_id)
 251:                 port_type = port.get("type") if port else None
 252:                 if port_type == "dynamic":
 253:                     port_type = (node.get("configuration") or {}).get("port_type")
 254:                 problems = validate_stub_payload(port_type, value) if port else []
 255:                 if not port or port_type == "control" or problems:
 256:                     raise ExecutionRequestError(
 257:                         "BAD_REQUEST", f"Input override {node_id}.{port_id} is not valid {port_type or 'data'}",
 258:                         details={"problems": problems} if problems else None,
 259:                     )
 260:                 result[str(node_id)][str(port_id)] = value
 261:         return result
 262: 
 263:     def _drain_project(self, project_id: str) -> None:
 264:         """Drain one project's FIFO without occupying workers for other projects."""
 265:         while True:
 266:             with self._queue_lock:
 267:                 queue = self._project_queues.get(project_id)
 268:                 if not queue:
 269:                     self._project_queues.pop(project_id, None)
 270:                     self._project_workers.pop(project_id, None)
 271:                     return
 272:                 handle = queue.popleft()
 273:                 if handle.queue_record.status == "cancelled":
 274:                     continue
 275:                 handle.queue_record.status = "running"
 276:                 handle.queue_record.started_at = now_iso()
 277:                 handle.scheduler.record.status = "running"
 278:                 handle.scheduler.record.started_at = handle.queue_record.started_at
 279:                 save_queue_record(handle.queue_record, root=self.queue_root)
 280:                 save_execution(
 281:                     handle.scheduler.record,
 282:                     root=self.execution_root,
 283:                     secrets=handle.scheduler.redactor.secrets,
 284:                 )
 285:             handle.thread = threading.current_thread()
 286:             self._run(handle, self.events.create(handle.scheduler.execution_id))
 287: 
 288:     def _run(self, handle: ActiveExecution, stream: ExecutionEventBuffer) -> None:
 289:         try:
 290:             handle.scheduler.run()
 291:         except Exception as exc:  # lock acquisition and scheduler setup boundary
 292:             record = handle.scheduler.record
 293:             status = "cancelled" if handle.stop_event.is_set() else "failed"
 294:             record.status = status
 295:             record.finished_at = now_iso()
 296:             save_execution(record, root=self.execution_root, secrets=handle.scheduler.redactor.secrets)
 297:             handle.queue_record.status = "cancelled" if status == "cancelled" else "failed"
 298:             handle.queue_record.finished_at = record.finished_at
 299:             save_queue_record(handle.queue_record, root=self.queue_root)
 300:             stream.emit({
 301:                 "type": "execution_finished",
 302:                 "node_id": None,
 303:                 "status": status,
 304:                 "error": {
 305:                     "code": getattr(exc, "code", "NODE_EXECUTION_FAILED"),
 306:                     "message": str(exc),
 307:                 },
 308:             })
