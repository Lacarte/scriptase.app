 829:     def _status(
 830:         self,
 831:         statuses: dict[str, str],
 832:         node_id: str,
 833:         status: str,
 834:         *,
 835:         node_record: NodeExecutionRecord | None = None,
 836:     ) -> None:
 837:         # A node keeps its own event order on its worker thread.  This lock
 838:         # makes the shared execution snapshot and the corresponding SSE event
 839:         # one atomic transition, even when sibling branches finish together.
 840:         with self._state_lock:
 841:             record = node_record or deepcopy(self.record.nodes[node_id])
 842:             statuses[node_id] = status
 843:             record.status = status
 844:             record.logs.append(self.redactor(ExecutionLog(
 845:                 ts=now_iso(), level="info", message=f"Node status changed to {status}"
 846:             ).__dict__))
 847:             self.record.nodes[node_id] = deepcopy(record)
 848:             self._persist_unlocked()
 849:             if self.on_status:
 850:                 self.on_status(node_id, status)
 851:             self._emit({
 852:                 "type": "node_status",
 853:                 "execution_id": self.execution_id,
 854:                 "node_id": node_id,
 855:                 "status": status,
 856:                 "attempt": record.attempts,
 857:                 "duration_ms": record.duration_ms or 0,
 858:                 "from_sample_data": record.from_sample_data,
 859:             })
 860: 
 861:     def _commit_node_record(self, node_id: str, node_record: NodeExecutionRecord) -> None:
 862:         with self._state_lock:
 863:             self.record.nodes[node_id] = deepcopy(node_record)
 864:             self._persist_unlocked()
 865: 
 866:     def _persist(self) -> dict[str, Any]:
 867:         with self._state_lock:
 868:             return self._persist_unlocked()
 869: 
 870:     def _persist_unlocked(self) -> dict[str, Any]:
 871:         return save_execution(self.record, root=self.execution_root, secrets=self.redactor.secrets)
 872: 
 873:     def _emit(self, event: dict[str, Any]) -> None:
 874:         if self.on_event:
 875:             self.on_event(self.redactor(event))
 876: 
 877:     @staticmethod
 878:     def _error_policy(node: Mapping[str, Any]) -> dict[str, Any]:
 879:         supplied = node.get("on_error") or {}
 880:         return {
 881:             "policy": supplied.get("policy", "stop"),
 882:             "max_attempts": supplied.get("max_attempts", 3),
 883:             "delay_ms": supplied.get("delay_ms", 1000),
 884:             "backoff_multiplier": supplied.get("backoff_multiplier", 2.0),
 885:         }
 886: 
 887:     def _failure_payload(self, node: Mapping[str, Any], exc: Exception, attempt: int) -> dict[str, Any]:
 888:         code = getattr(exc, "code", "NODE_EXECUTION_FAILED")
 889:         message = "Execution was cancelled" if code == "CANCELLED" else str(exc)
 890:         suggestion = (
 891:             "Start a new run when ready."
 892:             if code == "CANCELLED"
 893:             else "Review the node inputs and settings, then retry the failed node."
 894:         )
 895:         return self.redactor({
 896:             "node_id": node["id"],
 897:             "node_name": node.get("name") or node["id"],
 898:             "code": code,
 899:             "message": message,
 900:             "details": getattr(exc, "details", None),
 901:             "attempt": attempt,
 902:             "timestamp": now_iso(),
 903:             "recovery_suggestion": suggestion,
 904:         })
