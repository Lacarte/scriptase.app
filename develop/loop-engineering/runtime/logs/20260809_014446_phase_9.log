 624: def workflow_run():
 625:     denied = _require_loopback()
 626:     if denied:
 627:         return denied
 628:     body, failure = _json_body()
 629:     if failure:
 630:         return failure
 631:     has_id = "workflow_id" in body
 632:     has_snapshot = "workflow" in body
 633:     if has_id == has_snapshot:
 634:         return _error("BAD_REQUEST", "Provide exactly one of workflow_id or workflow", 400)
 635:     targets = body.get("target_node_ids", [])
 636:     if not isinstance(targets, list) or any(not isinstance(item, str) for item in targets):
 637:         return _error("BAD_REQUEST", "target_node_ids must be an array of node IDs", 400)
 638:     if not isinstance(body.get("force", False), bool):
 639:         return _error("BAD_REQUEST", "force must be a boolean", 400)
 640:     try:
 641:         if has_id:
 642:             workflow = load_workflow(body.get("workflow_id"))
 643:         elif isinstance(body.get("workflow"), dict):
 644:             workflow = body["workflow"]
 645:         else:
 646:             return _error("BAD_REQUEST", "workflow must be an object", 400)
 647:         execution_id, project_id = execution_manager.start(
 648:             workflow,
 649:             run_mode=body.get("run_mode", "full"),
 650:             target_node_ids=targets,
 651:             project_id=body.get("project_id"),
 652:             force=body.get("force", False),
 653:         )
 654:     except WorkflowNotFound:
 655:         return _error("NOT_FOUND", "Workflow not found", 404)
 656:     except ExecutionRequestError as exc:
 657:         status = 422 if exc.code in {"WORKFLOW_INVALID", "MISSING_REQUIRED_INPUT"} else 400
 658:         return _error(exc.code, str(exc), status, exc.details)
 659:     except ValueError as exc:
 660:         return _error("BAD_REQUEST", str(exc), 400)
 661:     return jsonify({
 662:         "execution_id": execution_id,
 663:         "project_id": project_id,
 664:         "status": "queued",
 665:     }), 202
