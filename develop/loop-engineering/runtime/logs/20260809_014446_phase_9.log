 297: // â”€â”€ Auto-align: magnet a dropped node into a neighbor's row/column â”€â”€â”€â”€â”€
 298: const ALIGN_TOLERANCE = 12
 299: 
 300: function magnetAlign(id, position) {
 301:   const aligned = { x: position.x, y: position.y }
 302:   let bestDx = ALIGN_TOLERANCE + 1
 303:   let bestDy = ALIGN_TOLERANCE + 1
 304:   for (const other of [...store.nodes, ...store.notes]) {
 305:     if (other.id === id) continue
 306:     const dx = Math.abs(other.position.x - position.x)
 307:     const dy = Math.abs(other.position.y - position.y)
 308:     if (dx <= ALIGN_TOLERANCE && dx < bestDx) { bestDx = dx; aligned.x = other.position.x }
 309:     if (dy <= ALIGN_TOLERANCE && dy < bestDy) { bestDy = dy; aligned.y = other.position.y }
 310:   }
 311:   return aligned
 312: }
