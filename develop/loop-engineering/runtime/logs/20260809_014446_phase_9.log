 253: def _allocate_id(pattern, prefix: str, existing) -> str:
 254:     alphabet = string.ascii_uppercase + string.digits
 255:     for _ in range(500):
 256:         candidate = prefix + "_" + "".join(random.SystemRandom().choices(alphabet, k=6))
 257:         if pattern.fullmatch(candidate) and not existing(candidate):
 258:             return candidate
 259:     raise ProjectArchiveError("RESTORE_CONFLICT", f"Could not allocate a new {prefix} identifier")
