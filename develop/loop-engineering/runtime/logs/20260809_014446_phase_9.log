 906:     def _sleep_before_retry(self, seconds: float) -> None:
 907:         """Wait in short intervals so a stop request interrupts long backoffs."""
 908:         remaining = seconds
 909:         while remaining > 0 and not self.stop_requested():
 910:             interval = min(0.1, remaining)
 911:             self.sleeper(interval)

