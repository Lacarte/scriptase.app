+    workflow = _workflow()
+    workflow["workflow_id"] = "wf_CONCUR"
+    rendezvous = threading.Barrier(2)
+
+    def resolver(_node):
+        def execute(_inputs, _config, context):
+            # Neither run can pass this point unless both project workers are
+            # executing at the same time.
