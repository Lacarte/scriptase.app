+@workflows_bp.route("/api/workflow/notifications", methods=["GET"])
+def workflow_notifications_list():
+    denied = _require_loopback()
+    if denied:
+        return denied
+    workflow_id = request.args.get("workflow_id", "")
+    try:
+        limit = int(request.args.get("limit", 100))
