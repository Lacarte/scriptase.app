+        changed = mark_notifications_seen(
+            body.get("workflow_id"), output_dir=execution_manager.output_dir
+        )
+    except ValueError as exc:
+        return _error("BAD_REQUEST", str(exc), 400)
+    return jsonify({"seen": True, "updated": changed})
+
+
