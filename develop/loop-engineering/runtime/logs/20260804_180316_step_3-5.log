+@workflows_bp.route("/api/workflow/run", methods=["POST"])
+def workflow_run():
+    denied = _require_loopback()
+    if denied:
+        return denied
+    body, failure = _json_body()
+    if failure:
+        return failure
+    has_id = "workflow_id" in body
+    has_snapshot = "workflow" in body
+    if has_id == has_snapshot:
