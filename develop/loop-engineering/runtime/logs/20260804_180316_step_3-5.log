  }

  async function saveWorkflow() {
    persistenceLoading.value = true
    persistenceError.value = ''
    try {
      const document = toDocument()
      const data = workflowId.value
        ? await api.put(`/api/workflows/${encodeURIComponent(workflowId.value)}`, {
