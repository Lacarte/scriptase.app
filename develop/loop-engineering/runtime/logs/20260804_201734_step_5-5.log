+        field: { name: 'delay', type: 'number', default: 1 },
+        value: 1,
+        expressionOptions: [option],
+      },
+    })
+    await wrapper.get('[aria-label="Insert expression"]').setValue(option.value)
+    expect(wrapper.emitted('update').at(-1)).toEqual([option.value])
