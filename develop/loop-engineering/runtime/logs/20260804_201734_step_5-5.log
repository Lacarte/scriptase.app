+
+
+def _workflow(target_value="{{ nodes.source.outputs.value }}"):
+    return {
+        "schema_version": 1, "workflow_id": "wf_ABC123", "name": "Expressions", "description": "",
+        "nodes": [_node("source", {"typed": [1, True]}), _node("target", target_value)],
+        "edges": [{
